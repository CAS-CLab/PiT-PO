    x2 = (np.cos(2*arctans(strains)) + strains**3) * (np.pi/4 + params[1])
    x3 = (np.exp(-(temp - 25)/(params[2] + 1)) + strains*(temp - 20) + ((temp - 20)**3)*params[3]) * (1 + np.tanh(params[4]*temp))
    return x1 + x2 + x3
