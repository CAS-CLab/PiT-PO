       params[6]*cos(params[7]*strain + params[8]*temp)*strain**2 + \
       params[9]*tanh(params[7]*strain + params[8]*temp) + params[10]*(sin(params[11]*strain + params[12]*temp)/sqrt(params[13]*strain**2 + params[14]*temp**2))
