    stress = z[0] * x + z[1] * y + \
        (z[2] * x**5 + z[3] * y**5 + z[4] * x*y**(y+z*x)) + \
        (z[5] * x**3 + z[6] * y**3 + z[7] * x**2 + z[8] * y**2) + \
        (np.cos(z[9]) * np.exp(x+y))
    return stress
