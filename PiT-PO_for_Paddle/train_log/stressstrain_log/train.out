def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u = np.sum([params[0]*(strain + temp)**5,
            params[1]*(strain**5), 
            params[2]*(temp**5), 
            params[3]*(strain*temp)**4, 
            params[4]*(strain**4 + temp**4)])
    v = np.sum([params[5]*(temp - strain)**4,
            params[6]*(strain**3 + temp**3), 
            params[7]*(strain + temp)**3, 
            params[8]*(np.maximum(temp**3, strain**3))])
    w = np.sum([params[9]*(strain + temp)**5,
            np.sum([params[0]*(strain + temp), 
                    np.sum([params[1]*(strain**2), 
                            np.sum([params[2]*(temp**2), 
                                    np.sum([params[3]*(strain*temp), 
                                            np.sum([params[4]*(strain + temp), 
                                                    np.sum([params[5]*(temp - strain)])])])])])])])
    x = np.sum([np.sum([params[6]*(strain**4),
                     np.sum([params[7]*(temp**4)])]), 
           np.sum([np.sum([params[8]*(strain**5), 
                           np.sum([params[9]*(temp**5)])])])])
    return u + v + w + x
