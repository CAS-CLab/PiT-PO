    params[0] * (strain + temp) +\
    (np.sin(strain) + np.cos(temp)) * params[1] +\
    (np.log(strain) + np.tan(temp)) * params[2] +\
    (np.sqrt(strain) + np.cbrt(temp)) * params[3] +\
