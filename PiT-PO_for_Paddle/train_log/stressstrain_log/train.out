                   np.log(params[2])*(strain + temp),
                   np.log(params[3])*(strain - temp),
                   np.log(params[4])*(strain**2 + temp**2)]))
    stress = u**2 * (np.sin(params[5]*strain + np.cos(params[6]*temp)) +
                np.tanh(params[7]*strain + np.cosh(params[8]*temp)))
    return stress
