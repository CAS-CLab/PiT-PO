def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    f = params[0] * (strain + 3) * (temp - 10) * (strain + 2) + \
    params[1] * (strainsq + straintemp + strain^3 + strainsqrt + straintemp^3) + \
    params[2] * (strain + 5) * (temp - 25) * (strain + 2)^2 + \
    params[3] * (strain^3 + strainsqrt + strain^3 + straintemp^3 + strain^3) + \
    params[4] * sin(arccos(strain) + arctan(temp - 20)) + \
    params[5] * (strain + 5) * (temp - 20) * (strain + 2) + \
    params[6] * (strain + 3) * (temp - 30)^3 + \
    params[7] * (strain + 5) * (temp - 40) * (sin(strain) + cos(arctan(temp - 20))) + \
    params[8] * (strain + 2) * (temp - 20) * (strain + 3)^2 + \
    params[9] * (strain + 5) * (strain + 3) * (temp - 10) * (arctanh(strain) + sinh(arccos(strain)))
    return f
