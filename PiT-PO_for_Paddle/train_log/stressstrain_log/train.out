def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    h = params[0] * (strain + temp)
    i = params[1] * (strain ** 2 + temp**2)
    j = params[2] * (temp ** 3 + strain ** 3 + strain * temp**2 + strain * temp)
    k = params[3] * (temp ** 4 + strain ** 4 + 3 * strain ** 2 * temp + 3 * strain * temp ** 2)
    l = params[4] * (strain + temp)
    m = params[5] * (strain ** 3 + 3 * strain * temp ** 2 + 3 * strain * temp)
    n = params[6] * (strain * temp + temp * strain)
    o = params[7] * (temp ** 5 + strain ** 5 + 5 * strain ** 3 * temp + 5 * strain * temp ** 3)
    p = params[8] * (temp + strain)
    q = params[9] * (temp ** 2 + strain ** 2)
    return h + i + j + k + l + m + n + o + p + q
