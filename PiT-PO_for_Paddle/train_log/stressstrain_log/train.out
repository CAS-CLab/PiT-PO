                        params[1] * strain * temp + \
                        params[2] * sin(params[3]*strain + params[4]*temp) + \
                        params[5] * exp(params[6]*strain + params[7]*temp) + \
                        params[8] * sqrt(strain + temp) + params[9]
    return f(strain, temp, params)
