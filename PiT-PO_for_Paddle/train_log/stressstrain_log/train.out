    x2 = np.cos(3 * np.pi / 2) * (temp + 5) * (strain - 3) + np.exp(-4 * (temp - 20))
    x3 = np.sqrt(strain + 2) * (temp - 5) + np.log(strain + 1) * (temp + 2)
    y1 = x1 + x2 + x3
    return y1
