    y = np.cos(np.pi * (temp**2 + strain**2)) + np.tan(np.arctan2(temp, strain)) + np.exp(params[2] * (np.log(strain + temp)))
    z = np.power((strain - temp), params[3]) + np.sinh(params[4] * (temp + strain)) + np.cosh(params[5] * (np.abs(temp - strain))) + \
