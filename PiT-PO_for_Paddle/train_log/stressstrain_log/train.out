    y = params[1] * (strain ** 2 - temp ** 2) + params[2] * strain * temp + params[3] * strain ** 3 + params[4] * temp ** 3
    z = params[5] * (strain ** 4 - temp ** 4) / 4 + params[6] * strain * temp * (strain + temp) + params[7] * temp ** 2
    w = params[8] * strain * temp * (strain + temp) ** 2 + params[9] * temp ** 4
    return x + y + z + w
