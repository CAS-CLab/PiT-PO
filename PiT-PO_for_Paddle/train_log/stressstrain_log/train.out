def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    from scipy.special import expit
    x = strain ** 2 + temp ** 2 + np.sum([params[i] * strain * temp for i in range(0, 8, 2)]) + \
    np.sum([params[i] * np.sin(np.pi/2 * (strain + temp)) for i in range(8, 10)]) + \
    np.sum([np.tanh(np.pi/2 * (strain + temp)) for i in range(10)])
    stress = params[0] * x**2 + np.sum([params[i+1] * (np.exp(i*strain + j*temp) - 1) for i in range(2) for j in range(5)]) + \
    np.sum([np.tanh(i*strain + j*temp) for i in range(5) for j in range(2)]) + np.sum([params[-1] * np.sinh(i*strain + j*temp) for i in range(5) for j in range(5)])
    return stress
