    x2 = params[2] * (strain - 14) * (temp - 28) ** 2 + params[3] * strain ** 4
    x3 = params[4] * (strain + 2) * (temp - 18) + params[5] * strain * (temp - 16)
    x4 = params[6] * (strain - 12) * (temp - 30) ** 2 + params[7] * strain * (temp - 26)
    x5 = params[8] * strain * (temp - 26) + params[9] * np.exp(-(temp - 24) / 2) * np.tanh(strain)
    y6 = params[0] * (strains ** 2) + params[1] * (temp - 20) * (strains + 10)
