    u = params[0]*exp(params[1]*temp + params[2]*strain)
    v = params[3]*exp(params[4]*strain + params[5]*temp)
    w = params[6]*log(u+v+1)
    z = params[7]*(u+v)**2
    a = params[8]*exp(-params[9]*(u+v))
    b = u*v*(u-v)
    c = log(z+a+b)
    return c
