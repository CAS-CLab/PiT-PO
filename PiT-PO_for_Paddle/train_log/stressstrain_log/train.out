def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + params[0] * strain * temp + \
    (params[1] * np.cos(params[2] * (strain + temp))) + \
    (params[3] * np.sin(params[4] * (temp - strain))) + \
    (np.sum([params[5] * np.sin((i % 2) * np.pi / 4) for i in range(4)])) + \
    (np.sum([params[6] * np.tanh(i * (strain + temp)) for i in range(3)])) 
    stress = (params[0] * x**2) + (np.sum([params[i+7] * np.sinh(i * x) for i in range(3)])) + \
    (np.sum([params[i+10] * np.cosh(i * x) for i in range(3)])) + \
    (np.sum([params[i+13] * np.sin(i * np.arccos(x)) for i in range(3)])) + \
    (np.sum([params[i+16] * np.cos(i * np.arccos(x)) for i in range(3)])) + \
    (np.sum([params[i+19] * np.sin(i * x) for i in range(3)]))
    return stress
