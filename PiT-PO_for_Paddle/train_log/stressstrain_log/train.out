    (np.log(np.abs(1 + temp)) * (strain - 12)) * ((temp - 28) ** 4)
    y2 = (np.sin(np.pi * (strain + 12)) * (temp - 38)) ** 2 + \
    (np.cos(3 * np.pi / 2 * (strain - 8))) * ((temp - 32) ** 2)
