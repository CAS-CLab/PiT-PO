def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    from numpy import sin, cos, exp, power, add, subtract, multiply, divide

    stress = (
    params[0] * (sin(strain*params[1])*temp**2 + cos(strain*params[5])*temp)
    + params[1] * (strain**2 + temp**2)*power(temp, 2)
    + params[2] * (exp(strain*temp) - 1)
    + params[3] * (strain**3 + temp**3)
    + params[4] * (strain*temp + strain*temp**3)
    + params[5] * (strainsubtract(power(strain, 4), power(strain, 2)))
    + params[6] * (temp**4 - power(temp, 2))
    + params[7] * (strain*temp + strain*temp**3)
    + params[8] * (strain**2 + temp**2)*power(temp, 3)
    + params[9] * (temp**4 - power(temp, 2))*power(temp, 2)
    )

    return stress
