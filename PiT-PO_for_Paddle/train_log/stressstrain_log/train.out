    params[4] * np.cos(params[5] * strain + params[6] * temp) + params[7] * np.tanh(params[8] * strain + params[9] * temp)
    stress = params[0] * x**2 + params[1] * (np.exp(x) - 1) + params[2] * np.log(np.cosh(x)) + \
