def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sum([params[0] * (strain ** 2),
             np.mean(params[1:]) * (temp - 20) * (strain + 10)])
    x2 = np.sum([np.mean(np.sin(np.pi*strains) for strains in zip(strain, np.arange(len(strain)))) +
             np.mean(np.cos(2*np.pi*strains) for strains in zip(strain, np.arange(len(strain)))) *
              (temp - 20) ** 2 + 
              np.sum([params[i] * (temp - 20) ** i for i in range(3, len(params))])])
    x3 = np.sum([np.exp(-(temp - 25) / (np.mean([params[i] + 2 for i in range(len(params))]))),
              np.sum([params[i] * (temp - 20) for i in range(len(params))]),
              np.sum([np.power(temp - 20, i) for i in range(4)]) + 
              np.sum([np.power(strain - 5, i) for i in range(4)])])
    return x1 + x2 + x3
