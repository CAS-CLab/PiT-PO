    y = params[1] * (strain + temp) * temp + params[2] * strain * temp ** 2 + params[3] * temp ** 3
    z = params[4] * (strain + temp) ** 3 + params[5] * strain * temp ** 2 + params[6] * temp ** 3 + params[7] * strain ** 2 * temp
    w = params[8] * temp ** 4 + params[9] * strain * temp ** 3
    stress = y + z + w
    return stress
