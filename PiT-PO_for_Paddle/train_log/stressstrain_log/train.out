def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = np.dot(params[0], strain) + np.dot(params[1], temp)
    y = np.dot(np.dot(params[2], strain), strain) + np.dot(np.dot(params[3], temp), temp)
    z = np.dot(np.dot(params[4], strain), strain, strain) + np.dot(np.dot(params[5], temp), temp, temp)
    a = np.dot(np.dot(params[6], strain), strain, strain, strain) + np.dot(np.dot(params[7], temp), temp, temp, temp)
    b = np.dot(np.dot(np.dot(params[8], strain), strain, strain, strain, strain), strain) + \
    np.dot(np.dot(np.dot(params[9], temp), temp, temp, temp, temp), temp)
    return x + y + z + a + b
