    c6 = np.sin(np.arccos(np.cos(np.pi*np.array([temp]))+1)) * (np.power(strain, 3)* (np.power(params[6], 3)-np.power(params[7], 3)))
    d7 = (np.power(strain, 3) * (np.power(np.array([temp]), 2)+np.power(np.array([temp]), 1))) * np.cos(np.pi*np.array([temp]))
    e8 = np.cos(np.pi*np.array([temp])) * (np.exp(np.log(np.array([temp])-25)/3) * (np.power(strain, 2)+np.power(strain, 1)))
    f9 = np.cos(np.pi*np.array([temp])) * (np.exp(np.log(np.array([temp])-25)/3) * (np.power(strain, 2)))
    g10 = np.cos(np.pi*np.array([temp])) * (np.exp(-np.log(np.array([temp])+25)/15) * (np.power(strain, 1)+5))
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10
