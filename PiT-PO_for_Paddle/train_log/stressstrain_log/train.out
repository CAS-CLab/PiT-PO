    x2 = params[2] * (temp - 20) * (strain + 10) + params[3] * (strain * temp)
    x3 = params[4] * (strain - 5) * (temp - 20) ** 2 + params[5] * (strain ** 2 * temp)
    x4 = params[6] * (strain - 5) * (temp - 20) ** 3 + params[7] * (strain + 10) * (temp - 20)
    return x1 + x2 + x3 + x4
