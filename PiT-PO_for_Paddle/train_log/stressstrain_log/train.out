    params[1] * (temp - strain) * (temp - strain) + \
    params[2] * ((strain + temp) * (temp - strain)) + \
    params[3] * (strain * temp * (strain + temp - strain)) + \
    params[4] * (strain**2 * temp * (strain + temp - strain)) + \
    params[5] * (strain**3 * temp * (strain + temp - strain)) + \
    params[6] * (strain * temp**2 * (strain + temp - strain)) + \
    params[7] * (strain**2 * temp**2 * (strain + temp - strain)) + \
    params[8] * (strain**3 * temp**2 * (strain + temp - strain)) + \
    params[9] * np.exp(params[9] * np.abs((strain + temp) * temp - strain))
    return g
