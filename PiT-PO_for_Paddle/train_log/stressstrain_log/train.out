    x5 = params[4] * (strain - 5)**2 * (temp - 20)**2
    x6 = params[5] * np.cos(2*np.arctan(strain/np.sqrt(2)))
    x7 = params[6] * temp**3
    x8 = params[7] * (temp - 20)**3
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8
