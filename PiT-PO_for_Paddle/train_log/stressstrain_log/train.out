def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + np.sum([params[i+10] * np.sin(params[i+14] * strain + params[i+15] * temp)
                                      for i in range(10)]) + \
    np.sum([params[i+20] * np.cos(params[i+21] * strain + params[i+22] * temp) 
            for i in range(10)]) + \
    np.sum([params[24+i] * np.tanh(params[25+i] * strain + params[26+i] * temp) 
            for i in range(10)])
    stress = np.sum([params[10+i] * x**2 + params[11+i] * np.exp(x) + params[12+i] * (x + 1)
                 + np.log(np.abs(x)) + np.sinh(x) + np.cosh(x) 
                 for i in range(10)]) + \
         np.sum([params[28+i] * (x + 1) + np.log(np.abs(x)) 
                 for i in range(10)]) + \
         np.sum([params[34+i] * (x - 1) + np.sin(x) + np.cos(x) 
                 for i in range(10)]) + \
         np.sum([params[40+i] * (x + 1) + np.sin(x) + np.cos(x) 
                 for i in range(10)])
    return stress
