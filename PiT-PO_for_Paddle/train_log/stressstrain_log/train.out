def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + (params[0] * strain + params[1] * temp)**2 / 2 + \
    (params[2] * (strain + temp)) * np.cos(np.sqrt(params[3] * strain + params[4] * temp + 1) + np.pi/4) + \
    (params[5] * (strain + temp)) * np.exp(-np.sqrt(np.abs(params[6] * strain + np.abs(params[7] * temp)))) + \
    (params[8] * (strain + temp)) * np.log(1 + np.exp(np.sqrt(np.abs(params[9] * strain + np.abs(params[9] * temp)))))
    stress = (params[0] + (params[1] * (np.exp(x) - 1))) * (x**2 + 1) + (params[2] + (params[3] + np.cos(np.sqrt(np.abs(params[6] * strain + np.abs(params[7] * temp))))))
    return stress
