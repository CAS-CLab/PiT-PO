    w4 = np.power(strain, np.floor(np.log10(np.abs(temp)))+1) * (np.sin(np.arccos(params[4])))
    x5 = np.sum([params[i] * np.sin(i*np.pi*(temp+50)/(180+50)) for i in range(5, 10)])
    return o1 + u2 + v3 + w4 + x5
