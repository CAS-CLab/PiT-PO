def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * (strain ** 2)
    b = params[1] * (temp - 25) * (np.exp(np.log(temp + 273.15)))
    c = np.where((temp - 20) >= 0,
             params[2] * (strains - 5) * ((temp - 20)**2), 
             0)
    d = np.where(strain >= 0,
             params[3] * (strains * temp),
             0)
    e = np.where(strain >= 0,
            np.sinh(strain * 50) * params[4],
            0)
    f = np.where(temp >= 0,
             (temp - 20)**3 * params[5],
             0)
    g = np.where((temp - 20) >= 0,
             (strains - 5) * ((temp - 20)**2) * temp * params[6],
             0)
    h = np.where(strain >= 0,
            (strains**2 * temp) * params[7],
            0)
    i = np.where(strain >= 0,
            (strains + 10) * (temp - 20) * np.log(temp + 273.15) * params[8],
            0)
    j = np.where(temp >= 0,
             np.sinh(2 * temp) * params[9],
             0)
    return a + b + c + d + e + f + g + h + i + j
