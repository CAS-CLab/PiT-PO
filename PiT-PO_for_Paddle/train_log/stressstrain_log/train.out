def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + np.dot(np.arange(5), np.array([strain, temp])) + \
    np.sum([np.sin(np.pi * (strain + np.dot(np.arange(3), np.array([temp, strain])))), np.cos(np.pi * (strain + np.dot(np.arange(3), np.array([temp, strain]))))]) + \
    np.tanh(np.pi * (strain + np.dot(np.arange(5), np.array([temp, strain, temp, strain]))))
    stress = params[0] * (x**2 + np.sum(params[5:9])) + np.dot(np.arange(4), [np.exp(x), np.log(x), np.sinh(x), np.cosh(x)]) + \
    np.sum([np.dot(np.arange(3), [x, temp, strain]), np.dot(np.arange(3), [x, temp, strain])]) + \
    np.dot(np.arange(3), [x, temp, strain])
    return stress
