    params[2] * temp + \
    params[3] * temp + \
    params[4] * x**(np.exp(x)+1) + \
    params[5] * x + \
    params[6] * temp + \
    np.sin(2 * np.pi * (strain + temp)) + \
    np.cos(2 * np.pi * (strain - temp))
    return stress
