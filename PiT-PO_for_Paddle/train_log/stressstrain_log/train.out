    params[0] * strain + params[1] * temp + \
    params[2] * strain**2 + params[3] * temp**2 + \
    params[4] * strain*temp*(strain+temp) + \
    params[5] * strain**4/temp**4 + params[6] * temp**4/strain**4 + \
    params[7] * strain**3 + params[8] * temp**3 + params[9]
    return lambd(strain, temp, params)
