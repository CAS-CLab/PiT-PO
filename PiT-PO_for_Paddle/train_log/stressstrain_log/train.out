def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.power(params[0], 2) * np.power(strain + 5, 3) + np.sum(np.power(params[1:], 2)) * (temp - 20) ** 2
    x2 = np.exp(params[0]) * (strain + 10) * (temp - 20) ** 3 + np.logspace(0, 5, len(params[1:])) * (np.abs(strain - 5) + 1) * (temp - 20) ** 4
    x3 = np.cos(temp) * (strain + 5) * np.power((temp - 25), 2) + np.tanh(strain) * (np.abs(strain - 15) + 1) * (temp - 30) ** 3
    x4 = np.sqrt(strain) * (strain - 10) * np.power((temp - 35), 2) + np.cosh(strain) * (strain + 5) * np.power((temp - 40), 3)
    x5 = np.sin(temp) * (strain + 10) * np.power(strain, 3)
    return x1 + x2 + x3 + x4 + x5
