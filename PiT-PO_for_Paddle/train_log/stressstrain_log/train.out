def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + np.exp(params[0] * (strain + temp)) + \
    np.cos(2 * np.pi * (np.sin(params[1] * strain - np.cos(params[2] * temp))) + np.pi/4) + \
    (1 / (1 + np.exp(-np.sqrt(params[3]) * (strain + temp))))**2 + \
    np.log(np.abs(np.cosh(np.sqrt(params[4]) * (strain + temp)))) + \
    (1 + np.tanh(np.sqrt(params[5]) * (strain - temp))) * (1 + np.tanh(np.sqrt(params[6]) * (strain + temp))) + \
    (1 - np.tanh(np.sqrt(params[7]) * (strain + temp))) * (1 - np.tanh(np.sqrt(params[8]) * (strain - temp)))
    stress = np.polyval([params[0], params[1]], x) + np.polyval([params[2], params[3]], x) + \
    np.polyval([params[4], params[5]], x) + np.polyval([params[6], params[7]], x) + \
    np.polyval([params[8], np.zeros_like(x)], x)
    return stress
