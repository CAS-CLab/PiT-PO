                     params[2], params[3]]) * (str(2*strain + 5) ** 2)) + \
    np.sum(np.array([params[4], params[5], 
                     params[6], params[7]]) * ((str(temp - 20)) ** 3)) + \
    np.sum(np.array([params[8], params[9]]) * (np.cos(temp) * strain ** 3))
    return y1
