def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.power(params[0], 3) * (np.power(strain, 2) * temp + 2) + np.power(params[1], 2) * (strain + 5) * (temp - 25)
    x2 = np.power(params[2], 4) * (np.power(strain, 3) * temp + 7) + np.power(params[3], 2) * (strain * temp + 1) + np.power(params[4], 3) * (np.cos(np.pi * temp / 50))
    x3 = np.power(params[5], 2) * (np.power(strain, 2) * temp + 4) + np.power(params[6], 2) * (strain * temp + 3) + np.power(params[7], 2) * (np.exp(-np.abs(strain)) * (temp - 22))
    x4 = np.power(params[8], 3) * (np.power(strain, 4) * temp + 9) + np.power(params[9], 2) * (np.sin(np.pi * temp / 30) * (strain + 2))
    return x1 + x2 + x3 + x4
