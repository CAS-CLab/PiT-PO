    x2 = params[2] * (strain - 5) * (temp - 20) ** 2
    x3 = params[3] * str(strain).find('1') if strain > 0 else params[4] * str(strain).find('-1')
    x4 = params[5] * np.exp(temp / (np.maximum(params[6], 1)))
    x5 = params[7] * (temp - 20) * (strain ** 2)
    x6 = params[8] * np.sin(np.pi * strain)
    return x1 + x2 + x3 + x4 + x5 + x6
