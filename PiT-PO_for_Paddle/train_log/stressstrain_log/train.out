def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sin(params[0]) * (strain + 3) * (temp - 10)
    x2 = np.cos(params[0]) * (temp - 20) * (strain + 2) ** 2
    x3 = params[1] * (strain * (temp - 20)) ** 2
    x4 = np.cos(params[1]) * (strain + 5) * (temp - 40)
    x5 = np.cos(np.pi/2 + params[1]) * (strains + 3) * (temp - 30)
    a = np.sin(params[2]) * (strain + 10) * (temp - 25)
    b = np.cos(np.pi/2 + params[2]) * (strains + 2) * (temp - 15)
    c = np.cos(params[3]) * (np.sqrt(strain + 5)) * (temp - 20)
    d = (np.sin(params[4]) * (np.sqrt(strain + 3))) + \
     ((np.cos(np.pi/4 + params[4])) * (np.sqrt(temp - 5)))
    return d + x1 + x2 + x3 + x4 + x5 + a + b + c + d
