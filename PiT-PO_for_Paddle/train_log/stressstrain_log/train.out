def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = params[0] * (strain + temp)**2 + \
    params[1] * strain * ((temp + strain + temp*strain**2/6)**2 + (temp**3 + strain**4)/4) + \
    params[2] * temp * (temp**3 + strain**4 + temp*strain**5/20) + \
    params[3] * temp**2 * (strain + temp**2 + strain**3*temp/6 + temp**4*strain/12) + \
    params[4] * strain * temp * (strain + temp**2 + strain**3*temp/3 + temp**4*strain/8) + \
    params[5] * (temp**2 + strain**3 + temp*strain**4/4 + strain**5*temp/60) + \
    params[6] * strain * temp * (strain**2 + temp**3 + strain**4 + temp**5*strain/20) + \
    params[7] * temp**4 * (strain + temp) + \
    params[8] * (strain**2 + temp**2 + strain*temp**3 + temp**4*strain/4) + \
    params[9]
    return x
