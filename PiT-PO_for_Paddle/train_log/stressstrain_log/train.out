    g = params[0] * (strain + temp) + \
    params[1] * strain * temp + \
    params[2] * strain**2 + \
    params[3] * temp**2 + \
    params[4] * strain*temp*(strain+temp) + \
    params[5] * (np.sin(strain) + np.cos(temp)) + \
    params[6] * (strain*np.sin(temp)+temp*np.cos(strain))
    return g
