def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = np.exp(params[0] * strain + np.log(temp)) * \
    (np.sinh((strain + temp) / np.sqrt(2)))**2 + \
    (np.cosh((strain + temp) / np.sqrt(2)))**4 + \
    (np.tanh((strain + temp) / np.sqrt(2)))**6 + \
    (np.cos((strain + temp) / np.sqrt(2)))**8 + \
    (np.sin((strain + temp) / np.sqrt(2)))**10 + \
    (np.arctan((strain + temp) / np.sqrt(2)))**12
    y = np.sum(np.square(x))
    z = np.exp(-params[8] * np.abs(x)) * \
    (np.exp(-(strain - temp) / np.sqrt(2)))**2 + \
    (np.exp((strain + temp) / np.sqrt(2)))**4 + \
    (np.exp(-(np.abs(strain - temp)) / np.sqrt(2)))**6 + \
    (np.exp(((strain + temp) / np.sqrt(2))**2))**8 + \
    (np.exp((np.abs(strain + temp) / np.sqrt(2))))**10 + \
    (np.exp(-(np.abs(strain + temp)) / np.sqrt(2)))**12
    a = np.sum(z) + np.sum(y)
    return a
