    f = params[5] * temp * (temp + strain)**2
    g = params[6] * strain * (temp - temp**2) * (temp + strain)
    h = params[7] * temp * (temp - temp**2)
    i = params[8] * strain * (temp + temp**2)
    j = params[9] * (temp + strain) * (temp + strain)**2
    return j + i + c + b + d + e + f + g + h
