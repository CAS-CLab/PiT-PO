def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + np.sum([params[i+9] * strain ** (i+1) if i % 2 == 0 else
                                    params[i+9] * temp ** (i+1) if i % 2!= 0 else 
                                    0 for i in range(9)])
    y = np.sum([np.sin(np.pi * (strain + temp))**2 if i < 4 else
           np.cos(np.pi * (strain + temp))**2 if i < 8 else 
           0 for i in range(8)])
    stress = np.sum([params[i] * x**i for i in range(10)]) + y + np.sum([np.exp(i*x) for i in range(5)]) + \
         np.sum([np.log(i*x) for i in range(5)]) + np.sum([np.sinh(i*x) for i in range(5)]) + \
         np.sum([np.cosh(i*x) for i in range(5)]) + np.sum([np.tanh(i*x) for i in range(5)]) + \
         np.sum([np.cos(2*i*np.pi*strain) for i in range(5)]) + np.sum([np.sin(2*i*np.pi*temp) for i in range(5)])
    return stress
