def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    from numpy import sin, cos, tanh, exp

    x = strain ** 2 + temp ** 2 + \
    (params[0] * strain + params[1] * temp) + \
    (sin(params[2] * strain + sin(params[3] * temp)) / (1 + cos(params[4] * (strain + temp))**2) +
     tanh(params[5] * (strain - temp)) + 
     exp((params[6] + sin(params[7] * (strain + temp))) * (strain + temp)))
    return params[0] * x + (params[1] * sin(params[2] * (strain + temp)) +
                        (exp((params[3] + cos(params[4] * (strain + temp))) * (strain + temp)) - 1) + 
                         (cos(params[5] * (strain - temp)) * exp((params[6] + sin(params[7] * (strain + temp))) * (strain + temp))))
