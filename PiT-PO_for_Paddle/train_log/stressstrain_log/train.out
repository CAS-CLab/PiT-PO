def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = params[0] * (strain ** 3) + params[1] * (strain ** 2) * (temp - 20)
    x2 = params[2] * (strain - 5) * (temp - 20) ** 2 + params[3] * (strain + 10) * (temp - 20)
    x3 = params[4] * (strain + 5) * (temp - 25)
    x4 = params[5] * (strain - 15) * (temp - 30) ** 2
    x5 = params[6] * (strain - 10) * (temp - 35)
    x6 = params[7] * (strain + 5) * (temp - 40)
    x7 = params[8] * (strain - 5) * (temp - 45)
    x8 = params[9] * (strain * temp) + params[0] * (strain ** 2 * temp)
    x9 = params[1] * (temp - 20) * (strain ** 2)
    x10 = params[2] * (strains - strains) * (temp - 20) ** 2
    x11 = params[3] * (np.sin(np.arcsin(strains)) + np.sin(np.arccos(strains)))
    x12 = params[4] * (np.exp(-(temp - 20)) / (params[5] + 1))
    x13 = params[5] * (temp - 20) * (strains - 5)
    x14 = params[6] * (strains - 5) ** 2
    x15 = params[7] * (temp - 20) ** 3
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10 + x11 + x12 + x13 + x14 + x15
