def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u = params[0] * (strain + temp) + params[1] * (np.exp((strain + temp)**2) - 1) + \
    params[2] * (np.cos(np.pi * (strain + temp)) * (np.exp((strain + temp)**2) + 1)) + \
    params[3] * (np.sin(2 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) - 1)) + \
    params[4] * (np.sin(3 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) + 1)) + \
    params[5] * (np.cos(4 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) - 1)) + \
    params[6] * (np.sin(5 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) + 1)) + \
    params[7] * (np.tan(6 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) - 1)) + \
    params[8] * (np.cosh(7 * np.pi * (strain + temp)) * (np.exp((strain + temp)**2) + 1)) + \
    params[9]
    stress = u**2
    return stress
