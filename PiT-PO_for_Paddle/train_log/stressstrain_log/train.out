                ((strains**2 + temps**2) * (strains * temps)) +\
                ((strains**2 + temps**2) * (strains * temps)) +\
                ((strains**2 + temps**2) * (strains * temps)) +\
                ((strains**2 + temps**2) * (strains * temps)))) +\
    (params[6] * (strains * (temps**2 - strins**2))) +\
    (params[7] * (temps * (strins**2 + temps**2))) +\
    (params[8] * (strains * temps * log(np.abs(strains*temps) + 1))) +\
    (params[9])
