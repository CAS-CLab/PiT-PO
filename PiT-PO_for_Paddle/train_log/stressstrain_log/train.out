    v = params[1] * (temp - strain)**2
    w = params[2] * (strain + temp)**2
    x = params[3] * (np.exp(params[4]*u) + np.exp(params[5]*v))
    y = params[6] * (np.cos(params[7]*u) + np.cos(params[8]*w))
    stress_2 = x + y
    return stress_2
