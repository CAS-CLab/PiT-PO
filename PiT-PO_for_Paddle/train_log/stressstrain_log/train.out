def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sum([np.power(params[0], 2), np.power(params[1], 2)]) * np.power(strain, 2)
    y2 = np.sum([np.power(np.abs(params[2]), 2), np.power(params[3], 2), np.power(params[4], 2)]) * np.power(temp - 20, 2)
    z3 = np.sum([np.power(np.abs(params[5]), 3), np.power(np.abs(np.log(temp + 273.15)), 3)])
    a4 = np.sum([np.power(strain, 2) * np.abs(params[6]), np.power(strain, 3) * np.abs(params[7])])
    b5 = np.sum([np.power(strain, 4) * np.abs(np.cos(strain * 100))])
    c6 = np.sum([np.power(np.abs(np.sinh(2 * temp)), 3)])
    d7 = np.sum([np.power(strain * np.abs(np.cos(strain * 100)), 2), np.power(temp - 20, 2) * np.abs(np.cos(strain * 100)), np.power(strain, 3) * np.abs(np.sinh(2 * temp))])
    e8 = np.sum([np.power(strain, 2) * np.abs(np.sinh(2 * temp)), np.power(temp, 2) * np.abs(np.cos(strain * 100))])
    f9 = np.sum([strain * np.abs(np.sinh(2 * temp)), np.abs(np.cos(strain * 100)) * (temp - 20)])
    g10 = np.sum([np.power(strain, 2) * np.abs(np.sinh(2 * temp)), np.abs(strain) * np.abs(temp)**2])
    h11 = np.sum([np.log(np.abs(temp + 273.15)), np.log(np.abs(strain + 10))])
    i12 = np.sum([np.tanh(strain * 100), np.tanh(-strain * 100)])
    j13 = np.sum([np.sinh(2 * temp), np.sinh(-2 * temp)])
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
