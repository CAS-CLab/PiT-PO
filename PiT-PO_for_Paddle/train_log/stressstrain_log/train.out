def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.power(params[0], 2) * np.power(strain, 2)
    y2 = np.sum([np.multiply(np.power(params[1], k), np.power(temp - 20, k))
             for k in range(1, 4)]) * np.add(strain, 10)
    z3 = np.sum([np.multiply(np.power(strain - 5, k), np.power(temp - 20, 2 * k))
             for k in range(1, 4)])
    a4 = np.dot(strain, temp)
    b5 = np.sum([np.multiply(np.power(strain, 2 * k + 1), np.power(temp, k))
             for k in range(3)]) * np.power(params[4], 1)
    c6 = np.power(temp - 20, 3) * np.power(params[5], 1)
    d7 = np.sum([np.multiply(np.power(strain - 5, k),
                         np.power(temp - 20, 2 * k) * np.power(temp, k))
              for k in range(3)]) * np.power(params[6], 1)
    e8 = np.multiply(np.power(strain, 2), temp) * np.power(params[7], 1)
    f9 = np.multiply(strain + 10, temp - 20) * np.power(params[8], 1)
    g10 = np.multiply(strain, np.power(temp, 2)) * np.power(params[9], 1)
    h11 = np.power(params[1], 1) * np.log(np.add(temp, 273.15))
    i12 = np.multiply(np.tanh(np.multiply(strain, 100)), np.power(params[3], 1))
    j13 = np.multiply(np.sinh(np.multiply(2, temp)), np.power(params[4], 1))
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
