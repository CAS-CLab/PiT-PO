def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = params[0] * (strains**2 + strains)
    y2 = np.sum([params[i] * (temp - 20)**(i//2) * (strains + 10**(i%2)) for i in range(2, 10)])
    z3 = np.sum([params[i] * (strains - 5)**(i//2) * (temp - 20**(i//2))**2 for i in range(2, 10)])
    a4 = np.sum([params[i] * strains * (temp - 20) for i in range(2, 10)])
    b5 = np.sum([params[i] * (strains**3) for i in range(2, 10)])
    c6 = np.sum([params[i] * (temp - 20)**3 for i in range(2, 10)])
    d7 = np.sum([params[i] * (strains - 5)**(i//2) * (temp - 20**(i//2))**2 * (temp - 20) for i in range(2, 10)])
    e8 = np.sum([params[i] * (strains**2) * (temp - 20) for i in range(2, 10)])
    f9 = np.sum([params[i] * (strains + 10) * (temp - 20) for i in range(2, 10)])
    g10 = np.sum([params[i] * (strains) * (temp - 20)**2 for i in range(2, 10)])
    h11 = np.sum([params[i] * np.log(temp) for i in range(2, 10)])
    i12 = np.sum([params[i] * np.tanh(strains) for i in range(2, 10)])
    j13 = np.sum([params[i] * np.sinh(temp) for i in range(2, 10)])
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
