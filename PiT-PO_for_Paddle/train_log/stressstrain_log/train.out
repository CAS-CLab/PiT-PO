def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u = np.sum([params[0] * (strain + temp)**(i+1) for i in range(1, 6)]) + \
    np.sum([params[6] * (strain**(i+1)) for i in range(1, 6)]) + \
    np.sum([params[12] * (temp**(i+1)) for i in range(1, 6)])
    v = np.sum([params[6] * (strains**2)**(i/2) for i in range(1, 11)]) + \
    np.sum([params[15] * (temps**2)**(i/2) for i in range(1, 11)]) + \
    np.sum([params[18] * ((strains + temps)**(i+1)/2) for i in range(1, 6)])
    w = np.sum([params[21] * (strains + temps) for i in range(1, 6)]) + \
    np.sum([params[24] * (strains**3) for i in range(1, 6)]) + \
    np.sum([params[27] * (temps**3) for i in range(1, 6)])
    x = np.sum([params[30] * (strains + temps)**(i+1) for i in range(1, 6)]) + \
    np.sum([params[33] * (strains**2)**(i/2) for i in range(1, 11)]) + \
    np.sum([params[36] * (temps**2)**(i/2) for i in range(1, 11)])
    return u + v + w + x
