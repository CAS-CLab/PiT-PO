def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    from numpy import cos, sin, tanh

    expansion_term_1 = params[0]*strain**4 + params[1]*temp**4
    expansion_term_2 = params[2]*(strain**2 + temp**2)
    expansion_term_3 = params[3]*strain*temp*(sin(params[4]*strain + params[5]*temp))
    expansion_term_4 = params[6]*(cos(params[7]*strain + params[8]*temp))*strain**2
    expansion_term_5 = params[9]*tanh(params[7]*strain + params[8]*temp)

    return expansion_term_1 + expansion_term_2 + expansion_term_3 + expansion_term_4 + expansion_term_5
