def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u = np.sum([params[0] * (strain + temp),
            params[1] * (np.sin(strain * np.pi/2) - np.cos(temp * np.pi)), 
            params[2] * (strain ** 2 + temp ** 2), 
            params[3] * (np.log(strain + temp) + np.log(strain - temp))])
    v = np.sum([params[4] * (strain ** 3 + temp ** 3),
            params[5] * (strain ** 4 + temp ** 4), 
            params[6] * (np.exp(strain * np.pi/2) + np.exp(-temp * np.pi)), 
            np.sum([params[8] * (strain ** i + temp ** i) for i in range(6)])])
    w = np.sum([params[7] * (np.sqrt(strain + temp) + np.sqrt(strain - temp)),
            np.sum([params[9] * (strain ** j + temp ** j) for j in range(8)])])
    return u + v + w
