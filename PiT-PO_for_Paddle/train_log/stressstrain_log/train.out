def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    n = len(params)
    x1 = np.sum([params[i] * (strains[i] ** 3) for i in range(n)])
    x2 = np.sum([params[n+i] * (strains[i] - 5) * (temps[i] - 20)**2 for i in range(len(strains))])
    x3 = np.sum([params[n+2+i] * (strains[i] + 5) * (temps[i] - 25) for i in range(len(strains))])
    x4 = np.sum([params[n+4+i] * (strains[i] - 15) * (temps[i] - 30)**2 for i in range(len(strains))])
    x5 = np.sum([params[n+6+i] * (strains[i] - 10) * (temps[i] - 35) for i in range(len(strains))])
    x6 = np.sum([params[n+7+i] * (strains[i] + 5) * (temps[i] - 40) for i in range(len(strains))])
    x7 = np.sum([params[n+8+i] * (strains[i] - 5) * (temps[i] - 45) for i in range(len(strains))])
    x8 = np.sum([params[i] * (strains[i] * temps[i]) for i in range(n)]) + \
     np.sum([params[n+i] * (strains[i] ** 2 * temps[i]) for i in range(n)])
    stress = x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8
    return stress
