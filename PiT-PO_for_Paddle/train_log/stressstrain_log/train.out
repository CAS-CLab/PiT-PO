    stress = params[0] * (strain + params[1] * temp)**2 + \
       params[1] * (temp - params[2] / strain)**2 + \
       params[3] * (exp(params[4] * strain) + exp(params[5] * temp)) + \
       params[4] * (sqrt(strain + params[5] * temp) - sqrt(strain + params[6] * temp)) + \
       params[7] * sin(pi * (strain + params[8] * temp)) + \
       params[8] * (log(strain) - log(temp))
    return stress
