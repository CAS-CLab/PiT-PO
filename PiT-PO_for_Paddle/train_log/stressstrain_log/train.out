    c = params[8]
    d = params[9]

    stress = u * ((strain + temp) / 2)**2 + v * (strain + temp) + w * (strain - temp)**3 + x * strain + y * temp + z * (strain + temp)**3 + a * (strain**2 + temp**2) + b * strain + c * temp + d * (strain**2 + temp**2)**2
    return stress
