    y2 = params[3] * np.sin(np.arctan(strain)) + params[4] * np.exp(-temp / (params[5] + 1)) + params[6] * strain * (temp - 20) + params[7] * (strain - 5) ** 2
    y3 = params[8] * (temp - 20) ** 3 + params[9] * np.cos(3 * np.arcsin(strain))
    return y1 + y2 + y3
