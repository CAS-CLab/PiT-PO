def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    h0 = params[0] * (strains + temps)**2 
    h1 = params[1] * (strains + temps) 
    h2 = params[2] * strains + params[3] * temps 
    h3 = params[4] * (strains + temps)**3 
    h4 = params[5] * np.sin(np.pi * strains + np.pi * temps) 
    h5 = params[6] * np.cos(2 * np.pi * strains + 2 * np.pi * temps) 
    h6 = params[7] * (strains - temps)**2 
    h7 = params[8] * (np.abs(strains) + np.abs(temps))**2 
    h8 = params[9] * (strains**2 + temps**2) 
    stress = h0 * params[0] + h1 * params[1] + h2 * params[2] + h3 * params[4] + h4 * params[5] + h5 * params[6] + h6 * params[7] + h7 * params[8] + h8 * params[9]
    return stress 
