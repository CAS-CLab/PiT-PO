    params[1] * (strain * temp) +\
    params[2] * (temp - strain) +\
    params[3] * ((strain + temp) ** 2) +\
    params[4] * (strain ** 2 * temp + strain * temp ** 2) +\
    params[5] * (strain * temp * (strain + temp)) +\
    params[6] * (temp * (strain + temp) ** 2) +\
    params[7] * (strain * temp * (strain ** 2 + temp ** 2)) +\
    params[8] * (strain ** 2 * temp ** 2) +\
    params[9] * (strain * temp * (strain + temp) + strain * temp * (temp + strain))
    return g
