    stress = params[0] * strain + params[1] * temp + \
        params[2] * strain**2 + params[3] * temp**2 + params[4] * strain * temp + \
        params[5] * np.exp(params[6] * temp + params[7] * strain) + \
        params[8] * strain**3 + params[9] * temp**3
    return stress
