    params[1] * strain * (temp + strain**2 + temp*strain**3/6 + strain**4/24) +\
    params[2] * temp * (temp**3 + strain**4 + temp**5*strain/20) +\
    params[3] * temp**2 * (strain + temp**2 + strain**3*temp/6 + temp**4*strain/12) +\
