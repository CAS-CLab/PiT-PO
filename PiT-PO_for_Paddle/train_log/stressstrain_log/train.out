    (np.sin(params[0]*strain + params[1]*temp) + \
     np.cos(params[2]*strain + params[3]*temp)) / \
    (np.sin(params[4]*strain + params[5]*temp) + \
     np.tanh(params[6]*strain + params[7]*temp) + \
     np.cosh(params[8]*strain + params[9]*temp))
    return params[0]*x**2 + params[1]*x + params[2]
