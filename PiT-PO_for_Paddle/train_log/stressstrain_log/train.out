    (params[4] * temp[:, None] * strain[:, None] +
    (np.sum(params[5:8], axis=0) * (temp[:, None]**3 + strain[:, None]**3))) + \
    (np.sum(np.array([params[9]]*len(temp)), axis=0) * (temp[:, None]**4))
    return u * temp[:, None]
