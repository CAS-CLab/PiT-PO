    k = np.polyfit(g, j, 1)
    l = np.poly1d(k)
    m = l(g) 
    n = np.polyfit(m, l, 2)
    o = np.poly1d(n)
    p = o(strain) 
    stress = params[0] * strain + params[1] * p + params[2] * strain**2 + params[3] * p**2 + params[4] * strain*p + params[5] * p*strain + params[6] * strain + params[7] * p + params[8] * strain + params[9] * p
    return stress
