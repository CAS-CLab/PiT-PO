    y = params[1] * strain * (strain + temp)**3
    z = params[2] * temp * (temp + strain) * (temp + strain)**2
    a = params[3] * strain * temp * (temp + strain) * (temp + strain)**2
    b = params[4] * (strain + temp)**4
    c = params[5] * (strains + temps)**3 * strains * temps
    d = params[6] * strans * temps * (strans + temps)**2
    e = params[7] * temp * (temp + strain) * (strains + temps)**2
    f = params[8] * strain * temp * (strains + temps)**3
    g = params[9] * (strain + temp)**5
    return x + y + z + a + b + c + d + e + f + g
