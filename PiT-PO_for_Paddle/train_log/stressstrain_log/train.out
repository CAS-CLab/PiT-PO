    params[3] * strains + params[4] * (temp*strains)**3 + \
    params[5] * (temp + strains)**2 + params[6] * (temp - strains)**2 + \
    params[7] * (temp**2 + strains**2)**2 + params[8] * (temp + strains)*(temp - strains) + \
    params[9] * (temp + strains)**4
