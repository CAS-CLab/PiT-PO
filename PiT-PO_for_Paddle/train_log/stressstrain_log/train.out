def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.exp(params[0]) * (np.exp(strain) - 1)
    y2 = np.exp(params[1]) * (np.exp(temp) - np.exp(5))
    z3 = np.exp(2*params[2]) * (temp - 20)**2
    a4 = np.cos(np.pi * (strain - 5)) * (np.sin(temp) + 1)
    b5 = (np.sinh(strain) / (np.cosh(strain)))**3 * np.exp(params[3])
    c6 = np.exp(3*params[4]) * (temp - 20)**3
    d7 = (np.sinh(strain) / (np.cosh(strain)))**2 * temp * np.exp(params[5])
    e8 = np.exp(2*params[6]) * (strain * temp)**2
    f9 = np.exp(np.log(params[7])) * (np.exp(strain) + 10) * (temp - 20)
    g10 = np.sin(np.pi * (strain * temp**2) + 90) * np.exp(params[8])
    h11 = np.log(1 + np.exp(-np.log(temp + 273.15) * 2))
    i12 = np.tanh(np.sqrt(strain) + 5)
    j13 = np.sinh(2 * temp) * np.exp(np.log(1 + np.cos(np.pi * temp)))
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
