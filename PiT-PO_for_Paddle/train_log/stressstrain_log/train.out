    x8 = np.sinh(2 * strains) * temp
    x9 = (strains + 10) ** 3 + (np.cos(3 * temp) + 1)/2
    x10 = strains * (temp + 10)
    return x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + x10
