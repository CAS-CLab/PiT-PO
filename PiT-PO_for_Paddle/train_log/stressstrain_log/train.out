    params[1] * np.sin(params[2] * (strain + temp)) + \
    params[3] * np.cos(params[4] * (strain - temp)) + \
    params[5] * np.arctan2(strain + temp, strain - temp) + \
    params[6] * np.log(strain + temp) + \
    params[7] * np.exp(params[8] * (strain + temp)) + \
    params[9] * np.sqrt(strain ** 2 + temp ** 2)
    return params[0] * x**3 + params[1] * x**2 + params[2] * x + params[3] * np.sin(np.pi * (x + temp))
