def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    g = params[0] * (strain + temp) * (np.sin(strain) + np.cos(temp)) + \
    params[1] * (temp - strain) * (np.cosh(strain) + np.sinh(temp)) + \
    params[2] * (strain ** 2 + temp ** 2) * (np.tan(strain) + np.cot(temp)) + \
    params[3] * (strain * temp) * (np.log(strain) + np.log(temp)) + \
    params[4] * (strain ** 3 + temp ** 3) * (np.sqrt(strain) + np.sqrt(temp)) + \
    params[5] * (strain ** 4 + temp ** 4) * (np.exp(strain) + np.exp(temp)) + \
    params[6] * (strain * temp * (strain ** 2 + temp ** 2)) * (np.arcsin(strain) + np.arccos(temp)) + \
    params[7] * (strain * temp * (strain ** 3 + temp ** 3)) * (np.asin(strain) - np.acos(temp)) + \
    params[8] * (strain * temp * (strain ** 4 + temp ** 4)) * (np.atan(strain) + np.atan(temp)) + \
    params[9] * (np.sin(strain) * np.cos(temp) + np.cos(strain) * np.sin(temp))
    return g
