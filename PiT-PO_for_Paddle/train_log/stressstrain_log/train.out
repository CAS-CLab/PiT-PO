def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    h = np.sin(np.log(params[0]) * (strain + 2)) + np.cos((np.log(params[1]) + np.pi / 4) * (temp - 15))
    i = np.sqrt(params[2] * (np.exp(params[3] * (strain + 5)) + 1) * (temp - 25))
    j = np.tanh(np.arctan2(params[4], params[5]))
    k = np.dot(strain, temp) + np.dot(strain**2, temp**2)
    l = np.dot(strain, temp**3) + np.dot(temp**2, strain**4)
    m = np.mean([strain, temp])
    n = np.sum([np.log(params[6]), np.log(np.cos(np.pi / 16) + np.sin(np.pi / 32))])
    o = np.exp(params[7] * (np.cosh(np.log(params[8])) - 1)) * (temp - 35)
    p = np.sin(np.arccos(params[9])) * (strain + 12)
    return p + h + i + j + k + l + m + n + o
