def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x11 = np.power(params[0], 2) * (np.power(strain, 3) * temp + 4)
    x12 = np.power(params[1], 3) * (strain * temp + 2) + np.power(params[2], 2) * (np.power(strain, 2) * (temp + 4))
    x13 = np.power(params[3], 4) * (np.power(strain, 2) * temp + 8) + np.power(params[4], 2) * (strain * temp + 6)
    x14 = np.power(params[5], 3) * (strain * temp + 3) + np.power(params[6], 2) * (np.power(strain, 2) * temp + 2) + np.power(params[7], 2) * (strain * temp + 1)
    x15 = np.power(params[8], 6) * (np.power(strain, 4) * temp + 10) + np.power(params[9], 3) * (strain * temp + 5)
    return x11 + x12 + x13 + x14 + x15
