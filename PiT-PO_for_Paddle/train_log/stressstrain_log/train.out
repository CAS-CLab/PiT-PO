def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    from scipy.special import expit, ellipj, sin, cos, sinh
    x = strain ** 2 + temp ** 2 + params[0] * strain * temp + \
    (params[1] + (params[2] + 1) / 2) * ellipj(np.pi/2 * (strain + temp), np.sqrt(1 + (strain - temp)**2)) + \
    (params[3] + (1 + (strain + temp)**2) / 2) * np.cos(np.sqrt(1 + (strain - temp)**2) * (strain + temp)) + \
    (params[4] + (1 + (strain - temp)**2) / 2) * np.sin(np.sqrt(1 + (strain - temp)**2) * (strain - temp)) + \
    (params[5] + (1 + (temp + strain)**2) / 2) * np.cos(np.sqrt(1 + (temp - strain)**2) * (temp + strain)) + \
    (params[6] + (1 + (temp - strain)**2) / 2) * np.sin(np.sqrt(1 + (temp - strain)**2) * (temp - strain)) + \
    (params[7] + (1 + (strain + temp)**2) / 2) * np.sinh(np.sqrt(1 + (strain - temp)**2) * (strain + temp)) + \
    (params[8] + (1 + (temp - strain)**2) / 2) * np.cosh(np.sqrt(1 + (temp - strain)**2) * (temp - strain))
    stress = (params[0] + (1 + (x + 1)**2) / 2) * x**2 + (params[1] + (1 + (x + 1)**2) / 2) * (expit(x) - 1) + \
         (params[2] + (1 + (x + 1)**2) / 2) * x + \
         (params[3] + (1 + (x + 1)**2) / 2) + (params[0] + (1 + (x + 1)**2) / 2) * sinh(x)
    return stress
