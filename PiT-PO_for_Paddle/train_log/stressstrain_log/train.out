    y = np.sum((np.abs(x - strain) + np.abs(x - temp)) ** 2)
    z = np.sum((np.abs(strain - x) + np.abs(temp - x)) ** 3)
    w = np.sum((np.abs(strain - x) + np.abs(temp - x)) ** 4)
    v = np.sum((np.abs(strain - x) + np.abs(temp - x)) ** 5)
    return h + y + z + w + v
