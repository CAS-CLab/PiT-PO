    c0 = params[2]
    d0 = params[3]
    e0 = params[4]
    f0 = params[5]
    g0 = params[6]
    h0 = params[7]
    i0 = params[8]
    j0 = params[9]

    stress = a0*np.sin(strain*h0+temp*f0) + \
          b0*strain**3*d0 + e0*strain**2*(temp**2+f0) + \
          c0*(temp**3+b0*strain**2)+ \
