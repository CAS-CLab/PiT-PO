    u = z[0] * x + (z[1] * y + z[2]) * x**2 +        (z[3] * y + z[4]) * x**3 +        z[5] * y**2 + (z[6] * y + z[7]) * x**4 +        (z[8] * y + z[9]) * x**5

    # Calculate stress
    stress = u * y
    return stress
