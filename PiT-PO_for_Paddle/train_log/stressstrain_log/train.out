    y = temp
    stress = np.dot(params, [x, y, np.power(x, 3), np.power(y, 3),
                     np.power(x, 2), np.power(y, 2), 
                     np.power(x, 5), np.power(y, 5), 
                     np.power(x + y, 4)])
    return stress
