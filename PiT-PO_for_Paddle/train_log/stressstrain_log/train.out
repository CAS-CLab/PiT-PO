    sin = np.sin
    log = np.log
    stress = \
    params[0] * (strain + temp) +\
    params[1] * (strains + temps) +\
    params[2] * (strains**3 - temps**3) +\
    (params[3] * (strains * temps * sints(strains) + temps * strains * sints(temps))) +\
    (params[4] * (strains * temps * (strains + temps))) +\
