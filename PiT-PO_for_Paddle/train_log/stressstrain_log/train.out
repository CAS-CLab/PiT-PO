    u = np.sum((strain - (params[0] + params[1]*temp + params[2]*(strain+temp)**2 + \
                     params[3]*strain**2 + params[4]*temp**2 + 
                     params[5]*np.tanh(params[6]*(strain+temp)) + 
                     params[7]*strain*np.sin(params[8]*temp) + 
                     params[9]*strain**3 + params[0]*temp**3)))**2
    v = u + params[10]
    w = v + params[11]*np.exp(-params[12]*temp)
    x = w + params[13]*strains * np.cos(params[14]*temps)
    return x
