def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sum([params[i] * (strain ** (i % 2)) for i in range(0, 11, 2)])
    x2 = np.sum([params[11 + j] * (temp - 20) ** (j // 2) * (strain - 5) ** ((j % 2 == 0) & (j < 9))
             for j in range(9)]) + np.sum([params[12 + j] * (strain * temp) ** (j // 2) 
                                        for j in range(9)]) + np.sum([params[j] * (temp - 20) ** (j // 2) 
                                                            for j in range(9)]) + \
            np.sum([np.sqrt(np.abs(params[j])) * (strains - 5) * (temps - 20) 
                    for j in range(9)]) + \
            np.sum([np.cos(j * np.pi / 9) * (strains ** 3) 
                    for j in range(9)]) + \
            np.sum([np.sin(3 * j * np.pi / 9) * (strains + 10) 
                    for j in range(9)]) + \
            np.sum([np.exp((j + 4) * np.pi / 9) * (strains * temps) 
                    for j in range(9)]) + \
            np.sum([np.log(1 + j * np.pi / 9) * (strains ** 4) 
                    for j in range(9)]) + \
            np.sum([np.tanh(j * np.pi / 9) * (temps - 20) 
                    for j in range(9)])
    return x1 + x2
