def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x11 = np.zeros_like(strain)
    y12 = np.sum(params[:3] * ((temp - 25)**i for i in range(3)), axis=0)
    z13 = np.sum(params[3:6] * (np.sin(np.sqrt(temp))**j for j in range(3)), axis=0)
    a14 = np.sum(params[6:9] * ((strain ** i) * (temp - 15) ** k for i in range(2) for k in range(2)), axis=(0, 1))
    b15 = np.sum(params[9:] * (strain * (temp - 15) ** l + np.exp((temp - 15) / 2)**m for l in range(2) for m in range(2)), axis=0)
    c16 = np.sum(params[9:] * ((temp - 20) ** 2 + temp), axis=0)
    return x11 + y12 + z13 + a14 + b15 + c16
