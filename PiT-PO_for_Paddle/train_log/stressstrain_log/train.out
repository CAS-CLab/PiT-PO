    y = a * strain + b * temp + c * (strain ** 2) + d * (temp ** 2) + e * (strain * temp) + f * (temp ** 3) + g * (strain ** 3) + h * (temp ** 4) + i * (strain ** 4) + j * (strain ** 5)
    return y
