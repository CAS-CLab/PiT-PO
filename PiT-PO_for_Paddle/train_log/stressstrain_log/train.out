def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(np.sqrt(params[0] * temp + params[1] * strain))
    v = np.cos(np.pi * (np.abs(temp - params[2]) / (params[3] + 1)) +
           np.arcsin((np.abs(strain - params[4]) / (params[5] + 1))))
    w = u ** 3 * v ** 2
    x = np.exp(w)
    y = np.sum(x, axis=1) + \
    np.sum(u ** 4 * v ** 3, axis=1) + \
    np.sum(np.sin(u) * v, axis=1) + \
    np.sum(np.sin(u) * v ** 3, axis=1) + \
    np.sum(v ** 2, axis=1) + \
    np.sum(u ** 2 * v, axis=1) + \
    np.sum(np.cos(np.pi * (np.abs(temp - params[2]) / (params[3] + 1))) * u, axis=1) + \
    np.sum(np.cos(np.pi * (np.abs(temp - params[2]) / (params[3] + 1))) * v, axis=1)
    return y
