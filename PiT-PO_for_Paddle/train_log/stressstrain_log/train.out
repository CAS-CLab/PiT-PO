def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    stress_2 = params[0] * strain ** 2 + params[1] * temp ** 2 + \
          params[2] * strain * temp + params[3] * (strain ** 3 - temp ** 3) + \
          params[4] * (strain ** 2 + temp ** 2) + \
          params[5] * (strain + temp) * np.tanh(params[6] * strain + params[7] * temp) + \
          params[8] * (strain ** 4 - temp ** 4)

    a1 = params[0] * strain ** 2 + params[1] * temp ** 2
    a2 = params[2] * strain * temp + params[3] * strain + params[4] * temp + params[5]
    f = a1 + a2
    stress_3 = f ** params[6] * np.exp(params[7] * strain + params[8] * temp) * (params[9] * strain + params[9] * temp)
    return stress_3
