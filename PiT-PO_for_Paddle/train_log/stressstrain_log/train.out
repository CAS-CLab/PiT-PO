def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u, v, w, x, y, z, _ = np.array(params).reshape((3, 3)), np.array(params)[12:]
    a, b = u[0], u[1]
    c, d, e, f, g, h = v[0], v[1], v[2], w[0], w[1], w[2]
    i, j, k, l, m, n = x[0], x[1], x[2], y[0], y[1], y[2]
    o, p, q, r, s, t = z[0], z[1], z[2], 0, 0, 0
    return np.array([
    a*(b*strain + c*temp) + 
    d*(b*temp - c*strain) + 
    e*((b*strain + c*temp)**2 + (b*temp - c*strain)**2) + 
    f*((b*temp - c*strain)**3 + (b*strain + c*temp)**3) + 
    g*((b*strain + c*temp)**4 + (b*temp - c*strain)**4) + 
    h*((b*strain + c*temp)**5 + (b*temp - c*strain)**5) +
    i*(strain**2 + temp**2) + 
    j*(strain + temp)*(temp - strai) + 
    k*(strain + temp)*temp + 
    l*(strain**2)*temp + 
    m*(strain**3)*temp + 
    n*(strain**2 + temp**2 + strai*temp)
    ])
