    f2 = params[3] * (strain ** 4) + params[4] * temp ** 2 + params[5] * temp
    f3 = params[6] * (strain * (temp - 30)) * np.sin(strain * np.pi)
    f4 = params[7] * (strain + 5) ** 3 + params[8] * temp ** 3 + params[9] * temp
    o = f1 + f2 + f3 + f4
    return o
