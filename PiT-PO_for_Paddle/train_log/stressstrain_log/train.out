def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sum(params[:3]) * (strain ** 2)
    y2 = np.sum(params[3:6]) * (temp - 20) * (strain + 10)
    z3 = np.sum(params[6:9]) * (np.cos(np.sqrt(strain)) * (temp - 20) ** 2)
    a4 = np.sum(params[9:]) * (strain * temp)
    b5 = np.sum(np.sin(strain) * np.sin(temp)) * (strain ** 3)
    c6 = np.sum(np.exp(-temp) * np.exp(strain)) * (temp - 20) ** 3
    d7 = np.sum(np.abs(strain) * np.abs(temp - 20) ** 2) * temp
    e8 = np.sum(np.power(strain, 3/2) * temp) * (strain ** 2)
    f9 = np.sum(np.cos(strain) * np.cos(temp)) * (strain + 10) * (temp - 20)
    g10 = np.sum(strain * (temp ** 2 + 1))
    h11 = np.sum(np.log(np.clip(temp + 273.15, 200, 350)))
    i12 = np.sum(np.tanh(100 * strain) * np.sinh(50 * temp))
    j13 = np.sum(np.sin(2 * temp) * np.cosh(2 * str(x=strain)))
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
