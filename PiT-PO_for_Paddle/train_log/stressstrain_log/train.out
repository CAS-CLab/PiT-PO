    o += params[2] * (strain + temp)**3 / 3
    o += params[3] * strain * temp**2
    o += params[4] * temp * str((strain + temp) / (strain - temp))
    o += params[5] * (strain + temp)**2
    o += params[6] * (temp - strain)**2
    o += params[7] * np.exp(strain * temp)
    o += params[8] * strain * temp**2
    return o
