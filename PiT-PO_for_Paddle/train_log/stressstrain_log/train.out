    c = params[0] * temp**3 + params[1] * temp**2 + params[2] * temp
    d = params[3] * strain**2 + params[4] * strain
    e = params[5] * temp**4 + params[6] * strain * temp**3 + params[7] * strain**2 * temp
    f = params[8] * temp**2 + params[9] * strain * temp
    return c + d + e + f
