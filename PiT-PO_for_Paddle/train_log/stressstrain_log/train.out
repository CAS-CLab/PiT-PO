def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.sum(params[:10] * (strain ** 2))
    y2 = np.dot(np.array([np.cos(temp - 20), np.sin(temp - 20)]).T,
            np.array([strain + 10, strain - 5]).T) * np.sum(params[10:])
    z3 = np.exp(np.dot(np.array([[0.5, 0.2], [0.1, 0.1]]),
                      np.array([strains**2, strains])) * (temp - 20)) * np.sum(params[-5:-3])
    a4 = np.einsum('ij,jk->ik', np.eye(2), params[:5]) @ np.array([strains, temp])
    b5 = np.sum((strains**3)[:, None] * np.array([params[5], params[6]]))
    c6 = np.sum((temp - 20)**3 * np.array([params[7], params[8]]))
    d7 = np.sum(np.einsum('ij,jk->ik', strains[:, None], temp[None, :]) * np.array([params[9], 1]))
    e8 = np.sum(strains**2[:, None] * temp[None, :])
    f9 = np.sum((strains + 10)[:, None] * (temp - 20)[None, :])
    g10 = np.sum(strains[:, None] * temp[None, :]**2)
    h11 = np.sum(np.log(temp + 273.15)[:, None] * np.array([params[10-1], 1]))
    i12 = np.sum(np.tanh(strain * 100[:, None]) * np.array([params[9+1], 1]))
    j13 = np.sum(np.sinh(2*temp[:, None]) * np.array([params[9+2], 1]))
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10 + h11 + i12 + j13
