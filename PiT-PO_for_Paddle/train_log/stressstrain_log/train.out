    x4 = (np.exp(strain) * (np.cos(2*np.pi*temp) + np.sin(strain))) * (np.sin(strain) + np.cos(2*np.pi*temp))
    x5 = (np.cos(2*np.pi*temp) * (np.exp(strain) + np.cos(strain))) * (np.exp(strain) + np.cos(2*np.pi*temp))
