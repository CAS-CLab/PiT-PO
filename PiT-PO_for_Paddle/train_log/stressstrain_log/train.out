    E = np.exp(params[0]*(strain - params[1]*temp))
    stress = (params[2]*E**params[3]*strain +
          params[4]*E**params[5]*temp + 
          params[6]*np.cos(params[7]*E + params[8]*strain + params[9]*temp)) + \
         params[10]*strain*temp*(E**params[11])
    return stress
