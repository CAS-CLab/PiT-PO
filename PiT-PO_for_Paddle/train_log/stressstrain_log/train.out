    b = params[1]
    c = params[2]
    d = params[3]
    e = params[4]
    f = params[5]
    g = params[6]
    h = params[7]
    i = params[8]
    j = params[9]

    stress = a*(strain+b*temp+c*strain**2+d*temp**2+e*strain*temp+f*strain*np.exp(temp)+g*np.sin(strain)+h*np.cos(temp)+i*strain**3+j*temp**3)
    return stress
