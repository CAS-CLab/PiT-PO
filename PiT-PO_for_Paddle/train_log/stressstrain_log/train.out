def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    h = np.sum(params[:3]) * (np.power(strain, 2)) / 2 + \
    np.sum(params[3:]) * (np.power(temp, 2))
    x = np.sum([params[i] * np.power(strain, i+1) for i in range(10)]) + \
    np.sum([params[10+i] * np.power(temp, i) for i in range(10)])
    y = np.sum([params[15+i] * np.power(x, i) for i in range(10)]) + \
    np.sum([params[20+i] * np.power(y, i) for i in range(10)])
    z = np.sum([params[25+i] * np.power(z, i) for i in range(10)]) + \
    np.sum([params[30+i] * np.power(w, i) for i in range(10)]) + \
    np.sum([params[35+i] * np.power(v, i) for i in range(10)])
    return h + x + y + z
