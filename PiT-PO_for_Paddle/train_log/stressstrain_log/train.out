def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + params[0] * strain * temp
    y = np.cos(2*params[1] * (strain + temp)) + \
    np.sinh(2*params[2] * (strain + temp)) + \
    np.tanh(2*params[3] * (strain + temp)) + \
    np.cosh(2*params[4] * (strain + temp)) + \
    np.sin(2*params[5] * (strain + temp)) + \
    np.cos(2*params[6] * (strain + temp)) + \
    np.tan(2*params[7] * (strain + temp)) + \
    np.log(np.cosh(2*params[8] * (strain + temp))) + \
    np.arctan2(np.sinh(2*params[9] * (strain + temp)), np.cosh(2*params[9] * (strain + temp)))
    stress = (params[0] * x**2 + np.sum(y) + params[1]) * (1 + np.exp(-params[2] * x)) + \
       (params[3] * x + np.sum(y) + params[4]) * (1 - np.exp(-2*params[5] * x))
    return stress
