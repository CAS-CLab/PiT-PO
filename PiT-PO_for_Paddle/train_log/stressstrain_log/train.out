     (np.cos(params[1] * strain) + np.cos(params[2] * temp))) + \
    (np.exp(np.log(params[3]) * (strain**4 + temp**4)))
    v = (np.tan(params[4] * (strain + temp)) * \
     (np.cosh(params[5] * temp) + np.cosh(params[6] * strain))) + \
    (np.sqrt(params[7] * (strain + temp) + np.pi / 2))
    w = (np.log(np.exp(params[8] * (strain + temp)) + 1) * \
     ((np.cos(params[9] * temp) + np.cos(params[9] * strain)))) + \
    (np.abs(np.sinh(params[0] * (strain - temp))))
