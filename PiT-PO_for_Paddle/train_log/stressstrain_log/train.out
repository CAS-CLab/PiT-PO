def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = (np.cos(np.pi/2*temp) + 1) * (strain + 5)**2
    y2 = (np.exp(-temp) + 1) * (strainsquared + 10) + (np.log(np.sqrt(temp)) + 1) * strain
    z3 = (np.sinh(2*np.pi*temp) + 1) * (strain - 10)**3
    a4 = (np.tanh(3*np.pi*temp) + 1) * (strainsquared - 5) + (np.arctan(temp) + 1) * (strainsquared - 10)
    b5 = (np.cos(np.pi/2*(temp+10)) + 1) * (strainsquared - 5)
    c6 = (np.exp(-np.pi*temp) + 1) * (strainsquared + 5) + (np.log(np.sqrt(temp+10)) + 1) * (strainsquared - 10)
    d7 = (np.sinh(2*np.pi*(temp+10)) + 1) * (strainsquared + 10) + (np.cosh(2*np.pi*temp) + 1) * (strainsquared + 5)
    e8 = (np.tanh(3*np.pi*(temp+10)) + 1) * (strainsquared - 15) + (np.arctan(temp+10) + 1) * (strainsquared - 20)
    f9 = (np.cos(np.pi/2*(temp-10)) + 1) * (strainsquared + 10)
    g10 = (np.exp(-np.pi*(temp-10)) + 1) * (strainsquared + 5) + (np.log(np.sqrt(temp-10)) + 1) * (strainsquared - 20)
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10
