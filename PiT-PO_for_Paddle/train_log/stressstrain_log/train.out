def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    u, v = strain, temp
    stress = (u + v) * (params[0] + params[1]) + \
    (u - v) * (params[2] + np.sqrt(params[3])) + \
    (u ** 2 + v ** 2) * (params[4] + np.cos(2 * np.pi * u) * np.sin(2 * np.pi * v) / 2) + \
    (v ** 4 - u ** 4) * (params[5] + np.cos(3 * np.pi * u) * np.sin(3 * np.pi * v) / 3) + \
    (u * np.sin(v) + v * np.sin(u)) * (params[6] + np.sin(2 * np.pi * (u + v))) + \
    (u * np.cos(v) - v * np.cos(u)) * (params[7] + np.cos(4 * np.pi * u) * np.sin(4 * np.pi * v) / 4) + \
    (u ** 3 + v ** 3) * (np.sqrt(params[8]) + np.cos(5 * np.pi * u) * np.sin(5 * np.pi * v) / 5) + \
    np.log(np.abs(u*v)) * (params[9] + np.cos(6 * np.pi * u) * np.sin(6 * np.pi * v) / 6)
    return stress
