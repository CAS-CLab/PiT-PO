def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    l = np.add(np.multiply(params[0], temp), np.multiply(params[1], strain))
    m = np.multiply(params[2], np.power(temp, 2)) + \
    np.multiply(params[3], np.power(strain, 2)) + \
    np.multiply(params[4], np.power(temp, 3)) + \
    np.multiply(params[5], np.power(strain, 3))
    n = np.multiply(np.multiply(params[6], strain), np.add(np.multiply(strain, temp), np.multiply(strain, str(0)))) + \
    np.multiply(np.multiply(params[7], np.multiply(strain, temp)), np.add(np.multiply(strain, str(0)), np.multiply(strain, str(0)))) + \
    np.multiply(params[8], np.multiply(strain, np.add(np.multiply(strain, temp), np.multiply(strain, str(0)))))
    o = l * m + n
    return o
