def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x11 = np.power(params[0], 2) * strain
    y12 = np.cos(np.arcsin(strain)) * np.sqrt(params[1]) * np.exp(-temp/np.add(1, np.divide(1, params[2])))
    z13 = np.multiply(temp-20, np.multiply(strain+10, np.square(np.divide(strain, 5))))
    a14 = np.sin(np.pi/2 - np.arcsin(strain)) * np.sin(np.pi/2 - np.arcsin(strain))
    b15 = np.multiply(strain, np.exp(-np.divide(temp, np.add(1, np.divide(1, params[5])))))
    c16 = np.divide(strain, np.add(1, np.multiply(strain, np.square(np.divide(1, 5)))))
    d17 = np.multiply(strain, np.square(np.divide(1, 5)))
    e18 = np.sqrt(np.add(np.square(np.divide(1, 5)), np.square(np.divide(strain, 5))))
    return np.add(x11, y12, z13, a14, b15, c16, d17, e18)
