    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    k = params[0] * (temp + strain) * (temp + strain - 2 * temp) * (temp + strain)
    l = params[1] * temp * (temp + strain) ** 2
    m = params[2] * temp * (temp + strain) * (temp + strain - 2 * temp)
    n = params[3] * temp ** 3 * (temp + strain)
    o = params[4] * strain * (temp + strain) * (temp + strain - 2 * temp)
    p = params[5] * temp * (temp + strain) * (temp + strain - 2 * temp) ** 2
    q = params[6] * strain * (temp + strain) * (temp + strain - 2 * temp) * (temp + strain)
    r = params[7] * temp * (temp + strain) * (temp - temp**2) * (temp + strain)
    s = params[8] * strain * (temp + temp**2) * (temp + strain)
    t = params[9] * (temp + strain) * (temp + strain)**2 * (temp + strain)
    return t + s + r + o + n + m + l + k
