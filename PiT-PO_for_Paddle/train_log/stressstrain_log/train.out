def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x = strain ** 2 + temp ** 2 + np.sum([params[i+1] * np.sin(params[i*2+3] * strain + params[i*2+4] * temp)
                                    for i in range(7)]) + \
    np.sum([params[i+1] * np.cos(params[i*2+3] * strain + params[i*2+4] * temp) 
            for i in range(7)]) + \
    np.sum([params[i+1] * np.exp(strain + np.tanh(temp)) 
            for i in range(7)])
    stress = np.sum([params[i+1] * x**2 for i in range(8)]) + \
        np.sum([params[i+1] * (np.exp(x) - 1) for i in range(8)]) + \
        np.sum([params[i+1] * (x + 1) for i in range(8)]) + \
        np.sum([params[i+1] * np.log(np.abs(x)) for i in range(8)]) + \
        np.sum([params[i+1] for i in range(8)]) + \
        np.sum([params[i+1] * (x - 1) for i in range(8)]) + \
        np.sum([params[i+1] * (x + 1) for i in range(8)]) + \
        np.sum([params[i+1] * np.sinh(x) for i in range(8)]) + \
        np.sum([params[i+1] * np.cosh(x) for i in range(8)])
    return stress
