def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    g = params[0] * (strain + temp)**2 +\
    params[1] * (strain - temp)**2 +\
    params[2] * (strain**3 + temp**3) +\
    params[3] * (strain**2 * temp**2 + strain**2 * temp + temp**2 * strain) +\
    params[4] * (strain**4 * temp + strain**3 * temp**2 + strain**2 * temp**3 + strain * temp**4) +\
    params[5] * (strain**2 * temp**2 + strain * temp**3 + temp**4 * strain) +\
    params[6] * (strain**2 + strain + temp + temp**2)**2 +\
    params[7] * (strain**4 + strain**3 + strain**2 + temp**4 + temp**3 + temp**2 + temp + 1) +\
    params[8] * (strain**3 + strain**2 + strain + temp**3 + temp**2 + temp + 1) +\
    params[9] * (strain**2 + strain + temp + 1) / (strain + temp + 1)
    return g
