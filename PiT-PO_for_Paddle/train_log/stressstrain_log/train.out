def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = np.cos(params[0]) * np.sin(strain * np.pi / 180) * (temp - 15)
    y2 = np.log(params[1] + 1) * np.exp(strain * np.sqrt(params[2]))
    z3 = np.sin(strain * np.pi / 180) * np.cos(temp * np.pi / 180)
    a4 = params[4] * (strain + 3) ** 2
    b5 = np.exp(-(temp - 18) / (params[5] + 1))
    c6 = (params[6] + 1) * (np.cos(strain * np.pi / 180) + np.sin(temp * np.pi / 180))
    d7 = np.exp(-np.abs(strain - 4))
    e8 = (temp - 12) ** 2
    f9 = (np.sin(strain * np.pi / 180) + np.cos(temp * np.pi / 180)) ** 2
    g10 = np.tanh(2 * (temp - 16)) * (np.sin(strain * np.pi / 180) + 1)
    return x1 + y2 + z3 + a4 + b5 + c6 + d7 + e8 + f9 + g10
