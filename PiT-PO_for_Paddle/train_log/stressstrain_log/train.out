    (np.sin(3*np.pi*strain + 2*np.pi*temp) - np.cos(4*np.pi*strain + 3*np.pi*temp))**2 + \
    np.exp(5*(x + np.log(temp))) + \
    params[0]*x**2 + y + (np.cos(6*x + 7*temp) - np.sin(8*x + 9*temp))
    return stress
