    params[2] * (strain ** 2 + temp ** 2) + \
    params[3] * strain * temp + \
    params[4] * temp ** 3 + \
    params[5] * strain ** 3 + \
    params[6] * temp ** 4 + \
    params[7] * (strain ** 4 + temp ** 5) + \
    params[8] * strain * (temp ** 2 + temp * strain)
    return x
