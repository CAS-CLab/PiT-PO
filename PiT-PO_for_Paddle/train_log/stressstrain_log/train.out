         params[2] * strain**2 + params[3] * temp**2 + \
         params[4] * strain * temp + params[5] * temp**3 + \
         params[6] * strain**3 + params[7] * strain * temp**2 + \
         params[8] * temp * strain**2 + params[9] * strain**2 * temp
    return stress
