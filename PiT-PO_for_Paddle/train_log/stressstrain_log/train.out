    x2 = params[2] * temp**2 * (strain + 5)**2 + params[3] * (strain + 5)**3 * temp
    y1 = params[4] * (strain + 10)**2 * np.tanh(params[5] * (temp - 20))
    x3 = params[6] * str(x1 + x2 + y1)
