    y = params[1] * (strain + temp) * temp
    z = params[2] * strain * temp ** 2 + params[3] * temp ** 3
    w = params[4] * temp ** 4 + params[5] * strain * temp ** 3 + params[6] * str((strain + temp) * temp) + params[7] * (temp ** 4) + params[8] * (strain + temp) * temp
    stress = x + y + z + w
    return stress
