    strain**2 * (temp ** 2 / np.pi) + \
    (temp / np.pi) * np.cos(2 * np.arccos(np.exp(-strains / (2 * np.sqrt(params[0]))))) + \
    strain * (np.cos(strain / np.sqrt(params[0])) * np.sin(temp / np.sqrt(params[0]))) + \
    strain * (temp / np.sqrt(params[1])) * np.sin(strain / np.sqrt(params[1]))
