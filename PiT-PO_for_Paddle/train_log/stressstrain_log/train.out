def equation(strain: np.ndarray, temp: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for stress in Aluminium rod

    Args:
        strain: A numpy array representing observations of strain.
        temp: A numpy array representing observations of temperature.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing stress as the result of applying the mathematical function to the inputs.
    """
    x1 = params[0] * (strain ** 2)
    y2 = np.sum(params[1:5] * ((temp - 20) * (np.cos(strain * np.pi/180)) +
                          (strain + 10) * (np.sin(strain * np.pi/180))))
    z3 = np.sum(np.abs((np.array([3, 4, 5]) * (np.cos(strain * np.pi/180))) *
                  (temp - 20)**2))
    w4 = np.sum(params[6:9] * (strain * temp))
    v5 = np.sum(params[9:] * (strain ** 3))
    u6 = np.sum(np.abs((np.array([4, 5, 6]) * (np.cos(strain * np.pi/180))) *
                  (temp - 20)**3))
    t7 = np.sum(np.abs((np.array([4, 5, 6]) * (np.cos(strain * np.pi/180))) *
                  (temp - 20)**2 * temp))
    s8 = np.sum(np.abs((np.array([7, 8, 9]) * (strain ** 2 * temp))))
    r9 = np.sum(np.abs((np.array([3, 4, 5]) * (strain + 10) * (temp - 20))))
    a10 = np.sum(np.abs((np.array([10, 11, 12]) * (strain * temp ** 2))))
    return x1 + y2 + z3 + w4 + v5 + u6 + t7 + s8 + r9 + a10
