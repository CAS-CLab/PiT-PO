      + np.sin(5*params[4]*x) * np.sinh(params[5]*v) * np.cosh(params[6]*x) \
      + np.sin(params[7]*v) * np.sinh(params[8]*x)) \
     + (np.sin(params[0]*x) ** 3 + np.cosh(v) ** 3) * (np.sin(params[1]*v) * np.cosh(params[2]*x) \
