from scipy.optimize import minimize
import numpy as np

def equation_v2(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> float:
    """Improved version of `equation_v1`."""
    a2 =     ((-6*params[0] + 12*params[1])*np.power(x, 3) - 
     (18*params[1] - 24*params[2])*x*((v**2 - 2*params[4])**2) + 
     (36*params[1]*params[2] - 72*params[3] - 48*params[4])*x*((v**2 - 2*params[4])**2) + 
     (72*params[1]*params[2] - 144*params[3]*x - 96*params[4]*v - 96*params[5])*((v**2 - 2*params[4])**3) + 
     (9*params[6] - 18*params[7])*np.power(x, 2) - 
     (30*params[6] - 60*params[7])*x*v + 
     (15*params[8] - 45*params[9])*np.power(x, 3) - 
     (20*params[8] - 40*params[9])*x*((v**2 - 2*params[4])**2) + 
     (16*params[7]*params[8] - 32*params[9])*x*((v**2 - 2*params[4])**2) + 
     (64*params[7]*params[8] - 128*params[9])*((v**2 - 2*params[4])**3) + 
     (18*params[8]*(np.power(x, 2) + 4*x*v + 4*np.power(v, 2)))*((v**2 - 2*params[4])**3)

    # Define initial guess for parameters
    init_guess = np.array([1.0]*10)

    # Minimize the difference between the model and the data
    res = minimize(lambda p: a2, init_guess, args=(x, v, params))

    return res.fun
