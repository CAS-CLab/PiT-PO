def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = 3 * (np.power(x, 2) - np.square(v)) ** 3 * np.sin(2 * np.pi * np.sqrt(params[0]) / 3)
    b0 = np.abs(v) * (np.square(np.abs(v)) - 3 * np.square(v) + 2 * np.square(v) *
                 (np.square(x) - np.power(np.cos(2 * np.pi * np.sqrt(params[1]) / 3), 2)))
    c0 = np.sum((np.square(v) - 3 * np.square(v) * np.square(x) + 2 * np.square(v) *
            (np.square(x) - np.cos(2 * np.pi * np.sqrt(params[1]) / 3)))**2 *
          (np.square(x) - np.cos(2 * np.pi * np.sqrt(params[1]) / 3)) * np.sin(2 * np.pi * np.sqrt(params[0]) / 3))
    dv = (a0 + b0 + c0) * v + (np.square(v) - 3 * np.square(v) * np.square(x) +
                         2 * np.square(v) * (np.square(x) - np.cos(2 * np.pi * np.sqrt(params[1]) / 3))) * v**3
    return dv
