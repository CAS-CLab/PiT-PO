    (params[1]*x**2 + params[2]*v**2 + 2*params[3]*x*v + 2*params[4]*x + 2*params[5]*v + 2*params[6]*x*v)**2 / 2 + \
    (params[7]*x + params[8]*v + 2*np.cos(2*params[6]*v)*dv) + \
    (params[9]*(dv + params[7]*v**2/2 + params[8]*v*(dv + params[7]*v**2/2))/(
        dv + params[7]*v**2/2 + 
        (2*params[7]*v + 2*params[8]*v**2)*(dv + np.cos(2*params[6]*v))))
    return dv
