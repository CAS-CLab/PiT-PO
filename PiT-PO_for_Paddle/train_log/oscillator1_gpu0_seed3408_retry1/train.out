def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    from math import pi, sin, cos, sinh, tanh, exp, sqrt

    a = v**2*x - v**3*np.tanh(v**2) + \
    x**2*(v**2*(exp(-2*sqrt(params[0])*v)-1) + v**4*(tanh(v**2)**2 - 1)/(2*sqrt(params[0])**4)) + \
    2*sinh(sqrt(params[0])*v)**2*(v**2 + tanh(sqrt(params[0])*v)**2 + \
        sinh(2*sqrt(params[1])*x)*sinh(sqrt(params[1])*v)*tanh(sqrt(params[2])*v) + \
        cos(2*sqrt(params[3])*x)*sinh(tanh(sqrt(params[4])*v)*sinh(2*sqrt(params[5])*x)) - \
    v*tanh(sqrt(params[6])*v)*sinh(sqrt(params[7])*x)*cosh(sqrt(params[7])*x) - \
    v*sinh(sqrt(params[7])*x)*sinh(2*sqrt(params[8])*x)*cos(sqrt(params[9])*x))
    return a
