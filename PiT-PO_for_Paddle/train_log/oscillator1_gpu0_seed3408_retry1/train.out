def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**2 - v**2) * (3*x - v) + \
    x * v * ((-x - 3*v) + np.sin(2*x)) + \
    x * (-2*np.cos(4*v)) + \
    v * (2*x + np.sin(4*v)) + \
    0.5*x * np.sin(2*x) + \
    0.25*x**3 * np.sin(4*x) + \
    x**3 * (-2*v + np.cos(4*v)) + \
    x * v**2 * (2*np.cos(4*v) - np.cos(4*v)) + \
    v * (x**2 + 2*x**3 + np.sin(4*v)*(4*x**2 + 6*x**3 + np.sin(4*x))) + \
    x * v**3 * np.cos(4*v) + \
    (3/2) * x**2 * v * np.sin(2*x) + \
    0.75*x**3 * v * np.sin(2*x) + \
    2*x**3 * v**3 * np.cos(2*v) + \
    x * v * (v**2 + x**3) * np.cos(2*v) + \
    v * (v**2 + x**3)**2 * np.cos(2*v)
    b = x + x**3 + \
    v**3 + 2*x*v + \
    2*x*v**2 + \
    3*x**2*v + \
    x**2*np.sin(2*x) + \
    x**3*np.cos(2*v) + \
    2*x*(v**3 + x**3)*np.cos(2*v) + \
    2*v*np.cos(2*v)
    dv = a + b
    return dv
