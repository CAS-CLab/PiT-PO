def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 0.6*params[0]*(x**7 + 4*x**5 + x**3)*(v**3) + \
    0.15*((x-2*params[1])**2)*(x*v**2 + 2*v*(x**2+3*x+2)) + \
    0.35*params[2]*((x+3*params[1])*v - 0.5*((x+3*params[1])**2 - 1))*(x-v) + \
    0.35*params[4]*(x-v)*((x-v)**3) + \
    0.35*params[5]*((x+4*params[1])**2 - 2*(x+4*params[1])) + \
    0.15*(x+4*params[1])**4 + \
    0.35*(x+2*params[1])**2*(v**2 - 2*v*(x+2*params[1])) + \
    0.35*(x+6*params[1])**5

    dv = a + 0.05*(x+4*params[1])*(x+v+2*params[1])**3 + \
    0.15*(x+2*params[1])*(x+v+4*params[1])**3 + \
    0.15*(x+4*params[1])**3*(v-x)**3 + \
    0.15*(x+2*params[1])**3*(x+4*params[1]-v)**3

    return dv
