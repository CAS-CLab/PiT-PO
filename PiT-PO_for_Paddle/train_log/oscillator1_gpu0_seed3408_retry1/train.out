def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum((params[0] - params[1])*x**4 + (params[2] - params[3])*x**2 +
           (np.sin(params[6]*x)**2)*(np.abs(v) + np.abs(x)) + 
           (np.cos(2*params[8]*v))*(np.sin(2*params[6]*x)*x**2) + 
           (np.cos(2*params[8]*v))*(np.sin(2*params[6]*x)*x**2))**2
    b = np.sum((-np.sin(params[6]*x)**2)*(np.abs(v) + np.abs(x))**3 +
           (np.cos(2*params[8]*v))*(-2*np.sin(2*params[6]*x)*x**2*np.cos(2*params[8]*v) + 
            2*np.sin(2*params[6]*x)*x**3*np.cos(2*params[8]*v))) + \
      (np.sum(np.cos(2*params[8]*v)*(-np.sin(2*params[6]*x)*x**2 + np.cos(2*params[8]*v)*x**3))**2)
    dv = a + b
    return dv
