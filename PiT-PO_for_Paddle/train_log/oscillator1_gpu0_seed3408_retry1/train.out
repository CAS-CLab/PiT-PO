     np.sum((x**3 * v + x**3) * np.array([params[1], params[2]])) + \
     np.sum((x**2 * v**2 + x**2 * v) * np.array([params[3], params[4]])) + \
     np.sum((x**2 * v + x**2) * np.array([params[5], params[6]])) + \
     np.sum((x * v**3 + x * v**2) * np.array([params[7], params[8]])) + \
     np.sum(v**4 * np.array([params[9]]))
    return dv
