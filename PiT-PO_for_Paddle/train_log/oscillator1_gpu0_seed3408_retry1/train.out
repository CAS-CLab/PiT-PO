    (np.sin(2*np.pi*x)*np.cos(np.pi*v/2) + \
     np.sin(4*np.pi*x)*np.sin(2*np.pi*v/2) + \
     np.sin(6*np.pi*x)*np.cos(3*np.pi*v/2)) + \
    (x**2 * (v**2 + 4*params[2]*(x**4 + v**6))) + \
    (np.log(v + 1)*(x**3 + v**3)) + \
    ((x + v)**2*(np.exp(-(x-v)**2) + (x-v)**2)) + \
    (x**2 * (v**4 + 2*params[3]*(x**6 + v**8))) + \
