    0.15*(x-2*params[1])**2*(x*v**2 + 2*v*(x**2+3*x+2)) + \
    0.35*params[2]*((x+3*params[1])*v - 0.5*((x+3*params[1])**2 - 1))*(x-v) + \
    0.35*params[4]*(x-v)*((x-v)**3) + \
