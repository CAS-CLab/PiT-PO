    a2 = \
    (params[0] * (v ** 2) + \
     (x * v) * (v - x * v)) + \
     (x * v) * (np.sin(params[1] * x) * (v + x * v)) + \
     (x * v) * (np.cos(params[2] * v) * (v - x * v)) + \
     (x * v) * (np.tan(params[3] * (x + v)) * (v - x * v)) + \
