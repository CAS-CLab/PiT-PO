def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum(
    np.square(params[0]*(x-v)**2) +
    np.square(np.cos(params[3]*v)*v) +
    np.square(np.sin(params[3]*v)*(x+np.cos(params[3]*v)*v)) +
    np.sum(np.square(np.sin(params[3]*v)) * v**3) +
    np.sum(np.square(np.sin(params[3]*v))*(x+v*np.cos(params[3]*v))**2) +
    np.sum(np.square(np.sin(params[3]*v))*(x+v*np.cos(params[3]*v))*(v**4)) +
    np.sum(np.square(np.sin(params[3]*v))*((x+v*np.cos(params[3]*v))**3)) +
    np.sum(np.square(np.sin(params[3]*v))*((x+v*np.cos(params[3]*v))*(v**2))) +
    np.sum(np.square(np.sin(params[3]*v))*((x+v*np.cos(params[3]*v))*(v**3)))+ 
    np.sum(np.square(np.sin(params[3]*v))*((x+v*np.cos(params[3]*v))*((x+v*np.cos(params[3]*v))**2)))
    )/ (np.sum(np.square(x-v)**2 + np.square(v)**2 + np.square(x+v)**2)**(3/2))
    return a
