def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(2)*x)*(v+1)**3*(np.cos(3*np.sqrt(2)*x)-1)
    b = 2*np.exp(-x/np.sqrt(3))*v*(np.cosh(2*np.sqrt(3)*x)+1)
    c = 2*np.pi*np.exp(-(x-1)**2/(2*np.pi))**3
    d = np.exp(-x/np.sqrt(2))*v*(1-np.exp(-x/np.sqrt(2)))
    e = (x/np.sqrt(2))**(3/2)*v*(1-np.exp(-x/np.sqrt(2)))
    f = 2*np.pi*np.exp(-(x-1)**2/(2*np.pi))**2
    g = (x/np.sqrt(2))**(5/2)*v*(1-np.exp(-x/np.sqrt(2)))**2
    h = np.exp(-(x-1)**2/(2*np.pi))**3
    i = (x/np.sqrt(2))**(7/2)*v*(1-np.exp(-x/np.sqrt(2)))**3
    j = (x/np.sqrt(2))**(9/2)*v*(1-np.exp(-x/np.sqrt(2)))**4
    k = np.exp(-(x-1)**2/(2*np.pi))**4
    l = (x/np.sqrt(2))**(11/2)*v*(1-np.exp(-x/np.sqrt(2)))**4
    m = (x/np.sqrt(2))**(13/2)*v*(1-np.exp(-x/np.sqrt(2)))**5
    n = (x/np.sqrt(2))**(15/2)*v*(1-np.exp(-x/np.sqrt(2)))**6
    o = (x/np.sqrt(2))**(17/2)*v*(1-np.exp(-x/np.sqrt(2)))**7
    p = (x/np.sqrt(2))**(19/2)*v*(1-np.exp(-x/np.sqrt(2)))**8
    dv = 12*a*c*e*f*g*h*i*j*k*l*m*n&o*p-v-b-d-e-f-g-h-i-j-k-l-m*n-o-p
    return dv
