def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    (np.power(params[0], 3) * np.power(x, 3)) / np.power(3, 3) - 
    (np.power(params[1], 2) * np.power(v, 2)) / np.power(2, 2) + 
    (np.power(np.power(params[2], 3), 3/3) * np.power(x, 3)) / np.power(3, 3) - 
    (np.power(np.power(params[3], 2), 3/2) * np.power(x, 3) * np.power(v, 2)) / np.power(2, 2) + 
    (np.power(params[4], 3) * np.power(x, 3) * np.exp(-np.power(params[5], 2) * np.power(v, 2))) / np.power(2, 2) + 
    (np.power(params[6], 2) * np.power(x, 3) * np.cos(2*np.power(params[7], 2)*np.power(v, 2))) / np.power(2, 2) + 
    (np.power(params[8], 2) * np.power(v, 3) * np.sin(2*np.power(params[9], 2)*np.power(x, 2))) / np.power(2, 2)
    )
    return a
