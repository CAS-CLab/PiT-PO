    -2*params[3]*v**2*x**2 +
    -2*params[4]*v*x**3 +
    -2*params[6]*v**2*x**2 +
    -2*params[7]*v**3*x +
    -2*params[8]*v**2*x*np.cos(v*params[8]))

    dv = a + b

    return dv
