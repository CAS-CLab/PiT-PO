def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.sqrt(params[0]) * x) - np.cos(np.sqrt(params[1]) * v)) / np.sin(np.sqrt(params[2]))
    b = np.sqrt((v**2 * (np.sinh(params[3]))**2 + (x**2 * np.cosh(params[3])**2 - 2*np.tanh(params[3])*x*v)))
    c = (v*(np.sinh(params[3])*np.cosh(params[3])*np.sinh(np.sqrt(params[4]) * x) + np.cosh(np.sqrt(params[4]) * x)*np.sinh(np.sqrt(params[5]) * v))) / np.sinh(np.sqrt(params[6]))
    d = (x*(np.sinh(np.sqrt(params[7]) * v) + np.cosh(np.sqrt(params[7]) * v)*np.sin(np.sqrt(params[8]) * x))) / np.sinh(np.sqrt(params[9]))
    return a + b * c + d
