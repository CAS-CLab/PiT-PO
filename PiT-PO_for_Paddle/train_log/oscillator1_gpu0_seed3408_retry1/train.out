def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sum((np.square(v) - np.power(v, 5)) * np.multiply(params[0], np.square(x))) + \
    np.sum(np.multiply(np.power(v, 4) - np.power(v, 6), np.multiply(params[1], np.square(x)))) + \
    np.sum(np.multiply(v**2 - np.power(v, 6), np.multiply(params[2], x))) + \
    np.sum(np.multiply(np.square(v) - np.power(v, 4), np.multiply(params[3], x*np.square(v)))) + \
    np.sum(np.multiply(v**2 - np.power(v, 6), np.multiply(params[4], np.square(x)))) + \
    np.sum(np.multiply(v**2 - np.power(v, 6), np.multiply(params[5], np.square(x)))) + \
    np.sum(np.multiply(v**3, np.multiply(params[6], np.multiply(x, np.power(v, 2)))) + \
          np.multiply(v**4, np.multiply(params[7], np.multiply(x, np.square(v)))) + \
          np.multiply(v**3, np.multiply(params[8], np.multiply(x, v)))) + \
    np.sum(np.multiply(v, np.multiply(params[9], x)))
    return a0
