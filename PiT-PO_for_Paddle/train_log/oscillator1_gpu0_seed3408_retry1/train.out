def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(np.square(params[:3])) / np.sum(np.square(params[:3]))) * x + \
    (np.sum(np.multiply(x**2, np.array([0, 1, 2]))) / np.sum(np.multiply(x**2, np.array([0, 1, 2])))) * v + \
    (np.sum(np.multiply(v**3, np.array([0, 1, 2]))) / np.sum(np.multiply(v**3, np.array([0, 1, 2])))) * x + \
    (np.sum(np.multiply(np.sin(np.array([0, 1, 2]) * x), np.array([0, 1, 2]))) / np.sum(np.multiply(np.sin(np.array([0, 1, 2]) * x), np.array([0, 1, 2])))) * x**3 + \
    (np.sum(np.multiply(np.cos(np.array([0, 1, 2]) * v), np.array([0, 1, 2]))) / np.sum(np.multiply(np.cos(np.array([0, 1, 2]) * v), np.array([0, 1, 2])))) * v**3 + \
    (np.sum(np.multiply(x, v)) / np.sum(np.multiply(x, v))) * x * v
    return a
