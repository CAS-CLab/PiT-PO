def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (params[0] * x**2 + 2*params[1] * v**2 +
     2*(2*params[2] - 2*params[3]) * x * v + 
     2*(2*params[3]**2 - 2*params[4]) * v**2 + 
     2*params[5] * x**2 * v + 
     2*params[6] * x * v**2 + 
     2*params[7] * x * v**3 + 
     2*params[8] * v**3 + 
     2*np.sin(2*params[9]*v)*v**3)/(
     2*x + 2*v*(2*params[3] - 2*params[5]/(2*params[9])) + 
     2*params[7]*v**2*
     (2*params[3]**2 - 2*params[4] - 2*params[6]*np.cos(2*params[9]*v)))
    b = 2*np.cos(2*params[9]*v)*(v*(2*params[3] - 2*params[5]/(2*params[9])) +
         (2*params[3]**2 - 2*params[4] - 2*params[6]*np.cos(2*params[9]*v))/2 +
         (2*np.sin(2*params[9]*v)*v**3)/(2*x + 2*v*(2*params[3] - 2*params[5]/(2*params[9])) + 
         2*params[7]*v**2*(2*params[3]**2 - 2*params[4] - 2*params[6]*np.cos(2*params[9]*v))))
    return b
