def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    np.sum(((x**2 - v**2/2)*(np.cos(np.pi*params[7]*x)-np.sin(2*np.pi*params[9]*v)) + (x*v*(np.cos(np.pi*params[7]*x)+np.sin(2*np.pi*params[9]*v)))) * (np.sqrt(2*params[0])*x+np.sqrt(2*params[1])*v)**3) +
    np.sum((-np.sqrt(2*params[0])*x+np.sqrt(2*params[1])*v)**5 - (-np.sqrt(2*params[0])*x-np.sqrt(2*params[1])*v)**5) * (np.sqrt(2*params[4])*x+np.sqrt(2*params[5])*v)**3 +
    np.sum((x**2 - v**2/2)**2 * (np.cos(np.pi*params[7]*x)+np.sin(2*np.pi*params[9]*v)) * (np.sqrt(2*params[2])*x+np.sqrt(2*params[3])*v)**3) +
    np.sum((-np.sqrt(2*params[0])*x+np.sqrt(2*params[1])*v)**3 * (np.cos(np.pi*params[7]*x)-np.sin(2*np.pi*params[9]*v)) * (np.sqrt(2*params[2])*x-np.sqrt(2*params[3])*v)**3) +
    (x**2 - v**2/2)**3*(2*np.sinh(np.sqrt(2*params[8])*x)*np.cosh(np.sqrt(2*params[8])*v) - 1)
    )
    return a
