def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[0] * x) * np.cos(v + np.pi / 4) + \
    (np.cos(2 * x) + 2 * v**2) * np.tan(params[1] * v) + \
    (v**3 + np.sin(3 * x)) * np.cosh(np.sqrt(params[2]) * x) + \
    (np.sin(4 * v) - v**4) * np.log(np.exp(params[3] * x) + np.exp(-np.pi / 2))
    b = np.sinh(np.sqrt(params[4]) * x) * np.cos(v + np.pi / 2) + \
    (np.sin(np.pi / 4) + np.cos(5 * x)) * np.arctan(v / np.sin(params[5] * x)) + \
    (np.cos(3 * v) + np.sin(2 * x)) * np.tanh(np.sqrt(params[6]) * v) + \
    (np.sin(2 * v) + np.cos(7 * x)) * np.cosh(np.sqrt(params[7]) * x)
    c = np.exp(np.sqrt(params[8]) * x) * np.cos(v + np.pi / 4) + \
    (np.sin(2 * v) - np.cos(5 * x)) * np.log(np.exp(np.sqrt(params[9]) * v) + np.exp(-np.pi / 2))
    dv = a * v + b + c
    return dv
