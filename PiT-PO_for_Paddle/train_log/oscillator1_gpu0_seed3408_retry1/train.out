def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(params[0]) * x)**3
    b = np.cos(np.sqrt(params[0]) * x)**2 * \
    (np.sin(np.sqrt(params[1]) * x)**2 * v**2 +\
     np.cos(np.sqrt(params[1]) * x)**2 * v**2 +\
     np.tan(np.sqrt(params[1]) * x) * (v * np.cos(np.sqrt(params[1]) * x) - x * np.sin(np.sqrt(params[1]) * x)))
    c = np.sin(np.arccos(np.cos(np.sqrt(params[2]) * x))) * \
    (np.cos(np.sqrt(params[2]) * x) * v +\
     np.sin(np.sqrt(params[2]) * x) * v**2 +\
     np.cos(2*np.sqrt(params[2]) * x) * v +\
     np.sin(2*np.sqrt(params[2]) * x) * v**2 +\
     np.cos(np.sqrt(params[3]) * x)*v +\
     np.sin(np.sqrt(params[4]) * x))
    d = np.sin(np.pi/2 - np.arctan2(v, x)) * \
    (np.cos(np.pi/2 - np.arctan2(v, x))*v +\
     np.sin(np.pi/2 - np.arctan2(v, x))*v**2)
    return a + b + c + d
