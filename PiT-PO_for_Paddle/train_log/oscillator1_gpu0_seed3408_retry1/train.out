def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(x**2 + v**4))
    b = np.cos(v) * x
    c = a * np.exp(-v) + np.exp(-x) + a * np.exp(-x) + b * np.sin(v)
    d = np.sqrt(c)
    e = np.sin(d) + np.cos(d) + np.sin(x) * np.sin(v)
    f = x**2 * np.sin(d) + np.cos(x) * np.cos(d)
    g = np.sin(f) + np.cos(f) * np.sin(v) + np.sin(v) * np.cos(x)
    h = np.sin(g) * np.sin(x) * np.sin(v) + np.cos(g) * np.cos(x) * np.cos(v)
    i = np.sin(h) * np.sin(x) + np.cos(h) * np.cos(x)
    j = np.sin(i) * np.sin(v) + np.cos(i) * np.cos(v)
    k = np.sin(j) * np.sin(v) + np.cos(j) * np.cos(v)
    l = np.sin(k) * np.sin(x) + np.cos(k) * np.cos(x)
    m = np.sin(l) * np.sin(v) + np.cos(l) * np.cos(v)
    n = np.sin(m) * np.sin(x) + np.cos(m) * np.cos(x)
    o = np.sin(n) * np.sin(v) + np.cos(n) * np.cos(v)
    p = np.sin(o) * np.sin(x) + np.cos(o) * np.cos(x)
    dv = a * x**4 + b * x**2 + c * x + d * v**4 + e * v**2 + f * v + g + h + i + j + k + l + m + n + o + p
    return dv
