     np.cos(params[1]) * np.sin(v) +
     np.exp(params[2] * x) * v**2 +
     np.log(np.abs(1 + v)) * x * v +
     np.tan(params[3]) * x * np.sin(v)**2 +
     np.sqrt(params[4]) * (x**3 + x * v**2) * np.cos(v) +
