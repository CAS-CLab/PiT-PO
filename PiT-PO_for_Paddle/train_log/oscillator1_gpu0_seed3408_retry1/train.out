    b = 0.5 * a * (x - 2 * np.tanh(0.1 * (x**2 + v**4)))* np.exp(-np.sqrt(2) * (x**2 + v**4))
    c = 0.1 * np.sinh(0.01 * x) * (x**3 + v**5)
    d = 0.05 * (x - 2 * np.arctanh(0.02 * (x**2 + v**4)))**2
    e = 0.01 * (x**2 + v**4)**2
    f = 0.005 * (x + 2 * np.cosh(0.005 * x))**3
    g = 0.001 * (x**2 + v**4)**3
    h = 0.0005 * (x**2 + v**2)**3
    dv = a*(e*f+g+h) + b*c + d*e + f*g + g*h + e*d + f*b + h*c
    return dv
