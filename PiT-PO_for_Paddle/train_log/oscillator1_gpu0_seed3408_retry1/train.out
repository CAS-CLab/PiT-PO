    np.dot(x, np.exp(-np.sqrt(params[0])*x)) + \
    np.sum(np.multiply(np.sin(2*np.pi*params[2]*x), np.square(x))) + \
    np.sum(np.multiply(np.sin(2*np.pi*params[5]*v), np.square(v))) + \
