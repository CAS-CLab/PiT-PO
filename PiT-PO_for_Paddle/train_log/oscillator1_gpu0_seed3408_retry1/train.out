    b = params[2] * (np.sin(params[3] * x) * v)
    c = params[4] * (x - params[5])**2
    d = params[6] * (v ** 3)
    e = params[7] * (x + params[8])**3
    dv = a * x**2 + b + c + d + e
    return dv
