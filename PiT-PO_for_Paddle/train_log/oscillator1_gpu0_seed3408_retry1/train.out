    a0 = params[0]
    b0 = a0 / (a0 ** 2 + 1)
    b1 = a0 * (a0 - 1) / ((a0 ** 2 + 1) ** 3)
    c1 = (b0 * a0) - (b1 * (a0 ** 2))
    d1 = (c1 * (a0 ** 3)) - (b0 * (a0 ** 4))
    e1 = (d1 * (a0 ** 5)) - (c1 * (a0 ** 6))
