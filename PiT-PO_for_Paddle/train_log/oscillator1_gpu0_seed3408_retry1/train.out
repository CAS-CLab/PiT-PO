def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(params[0]*x**2 + 3*params[1]*v**2 + 2*params[2]*x*v**2 + np.exp(2*params[3])))
    b = 2*(v**4 + 12*params[4]*(x**2 + np.exp(3*params[5]))) - \
    12*np.cos(np.sqrt(2*params[6]*x + 2*np.pi*np.arange(len(v))))*v**2 + \
    24*np.sin(np.sqrt(2*params[6]*x + 2*np.pi*np.arange(len(v))))*x*v**2 + \
    8*np.cos(4*np.pi*np.arange(len(v))) + \
    8*np.sin(4*np.pi*np.arange(len(v)))
    c = 4*np.cos(np.sqrt(2*params[7]*x + np.pi*np.arange(len(v))))*x + \
    16*np.sin(np.sqrt(2*params[7]*x + np.pi*np.arange(len(v))))*v**2 + \
    48*np.cos(2*np.pi*np.arange(len(v))*x)*v**3 + \
    96*np.sin(2*np.pi*np.arange(len(v))*x)*x*v**3 + \
    2*params[8]
    return b*c + a*c + c
