    np.sum([(i % 4 == 0) * (v**(i//2)) for i in range(MAX_NPARAMS)]) * \
    np.sum([(i % 2!= 0) * (np.exp(i * np.pi / MAX_NPARAMS) * np.cos(i * np.pi / MAX_NPARAMS)) for i in range(MAX_NPARAMS)]) + \
