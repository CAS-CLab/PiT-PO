    a = (params[0] * (x ** 2 - 2 * (x + v / (2 * params[5]))**2) +
     2 * v * (x + v / (2 * params[5]))) / (2 * params[5])

    b = (params[1] * (x + v / (2 * params[5]))**2 -
     params[2] * (x + v / (2 * params[5]))*v)

    c = (x + v / (2 * params[5]))**3

    d = np.sqrt(c)

    e = (d**2 - a) / (2 * d)

    f = e - (x + v / (2 * params[5]))

    g = (f**2 / (12 * (d**2 - a))) - ((x + v / (2 * params[5]))**3 / (27 * d))

    h = (3 / 32) * (d**2 - a)**(3/2) * (d**2 + a)**(-3/2)

    return h
