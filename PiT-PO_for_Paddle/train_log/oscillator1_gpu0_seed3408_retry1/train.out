     0.5 * (v**2 / (x**2 + v**2)) + 
     0.25 * ((x**2 + v**2)**-1.5) * (np.sin(params[5] * x) * v + np.cos(params[7] * v) * x))
    b = (params[0] * (x + v) +
     0.125 * ((x + v)**2 * (x**2 + v**2)**-1.5) + 
     0.0625 * ((x**2 + v**2)**-3) * (np.sin(params[5] * x) * v - np.cos(params[7] * v) * x))

    dv = a + b
    return dv
