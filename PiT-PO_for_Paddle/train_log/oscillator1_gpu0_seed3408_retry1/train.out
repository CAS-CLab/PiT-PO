    (params[0] * (x**2)) + 
    (params[1] * (x * v)) + 
    (params[2] * (x ** 2)) + 
    (params[3] * (x * v ** 2)) + 
    (params[4] * (x * v ** 3)) + 
    (params[5] * (x ** 3)) + 
    (params[6] * (x ** 2 * v)) + 
    (params[7] * (x * v ** 4)) + 
    (params[8] * (x ** 2 * v ** 2)) + 
