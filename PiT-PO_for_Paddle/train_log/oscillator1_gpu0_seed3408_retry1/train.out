def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[0]) * x**2 + \
    np.cos(params[1]) * np.sin(v) + \
    np.exp(params[2] * x) * v**2 + \
    np.log(params[3]) * x * v + \
    np.tan(params[4]) * x * np.sin(v)**2 + \
    np.sqrt(params[5]) * x**3 * np.cos(v) + \
    np.cosh(params[6]) * x * v**3 + \
    np.arcsin(params[7]) * x * np.sin(v)**3 + \
    np.sinh(params[8]) * x**4 + \
    np.log(np.abs(1 + v)) * np.sin(params[9])

    b = np.sin(params[0]) * x**3 + \
    np.cos(params[1]) * x * v**3 + \
    np.exp(params[2] * x) * v**4 + \
    np.log(params[3]) * x**2 * v**2 + \
    np.tan(params[4]) * x * v**4 + \
    np.sqrt(params[5]) * x**2 * np.cos(v) + \
    np.cosh(params[6]) * x * v**5 + \
    np.arcsin(params[7]) * x * v**4 + \
    np.sinh(params[8]) * x**5 + \
    np.log(np.abs(1 + v)) * np.sin(params[9]) * x

    dv = a + b * x
    return dv
