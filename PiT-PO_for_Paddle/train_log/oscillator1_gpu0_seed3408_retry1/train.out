def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = np.power(params[0], 2) * np.power(v, 6)
    i = np.sum((x + v)**2 * np.power(v, 2))
    j = np.sum(np.power(x, 4) + np.power(v, 4) + np.power(v, 6)**2)
    k = np.sum((x * v - np.power(h, 2/3)) * (x * v + np.power(h, 2/3)))
    l = np.sum((x * v - np.power(h, 2/3))**2 * (x * v + np.power(h, 2/3))**2)
    m = np.sum(np.power(x, 3) + np.power(v, 3)**2)
    n = np.sum(np.power(x, 2) + np.power(v, 2)**2 + np.power(h, 2))
    o = np.sum((x * v - np.power(h, 2/3)) * (x * v + np.power(h, 2/3))**3)
    p = np.sum(np.power(x, 2) + np.power(v, 4)**2 + np.power(v, 6)**2)
    q = np.sum(np.power(x, 2) + np.power(v, 2)**2 + m)
    dv = l + k + i + o + j + p + q
    return dv
