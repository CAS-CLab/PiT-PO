    b = params[3] * x**2 + params[4] * v**3 + params[5] * np.sin(params[6] * x) + \
    (np.abs(v) + params[7]) * np.arctan2(np.abs(v), x) + \
    (x - np.abs(v)) * np.pi/2
    c = np.sqrt(a**2 + b**2)
    dv = (a + c) * v + b - (c - a) * (x - np.abs(v))
    return dv
