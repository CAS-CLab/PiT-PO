def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * (x**4 - 3*x**2*v**2 + 2*x**3*v + 2*x*v**3) + \
    params[1] * (-v**4 + 3*v**2*x**2 - 2*v*x**3 + 2*v**3*x) + \
    params[2] * x**3 * np.sin(params[3] * x) + \
    params[4] * x**2 * v**2 * np.cos(params[5] * v) + \
    params[6] * x * v * np.sin(params[7] * x) + \
    params[8] * v * np.exp(params[9] * v)
    b = params[0] * x * (x**2 - v**2) + params[1] * v * (x**2 - v**2) + \
    params[2] * x * (x**3 - 3*x*v**2 + 2*x**2*v) + \
    params[3] * v * (x**3 - 3*x*v**2 + 2*x**2*v) + \
    params[4] * x * v * (x**2 + v**2) + \
    params[5] * x * v * (x**2 + v**2) + \
    params[6] * np.cos(params[7] * x) * (x**2 + v**2) + \
    params[8] * np.sin(params[9] * v) * (x**2 + v**2)
    dv = a + b * x
    return dv
