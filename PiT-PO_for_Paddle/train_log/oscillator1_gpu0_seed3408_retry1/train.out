def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[i] * x**(i+1) for i in range(MAX_NPARAMS)])) + \
    (np.sum([params[MAX_NPARAMS-1-i] * v**(i+1) for i in range(MAX_NPARAMS)])) + \
    (np.sum([np.sum([params[j] * x**(j+i) * v**i for j in range(MAX_NPARAMS)]) for i in range(MAX_NPARAMS)]))

    b = np.sum([(x + v)**params[6] * np.sin(np.pi/2 * (x + v) + np.pi*params[5]) for _ in range(MAX_NPARAMS)]) + \
    np.sum([(x + v)**params[6] * np.sin(np.pi*3/2 * (x + v) + np.pi*params[5]) for _ in range(MAX_NPARAMS)]) + \
    np.sum([np.cos(v * np.pi/2) * np.cos(v * 3*np.pi/2) for _ in range(MAX_NPARAMS)]) + \
    np.sum([x * v * np.sin(np.pi/2 * (x + v) + np.pi*params[5]) for _ in range(MAX_NPARAMS)])

    dv = a + b
    return dv
