            np.dot((x**4 - v**4/4), np.exp(-v)) + 
            np.sin(np.dot(params[8], x)) * np.cos(np.dot(params[8], v)) + 
            np.cos(np.dot(params[9], v)) * np.sin(np.dot(params[8], x))])
    return a
