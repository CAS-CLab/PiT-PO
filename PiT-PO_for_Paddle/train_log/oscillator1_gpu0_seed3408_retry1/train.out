def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = np.sin(np.sqrt(params[0]) * np.abs(x + v))
    i = np.exp(np.log(params[1]) * (np.abs(x + v) ** 2 + np.abs(v) ** 2))
    j = np.cos(np.sqrt(params[2]) * np.sqrt((x ** 2 + v ** 2) + np.square(h)))
    k = np.tanh(np.sqrt(params[3]) * np.abs(x * v - h))
    l = np.cosh(np.sqrt(params[4]) * np.abs(x * v - h))
    m = np.arctan2(np.sqrt(params[5]) * (x ** 2 + v ** 2), np.sqrt(np.square(h) + np.square(l)))
    n = np.sqrt(np.square(k) + np.square(m))
    o = np.exp(np.log(params[6]) * np.abs(x * v - h)) * np.sin(np.pi / 2)
    p = np.cos(np.sqrt(params[7]) * np.abs(x * v - h))
    q = np.exp(np.log(params[8]) * (np.square(x) + np.square(v))) + np.square(o)
    dv = (l * p) + (j * n) + (i * k) + (o * q) + (k * h) + (m * j)
    return dv
