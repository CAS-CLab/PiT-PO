def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(params[0]**2 + x**2)) * v * (v**2 + 3*x**2)
    b = np.cos(np.sqrt(params[0]**2 + x**2)) * x**2 * v**3
    c = np.exp(-((np.sqrt(params[1]**2 + x**2))**2 - np.sqrt(params[2]**2 + x**2))**2 / np.sqrt((np.sqrt(params[2]**2 + x**2))**2))
    d = x * v**2 * (v**2 + 2*np.sqrt(params[3]**2 + x**2)*np.sqrt(params[4]**2 + x**2))
    e = (v**2 + 2*np.sqrt(params[5]**2 + x**2)*np.sqrt(params[6]**2 + x**2))*(v**2 + 2*np.sqrt(params[7]**2 + x**2)*np.sqrt(params[8]**2 + x**2))
    f = np.sqrt(v**4 + 2*v**2*(x**2 + 2*np.sqrt(params[9]**2 + x**2)*np.sqrt(params[8]**2 + x**2)))
    return a - b*c*e + d*f
