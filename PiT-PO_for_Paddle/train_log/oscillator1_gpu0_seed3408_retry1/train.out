def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**2 + v**2) * (np.sin(np.sqrt(params[8]*v)*v) / np.sqrt(params[8]*v)) + \
    (x**2 * (np.cos(params[6]*x)**2 - np.sin(params[6]*x)**2) / (2*params[6])) + \
    (v**2 * (np.cos(np.sqrt(params[8]*v)*v)**2 - np.sin(np.sqrt(params[8]*v)*v)**2) / (2*np.sqrt(params[8]*v))) + \
    (x * v * ((-np.cos(2*params[6]*x)) / (4*params[6]))) + \
    (x * (np.cos(np.sqrt(params[8]*v)*v) - np.sin(np.sqrt(params[8]*v)*v))) + \
    (v * (np.cos(np.sqrt(params[8]*v)*v) + np.sin(np.sqrt(params[8]*v)*v))) + \
    (x * (np.cos(np.sqrt(params[8]*v)*v) - np.sin(np.sqrt(params[8]*v)*v)) * np.exp(-(np.cos(np.sqrt(params[8]*v)*v) + np.sin(np.sqrt(params[8]*v)*v)))) + \
    (v * (np.cos(np.sqrt(params[8]*v)*v) - np.sin(np.sqrt(params[8]*v)*v)) * np.exp(-(np.cos(np.sqrt(params[8]*v)*v) + np.sin(np.sqrt(params[8]*v)*v))))
    b = (x * (np.exp(-np.sqrt(params[0]*v)) + np.exp(np.sqrt(params[0]*v)))) + \
    (v * (np.exp(-np.sqrt(params[0]*v)) - np.exp(np.sqrt(params[0]*v)))) + \
    (np.exp(-np.sqrt(params[0]*v)) - np.exp(np.sqrt(params[0]*v)))
    dv_simplified = a + b
    return dv_simplified
