    a = params[0] * x**2 - params[1] * v + params[2] * np.exp(params[3]) * x + params[4] * v**2 + params[5] * x * v + params[6]
    b = params[7] * x + params[8] * v + params[9] * np.cos(params[9] * v)
    dv = a + b
    return dv
