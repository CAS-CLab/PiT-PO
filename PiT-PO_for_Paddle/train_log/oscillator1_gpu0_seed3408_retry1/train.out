def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.tan(params[0] * x + np.pi/4)
    b0 = np.exp(-v**2 / (2*(np.sqrt(params[1])**2 + 1)))
    c0 = np.cos(np.sqrt(params[2]) * v)
    d0 = np.sin(np.sqrt(params[3]) * x)
    e0 = np.log(v**2 + 1)
    f0 = np.sinh(params[4] * x)
    g0 = np.cosh(params[5] * v)
    h0 = np.arctanh((x + 1)/(2*np.sqrt(params[6])))
    dv = (a0 * b0 * d0 + e0 * c0 * x + f0 * np.exp(g0)) + \
     np.sin(c0) * np.sin(h0) * x + \
     np.sin(a0) * c0 * v + \
     np.cos(c0) * np.sin(h0) * v + \
     np.sin(d0) * np.cos(h0) * x + \
     np.cos(d0) * np.sin(h0) * x + \
     np.sin(e0) * np.cos(h0) * v + \
     np.cos(e0) * np.sin(h0) * v + \
     np.sin(h0) * v**2 + \
     np.cos(h0) * x * v
    return dv
