    np.cos(np.sqrt(params[1] * v**2 + np.pi * x**2)) * v + \
    np.tanh(np.sqrt(params[2] * x**2 + np.pi * v**2)) * (x**2 - np.pi * v**2) + \
    np.log(np.sqrt((np.sinh(np.sqrt(params[3] * x**2 + np.pi * v**2)))**2 + (np.cosh(np.sqrt(params[4] * x**2 + np.pi * v**2)))**2)) * \
    (v**4 / (12 * np.sqrt(params[5] * x**2 + np.pi * v**2)) + v**2 / (2 * np.sqrt(params[6] * x**2 + np.pi * v**2)))
