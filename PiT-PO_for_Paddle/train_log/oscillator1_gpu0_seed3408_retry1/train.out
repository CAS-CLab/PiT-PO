        (-v*x*np.sin(np.pi*params[7]*x)+(x**2 - v**2/2)*np.sin(2*np.pi*params[9]*v))*
        (np.sqrt(2*params[8])*x+np.sqrt(2*params[9])*v)**3
    )
    )
    return a
