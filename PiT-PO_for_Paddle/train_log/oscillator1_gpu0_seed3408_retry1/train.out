def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([((-x**i)*(v**(2*i)))*params[0] for i in range(10)]) + \
    np.sum([(x**i)*(v**(2*i+1))]*params[1]) + \
    np.sum([(x**(i+2))*(v**(2*(i+1)))]*params[2]) + \
    np.sum([(x**(i+2))*(v**(2*i+2))]*params[3]) + \
    np.sum([(x**(i+2))*(v**(2*i+3))]*params[4]) + \
    np.sum([(-x**(i+3))*(v**(2*i+3))]*params[5]) + \
    np.sum([((-x**(i+3))*(v**(2*i+4)))*params[6] + ((-x**(i+3))*(v**(2*i+5)))*params[7]]*params[8]) + \
    np.sum([(x**(i+3))*(v**(2*i+6))]*params[9])
    dv = a + v*np.sum([(-x**(i))*(v**(2*i))*params[0] for i in range(10)]) + \
      v**2*np.sum([(x**(i))*(v**(2*i+1))*params[1] for i in range(10)]) + \
      v**3*np.sum([(x**(i+1))*(v**(2*i+2))*params[2] for i in range(10)]) + \
      v**4*np.sum([(x**(i+1))*(v**(2*i+3))*params[3] for i in range(10)]) + \
      v**5*np.sum([(x**(i+1))*(v**(2*i+4))*params[4] for i in range(10)]) + \
      v**6*np.sum([(-x**(i+1))*(v**(2*i+5))*params[6] for i in range(10)]) + \
      v**7*np.sum([((-x**(i+1))*(v**(2*i+6)))*params[7] + ((-x**(i+1))*(v**(2*i+7)))*params[8]]*params[9]) + \
      v**8*np.sum([(x**(i+1))*(v**(2*i+6))*params[9] for i in range(10)])
    return dv
