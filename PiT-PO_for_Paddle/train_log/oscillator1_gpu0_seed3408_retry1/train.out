def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([x * (x**i) * np.sin(params[i+9]) for i in range(9)]) + \
    np.sum([v**j * np.cos(params[j+9]) for j in range(9)]) + \
    np.sin(params[0]) * np.sin(params[9] * v) + \
    np.cos(np.pi/2 + np.arange(9)*np.pi/9 * x) + \
    np.exp(-(x + v)**2/2) - \
    np.sum([a * np.sin(params[i+9]) for i in range(9)]) - \
    np.sum([v**2 / (x**(i+1)) * np.cos(params[i+9]) for i in range(9)]) - \
    np.sum([np.cos(np.pi/2 + np.arange(i+1)*np.pi/(i+1) * x) for i in range(9)])
    dv = a * v + a * v + a * v - \
    np.sum([v * np.sin(params[i+9]) for i in range(9)]) - \
    np.sum([v * np.cos(np.pi/2 + np.arange(i+1)*np.pi/(i+1) * x) for i in range(9)]) - \
