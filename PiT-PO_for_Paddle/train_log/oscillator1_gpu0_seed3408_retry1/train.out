    a = (x ** 2) * (v ** 4) + (x ** 3) * v * (np.sinh(v ** 2) ** 3) + \
    ((1 / 24) * v ** 6) * (x ** 2) + ((1 / 60) * v ** 8) * (x ** 4) + \
