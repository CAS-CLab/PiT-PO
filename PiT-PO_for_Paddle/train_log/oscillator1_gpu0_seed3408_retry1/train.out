def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[0] * v)
    b = params[1] * x**2 + params[2] * (a * v + a**3) + \
     params[3] * x * v + params[4] * (v**3 + x**2 * a) + \
     params[5] * (x**2 + params[6]) * v**2 + \
     params[7] * (a * x + a**2 * v) + \
     params[8] * (x**2 + params[9]) * v
    c = (params[0] * x**5 +
     params[1] * v**5 - 
     params[2] * x**3 + 
     params[3] * v**3 + 
     params[4] * v**7 - 
     params[5] * x*v**3 - 
     params[6] * x**7 + 
     params[7] * v**5 + 
     params[8] * x*v**5 + 
     params[9] * (x**7 + v**7))
    d = (params[0] * a*x**4 +
     params[1] * c*x**4 + 
     params[2] * b*x**3 + 
     params[3] * a*x**3 + 
     params[4] * (a*c + a*b)*x**2 + 
     params[5] * (a**2*x**2 + c*x**2 + b*x) + 
     params[6] * a*x + 
     params[7] * (a**2*x + c*x + b*x**2 + a**2*x**2 + c*x**2 + b*x**3))
    return d
