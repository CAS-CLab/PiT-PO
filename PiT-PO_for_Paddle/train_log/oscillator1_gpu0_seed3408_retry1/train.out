def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    dv = (np.sin(2*np.pi*params[0]*x)**2 *
      np.cos(2*np.pi*params[1]*x)**3 *
      v**5 +
     0.75*(x**5+3*x**3*v**2+5*x*v**4+2*x**4*v**2+v**6)*v**3 -
     0.125*x**6*v**2-0.375*x**4*v**4-0.75*x**2*v**6+0.1875*x**6*v**4+
     (np.cos(2*np.pi*params[2]*x)-1)*v**5 +
     (2*np.cos(np.pi*params[3]*x)*v*(3*x**4+11*x**2*v**2+22*x*v**4+6*x**6))*
     (x**5+3*x**3*v**2+5*x*v**4+2*x**4*v**2+v**6) +
     np.sin(2*np.pi*params[6]*x)*v*(x**7+7*x**5*v**2+21*x**3*v**4+35*x*v**6+14*x**2*v**8+
                                  7*x**5*v**2+15*x**3*v**4+21*x*v**6+7*x^2*v^8+3*x*v^10))
    return dv
