def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(2*np.pi*params[0]*x) +
     np.cos(2*np.pi*params[1]*x) + 
     np.sin(2*np.pi*params[2]*v) + 
     np.cos(2*np.pi*params[3]*v) + 
     (x - v)**2/2 + 
     np.sin(np.pi*(x - v)) + 
     np.cos(3*np.pi*x) - 
     np.sin(3*np.pi*v) + 
     np.sin(2*np.pi*v)/4 + 
     np.cos(2*np.pi*x)/4 + 
     np.sin(2*np.pi*x)/8 + 
     np.cos(2*np.pi*v)/16 + 
     np.sin(2*np.pi*x)*np.sin(2*np.pi*v)/32 + 
     np.cos(2*np.pi*x)*np.cos(2*np.pi*v)/64)
    b = (x - v)**3/12 + np.sin(2*np.pi*params[4]*v) + np.cos(2*np.pi*params[5]*x) + np.sin(np.pi*params[6]*x) + np.cos(2*np.pi*params[7]*v) + np.sin(2*np.pi*params[8]*v)
    dv = a + b
    return dv
