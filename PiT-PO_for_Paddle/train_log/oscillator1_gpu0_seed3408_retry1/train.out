            np.dot(v, np.exp(-x)) + 
            np.dot((x**2 - v**2/2), np.exp(-x)) + 
            np.dot(x * v, np.exp(-x)) + 
            np.dot((x**3 - v**3/3), np.exp(-x)) + 
