      18*(x**2 + 2*x*v + v**2)**2) + \
     (np.sum(params[:8], axis=0) + np.sum((x + v)**4, axis=0) -
      np.sum((x + v)**2, axis=0) + np.sum(x**2, axis=0))
    return a
