    b = np.sum((a**2 - 1) / (params[3] * np.tanh(np.sqrt(params[4] * x) + np.cosh(np.sqrt(params[5] * v))))) - \
    np.sinh(params[6] * (v - x)) / np.sinh(np.sqrt(params[7] * x) + np.sqrt(params[8] * v))
    return b
