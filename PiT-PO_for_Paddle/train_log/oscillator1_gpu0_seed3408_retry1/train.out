def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([(-1)**i * np.math.factorial(i) *
             (np.math.pow(params[0], i) * 
              np.math.pow(x, 2*i-1)) 
            for i in range(11)])) + \
    (np.sum([(-1)**i * np.math.factorial(i) * 
             (np.math.pow(v, 2*i) * 
              np.math.pow(np.math.cos(2*np.pi*v), i)) 
            for i in range(11)])) + \
    (np.sum([((-1)**i) * np.math.factorial(i) * 
             (np.math.pow(np.math.cos(2*np.pi*v), i) * 
              np.math.pow(x, 2*i-1)) 
            for i in range(11)]))

    b = (np.sum([(-1)**i * np.math.factorial(i) *
             (np.math.pow(params[1], i) * 
              np.math.pow(np.math.sin(2*np.pi*x), i)) 
            for i in range(11)])) + \
    (np.sum([(-1)**i * np.math.factorial(i) * 
             (np.math.pow(np.math.sin(2*np.pi*x), i) * 
              np.math.pow(np.math.cos(2*np.pi*v), i)) 
            for i in range(11)])) + \
    (np.sum([((-1)**i) * np.math.factorial(i) * 
             (np.math.pow(np.math.cos(2*np.pi*v), i) * 
              np.math.pow(x, 2*i-1)) 
            for i in range(11)]))

    c = np.sum([((-1)**i) * np.math.factorial(i) *
             (np.math.pow(np.math.sin(2*np.pi*x), i) * 
              np.math.pow(np.math.cos(2*np.pi*v), i)) 
            for i in range(11)])

    dv = a + b + c
    return dv
