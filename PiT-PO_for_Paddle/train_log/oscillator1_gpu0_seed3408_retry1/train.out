    a = params[0] * (x**3 + v**5)
    b = params[1] * (x**2 - v**4)
    c = params[2] * np.sin(params[3] * x + params[4] * v)
    d = params[5] * (x**2 + v**3)
    e = params[6] * (x + v)
    f = params[7]
