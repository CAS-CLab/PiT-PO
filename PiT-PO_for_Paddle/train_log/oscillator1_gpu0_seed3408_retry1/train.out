    np.cos(params[2]*v) * (x**2 + v**2)**(3/2) + \
    np.tanh(np.sqrt(params[3])*v) * (x**4 - v**4) + \
    np.cosh(np.sqrt(params[4])*x) * (x**2 + v**2)**2 + \
