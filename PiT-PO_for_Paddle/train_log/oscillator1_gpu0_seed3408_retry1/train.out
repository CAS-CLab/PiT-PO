    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[0]*x,
            np.dot(params[1], v),
            np.dot(params[2], x**2),
            np.dot(params[3], x**3),
            np.dot(params[4], v**4),
            np.dot(params[5], np.sin(params[6]*x)*np.cos(params[7]*v)),
            np.dot(params[5], np.sin(2*params[6]*x)*(np.cos(2*params[7]*v) - np.exp(-2*params[8]*v**2))),
            np.dot(params[9], v**5)])
    b = np.dot(params[2], x**2) + \
    np.dot(params[3], x**3) + \
    np.dot(params[4], v**4) + \
    np.dot(params[5], np.sin(2*params[6]*x)*(np.cos(2*params[7]*v) - np.exp(-2*params[8]*v**2))) + \
    np.dot(np.array([0.25*params[5]]), np.sin(4*params[6]*x)*(np.cos(4*params[7]*v) - np.exp(-4*params[8]*v**2)))
    dv = a * v + b
    return dv
