    b = np.sin(params[1] * v)
    c = x**2 * (v**4 - 2*v**2 + 1) - x * (v**4 - v**2 + 1) - x**2 * (v**4 - 2*v**2 + 1) + \
    2*x*v*(v**4 - 2*v**2 + 1) + 2*x**2*v*(v**4 - v**2 + 1) - 2*x**3*v*(v**4 - 2*v**2 + 1) + \
    x**4*(v**4 - 2*v**2 + 1) - 2*x**5*v*(v**4 - 2*v**2 + 1) + x**6*(v**4 - 2*v**2 + 1) + \
