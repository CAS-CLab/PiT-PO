         (params[3] * x**4 +
          12 * (params[4] + 3 * x**2) * v**3 +
          24 * (params[5] + 2 * x**2) * v**5))

    a0 = (m1 + m2) / (params[6] * x**2 + params[7] * v**2 + params[8] * x**4 + 
                    2 * x**2 * v**4 + 2 * x**4 * v**2 + 2 * x**2 * v**4)

    return a0
