def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] - 3*params[1] + 2*np.sin(params[2])*v
    b = 2*(x - 2*params[3])**2 * (np.cos(params[4]) * v + np.sin(params[4]))
    c = 4*(x - 2*params[3])**3 * (v ** 2 - 2*params[5])
    d = 8*(x - 2*params[3])**4 * (v ** 3 + 3*params[6]*(x - 2*params[3]))/2
    e = 16*(x - 2*params[3])**5 * (v ** 4 + 6*params[7]*(x - 2*params[3])**2)/3
    f = 32*(x - 2*params[3])**6 * (v ** 5 + 20*params[8]*(x - 2*params[3])**3)/(3*2)
    g = 64*(x - 2*params[3])**7 * (v ** 6 + 56*params[9]*(x - 2*params[3])**4)/(4*3*2)
    h = 128*(x - 2*params[3])**8 * (v ** 7 + 168*params[8]*(x - 2*params[3])**5/(3*2)) / 2
    i = 256*(x - 2*params[3])**9 * (v ** 8 + 672*params[9]*(x - 2*params[3])**6/(3*2*3))
    dv = a*i + b + c + d + e + f + g + h + i
    return dv
