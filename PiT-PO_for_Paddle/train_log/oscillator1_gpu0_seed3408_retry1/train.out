    (x**2 * v**2) + \
    ((np.sin(2*np.pi*x))**2) * v**4 + \
    (x * v**2) * (2*v**3 - 3*x*v**2 + np.cos(2*np.pi*x)*v) + \
    (-x**2 * v**4) + \
    (x * v)**2 * (2*x**2 - v**2) + \
