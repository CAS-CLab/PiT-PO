def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a1 = np.sum(params[:3]) / np.sum(np.square(params[3:]))
    b1 = (np.sum(params[:3]) * np.sum(np.square(params[3:]))) / np.sum(np.square(np.array([u**2 for u in params[:3]])))
    c1 = (np.sum(np.square(params[:3])) - np.sum(np.square(params[3:]))) / np.sum(np.square(np.array([v**2 for v in params[3:]])))
    dv = (a1 * x + b1 * v + c1 * v**2 +
      (np.sum(params[:3]) * np.sum(np.square(np.array([u**3 for u in params[:3]])))) * v**3 +
      ((np.sum(np.square(np.array([u**4 for u in params[:3]])))-np.sum(np.square(np.array([v**4 for v in params[3:]]))))) * v**4 +
      (np.sum(np.square(np.array([u**5 for u in params[:3]])))) * x**5 +
      (np.sum(np.square(np.array([v**2 for v in params[3:]])))) - np.sum(np.square(np.array([u**2 for u in params[:3]]))) +
      (np.sum(np.square(np.array([u**2 for u in params[:3]])))) * x**2)
    return dv
