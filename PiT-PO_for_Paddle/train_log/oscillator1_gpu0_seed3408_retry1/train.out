def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = \
    (params[0] * (np.power(x, 2) - np.power(v, 2))) + \
    ((x * v)**2 * (params[2] * (np.sin(2*np.pi*params[6]*x)))) + \
    ((x * v)**2 * (params[3] * (np.cos(np.pi*params[8]*v)))) + \
    ((x ** 3) * (v ** 2) * (params[4])) + \
    ((x * v) * (v ** 3) * (np.tan(np.pi*params[6]*x))) + \
    ((x * v) * (v ** 3) * (np.tan(2*np.pi*params[6]*x))) + \
    ((x * v) * (v ** 3) * (np.tan(np.pi*params[8]*v))) + \
    ((x ** 4) * (v ** 3) * (np.sin(2*np.pi*params[6]*x))) + \
    ((x ** 4) * (v ** 3) * (np.sin(np.pi*params[8]*v)))
    b = \
    ((x * v) * (v ** 2) * (np.cos(np.pi*params[8]*v))) + \
    ((x ** 3) * (v ** 4) * (np.cos(2*np.pi*params[6]*x))) + \
    ((x * v) * (v ** 2) * (np.sin(np.pi*params[6]*x))) + \
    ((x * v) * (v ** 2) * (np.sin(2*np.pi*params[8]*v))) + \
    ((x * v) * (v ** 2) * (np.sin(np.pi*params[6]*x))) + \
    ((x * v) * (v ** 2) * (np.sin(2*np.pi*params[8]*v))) + \
    ((x * v) * (v ** 2) * (np.sin(np.pi*params[8]*v))) + \
    ((x ** 3) * (v ** 2) * (np.sin(2*np.pi*params[6]*x)))
    dv = a + b
    return dv
