    params[2] * x**2 * v**2 + params[3] * x * v**3 + \
    params[4] * v**4 + params[5] * x**2 * v**2 + \
    params[6] * (x**2 + v**2) * v + \
    params[7] * x * v**3 + \
    params[8] * (x + v) * (x - v) + \
    params[9] * np.sin(params[9] * v)
    return a
