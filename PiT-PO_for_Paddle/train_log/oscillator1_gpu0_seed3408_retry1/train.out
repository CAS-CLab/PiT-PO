    (x**2 + 2*v**3)*(v**2*params[1] + v**3*params[2]) + \
    (x**2 + 4*v**2)*(v**2*params[3] + v**4*params[4]) + \
    (x**2 + 6*v**2)*(v**2*params[5] + v**4*params[6]) + \
    (x**2 + 8*v**2)*(v**2*params[7] + v**4*params[8]) + \
    (x**2 + 10*v**2)*(v**2*params[9])

    return a
