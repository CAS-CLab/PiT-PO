def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (((x + 2 * v * x ** 2 +
    2 * (v ** 3 + x ** 2 * (3 * params[0] + 3 * x * params[5])) +
    2 * (v ** 2 - x ** 2 / 2) * np.sin(2 * np.pi * np.arange(len(v))) +
    2 * np.sin(2 * np.pi * x) * v) *
    (x ** 2 - v ** 2 / 2) +
    2 * np.sinh(np.sqrt(2 * np.pi * np.arange(len(v)) * params[0]) * v) * x * v ** 2 +
    (2 * np.pi / (6 * np.pi * np.arange(len(v)) * np.arange(len(v)) *
    np.arange(len(v)))) * np.sinh(np.sqrt(2 * np.pi * np.arange(len(v)) * params[0]) * v) ** 3 -
    (2 * np.pi / (12 * np.pi * np.arange(len(v)) * np.arange(len(v)) *
    np.arange(len(v)))) * np.sinh(np.sqrt(2 * np.pi * np.arange(len(v)) * params[0]) * v) ** 5 +
    np.cos(2 * np.pi * np.arange(len(v)) * x) * np.sinh(np.sqrt(2 * np.pi * np.arange(len(v)) * params[0]) * v) ** 2 +
    2 * np.pi / (6 * np.pi * np.arange(len(v)) * np.arange(len(v))) * v ** 3 +
    np.cos(2 * np.pi * np.arange(len(v)) * x) * np.sinh(np.sqrt(2 * np.pi * np.arange(len(v)) * params[0]) * v)))
    return a
