def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sum((params[0] * x**3) * v**4, axis=1)
    a1 = np.sum((np.sqrt(params[1]) * x**2) * (x**3 + v**3), axis=1)
    a2 = np.sum((np.sqrt(params[2]) * x**2) * (x**2 + v**3), axis=1)
    a3 = np.sum((np.sqrt(params[3]) * x**2) * (v + v**3), axis=1)
    a4 = np.sum((np.sqrt(params[4]) * x**2) * v**3, axis=1)
    a5 = np.sum((np.sqrt(np.pi / 2) * (x**2 + v)) * (x + v), axis=1)
    a6 = np.sum((np.sqrt(np.pi / 2) * (x**2 + v)) * (x + v), axis=1)
    a7 = np.sum((np.sqrt(np.pi / 2) * (x**2 + v)**2), axis=1)
    a8 = np.sum((np.sqrt(np.pi / 3) * x) * (v**3 + v), axis=1)
    a9 = np.sum((np.sqrt(2/3) * (v ** 3) + np.sqrt(2/3) * x * v), axis=1)
    dv = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
    return dv
