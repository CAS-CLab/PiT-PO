def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sinh(np.sqrt(2*params[0])*v)**2 * (x**2 - v**2/2) + \
    2*np.exp(np.sqrt(2*params[0])*v)*x*v**2 + \
    np.exp(np.sqrt(2*params[0])*v)**3*x + \
    2*params[1]*x + \
    (2*params[2]*(x**2 - v**2/2) + \
    3*params[3]*x**2 + \
    2*params[4]*x**3) * np.cosh(np.sqrt(2*params[0])*v) + \
    np.sin(2*params[5]*x)*np.sinh(np.sqrt(2*params[0])*v) + \
    np.cos(2*params[5]*x)*np.cosh(np.sqrt(2*params[0])*v)/(np.sqrt(2*params[0])**3) + \
    np.cos(2*params[7]*x)*(np.sinh(np.sqrt(2*params[0])*v)**2 - \
    np.tanh(np.sqrt(2*params[0])*v)**2) + \
    np.cos(2*params[8]*x)*np.exp(np.sqrt(2*params[0])*v) + \
    np.sinh(np.sqrt(2*params[0])*v)**3*x*np.cos(2*params[9]*v)
    return a
