def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**5)*(3*(v+2*x)*np.cos(2*x)-v*np.sin(2*x)+12*np.sin(2*x)**2-24*np.sin(x)**2*np.cos(2*x))
    b = x*(2*v*np.cos(2*x)**2-4*np.sin(2*x)**2+2*np.cos(4*x)+v**3-12*x*np.sin(2*x)**2+36*np.sin(x)**2*np.cos(2*x))
    c = x*v*(3*np.sin(2*x)**2-v*np.cos(2*x)+18*np.cos(2*x)**2-12*np.sin(x)**2*np.cos(2*x)-20*np.sin(x)**2*np.cos(4*x))
    d = (np.pi/2-x)**2*np.sin((np.pi/2-x)/2)**2*(3*np.cos(np.pi/2-x)**2-np.cos(np.pi/2-x)**4+
    3*np.sin(np.pi/2-x)**2-2*np.sin(np.pi/2-x)*np.cos(np.pi/2-x)**3+
    16*np.cos(3*np.pi/2-x)**2*np.sin(3*np.pi/2-x)**2-48*np.sin(3*np.pi/2-x)**4*np.cos(np.pi/2-x)**2*np.sin(3*np.pi/2-x)**2)
    dv = a+b+c+d
    return dv
