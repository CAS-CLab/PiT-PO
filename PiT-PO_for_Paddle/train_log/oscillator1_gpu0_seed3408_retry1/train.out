    params[5] * np.sin(params[6] * x) + params[7] * np.cos(params[8] * v)
    b = params[8] * x + params[9] * np.exp(-params[0] * v)
    c = params[0] * x**2 + params[1] * v**2 + params[2] * x * v + params[3] * x + params[4] * v + params[5] * np.sin(params[6] * x)
