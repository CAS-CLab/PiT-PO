    c = (x + v * np.exp(-x))**(1/2) / (1 + np.sum(x * (x + v * np.exp(-x))**-2, axis=1, keepdims=True))**(3/2)
    dv = a * v + b * np.cos(c) + c * (x + v * np.exp(-x))**(1/2)
    return dv
