def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    (4*params[0]*(x+v)**3 - 12*params[1]*(x+v)*v**2 +
     8*params[2]*v**3*(x+v) - 8*params[3]*v**3*(x+v) + 
     4*params[4]*v**4*(x+v) - 4*params[5]*v**4*(x+v) + 
     8*params[6]*v**4*(x+v)*(x+v) - 
     8*params[7]*v**4*(x+v)*(x+v) + 
     8*params[8]*v**4*(x+v)*(x+v) - 
     4*params[9]*v**4*(x+v)*(x+v)))
    b = (
    (16*params[0]*(x+v)**5 - 40*params[1]*(x+v)^3*v**2 + 
     20*params[2]*v^3*(x+v)^3 - 
     40*params[3]*v^3*(x+v)^3 + 
     20*params[4]*v^4*(x+v)^3 - 
     40*params[5]*v^4*(x+v)^3 + 
     20*params[6]*v^4*(x+v)^3*(x+v) - 
     20*params[7]*v^4*(x+v)^3*(x+v) + 
     20*params[8]*v^4*(x+v)^3*(x+v) - 
     20*params[9]*v^4*(x+v)^3*(x+v))
    )
    dv = (a - b)
    return dv
