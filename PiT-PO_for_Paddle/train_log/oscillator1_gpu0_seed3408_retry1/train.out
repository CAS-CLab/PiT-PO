def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    (np.sin(params[5] * x) * (x**2 * v**4 + 3*v**6 - x**4 * v**2)) + 
    (np.cos(2*params[8]*v) * (x**3 * v**3 - x * v**5)) + 
    (np.exp(2*params[1]*v**2) * (x**4 * v**2 + x**2 * v**4)) + 
    (x**2 * v**2 * (np.exp(2*params[0]*x**2) + np.exp(-2*params[0]*x**2))) + 
    (x**6 * v**6 * np.log(np.exp(2*params[3]*v**2) + np.exp(-2*params[3]*v**2)))
    )
    b = (
    (x**5 * v**5 - x**3 * v**3) + 
    (x**7 * v**7 - x * v**9) + 
    (x**2 * v**2 * np.log(np.exp(2*params[2]*x**2) + np.exp(-2*params[2]*x**2))) + 
    (x**4 * v**4 * np.exp(2*params[4]*x**2) - x**4 * v**4 * np.exp(-2*params[4]*x**2)) + 
    (x**8 * v**8 * np.exp(2*params[5]*v**2) - x**8 * v**8 * np.exp(-2*params[5]*v**2)) +
    (x**6 * v**6 * np.exp(2*params[6]*v**2) - x**6 * v**6 * np.exp(-2*params[6]*v**2))
    )
    dv = a + b
    return dv
