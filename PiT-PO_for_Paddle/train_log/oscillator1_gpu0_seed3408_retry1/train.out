    d0 = (2 * params[5] + 3 * params[6]) * (x ** 3)
    e0 = (2 * np.sin(params[7]) + 3 * np.cos(params[8])) * x
    f0 = (np.exp(params[9]) + 1) * v**3
    dv = a0 * v + b0 * x + c0 * v**2 + d0 * x**2 + e0 * v + f0 * v**3
    return dv
