def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sqrt(params[0]) * np.cos(np.sqrt(2*params[1])*v + np.sin(np.sqrt(2*params[1]))) * \
    ((x + v)**4 - 4*(x + v)*x*v**3) / 24 +\
    np.exp(-2*np.sqrt(2*params[2])*v) * ((x + v)**3 - 3*x*(x + v)**2 - 3*(x + v)**2*x - 3*x**2*v - 3*x*v**2) / 8 +\
    (np.sinh(np.sqrt(2*params[3])*v) * (np.cosh(np.sqrt(2*params[3])) * x - np.sinh(np.sqrt(2*params[3])) * v))**2 / 32 +\
    (np.sqrt(params[4]) * (np.cos(np.sqrt(2*params[5])) * v + np.sin(np.sqrt(2*params[5]))) * (x + v))**2 / 16 +\
    (np.exp(-2*np.sqrt(2*params[6])*v) * (x - 2*np.sqrt(2*params[7]) + v**3/(6*np.sqrt(2*params[8]))))**3 / 6 +\
    (np.exp(-2*np.sqrt(2*params[8])*v) * (x - 2*np.sqrt(2*params[8]) + v**3/(6*np.sqrt(2*params[8]))))**4 / 8
    return a0
