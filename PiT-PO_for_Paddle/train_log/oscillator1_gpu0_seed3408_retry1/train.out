def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[i] * ((x**(i+2)) * (v**(i))) for i in range(9)])) + \
    (np.sum([params[9] * (x**i) for i in range(2)])) + \
    (np.sum([params[0] * (x**(i-1)) for i in range(3, 11, 2)])) + \
    (np.sum([params[5] * np.sin((np.arange(0, len(x), 1)*params[6])) for i in range(0, 11, 2)])) + \
    (np.sum([params[7] * (np.arange(0, len(x), 1)**2 * (v**2) + np.sin(v) * np.arange(0, len(x), 1)) for i in range(0, 11, 2)])) + \
    (np.sum([params[8] * ((v**(i//2)) * (x**(i%2))) for i in range(0, 21, 2)])) + \
    (np.sum([params[1] * (v**(i//2)) for i in range(1, 21, 2)]))
    b = (np.sum([params[0] * (x**(i+1)) for i in range(9)])) + \
    (np.sum([params[9] * (x**(i+1)) for i in range(0, 11, 2)])) + \
    (np.sum([np.exp((np.arange(0, len(x), 1)*params[3])) * v**(i//2) for i in range(1, 21, 2)])) + \
    (np.sum([params[4] * (v**(i//2)) for i in range(1, 21, 2)]))
    dv = a + b
    return dv
