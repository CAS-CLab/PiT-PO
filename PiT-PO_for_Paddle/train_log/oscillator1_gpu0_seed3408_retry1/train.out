     (v*params[1]) + (x**4) + (x**3) + (x**2) + (x*np.sin(v)) + \
     (x*np.cos(np.pi/2 * (v**2)))
    b = (x**5) + (x**4) + (x**3) + (x**2) + (x*np.sin(v)) + \
     (x*np.cos(np.pi/2 * (v**2))) + \
     (v**4) + (v**3) + (v**2) + (v*np.sin(x)) + \
     (v*np.cos(x))
    dv = a + b
    return dv
