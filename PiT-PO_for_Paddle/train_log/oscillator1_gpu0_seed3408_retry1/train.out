    + np.sum(params[5:] * (x**2 + v**2)) \
    + (params[0] * (x - v * np.sinh(params[5] * x))) \
    + (np.sum(np.arange(0, 5, 2) * np.exp(-v * (np.sqrt(params[1:]) + 1) ** 2) * \
           (v * np.cosh((np.sqrt(params[1:]) + 1) * v)))) \
    + (np.sum(np.arange(0, 5, 2) * np.exp(-x * (np.sqrt(params[0]) + 1) ** 2) * \
           (x - v * np.tanh((np.sqrt(params[0]) + 1) * x))))
    b = (a + (np.sum(np.arange(0, 5, 2) * np.exp(-v * (np.sqrt(params[1:]) + 1) ** 2) * \
             (v * np.cosh((np.sqrt(params[1:]) + 1) * v)))) \
    + (np.sum(np.arange(0, 5, 2) * np.exp(-x * (np.sqrt(params[0]) + 1) ** 2) * \
           (x - v * np.tanh((np.sqrt(params[0]) + 1) * x)))) \
