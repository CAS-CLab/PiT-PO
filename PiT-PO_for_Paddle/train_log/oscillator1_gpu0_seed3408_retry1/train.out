    a = (params[0] * x**2 * (x + 2*v)) - \
    (params[1] * v**2 / (x + 3*v)) + \
    (params[2] * x**3 + 2*v*(x**2 - 2*v**2)) + \
    (params[3] * v**3/(x**2 + 2*v**2)) + \
