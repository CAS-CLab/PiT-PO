     params[3] * (v**3 * x**2 + x * v**2 + v**4 / 12) +
     (params[1] * np.sin(params[6] * x) + 
      np.cos(params[8] * v)) + 
     np.exp(-params[0] * x) * 
     (params[2] * (x - v**2 / 2)))

