    b = params[3] * x + params[4] * v + params[5] * np.sin(params[6] * x)
    c = params[7] * v + params[8] * (x**2 + v**2)
    d = params[9] * np.cos(params[7] * v)
    e = a * x + b
    f = c * v
    g = d * (x**2 + v**2)
    return e + f + g
