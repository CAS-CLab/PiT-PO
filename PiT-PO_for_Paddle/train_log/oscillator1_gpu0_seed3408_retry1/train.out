    ((np.exp((x - np.tanh(params[3] * x)) / (v + 1)) + np.exp(-(x - np.tanh(params[3] * x)) / (v + 1))) ** 2) - \
    (np.sinh(params[4] * x) * (np.exp(params[5] * x) + np.exp(-np.abs(params[6] * v))))
