def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = np.power(params[0], 1/2) * np.power(v, 5)
    i = np.power(params[1], 1/2) * (x + v) * (np.power(x, 2) + np.power(v, 2))
    j = np.power(params[2], 1/2) * (np.power(x, 4) + np.power(v, 4) + np.power(v, 6))
    k = np.power(params[3], 1/2) * (x * v + h) * (x * v - h)
    l = np.power(params[4], 1/2) * (x * v - h) * (x * v + h)
    m = np.power(params[5], 1/2) * (np.power(x, 3) + np.power(v, 3))
    n = np.power(params[6], 1/2) * (np.power(x, 2) + np.power(v, 2) + h)
    o = np.power(params[7], 1/2) * (x * v - h) * (x * v + h)
    p = np.power(params[8], 1/2) * (np.power(x, 2) + np.power(v, 4) + np.power(v, 6))
    q = np.power(params[9], 1/2) * (np.power(x, 2) + np.power(v, 2) + m)
    dv = (2 * h * x + 2 * np.power(v, 2) + 4 * l + 2 * k + 4 * i + 6 * j +
     4 * p + 4 * q - 12 * o - 12 * n - 24 * m) / 24
    return dv
