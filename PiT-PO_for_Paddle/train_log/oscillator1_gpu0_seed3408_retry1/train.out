    a1 = np.cos(params[2]) * (x**2 + 2 * v**2 + 3 * np.sin(params[3]) * x)**2
    a2 = np.sin(params[4]) * np.exp(2 * np.sqrt(np.abs(params[5]))) * v**3
    a3 = np.tan(params[6]) * (v**3 + x**3 + 2 * np.sin(params[7]) * v)**2 + \
