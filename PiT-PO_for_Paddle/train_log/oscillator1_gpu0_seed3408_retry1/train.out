    (np.sum((v ** 2) * (np.array([np.sin(params[7]), np.sin(np.pi/2+3*np.pi/2)])).T, axis=1)) + \
    (np.cos(v) ** 2) * \
    (np.sum((x ** 2) * (np.array([np.cos(np.pi/2), np.cos(3*np.pi/2)]).T), axis=1))

