def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 4*params[0]*x**3*v**2 + 3*x**2*(v**4 - 2*v**2*params[0]*x**2) + \
    2*x*(v**3 - 3*v*(v**2 - 2*params[0]*x**2)) + \
    v*(v**2 - 2*params[0]*x**2)**2 + \
    np.cos(2*np.pi*params[5]*x)*np.sin(np.pi/2*params[7]*v) + \
    np.cos(2*np.pi*params[5]*x)*v*np.sin(np.pi/2*params[7]*v) + \
    np.sin(2*np.pi*params[5]*x)*np.cos(np.pi/2*params[7]*v) + \
    np.sin(2*np.pi*params[5]*x)*v*np.cos(np.pi/2*params[7]*v) + \
    np.exp(2*np.pi*params[0]*x)*(v**3 - 3*v*(v**2 - 2*params[0]*x**2))
    b = (v**2 - 2*params[0]*x**2)**2 + \
    (x + v)**2*(v**2 - 2*params[0]*x**2) + \
    2*x*v*(v**2 - 2*params[0]*x**2) + \
    x*v**3 + \
    np.sin(2*np.pi*params[5]*x)*v*np.cos(np.pi/2*params[7]*v) + \
    np.sin(2*np.pi*params[5]*x)*v*np.cos(np.pi/2*params[7]*v) + \
    np.cos(2*np.pi*params[5]*x)*v*np.cos(np.pi/2*params[7]*v) + \
    np.cos(2*np.pi*params[5]*x)*v*np.cos(np.pi/2*params[7]*v) + \
    np.exp(2*np.pi*params[0]*x)*(v**3 - 3*v*(v**2 - 2*params[0]*x**2))
    dv = a + b
    return dv
