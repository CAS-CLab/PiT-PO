def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[0]) * \
    (x ** 4 + v ** 4) + \
    np.cos(params[1]) * \
    (x ** 2 * v ** 2 + 2*x*v) + \
    np.exp(2*np.array(params[3])*x) * \
    (v ** 2 + x ** 2) + \
    np.log(np.abs(1 + v)) * \
    (x ** 2 + v ** 2) + \
    np.tan(np.array([params[5]])) * x * v ** 2 + \
    np.sqrt(np.array([params[7]])) * \
    (x ** 4 + v ** 4 - 2*(x**2+v**2)**2/(3*np.pi)) + \
    np.cosh(2*np.array(params[8])*v) * \
    x * v ** 2 + \
    np.arcsin(np.array([params[9]])) * v ** 4 / (16 * np.pi)
    b = np.sin(params[0]) * \
    (x ** 2 * v ** 2 + 2*x*v) + \
    np.cos(params[1]) * \
    (x ** 4 + v ** 4) + \
    np.exp(2*np.array(params[3])*x) * \
    v ** 6 / (6 * np.sqrt(np.pi)) + \
    np.log(np.abs(1 + v)) * \
    (x ** 2 + v ** 2) + \
    np.tan(np.array([params[5]])) * x * v * \
    (x**2+v**2)/(x**2+v**2) + \
    np.sqrt(np.array([params[7]])) * \
    (x * v * (x ** 4 + v ** 4) - (x ** 5 + v ** 5)**2/(5 * np.sqrt(np.pi))) + \
    np.cosh(2*np.array(params[8])*v) * x * v + \
    np.arcsin(np.array([params[9]])) * v ** 6 / (128 * np.pi)
    dv = a + b * x
    return dv
