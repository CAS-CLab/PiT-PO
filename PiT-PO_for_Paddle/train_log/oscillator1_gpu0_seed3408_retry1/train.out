def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    dv = (np.sum((x - np.exp(params[0] * x))**2, axis=1) / np.sum(np.abs(x - np.exp(params[0] * x))**2, axis=1)) * \
     (np.sin(params[1] * x) * v + np.cos(params[1] * x) * np.diff(v)) + \
     (np.sqrt(params[2]) * np.abs(x - np.exp(params[2] * x))) + \
     (np.sum(((v - np.sin(params[3] * x))**2), axis=1) / np.sum(np.abs(v - np.sin(params[3] * x))**2, axis=1)) * \
     (x - np.exp(params[4] * x)) + \
     (x**2 * np.sum((x - np.exp(params[5] * x))**2, axis=1) / np.sum(np.abs(x - np.exp(params[5] * x))**2, axis=1)) + \
     (np.sum(np.abs(x - np.exp(params[6] * x))**2, axis=1) / np.sum(np.abs(x - np.exp(params[6] * x))**2, axis=1)) * \
     np.cos(params[7] * x) + \
     (x**4 * np.sum((x - np.exp(params[8] * x))**2, axis=1) / np.sum(np.abs(x - np.exp(params[8] * x))**2, axis=1))
    return dv
