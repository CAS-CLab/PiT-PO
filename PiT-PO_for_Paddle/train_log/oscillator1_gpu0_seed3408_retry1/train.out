def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (2*np.pi/15)*np.sin(2*np.pi*(x+v)/15) + \
    (16*np.pi**2/945)*(x-v)**2*(x+4*v/3 + v**2/12) + \
    (256*np.pi**4/4725)*(x-v)**4*(x+4*v/3 + v**2/12) + \
    (4096*np.pi**6/148350)*(x-v)**6*(x+4*v/3 + v**2/12) + \
    (49152*np.pi**8/479001600)*(x-v)**8*(x+4*v/3 + v**2/12) + \
    (65536*np.pi**10/4790016000)*(x-v)**10*(x+4*v/3 + v**2/12)

    b = (32*np.pi**2/315)*(x+v)*(x+4*v/3 + v**2/12) + \
    (1024*np.pi**4/2835)*(x+v)*(x+4*v/3 + v**2/12)*(x-v)**2 + \
    (16384*np.pi**6/51003)*(x+v)*(x+4*v/3 + v**2/12)*(x-v)**4 + \
    (262144*np.pi**8/1285770)*(x+v)*(x+4*v/3 + v**2/12)*(x-v)**6 + \
    (4194304*np.pi**10/25537500)*(x+v)*(x+4*v/3 + v**2/12)*(x-v)**8 + \
    (536870912*np.pi**12/1680647000)*(x+v)*(x+4*v/3 + v**2/12)*(x-v)**10

    dv = a + b
    return dv
