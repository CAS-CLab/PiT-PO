def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = params[0]
    b0 = np.sqrt(params[1]**2 + np.exp(-np.abs(v)*np.sin(params[2]*x)))
    c0 = np.log(np.cosh((b0-1)*(v**2+1)))
    d0 = b0 * np.tanh(b0*(x**2+v**2/2))
    e0 = np.arctan2(d0*x,v)
    f0 = np.tan(e0*np.pi/2)
    g0 = np.csc(f0*np.pi)
    h0 = np.cos(g0*np.pi/2)
    i0 = h0**2
    dv = (
    (i0-1)*x**2*(
        (h0*x - 1)**2 + 
        np.sin(f0*g0*x)**2 + 
        np.sin(e0*f0*x)**2 + 
        np.sin(e0*(f0-g0*x))**2 + 
        np.sin(e0*(f0+g0*x))**2 + 
        (e0-f0)**2*np.sin(f0*e0*x)**2 + 
        (e0+f0)**2*np.sin(g0*e0*x)**2
    ) + 
    (h0*x - 1)**2*(1-i0) + 
    d0*(1-h0**2)*(v**2-x**2) + 
    f0*d0*x*np.sin(2*f0*g0*x) + 
    e0*d0*x*np.sin(2*e0*f0*x) + 
    e0*g0*x*np.sin(2*e0*g0*x) + 
    x*np.sin(2*h0*x)
    )
    return dv
