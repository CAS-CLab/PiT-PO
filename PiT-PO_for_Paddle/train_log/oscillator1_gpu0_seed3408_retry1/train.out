def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([np.power(v, 8-i)*np.power(x, i) for i in range(10)])*np.power(np.sum([np.power(params[j], j) for j in range(10)]), 1) \
    - np.sum([np.power(v, 6-i)*np.power(x, i+1) for i in range(10)])*np.sum([np.power(params[j], j) for j in range(10)]) \
    - np.sum([np.power(v, 4-i)*np.power(x, i+2) for i in range(10)])*(np.sum([np.power(params[j], j) for j in range(10)])) \
    - np.sum([np.power(v, 2-i)*np.power(x, i+3) for i in range(10)])*np.sum([np.power(params[j], j) for j in range(10)]) \
    / np.sum([np.power(params[j], j) for j in range(10)])**2
    return a
