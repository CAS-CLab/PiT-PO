def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(np.sqrt(params[0]) * x) * np.cos(np.sqrt(params[0]) * v) + \
        np.exp(-np.sqrt(params[1]) * x) * np.exp(np.sqrt(params[1]) * v) + \
        np.tanh(np.sqrt(params[2]) * x) * np.cosh(np.sqrt(params[2]) * v) + \
        np.sqrt(params[3]) * np.arcsin(x) * np.arccos(v) + \
        np.power(params[4], 1.5) * x**(1.75) * np.power(v, 1.75) + \
        np.power(params[5], 1.25) * np.power(x, 1.25) * np.power(v, 2.5) + \
        np.cos(np.pi * np.sqrt(params[6]) * x) * np.sin(np.pi * np.sqrt(params[7]) * v) + \
        np.sin(np.pi * np.sqrt(params[8]) * x) * np.cos(np.pi * np.sqrt(params[9]) * v)
    return u
