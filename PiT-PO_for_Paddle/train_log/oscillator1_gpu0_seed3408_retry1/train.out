def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[i] * x**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * v**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * np.sin(i * np.pi * x + i * np.pi/2 * v) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * (x + v)**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * (x**2 + v**4)**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * (np.cos(i * np.pi * x) + np.sin((i+1)*np.pi/2 * v)) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * np.log(v + 1)**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * np.exp(-(x + v)**2)**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * (x + v)**(i+1)*(x + v)**(i+1) for i in range(MAX_NPARAMS)]) + \
    np.sum([params[i] * (x**3 + v**2)**(i+1) for i in range(MAX_NPARAMS)])
    return a * v + 5*x**2*v**4
