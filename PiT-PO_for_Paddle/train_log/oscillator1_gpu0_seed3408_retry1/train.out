def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([np.sinh(params[1] * x) * v**2 * (np.exp(params[0] * v) + np.exp(-params[0] * v)),
            np.cosh(params[1] * x) * (v**4 + v**2 * x**2),
            np.exp(2*params[0] * v) * (v**3 + v**2 * x),
            x * v * (v**2 + 1) * (v**2 * np.exp(2*params[2] * v) + v*np.exp(2*params[2] * v) + 1)])
    b = np.pi * (x * v * (v**2 + 1) * (v**2 * np.exp(2*params[3] * x) + v*np.exp(2*params[3] * x) + 1) +
             (x + v)**2 * (v**2 * np.exp(2*params[4] * x) + v*np.exp(2*params[4] * x) + 1) +
             x * v * (v**2 + 1) * (v**2 * np.exp(2*params[5] * x) + v*np.exp(2*params[5] * x) + 1))
    c = v * (v**4 + v**2 * x**2) * (x + v) * (v**2 * np.exp(2*params[6] * x) + v*np.exp(2*params[6] * x) + 1)
    return a + b + c
