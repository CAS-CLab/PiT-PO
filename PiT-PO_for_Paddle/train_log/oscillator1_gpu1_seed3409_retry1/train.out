    b = (params[2] - 0.25*params[3])*x*v*(x**4 + 2*x**2*v**2 + v**4)
    c = (params[4] + 0.125*np.sin(2*params[5])*x**2)*np.cos(2*params[6]*v)
    d = (params[7] + 0.0625*np.sin(4*params[8])*x**2)*(x**2 + v**2)**2
    dv = a + b + c + d
    return dv
