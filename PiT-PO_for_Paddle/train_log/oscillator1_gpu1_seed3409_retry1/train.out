def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**6 - 15*x**4*v**2 + 45*x**2*v**4)/12
    b = (v**6 - 30*x**2*v**4 + 20*x**4*v**2)/4
    c = (x**2 + v**2)**(3/2)
    d = (x**4 - 6*x**2*v**2 + v**4)/3
    e = (x**2 + v**2)**(3/2)*(x**2 + 2*v**2)
    f = (x**2 + v**2)**(3/2)*(v**2 - x**2)
    g = (x**4 + 4*x**2*v**2 + v**4)/(2*(x**2 + v**2))
    h = (x**2 + v**2)**(3/2)*np.sin(np.pi*x)
    i = (x**2 + v**2)**(3/2)*np.sin(2*np.pi*v)
    j = (x**2 + v**2)**(3/2)*np.cos(np.pi*x)
    k = (x**2 + v**2)**(3/2)*np.cos(2*np.pi*v)
    l = (x**2 + v**2)**(3/2)*np.sin(3*np.pi*x)
    m = (x**2 + v**2)**(3/2)*np.cos(2*np.pi*v)
    n = (x**2 + v**2)**(3/2)*np.sin(3*np.pi*x)
    o = (x**2 + v**2)**(3/2)*np.sin(4*np.pi*v)
    return a + b + c + d + e + f + g + h + i + j + k + l + m + n + o
