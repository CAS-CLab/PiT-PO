    q = 0.0006 * np.sin(2*params[8]*v) + 0.0004 * x**2
    r = 0.0004 * (x + v) + 0.00025 * (x - v)
    dv = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r
    return dv
