    b = np.square(params[1]) * (v**6 - 6*v**4*x**2 + 3*v**2*x**4)
    c = np.square(params[2]) * (x + v)**(5/2)
    d = np.sum([params[3]*np.square(x), params[4]*np.square(v)])
    e = np.sum([np.square(np.sin(params[5]*(x + v))), np.square(np.cos(params[6]*v)),
            np.sum([np.square(params[7]), np.square(np.sinh(params[8]*v)), np.square(np.cos(params[9]*(x + v)))])])
    f = np.sum([params[0]*np.square(np.sin(params[5]*(x + v))),
            np.square(params[1]*v), np.square(np.sin(params[2]*(x + v))), 
            np.square(params[3]*x + np.square(params[4])*v)]) 
    dv = a + b + c + d + e + f
    return dv
