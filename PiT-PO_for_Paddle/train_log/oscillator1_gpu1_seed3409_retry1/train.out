def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 24*params[0]*np.sinh(12*params[2]*x)*v**5 + \
    12*np.pi*params[8]*x*np.sinh(16*params[8]*x) + \
    36*params[1]*x*v*(x**2 - 2*v**2)*np.cosh(18*params[6]*x) - \
    18*params[4]*x*np.sin(20*params[5]*x) - \
    24*np.pi*params[0]*x*(x**2)*(v**2)**2*np.cos(14*params[3]*x) + \
    30*params[7]*x*v*(x**2 - 2*v**2)*np.tanh(22*params[0]*x) + \
    72*params[0]*np.sin(18*params[9]*x)*v + \
    48*np.pi*params[8]*x*(x**2 - 2*v**2)*np.sinh(10*params[4]*x) + \
    60*np.pi*params[0]*x*v*(x**2)*(v**2)**2*np.sin(15*params[1]*x) + \
    24*np.pi*params[7]*x*v*(x**2 - 2*v**2)*np.sin(20*params[8]*x) + \
    18*np.pi*params[5]*x*v*(x**2 - 2*v**2)*np.cosh(16*params[2]*x) + \
    12*params[6]*x*np.sin(25*params[6]*x)*v
