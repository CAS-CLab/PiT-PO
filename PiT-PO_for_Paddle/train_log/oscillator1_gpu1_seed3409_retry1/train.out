def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    y4 = np.sin(np.pi*params[5])*x*(np.cos(np.pi*params[8])*v +
                           (np.sin(2*np.pi*params[6])*x**3 - np.cos(2*np.pi*params[1])*v**3))**3
    a = (np.sin(2*np.pi*params[0])*v*x**5 +
     np.cos(np.pi*params[2])*x*v*(np.cos(np.pi*params[9])*v + np.sin(np.pi*params[1])*x))**3
    b = np.cos(2*np.pi*params[7])*x*(np.sin(np.pi*params[4])*v**3 -
                             (np.sin(np.pi*params[8])*x + np.cos(np.pi*params[3])*v)**3)
    c = (np.sin(2*np.pi*params[4])*x**3 +
     np.cos(3*np.pi/2*params[9])*v**3)*(np.sin(np.pi*params[1])*x +
                                            (np.cos(np.pi*params[2])*v*x +
                                             np.sin(2*np.pi*params[0])*x))
    return 0.015625*y4-0.015625*b+0.03125*a+0.0625*c
