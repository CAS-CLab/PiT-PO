    k_x = np.exp(-((x - 4*params[6])**2)/((12*params[7])**2))*np.sin(4*params[8]*x)
    l_x = (x**2 + v**2)**(2*params[3]) * np.cos(3*params[2]*x)
    m_x = (x**2 + v**2)**(2*params[8]-1)*(x-2*params[7])*np.sin(2*params[8]*x)
    dv = f_x*g_x*h_x*i_x+j_x+k_x+l_x+m_x
    return dv
