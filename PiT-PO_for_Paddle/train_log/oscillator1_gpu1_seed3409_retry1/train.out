def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**3 + v**4)*(np.sinh(np.sqrt(params[0])*x) - np.cosh(np.sqrt(params[1])*v))
    b = (x**2 + v**2)**(3/2)*(np.sqrt(params[2])*x + np.sqrt(params[3])*v)
    c = (x**2 + v**2)**(3/2)*(np.sinh(np.sqrt(params[4])*x) + np.cosh(np.sqrt(params[5])*v))
    d = (x**2 + v**2)**(3/2)*(np.tanh(np.sqrt(params[6])*x) + np.arctan2(v, x))
    e = (x**2 + v**2)**(3/2)*np.exp(-np.sqrt(params[7])*v)
    f = (x**2 + v**2)**(3/2)*np.log(np.sqrt(x**2 + v**2) + np.sqrt(np.abs(x**2 - v**2)))
    g = (x**2 + v**2)**(3/2)*np.sinh(np.sqrt(np.sum([x**2, v**2]))*x)
    h = (x**2 + v**2)**(3/2)*np.cos(np.sqrt(np.sum([x**2, v**2]))*v)
    i = (x**2 + v**2)**(3/2)*np.sin(np.sqrt(np.sum([x**2, v**2]))*v)
    dv = a + b + c + d + e + f + g + h + i
    return dv
