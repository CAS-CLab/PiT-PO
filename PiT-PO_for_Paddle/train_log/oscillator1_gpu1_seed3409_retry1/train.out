    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[0]*(x**3 - 3*x*v**2),
            params[1]*(v**4 - v**2*x**2), 
            params[2]*(x**2 + v**2)**(3/2)])
    b = np.sum([params[3]*x**2,
            params[4]*v**2, 
            params[5]*np.sin(params[6]*x), 
            params[7]*np.cos(params[8]*v)])
    c = np.sum([params[9]*x*v])
    dv = a + b + c
    return dv
