def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.sqrt(3)*x)*v - 2*np.cos(np.sqrt(2)*x)*x)**2 + \
    (2*np.pi*np.sqrt(5)*x*np.exp(-np.sqrt(4)/x))*v + \
    (x**(7/3)*v - 5*(np.log(x)+1)*x*np.exp(-(x+1))) + \
    (x**2*(np.cosh(2*x)-1))*v - np.cos(3*x)*x + \
    (2*np.sqrt(3)*x*np.tanh(np.sqrt(2)*x)) + \
    (2*np.sqrt(2)*x*np.cos(np.pi/4)*v) - 2*np.sin(x)*v
    b = (2*np.pi*np.sqrt(3)*x**3)*np.exp(-np.sqrt(4)*x)*v + \
    (x*np.exp(-(x+1))*(x**2*np.exp(-np.sqrt(2)*x)+np.cos(np.pi/4))) + \
    (np.pi*np.sqrt(2)*x*(np.cosh(2*x)-1))*v + \
    (x*(np.cosh(2*x)-1)*x - 2*np.sin(2*x)*x) + \
    (2*np.sqrt(3)*x*(np.log(x)+1)*np.exp(-(x+1)))
    return a+b
