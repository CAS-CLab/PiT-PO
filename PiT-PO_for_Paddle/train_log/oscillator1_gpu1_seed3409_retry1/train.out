def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([np.power(x, 3*i) - 3*np.power(v, 2*i)*np.power(x, 2*(i+1)) for i in range(10)])
    b = np.sum([np.power(v, 4*i - 2*i*2) - np.power(v, 2*i)*(np.power(x, 2*i)) for i in range(10)])
    c = np.power(np.sqrt(np.add(np.power(x, 2) + np.power(v, 2), 1)), 3)
    d = np.sum([np.multiply(params[i], np.power(x, 2*i)) + np.multiply(np.multiply(params[i+10], np.power(v, 2*i))) for i in range(20)])
    e = np.sum([np.multiply(np.sin(np.multiply(params[6], np.power(x, i))), np.multiply(np.cos(np.multiply(params[8], np.power(v, i))), np.multiply(np.power(params[14], i)))) for i in range(10)])
    f = np.sum([np.multiply(np.power(np.sqrt(np.add(np.power(x, 2) + np.power(v, 2), 1)), np.multiply(np.power(params[9], i))), np.multiply(np.power(x, i), np.power(v, i))) for i in range(10)])
    dv = a + b + c + d + e + f
    return dv
