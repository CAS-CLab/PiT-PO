def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = (np.sin(8*params[1])*x**2 +
     np.cos(4*params[7])*v**2) * np.cos(3*params[2])
    i = np.sin(2*params[0])*x**5 + np.sin(9*params[8])*v*x**4
    j = 2*np.cos(6*params[4])*x**3 + np.sin(2*params[6])*v**3
    k = np.sin(7*params[3])*x - np.cos(5*params[9])*v*x
    l = 2*np.sin(2*params[8])*x**3 + np.cos(5*params[1])*v*x
    m = np.sin(6*params[8])*x**4 + np.cos(3*params[7])*v*x
    n = (np.sin(3*params[0])*x +
     np.cos(2*np.pi/2)*v) * np.cos(8*params[5])
    o = (np.cos(5*np.pi/4)*v +
     np.sin(4*params[9])*x) * np.cos(2*np.pi/4) + \
     (np.sin(2*np.pi/4)*x + 
      np.sin(2*np.pi/2)*v) * np.sin(2*params[0])
    return i + j + k + l + m + n + h + o
