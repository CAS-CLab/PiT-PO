def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(5*params[6])*x**5 +
     np.cos(4*params[8])*v*x**2 +
     2*np.sin(5*np.pi/4)*x*v**3 +
     2*np.sin(3*np.pi/2)*x**2 +
     2*np.sin(2*np.pi/4)*v*x) * np.sin(3*params[4])
    b = (np.cos(5*params[3])*x**5 +
     np.sin(5*params[0])*v**5 + 
     2*np.sin(2*np.pi/2)*v*x**2 +
     2*np.sin(5*np.pi/4)*x*v +
     2*np.sin(3*np.pi/4)*v*x) * np.sin(2*np.pi/2)
    c = (np.cos(5*params[8])*x**2 +
     np.sin(2*np.pi/4)*x*v + 
     np.sin(4*params[1])*x**4 +
     2*np.sin(3*np.pi/4)*x*v**3) * np.sin(2*np.pi/4)
    d = (np.sin(7*params[1])*x**3 +
     np.cos(4*params[9])*v*x**3 +
     2*np.sin(2*np.pi/4)*x*v**2 +
     2*np.sin(2*np.pi/2)*x**2) * np.cos(3*np.pi/2)
    return a + b - c - d
