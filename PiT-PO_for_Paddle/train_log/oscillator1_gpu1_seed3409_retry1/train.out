def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * (x**3 - 3*x*v**2)
    b = params[1] * (v**4 - v**2*x**2)
    c = np.sqrt(np.sum(params[2:]**2)) * (x**2 + v**2)**(3/2)
    d = params[3] * x**2 + np.sum([params[i]*x for i in range(4, 10)])
    e = np.sum([params[i]*np.sin(params[i+3]*x) for i in range(3)]) + np.sum([params[i]*np.cos(params[i+4]*v) for i in range(4, 8)]) + x*v
    f = np.sum([params[i]*x*v for i in range(9)])
    g = np.tanh(params[0]*x)
    h = np.cosh(params[1]*v)
    i = np.exp(params[2]*v)
    j = np.sin(params[3]*x)
    k = v**2
    l = np.sum([params[i]*x*v for i in range(5, 9)]) + np.sum([params[i]*x for i in range(5, 10)]) + np.sum([params[i]*v for i in range(6, 9)]) + x**2*v**2
    m = np.sum([params[i]*x*v for i in range(9)])
    dv = a + b + c + d + e + f + g + h + i + j + k + l + m
    return dv
