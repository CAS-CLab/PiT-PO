def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    f = ((x**5)*(v**5))*(np.exp(-3*params[0]*(x**2+v**2))+
     (x**3)*(v**3)*np.sin(params[1]*(x**2+v**2))+
     (x**2)*(v**2)*np.cos(v*np.pi/2)-
     (x**(3/2))*(v**2)*np.exp(-(x**2+v**2)/2))
    g = (x**2*v**3)*np.exp((x**2+v**2)/2)/(2*np.pi*params[2]*(x**2+v**2))
    h = (x**2*v**2)*np.exp(-(x**2+v**2)/2)/np.sqrt(np.pi*params[3]*(x**2+v**2))
    i = (x**2*v**2)*np.exp((x**2+v**2)/2)/np.sqrt(np.pi*params[4]*(x**2+v**2))
    j = (x**2*v**3)*np.exp(-(x**2+v**2)/2)/(2*np.sqrt(np.pi*params[5]*(x**2+v**2)))
    k = (x**2*v**2)*np.exp(-(x**2+v**2)/2)/np.sqrt(np.pi*params[6]*(x**2+v**2))
    l = (x**2*v**2)*np.exp((x**2+v**2)/2)/np.sqrt(np.pi*params[7]*(x**2+v**2))
    m = (x**2*v**3)*np.exp(-(x**2+v**2)/2)/np.sqrt(np.pi*params[8]*(x**2+v**2))
    n = (x**2*v**3)*np.exp((x**2+v**2)/2)/(2*np.pi*params[9]*(x**2+v**2))
    return f+g+h+i+j+k+l+m+n
