def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**7 - 7*x**5*v**2 + 21*x**3*v**4 - 7*x*v**6)*np.sinh((np.sqrt(params[0])*x + np.sqrt(params[1])*v)/np.sqrt(params[2]))
    b = (x**5 - 5*x**3*v**2 + x*v**4)*np.cosh((np.sqrt(params[3])*x + np.sqrt(params[4])*v)/np.sqrt(params[5]))
    c = (x**2 + v**2)**(5/2)*np.sin(3*params[6]*x + 2*params[7]*v + 3*params[8]*x*v)
    d = (x**4 - 4*x**2*v**2 + v**4)*np.tanh((np.sqrt(params[9])*x - np.sqrt(params[0])*v)/np.sqrt(params[1]))
    e = (x**3 - 3*x*v**2)*np.sinh(np.sqrt(params[2])*x)
    f = (x**2 + v**2)**(3/2)*np.cos(2*params[6]*x + 3*params[7]*v)
    g = (x*v)**2*(np.exp(np.sqrt(params[3])*x) + np.exp(-np.sqrt(params[3])*x))
    h = (x**2 + v**2)*np.sin(2*params[8]*v)
    dv = a + b + c + d + e + f + g + h
    return dv
