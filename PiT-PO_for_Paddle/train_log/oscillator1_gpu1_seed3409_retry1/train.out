    3*params[0]*x**3 + 2*params[2]*x**2 - 3*params[6]*x*v**2 + 2*params[7]*v**4 + \
    3*params[9]*v**2 + 2*params[3]*v + 5*params[0]*x*v + 3*params[5]*x**2 + \
    5*params[6]*v**3 + 3*params[8]*x**4
    return a
