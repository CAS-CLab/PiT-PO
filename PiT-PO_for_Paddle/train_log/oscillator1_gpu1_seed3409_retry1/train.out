    a = t*params[0]*x + (x*t-3*t*np.power(v, 2))*np.sum(params[8]*np.square(x))
    b = t*np.power(v, 3)*np.sum(np.insert(params[6], 0, 0)*x)
    c = 3*np.sum(t*np.multiply(x,v)*np.insert(params[4], 0, 0)*(np.insert(params[7], 0, 0)-np.power(v, 2)))
    return a+b+c
