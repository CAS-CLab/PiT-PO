def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * (x**3 - 3*x*v**2)
    b = params[1] * (v**4 - v**2*x**2)
    c = params[2] * (x**2 + v**2)**(3/2)
    d = params[3] * x**2 + params[4] * v**2
    e = np.sin(np.pi*params[5]*x)*np.cos(np.pi*params[6]*v) + np.sin(np.pi*params[7]*v)*np.cos(np.pi*params[8]*x) + np.sin(np.pi*params[9]*x)*np.cos(np.pi*params[6]*v)
    f = params[0] * (x**2 + v**2)**(3/2)
    g = np.sin(np.pi*params[1]*x)*np.cos(np.pi*params[2]*v) + np.sin(np.pi*params[3]*x)*np.cos(np.pi*params[4]*v) + np.sin(np.pi*params[5]*x)*np.cos(np.pi*params[6]*v) + np.sin(np.pi*params[7]*x)*np.cos(np.pi*params[8]*v)
    h = np.cos(np.pi*params[0]*x)*np.sin(np.pi*params[1]*v) + np.cos(np.pi*params[2]*v)*np.sin(np.pi*params[3]*x) + np.cos(np.pi*params[4]*x)*np.sin(np.pi*params[5]*v) + np.cos(np.pi*params[6]*v)*np.sin(np.pi*params[7]*x) + np.cos(np.pi*params[8]*x)*np.sin(np.pi*params[9]*v)
    dv = a + b + c + d + e + f + g + h
    return dv
