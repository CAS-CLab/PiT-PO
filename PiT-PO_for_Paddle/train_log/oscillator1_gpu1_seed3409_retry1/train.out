    b = 12*np.sin(np.pi*3*params[2])*x*(x-5*np.cos(2*params[9])*x)*(x+4*np.sin(2*params[4]))
    c = 9*np.cos(2*np.pi*3*params[1])*x**3*(x-3*np.cos(2*params[0])*x)
    d = 2*np.sin(2*np.pi*3*params[7])*x*(x-2*np.cos(3*params[2])*x)-8*np.sin(2*np.pi*4*params[1])*x
    e = 16*np.sin(2*np.pi*8*params[8])*(x-4*np.sin(2*params[5])*x)*np.sin(2*params[9]*(x-2*np.sin(3*params[8])*x))
    f = 13*np.cos(2*np.pi*4*params[8])*x*(x-3*np.cos(2*params[2])*x)*(x+4*np.sin(2*params[4]))*(x-2*np.sin(3*params[8])*x)
