def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(5*params[8])*x**3 - 2*np.cos(3*params[5])*v*x**2 +
     np.cos(2*params[1])*v**3 + 2*np.sin(4*params[7])*x) * \
    (np.sin(4*params[3])*v + np.cos(3*params[6])*x) / \
    (np.sin(5*params[4])*v + np.cos(3*params[0])*x) * \
    (np.sin(5*params[5])*x + np.cos(2*params[4])*v)**-1
    b = (np.sin(7*params[1])*x**5 +
     3*np.cos(4*params[0])*v**5 + 
     2*np.sin(2*params[6])*v*x**4 +
     2*np.sin(np.pi/2)*v*x**2 +
     2*np.sin(2*params[8])*x**3 + 
     np.sin(2*np.pi/4)*v**3 + 
     np.sin(3*params[9])*x) * np.cos(3*params[7])
    c = (np.cos(5*params[0])*v +
     np.sin(5*params[3])*x) * np.cos(2*params[9]) + \
