def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*params[8])*x - \
    np.sin(5*params[1])*v*np.sin(7*params[0]) + \
    np.sin(6*np.pi/4)*v**3 + \
    np.cos(2*params[5])*x**3 + \
    np.cos(3*np.pi/2)*x*v**2 + \
    np.sin(2*params[3])*x*np.cos(9*params[8]) + \
    np.sin(8*params[9])*x
    b = 2*np.sin(3*params[2])*x**2 + \
    np.sin(3*np.pi/4)*v*x - \
    2*np.sin(4*np.pi/4)*v*x**4 + \
    np.sin(5*np.pi/4)*v**3 + \
    np.sin(2*params[6])*x*np.cos(2*params[1])
    c = np.cos(4*params[0])*x + \
    np.sin(3*np.pi/2)*v*x + \
    2*np.sin(2*np.pi/2)*v**3 + \
    np.sin(5*np.pi/4)*x*np.sin(2*np.pi/4) + \
    np.sin(2*params[8])*x**2
    return a + b + c
