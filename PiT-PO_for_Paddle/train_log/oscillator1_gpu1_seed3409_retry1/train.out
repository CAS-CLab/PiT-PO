def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**2 + v**2) * np.exp(-np.sqrt(np.sum((np.arange(0, 10, 2)+1)**2)*x))
    b = (x*np.pi/2) * v**2 * np.sin(2*x+np.pi*params[4])
    c = (x**2 + v**2)**0.5 * np.exp(-(x+np.tan(np.arcsin(v/np.sqrt(x**2+v**2)))*params[2]))
    d = np.sum([params[i]*np.sin(i*np.pi/2)*np.sin(params[6]*x) for i in range(0, 10, 2)])
    e = np.sum([np.sqrt(x**2+v**2)*np.cos(np.pi/2-i*np.pi/2)*np.sin(params[9]*v) for i in range(0, 10, 2)])
    f = a+b+c+d+e
    g = x*np.cos(2*x+np.pi*params[5])*np.exp(-(x+np.sqrt(x**2+v**2))*params[2])
    h = x*v*(np.pi/2)*np.sin(2*x+np.pi*params[8])
    dv = f+g+h-h*x-v*(np.pi/2)*np.cos(2*x+np.pi*params[8])
    return dv
