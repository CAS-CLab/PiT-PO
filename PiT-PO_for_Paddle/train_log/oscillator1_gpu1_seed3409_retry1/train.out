def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(3*np.pi*params[0])*v**5 + \
    np.cos(3*np.pi*params[9])*x*v*(np.sin(np.pi*params[1])*v + np.cos(np.pi*params[8])*x)**3
    b = (np.sin(2*np.pi*params[6])*x**3 - np.cos(2*np.pi*params[5])*v**3)* \
    (np.sin(np.pi*params[2])*x + np.cos(np.pi*params[7])*v)* \
    (np.sin(np.pi*params[4])*x**3 + np.cos(np.pi*params[0])*v**3)
    c = (np.sin(np.pi*params[8])*x + np.cos(np.pi*params[3])*v)*(np.sin(np.pi*params[9])*x - np.cos(np.pi*params[1])*v)
    d = np.sin(np.pi*params[5])*x*(np.sin(np.pi*params[7])*x + np.cos(np.pi*params[4])*v)**3
    e = (np.sin(np.pi*params[9])*x**5 - np.cos(np.pi*params[7])*v**5)* \
    (np.sin(3*np.pi/2*params[8])*x**3 + np.cos(3*np.pi/2*params[6])*v**3)
    return 0.0625*e+0.03125*b+0.0625*a+0.125*c+0.25*d
