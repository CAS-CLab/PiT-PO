    f = np.sum([params[i] * x * v**(i+1) for i in range(MAX_NPARAMS)])
    g = np.sum([params[i] * x**(2*i+1) * v**(2*i+1) for i in range(MAX_NPARAMS)])
    dv = a + b + c + d + e + f + g
    return dv
