def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(params[6]*x) + np.cos(params[7]*v)
    a = params[0]*(x**7 - u**7) + params[1]*(v**7 - u**7) + params[2]*x**5 + params[3]*v**5 + params[4]*x**3 + params[5]*v**3 + params[8]*v*u
    b = params[0]*x**5 + params[1]*v**5 + params[2]*x**3 + params[3]*v**3 + params[4]*x*v + params[6]*x*(u**2 - x**2) + params[7]*v*(u**2 - v**2)
    c = params[0]*x**3 + params[1]*v**3 + params[2]*x*v + params[3]*v*x + params[4]*(x**3 - u**3) + params[5]*(v**3 - u**3) + params[8]*u
    d = params[0]*x + params[1]*v + params[2]*x**2 + params[3]*v**2 + params[4]*x*u + params[5]*v*u + params[6]*x*(u**2 - x**2) + params[7]*v*(u**2 - v**2)
    dv = a + b + c + d
    return dv
