def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[0]*x**i for i in range(1,11)])
    b = np.sum([params[1]*(x-v)**2 for i in range(2,11)])
    c = np.sum([params[2]*np.exp(-(x-v)/params[3]) for i in range(4,11)])
    d = np.sum([params[4]*x*(x-v)**2 for i in range(5,11)])
    e = np.sum([params[5]*np.cos(np.sqrt(params[6])*x)*np.sin(np.sqrt(params[7])*v) for i in range(6,11)])
    f = np.sum([params[8]*np.sin(np.pi*params[9]*x)*np.cos(np.pi*params[10]*v) for i in range(9,12)])
    g = np.sum([params[9]*x*np.sin(np.pi*params[10]*x)*np.cos(np.pi*params[10]*v) for i in range(10,13)])
    dv = a + b + c + d + e + f + g
    return dv
