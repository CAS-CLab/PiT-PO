def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(5*params[0])*x**3 -
     3*np.cos(3*params[8])*v*x**2 +
     np.cos(2*params[3])*v**3 +
     np.sin(4*params[6])*x + 
     2*np.sin(2*params[2])*v*x**3) * np.sqrt((np.sin(4*params[1])*v + 
                                            np.cos(3*params[7])*x) ** 2 +
                                            (np.sin(5*params[4])*x + 
                                             np.cos(2*params[5])*v) ** 2)
    b = (np.sin(7*params[9])*x**5 +
     np.cos(4*params[0])*v**5 + 
     2*np.sin(2*params[9])*v*x**4 +
     np.cos(2*params[8])*v*x**2 + 
     2*np.sin(5*np.pi/4)*v*x) * np.cos(3*params[1])
    c = (np.cos(5*params[7])*v +
     np.sin(5*params[2])*x) * np.cos(2*params[3]) +\
     (np.cos(3*params[2])*v**3 + 
