    a = ((x+np.sqrt(v))**(1/3))*((x*np.sqrt(v)-np.sqrt(v))**2 - (x**2+v**2)*(np.sqrt(v)))
    b = (x-v)
    c = (x-v)
    dv = a + b + c
    return dv
