def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(8*np.pi*params[8])*x**9 + np.sin(6*np.pi*params[1])*v**5 +\
    np.cos(4*np.pi*params[2])*x**7 + np.cos(2*np.pi*params[3])*x*v**3 +\
    np.sin(6*np.pi*params[5])*x**3 + np.sin(3*np.pi*params[9])*x*v
    b = np.cos(2*np.pi*params[0])*x**7 + np.cos(8*np.pi*params[7])*v*x**7 +\
    np.sin(7*np.pi*params[4])*x**5 + np.sin(3*np.pi*params[6])*v**5 +\
    np.cos(5*np.pi*params[8])*x*v**3 + np.cos(4*np.pi*params[9])*x
    c = np.sin(9*np.pi*params[0])*x*v**3 + np.sin(4*np.pi*params[7])*x**5 +\
    np.cos(7*np.pi*params[1])*x^3 + np.sin(2*np.pi*params[8])*x +\
    np.sin(9*np.pi*params[2])*v**3 + np.sin(2*np.pi*params[6])*x*v
    d = np.cos(3*np.pi*params[5])*x^7 + np.sin(6*np.pi*params[9])*v^3 +\
    np.sin(2*np.pi*params[3])*x*v**5 + np.sin(7*np.pi*params[8])*x +\
    np.cos(5*np.pi*params[4])*x*v^3
    return a-b+c+d
