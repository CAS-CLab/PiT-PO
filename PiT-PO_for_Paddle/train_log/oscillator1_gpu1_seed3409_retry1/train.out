def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    f = np.sum([
    (np.sin(2*params[0])*x - np.sin(2*params[0]*v)*(x**2 + v**2)) / (x**2 + v**2),
    -(np.sin(np.pi/2)*x - np.cos(np.pi/2)*v*np.sin(2*params[3]*v)), 
    (np.cos(np.pi/4)*x - np.sin(np.pi/4)*v*(x**2 + v**2)) / (x**2 + v**2), 
    -(np.cos(np.pi/2)*x - np.cos(np.pi/2)*v*(x**2 + v**2)),
    (np.sin(np.pi/6)*v - np.cos(np.pi/6)*x*(x**2 + v**2)) / (x**2 + v**2),
    (np.sin(np.pi/4)*x - np.cos(np.pi/4)*v*(x**2 + v**2)),
    -(np.cos(2*np.pi/3)*x - np.sin(2*np.pi/3)*v*(x**2 + v**2)) / (x**2 + v**2),
    (np.sin(np.pi/8)*x - np.cos(np.pi/8)*v*(x**2 + v**2)) / (x**2 + v**2),
    np.sin(np.pi/12)*x,
    -np.cos(np.pi/24)*v,
    ])
    dv = f
    return dv
