     np.tan(np.sqrt(params[1]*x + 2*np.pi/3)*v) +
     np.cosh(np.sqrt(2*params[2]*x + np.e)/2)*np.sinh(np.sqrt(3*params[3]*x + np.pi/6)*v))
    b = (3*params[4]*x + 2*params[8]*v*(x**2 + v**2)**0.5 +
