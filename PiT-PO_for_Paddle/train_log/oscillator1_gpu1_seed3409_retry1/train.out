    e = (np.sqrt(x**2 + v**2) * (np.cos(np.pi/4)*x + np.sin(np.pi/4)*v))/2
    f = (x + v)*(x - v)/(2*np.tan(np.pi/8))
    dv = a + b + c + d + e + f
    return dv
