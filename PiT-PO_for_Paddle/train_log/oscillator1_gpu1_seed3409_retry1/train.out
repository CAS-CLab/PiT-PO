def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (params[0] - 2*params[1])*x**3 + \
     (3*params[2] - 3*params[3])*x**2*v + \
     (3*(params[3]-2*params[4]))*x*v**2 + \
     (3*params[5] - 3*params[6])*x*v**3 + \
     (2*params[7] - 2*params[8])*x*v + \
     (2*params[9])*(x + v)*np.sin(np.pi*x)

    ay = (3*params[0] - 3*params[1])*x**2*v + \
     ((-9*params[2] + 6*params[3])*x - 3*params[4])*v**2 + \
     (-6*params[5] + 6*params[6])*x*v**3 + \
     (3*params[7] - 3*params[8])*x*v + \
     (6*params[9])*(x + v)*np.cos(np.pi*x)

    a = ax + ay
    f_x = (2*params[0])*(x + v)**2 + \
      (2*params[1])*(x + v)*(x**2 - 2*x*v + v**2) + \
      (2*params[2])*((x + v)**2 - 2*(x + v)*x*v + v**2)
    dv = a + f_x
    return dv
