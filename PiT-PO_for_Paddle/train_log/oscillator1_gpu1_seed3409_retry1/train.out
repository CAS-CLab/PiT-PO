def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[8]*x)**2*np.cos(v+np.pi/4)**3
    b = 2*params[7]*(x**2-v**2)-2*np.sqrt(2)*np.tan(np.arccos(params[6])*x)*np.cos(v+np.pi/4)
    c = np.exp(-(x-2*v)/np.sqrt(2))*np.cos(3*v+np.pi/2)*np.sqrt(2*params[5]+1)
    d = 2*params[4]*(x-v)**2*np.sqrt(2*params[9]-1)+2*np.sqrt(2)*(x-v)*np.sqrt(2*params[5])
    e = 2*params[1]*(x**2-np.pi/16*np.cos(3*v))+(x-np.pi/16*np.cos(3*v))
    f = 2*np.sqrt(2)*np.sin(v+np.pi/4)*np.sqrt(np.sin(2*x)**2-np.cos(2*x)**2)
    g = np.sin(np.sqrt(2*params[3]))*x*np.sin(v+np.pi/4)
    h = 2*np.sqrt(2)*np.sin(v+np.pi/4)*np.sqrt(np.sin(2*x)**2-np.cos(2*x)**2)
    i = 2*np.sin(np.sqrt(2*params[2]))*x*np.cos(v+np.pi/4)
    j = np.sin(3*v)*x
    return a+b+c+d+e+f+g+h+i+j
