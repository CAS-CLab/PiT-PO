def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*np.pi*params[3])*x**3*np.sin(3*np.pi*params[8])
    b = np.sin(3*np.pi*params[4])*v**3*np.sin(2*np.pi*params[7])
    c = np.cos(5*np.pi*params[1])*x**2*np.sin(2*np.pi*params[6])
    d = 2*np.sin(4*np.pi*params[2])*x*np.sin(2*np.pi*params[0])
    e = np.sin(6*np.pi*params[8])*x**4*np.sin(2*np.pi*params[5])
    f = 2*np.sin(8*np.pi*params[9])*v*x
    g = np.sin(4*np.pi*params[1])*x**2*np.sin(3*np.pi*params[3])
    h = 2*np.sin(2*np.pi*params[7])*v*x**3
    i = np.cos(2*np.pi*params[8])*v**2
    dv = (a+b*c+d+e*f+g+h+i)
    return dv
