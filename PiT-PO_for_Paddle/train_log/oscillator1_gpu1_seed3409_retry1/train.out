    np.cos(3*np.pi*params[9])*v*(np.sin(np.pi*params[7])*x + np.cos(np.pi*params[8])*v)
    y1 = np.cos(np.pi*params[4])*v*x + \
    (np.sin(2*np.pi*params[2])*x**7 + np.sin(2*np.pi*params[8])*v**3)
    a = 0.0625*f0 + 0.03125*y1 + 0.125*(np.cos(np.pi*params[0])*x**5 + np.sin(np.pi*params[6])*x*v)
    b = (np.sin(np.pi*params[5])*x**5 + np.sin(3*np.pi/2*params[8])*v**5)*\
    (np.sin(np.pi*params[3])*v - np.cos(np.pi*params[9])*x)
    c = (np.sin(np.pi*params[9])*v*x - np.cos(np.pi*params[2])*v**3)*\
    (np.sin(3*np.pi*params[4])*x**5 + np.cos(2*np.pi*params[1])*x*v)
    d = np.cos(np.pi*params[8])*v*x*(np.sin(np.pi*params[7])*x + np.cos(np.pi*params[6])*v)
    return a+c+d-b
