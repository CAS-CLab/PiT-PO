def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(5*np.pi*params[8])*x**7 +\
    np.sin(2*np.pi*params[1])*v +\
    2*np.cos(9*np.pi*params[0])*x**5 +\
    np.sin(7*np.pi*params[3])*x +\
    2*np.sin(8*np.pi*params[4])*v**3 +\
    2*np.cos(6*np.pi*params[7])*v +\
    np.cos(3*np.pi*params[6])*x**3 +\
    2*np.cos(4*np.pi*params[9])*x*v +\
    2*np.sin(9*np.pi*params[2])*v +\
    2*np.cos(8*np.pi*params[5])*x
    dv = 2*np.sin(2*np.pi*params[9])*x +\
    np.sin(3*np.pi*params[8])*v**5 +\
    np.sin(6*np.pi*params[0])*x**7 +\
    2*np.sin(2*np.pi*params[5])*x**3 +\
    np.sin(9*np.pi*params[4])*v +\
    2*np.cos(7*np.pi*params[1])*x +\
    np.cos(5*np.pi*params[6])*v +\
    np.cos(4*np.pi*params[7])*x +\
    2*np.cos(9*np.pi*params[2])*x
    return dv
