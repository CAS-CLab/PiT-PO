    (x*np.cos(params[1]*v))*(v**2) + \
    (x**4)*(v**7)*np.exp(-np.sqrt(np.sum(x**2))**2*params[2]) + \
    (x+2*v)*np.log(1+np.tan(params[3]*x/2))*np.sqrt(v**2+x**2) + \
    (x**3)*(v**5)*np.arcsin(params[4]*x/v) + \
