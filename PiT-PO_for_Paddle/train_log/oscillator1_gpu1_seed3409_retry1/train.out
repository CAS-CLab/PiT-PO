    b = params[5] * x * v
    c = np.sin(params[6]*x) * np.cos(params[6]*x)
    d = np.sin(params[6]*x) - np.cos(params[6]*x)
    e = a * (x**2 + v**2)**(params[3]-1) * np.exp(-params[4]*(x + params[5]*v)) + \
