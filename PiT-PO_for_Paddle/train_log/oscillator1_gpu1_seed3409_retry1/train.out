    f = 3*x*v*abs(x*3+2*v*2*abs(x**2+4*v**2)**(1/2))
    h = (x**2 + v**2)**(4/3)*np.tanh(2*x*4-3*v*2*np.arctan2(v, x))
    dv = g + f + h
    return dv
