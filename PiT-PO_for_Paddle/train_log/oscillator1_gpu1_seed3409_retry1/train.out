    (-39*x + 20*v)*np.sqrt((x + v)**2 + (x**2 + 3*x*v**2)**2)*np.exp(params[7]) +\
    (16*x + 4*v)*np.cos(2*np.arctan2(v, x))*np.sin(3*x**2 + 2*np.pi*params[8]) +\
