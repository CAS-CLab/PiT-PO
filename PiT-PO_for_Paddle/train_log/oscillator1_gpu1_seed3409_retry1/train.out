    np.cos(11*np.pi/20)*v*(2*np.sin(3*np.pi/4)*x**2 + 2*np.sin(5*np.pi/4))*np.sin(2*params[1]) + \
    np.sin(3*np.pi/4)*(2*np.sin(2*np.pi/4)*x**2 + 2*np.sin(3*np.pi/2)*v*x + \
