def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (2*params[5]-4*params[9])*x*(x-v)**2 + \
     (2*params[8]+2*params[0])*(x+v)*(v-x) + \
     (4*params[3]-2*params[2])*x*v + \
     (4*params[2]-2*params[1])*x*v**2 + \
     2*params[0]*x*v**3 + \
     (2*params[7]-4*params[9])*v*(x-v)**2 + \
     (2*params[5]-4*params[8])*v*(x+v)*x + \
     (4*params[6]-2*params[4])*v**2 + \
     (4*params[6]-2*params[0])*v**3 + \
     (2*params[2]-2*params[1])*v**4
    ay = (2*params[8]-4*params[5])*x*(x-v)**2 + \
     (-2*params[0]+4*params[2])*x*(x+v) + \
     (2*params[7]+4*params[4])*x*(v+x) + \
     (-4*params[5]+2*params[1])*x*v + \
     (4*params[6]+2*params[3])*x*v**2 + \
     (2*params[4]+2*params[9])*x*v**3 + \
     (2*params[2]-2*params[8])*v*(x-v)**2 + \
     (2*params[6]-4*params[3])*v*(x+v)*x + \
     (4*params[1]-2*params[0])*v**2 + \
     (4*params[0]-2*params[2])*v**3 + \
     (2*params[9]-2*params[6])*v**4
    return ax + ay
