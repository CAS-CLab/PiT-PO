    a_3 = 0.63*np.sin(4*3*params[8]*x)
    b_3 = 0.87*np.cos(2*3*params[0]*x)*np.sin(v)
    c_3 = 0.48*np.sin(3*4*params[1]*x)*np.sin(2*3*params[9])
