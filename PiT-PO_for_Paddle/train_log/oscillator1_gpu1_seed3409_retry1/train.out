     3*np.cos(3*params[5])*v*x**2 +
     np.cos(2*params[1])*v**3 +
     np.sin(4*params[7])*x) * np.sqrt((np.sin(4*params[2])*v + 
                                        np.cos(3*params[9])*x) ** 2 +
                                        (np.sin(5*params[0])*x + 
                                         np.cos(2*params[5])*v) ** 2)
    b = (np.sin(7*params[6])*x**5 +
     np.cos(4*params[9])*v**5 + 
     2*np.sin(2*params[1])*v*x**4 +
     2*np.sin(np.pi/2)*v*x**2 +
     2*np.sin(2*params[4])*x**3 + 
     np.sin(2*np.pi/4)*v**3 +
     2*np.sin(5*np.pi/4)*v*x) * np.cos(3*params[2])
