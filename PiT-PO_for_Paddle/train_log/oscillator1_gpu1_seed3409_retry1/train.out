    g = np.sin(2*np.pi/4)*x**3 + 2*np.sin(6*params[1])*x**4
    f = np.sin(4*params[3])*x**2*v - 2*np.sin(4*params[2])*x*v**3
    e = np.sin(5*np.pi/4)*(v*x**2 - np.sin(3*params[5])*x) + \
    2*np.sin(2*params[0])*x**2*v - np.sin(5*params[8])*x*v**3
    d = np.sin(2*params[7])*x**2 + 2*np.sin(8*params[8])*x
    c = np.sin(6*params[9])*x*v - 2*np.sin(9*params[0])*x + np.sin(8*params[8])*x**2
    b = np.sin(2*np.pi/2)*v - np.cos(4*params[1])*x*v**3 + \
    2*np.sin(3*params[4])*x**4 - np.sin(5*params[1])*x*v
