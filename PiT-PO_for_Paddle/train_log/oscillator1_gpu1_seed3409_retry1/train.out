def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    j = (2*np.sin(8*params[1])*x*v**3 + 2*np.sin(6*params[9])*x)
    k = (np.sin(2*params[1])*x + np.sin(9*params[2])*v*x) * np.cos(4*params[5])
    l = (2*np.sin(8*params[2])*x**2 + 3*np.sin(3*params[1])*x*v**2)
    m = (np.sin(9*params[3])*x**4 + 2*np.sin(5*params[1])*x + 3*np.sin(7*params[8])*x**2)
    n = (2*np.sin(6*params[4])*v*x + np.sin(5*np.pi/4)*x**2) * np.sin(2*params[8])
    o = (2*np.sin(8*params[5])*x**2 + 2*np.sin(9*params[9])*x*v)
    p = (2*np.sin(3*np.pi/2)*x + 2*np.sin(2*np.pi/4)*x*v**3)
    q = (np.sin(6*params[7])*x + 2*np.sin(5*np.pi/2)*x**2 + 2*np.sin(9*params[0])*x**2)
    r = (2*np.sin(4*params[8])*x*v + 2*np.sin(8*params[9])*x) * np.sin(3*params[4])
    s = (3*np.sin(6*np.pi/4)*x*v**2 + 3*np.sin(3*np.pi/4)*x**3)
    t = (2*np.sin(2*np.pi/2)*x + 2*np.sin(5*np.pi/4)*x*v)
    u = (3*np.sin(5*np.pi/4)*x + 2*np.sin(7*np.pi/4)*x**3)
    return j*k + l*m + n*p + o*r + s*t + u*q
