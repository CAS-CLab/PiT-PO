def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 2*(3*params[8] - 5*params[7])*x*v + \
    (-2*params[0] - 7*params[5])*v**5 + \
    (2*params[4]*x + 5*params[9])*x**3 + \
    (2*params[6]*x - 3*params[1])*v**2 + \
    (5*params[1]*x - 7*params[2]*x**2) + \
    (2*params[8]*x - 2*params[4]*x) + \
    (3*params[3]*x + 5*params[6])

    b = 2*params[2]*x - 7*params[5]*v**5 + \
    (2*params[0]*x + 3*params[1])*x**2 + \
    (2*params[7]*x + 3*params[8])*v**2 + \
    (5*params[4]*x - 2*params[6])*v + \
    (2*params[3]*x - 5*params[9])

    c = 2*params[0]*x + 2*params[9]*x + \
    (-2*params[7]*x - 2*params[8])*v + \
    (2*params[6]*x - 2*params[1])*v + \
    (2*params[4]*x + 3*params[2]*x)

    dv = a*b + c
    return dv
