def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(2)*x)*np.cos(np.sqrt(3)*v)/np.sqrt(5) - \
    np.sqrt(3)*(np.sqrt(2)*x*np.cos(np.sqrt(5)*v) + 
                np.sqrt(5)*v*np.cos(np.sqrt(2)*x))/np.sqrt(7) + \
    2*(x**3 + 3*v**3)/np.sqrt(14) - \
    (x**2 + v**2)/(16*np.sqrt(2)) + \
    (x**2 + v**2)**2/64*np.cos(2*np.pi*params[8]*v)
    b = 0.75 * np.cos(2*np.pi*params[2]*x) + \
    0.3125 * np.sin(2*np.pi*3*params[5]*x) - \
    0.078125 * x/(16*np.sqrt(2))
    c = 0.265625 * (x**2 + v**2)/32 - \
    0.015625 * x/(2*np.pi*3*params[6])*np.cos(2*np.pi*3*params[8]*v)
    d = 0.00390625 * x*np.sin(2*np.pi*6*params[7]*x) - \
    0.001953125 * v*np.cos(np.pi*3*params[8]*x) + \
    (x**4 + 2*x**2*v**2 + v**4)/40
    return a + b + c + d
