def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = ((x + v * np.sin(np.pi / 4))**2 - x**2) * (x**2 + v**2) ** (-1/2) * (np.cos(np.pi / 4) * x - np.sin(np.pi / 4) * v)
    b = x * (x**2 + v**2) ** (1/2) * (np.cos(np.pi / 4) * x + np.sin(np.pi / 4) * v)
    c = v * (x**2 + v**2) ** (1/2) * (np.cos(3*np.pi / 4) * x - np.sin(3*np.pi / 4) * v)
    d = (x**2 + v**2) ** 1.5 * (np.sin(np.pi / 4) * x - np.cos(np.pi / 4) * v) ** 2
    e = (x * v * np.cos(np.pi / 4)) ** 2
    f = (x**2 + v**2) ** (3/2) * (np.sin(3*np.pi / 4) * x - np.cos(3*np.pi / 4) * v)
    g = v * (x**2 + v**2) ** (1/2) * (np.sin(np.pi / 4) * x + np.cos(np.pi / 4) * v) ** 2
    h = (x**2 + v**2) ** 1.5 * (np.cos(np.pi / 4) * x + np.sin(np.pi / 4) * v) ** 2
    i = v * (x**2 + v**2) ** (1/2) * (np.cos(3*np.pi / 4) * x + np.sin(3*np.pi / 4) * v) ** 2
    j = (x**2 + v**2) ** (1/2) * (np.sin(3*np.pi / 4) * x - np.cos(3*np.pi / 4) * v) ** 2
    dv = a + b + c + d + e + f + g + h + i + j
    return dv
