     2*(3*np.cos(3*params[5])-np.cos(params[0]))*x*(v+0.5)**3+
     3*(5/2)*(2*np.cosh(2*params[4])-3*np.cos(3*params[1]))*v*(v+0.5)**2*x+
     (9/2)*(2*np.sinh(2*params[3])-4*np.cos(params[0]))*v*(v+0.5)**3)
