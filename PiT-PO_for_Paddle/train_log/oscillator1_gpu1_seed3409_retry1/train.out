    b = (x**2)*v*(params[1]-np.power(x, 2)*(params[2]+np.power(v, 2)))
    c = (x*(v*(v-np.power(x, 3))))* (params[3]-np.power(x, 2)*(params[4]+np.power(v, 2)))
    dv = a + b + c
    return dv
