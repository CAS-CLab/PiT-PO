    np.cos(2*np.pi*params[2])*x**3 + np.sin(6*np.pi*params[0])*x*v**3 + \
    np.cos(3*np.pi*params[5])*x**7 + np.sin(8*np.pi*params[7])*x*v + \
    np.sin(2*np.pi*params[4])*v**5 + np.cos(9*np.pi*params[9])*x*v**3
    b = np.sin(5*np.pi*params[2])*x*v + np.sin(2*np.pi*params[9])*x**5 + \
