    e = (x**2+v**2)**3*np.sinh(2*np.sqrt(x**2+v**2)*np.sqrt(params[6]))*\
     (x**2+v**2)**3*np.exp(np.sqrt(x**2+v**2)*np.sqrt(params[7]))

    f = (x**2+v**2)**3*np.sinh(2*np.sqrt(x**2+v**2))*\
     ((x**2+v**2)**3*np.exp(-(x**2+v**2)*np.sqrt(params[8])) - \
      (x**2+v**2)**3*np.exp((x**2+v**2)*np.sqrt(params[8])))

    g = (x**2+v**2)**3*np.sinh(2*np.sqrt(x**2+v**2)*np.sqrt(params[9]))*\
     (x**2+v**2)**3*np.exp(np.sqrt(x**2+v**2)*np.sqrt(params[0]))

