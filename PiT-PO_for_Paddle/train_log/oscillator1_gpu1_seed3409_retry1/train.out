def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*params[0]*x+3*np.pi/2)*np.cos(v**2*(3*params[1]-1))
    b = np.sqrt(np.abs(x))**3*3*np.cos(2*params[8]*(v**2-1)+4*np.pi/3)
    c = np.tanh(v*(np.exp(2*params[5])-1))*np.sqrt(np.sinh(2*x+np.pi/2))
    d = np.sum([np.sin(i*np.pi*x+np.pi/6)*np.cos(j*np.pi*v+2*np.pi) for i,j in [(5,8),(3,2),(4,6)]],axis=0)
    e = np.sinh(2*params[7]*x+3*np.pi/2)*np.cosh(2*np.sqrt(2)*x-1)
    f = np.einsum('ik,kj->ij', np.sin(2*x), np.sin(v*2-3*np.pi/2))
    g = np.sum([np.cos(k*np.pi*x+k*np.pi/2)*np.sin(l*np.pi*v+l*np.pi/2) for k,l in [(4,6),(2,1),(3,8)]],axis=0)
    return np.sum([f[0,0]*g[0,0]+e[0,0]*d[0,0]+c[0,0]*b[0,0]+a[0,0]*g[1,1]+b[1,1]*e[1,1]]+[f[1,1]*g[1,1]+b[1,0]*d[1,0]+a[1,0]*g[1,0]+b[0,1]*e[1,1]], axis=0)
