def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (3/2)*np.sin(np.sqrt(3*params[0])*x)**3
    b = -(1/6)*np.sin(np.sqrt(3*params[0])*x)**3*np.sin(np.sqrt(3*params[8])*v)**3
    c = np.cos(np.sqrt(3*params[0])*x)*v + (1/2)*np.sin(np.sqrt(3*params[0])*x)*x*(3*params[1]-3*params[8])*np.sin(np.sqrt(3*params[0])*x)*v + \
    (3/2)*(3*params[2]-3*params[6])*np.sin(np.sqrt(3*params[0])*x)**2*v + \
    (3/2)*(3*params[3]+3*params[9])*np.sin(np.sqrt(3*params[0])*x)*v*(3*params[2]-3*params[4])*np.sin(np.sqrt(3*params[0])*x)*v + \
    (3/2)*np.sin(np.sqrt(3*params[2])*x)*np.sin(np.sqrt(3*params[5])*v)*x*(3*params[4]-3*params[6])*np.sin(np.sqrt(3*params[0])*x)*v
    dv = a + b + c
    return dv
