def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[i]*x**(i+2) for i in range(0, MAX_NPARAMS, 2)])
    b = np.sum([params[i]*v**(i+1)*x for i in range(0, MAX_NPARAMS, 2)])
    c = np.sum([params[i]*v**(i+1)*x for i in range(1, MAX_NPARAMS, 2)])
    d = np.sum([params[i]*x*v*(x+v)**i for i in range(1, MAX_NPARAMS, 2)])
    e = np.sum([params[i]*v*x*np.sin((x+v)**i) for i in range(0, MAX_NPARAMS, 2)])
    f = np.sum([params[i]*x*v*np.cos((x+v)**i) for i in range(1, MAX_NPARAMS, 2)])
    g = np.sum([params[i]*x*v*(x+v)**i*np.exp(-i*params[MAX_NPARAMS-1]) for i in range(0, MAX_NPARAMS, 2)])
    h = a + b + c + d + e + f + g
    return h
