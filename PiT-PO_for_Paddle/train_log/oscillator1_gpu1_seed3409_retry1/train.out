                      np.sin(np.pi*params[5])*v**7)) * \
    (np.cos(2*np.pi*params[1])*x**3 + np.sin(2*np.pi*params[4]))
    b = np.cos(np.pi*params[0])*v*(2*np.sin(3*np.pi/4)*x**3 + np.sin(2*np.pi/2)*v*x) \
    + (np.cos(np.pi*params[3])*x*(2*np.sin(2*np.pi/4)*v + np.sin(2*np.pi*2))) * \
