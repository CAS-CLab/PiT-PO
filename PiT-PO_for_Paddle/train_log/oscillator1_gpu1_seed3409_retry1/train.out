    (params[5] * (x + v)**3 + params[6] * (x**2 + 2*x*v*v + v**4)*x + params[7] * (x + v)**2 + \
    (params[8] * (x**2 + v**2)*x + params[9] * x*v*(x + 3*x*v**2)))
    return a
