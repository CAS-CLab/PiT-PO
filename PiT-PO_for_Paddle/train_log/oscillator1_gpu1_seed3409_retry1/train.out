      np.sin(2*np.pi/4)*x**2 + 
      np.sin(2*np.pi/2)*v*x) * np.cos(3*params[4])
    return \
    b * (a + c) - \
    2*np.sin(np.pi/2)*v*x**2 - \
    2*np.sin(2*np.pi/4)*v*x**3
