    params[1] * (x * v**2) + \
    params[2] * (x**2 * v - x * v**2) + \
    params[3] * (x * v**3) + \
    params[4] * (x**2 + v**2) + \
    params[5] * (x + v) + \
    params[6] * np.sin(2*np.pi*x) + \
    params[7] * np.cos(2*np.pi*v) + \
    params[8] * (x**2 - v**2) + \
    params[9] * (x + v)
    return a
