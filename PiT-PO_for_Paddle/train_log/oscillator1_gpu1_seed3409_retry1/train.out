    g = (x**2 + v**2)*np.sinh((np.sqrt(params[9])*x + np.sqrt(np.sum(params[0:9])*x**2))/np.sqrt(np.sum([val*val for val in params[0:9]])))
    dv = a + b + c + d + e + f + g
    return dv
