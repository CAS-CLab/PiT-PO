def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a1 = np.sin(5*params[0])*v
    b1 = 2*np.sin(np.pi/4)*x
    c1 = np.cos(3*np.pi/4)*v**2
    d1 = 3*np.sin(2*np.pi/4)*x**2
    e1 = 2*np.cos(2*np.pi/2)*v*x
    f1 = np.sin(3*np.pi/4)*x**3
    g1 = np.cos(5*np.pi/4)*v**3
    h1 = 2*np.sin(3*np.pi/2)*v
    i1 = np.cos(2*np.pi/4)*x
    j1 = 2*np.sin(3*np.pi/4)*x*v
    k1 = np.sin(4*np.pi/4)*v**2
    l1 = np.cos(5*np.pi/2)*x**4
    m1 = 2*np.sin(np.pi/6)*v*x**3
    n1 = np.cos(7*np.pi/4)*x**2
    o1 = np.sin(2*np.pi/4)*x*v
    p1 = np.cos(11*np.pi/4)*x**4
    q1 = np.sin(7*np.pi/4)*v*x**2
    r1 = 2*np.sin(2*np.pi/2)*v**2
    s1 = np.cos(13*np.pi/4)*x**2
    t1 = np.sin(2*np.pi/3)*v*x**3
    u1 = np.cos(15*np.pi/4)*x**4
    v1 = np.sin(2*np.pi/3)*x*v
    w1 = np.cos(17*np.pi/4)*v**3
    x1 = 2*np.sin(3*np.pi/2)*v*x**2
    y1 = np.cos(19*np.pi/4)*x**4
    z1 = np.sin(2*np.pi/3)*v*x**2
    return \
    f1*(d1+k1+x1)*r1 - \
    e1*(s1+m1+b1)*w1 - \
    j1*(i1+o1+z1)*v1 - \
    k1*(t1+n1+s1)*u1 - \
    l1*(y1+p1+m1)
