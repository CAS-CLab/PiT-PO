    b = (params[1] + 0.02)*x*v*(x**2 + v**2 + 2*x*v + x**4 + v**4 + 2*x**2*v**2 + x*v**3 + v**3*x**2)*np.exp(-np.sqrt((x**2 + v**2)**2 + (x**4 + v**4)**2)/500)
