      np.sin(2*np.pi/4)*x**2 + 
      np.sin(2*np.pi/2)*v*x) * np.sin(3*params[7])
    return a*(b+c)*(2*np.sin(3*params[4])*x+np.cos(2*params[2])*v**3)
