    a = (params[0] * (x**3 - 3*x)) / (x**5 - 15*x**3 + 45*x)
    b = params[1] * x + params[2] * v
    c = params[3] * (np.exp(params[4]*x) - np.exp(params[5]*v))
    d = params[6]*(x**2) + params[7]*(v**2) + params[8]*x*v
    e = params[9]*np.sin(params[0]*x)
    dv = b + c + d + e
    return dv
