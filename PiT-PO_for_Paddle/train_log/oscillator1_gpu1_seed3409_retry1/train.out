def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[i] * (x**i) for i in range(10)])
    b = np.sum([params[i] * (v**(10-i)) for i in range(10)])
    c = np.sum([np.multiply(np.abs(params[5]), np.sin(np.pi*abs(x))) for _ in range(3)]) + \
    np.sum([np.multiply(np.abs(params[6]), np.cos(np.pi*abs(v))) for _ in range(3)]) + \
    np.sum([np.multiply(np.abs(x), np.log(abs(x))) for _ in range(3)]) + \
    np.sum([np.multiply(np.abs(v), np.log(abs(v))) for _ in range(3)]) + \
    np.sum([np.multiply(np.abs(x-v), np.arcsin((x+v)/(2*np.sqrt(x**2+v**2)))) for _ in range(3)]) + \
    np.sum([np.multiply(np.abs(x+v), np.arccos((x-v)/(2*np.sqrt(x**2+v**2)))) for _ in range(3)]) + \
    np.sum([np.multiply(x, v), np.multiply(-v, x), np.multiply(np.power(x, 2), np.power(v, 2)), np.multiply(np.power(x, 3), np.power(v, 3))])
    return a + b + c
