def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = np.sum([params[i] * (x**(i//2)) for i in range(10)])
    av = np.sum([params[i] * x**(i-1) for i in range(1, 10)]) + np.sum([params[i] * v**(i-1) for i in range(1, 10)])
    a = av - np.sum([params[i] * x**(i-1) for i in range(10)]) - np.sum([params[i] * v**(i-1) for i in range(10)])
    b = np.sum([params[i] * (x**(2*i)) for i in range(5)]) + np.sum([params[i] * x**(2*i+1) for i in range(5)])
    c = np.sum([params[i] * (x**(2*i)) for i in range(5)]) + np.sum([params[i] * v**(2*i) for i in range(5)]) + np.sum([params[i] * x**(2*i+1) for i in range(5)]) + np.sum([params[i] * x*v**(2*i) for i in range(5)]) + np.sum([params[i] * v**(2*i+1) for i in range(5)]) + np.sum([params[i] * v**(4*i) for i in range(2)])
    d = np.sum([params[i] * (x**(2*i+1)) for i in range(5)]) + np.sum([params[i] * x**(2*i) for i in range(5)]) + np.sum([params[i] * v**(2*i) for i in range(5)]) + np.sum([params[i] * x*v**(2*i+1) for i in range(5)]) + np.sum([params[i] * v**(4*i+1) for i in range(2)]) + np.sum([params[i] * v**(4*i) for i in range(2)])
    dv = a + b + c + d
    return dv
