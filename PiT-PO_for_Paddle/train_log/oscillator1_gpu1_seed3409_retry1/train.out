    (x**4 - 12*x**2*v**2 + 6*x*v**4)*params[0]
    + (v**6 - 6*v**4*x**2 + 3*v**2*x**4)*params[1]
    + (x**2 + v**2)**(5/2)*params[2]
    + x**2*params[3] + v**2*params[4]
