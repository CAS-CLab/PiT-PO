def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.pi*params[8])*x**3 + np.sin(np.pi*params[1])*v**3 +
    np.cos(2*np.pi*params[4])*x*v + np.cos(3*np.pi*params[3])*x**2 +
    2*np.sin(np.pi*params[2])*v*x + np.sin(np.pi*params[9])*x*v**3)* \
    np.cos(4*np.pi*params[0])

    b = (2*np.sin(2*np.pi*params[6])*x**2 + np.sin(6*np.pi*params[5])*x*v +
    np.cos(4*np.pi*params[8])*v**3 + np.sin(2*np.pi*params[7])*x*v**3 +
    np.sin(8*np.pi*params[4])*x*v + 2*np.sin(2*np.pi*params[1])*x*v**3)

    c = (np.sin(np.pi*params[8])*x + 2*np.sin(2*np.pi*params[5])*v*x +
    np.sin(np.pi*params[3])*x**3 + np.sin(2*np.pi*params[0])*v*x**3 +
    np.cos(2*np.pi*params[6])*x*v + np.cos(2*np.pi*params[8])*x**3)

    d = (np.sin(4*np.pi*params[4])*x + 3*np.sin(3*np.pi*params[2])*x**3 +
    np.sin(2*np.pi*params[1])*x*v + np.sin(3*np.pi*params[7])*v**3)

    return a*b*c+d*(3*np.sin(np.pi*params[1])+3*np.sin(np.pi*params[9]))
