def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x ** 3 + v ** 3) * np.tanh(np.sqrt(params[0]) * (x - v)) + \
    (np.abs(x - v)) * np.log(params[1]) * (x + v) + \
    (x ** 2 + v ** 2) * (x * v) + \
    (x ** 2 + v ** 2) * np.sinh(np.sqrt(params[2]) * (x + v)) + \
    (x ** 2 + v ** 2) * (x * v) * np.cosh(np.sqrt(params[3]) * (x - v)) + \
    (x ** 3 + v ** 3) * np.tanh(np.sqrt(params[4]) * x) + \
    (x ** 2 + v ** 2) * (x * v) * np.sinh(np.sqrt(params[5]) * v) + \
    (x ** 2 + v ** 2) * (x * v) * np.tan(np.arctan2(v, x) + np.pi/4) + \
    (x ** 2 + v ** 2) * (x * v) * np.sinh(np.sqrt(params[6]) * (x + v)) + \
    (x ** 2 + v ** 2) * (x * v) * np.cosh(np.sqrt(params[7]) * (x + v)) + \
    (x ** 2 + v ** 2) * (x * v) * np.sin(np.arcsinh(x / v) + np.pi/4) + \
    (x ** 2 + v ** 2) * (x * v) * np.sinh(np.sqrt(params[8]) * x) + \
    (x ** 3 + v ** 3) * np.tanh(np.sqrt(params[9]) * v)
    dv = a + b + c + d + e
    return dv
