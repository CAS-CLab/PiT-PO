    0.125*params[6]*x*v*(v**2 - x**2) +
    0.03125*params[4]*x**2*v +
    0.015625*params[1]*x**3*v +
    0.0078125*params[9]*np.sin(2*np.pi*x) + \
    0.00390625*params[9]*x + \
    0.0015625*params[7]*v
    )
    return ax + ay
