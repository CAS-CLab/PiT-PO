def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([np.power(x, i) * np.power(v, j) * np.sin(i*j*np.pi/2) for i in range(10) for j in range(10)])
    b = np.sum([np.power(x, i) * np.power(v, j) * np.cos(j*i*np.pi/2) for i in range(10) for j in range(10)])
    c = np.sum([np.power(x, i) * np.power(v, j) for i in range(10) for j in range(10)]) + np.sum([np.power(np.sin(k*x), m) for k in range(10) for m in range(10)])
    d = np.sum([np.power(x, i) * np.power(v, j) * np.sin(i+j*2*np.pi) for i in range(10) for j in range(10)])
    e = np.sum([np.power(x, i) * np.power(v, j) * np.cos(i-j*2*np.pi) for i in range(10) for j in range(10)])
    f = np.sum([np.power(x, i) * np.power(v, j) * np.sin((i+1)*j*np.pi/2) for i in range(10) for j in range(10)])
    g = np.sum([np.power(x, i) * np.power(v, j) * np.cos((i-1)*j*np.pi/2) for i in range(10) for j in range(10)])
    h = np.sum([np.power(x, i) * np.power(v, j) * np.sin(j*i*np.pi/2) for i in range(10) for j in range(10)])
    dv = a + b + c + d + e + g + h + f + h
    return dv
