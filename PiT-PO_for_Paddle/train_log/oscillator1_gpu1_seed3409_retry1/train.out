def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**2 + 2*v**2)*((x**2 + v**2)*np.sin(np.sqrt(x**2+v**2)*params[0]))
    b = (x*v*(x**2+v**2))*(np.sin(v*2*params[1]) - np.cos(x*2*params[2]))
    c = (x**2 + 2*v**2)*(np.sin(3*np.pi*params[3])*np.cosh(np.sqrt(x**2+v**2)*np.sqrt(2*params[4])))
    d = (x**2 + 4*v**2)*(np.tan(np.sqrt(x**2+v**2)*2*params[5]))
    e = (x**2 + 2*v**2)*(np.sinh(np.sqrt(x**2+v**2)*2*params[6]) - np.cosh(x*2*params[7]))
    f = (x**2 + v**2)*np.sin(np.arcsinh(x/v)*np.sqrt(2*params[8]))
    g = (x*v*(x**2+v**2))**(3/2)*(np.exp(-np.sqrt(x**2+v**2)*np.sqrt(2*params[9])))
    return a + b + c + d + e + f + g
