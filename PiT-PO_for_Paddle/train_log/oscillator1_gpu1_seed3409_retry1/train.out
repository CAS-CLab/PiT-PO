    b = (x**8)*v*(3*params[8]**2-6*np.pi*params[8]*v+3*np.pi**2*params[9])+(x**3)*v*(4*np.pi*params[8]-3*np.pi*params[5])+(x**0)*v*(3*np.pi*params[8]-3*np.pi*params[7])
