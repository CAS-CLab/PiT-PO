    c = (x**2)*(v**3)*np.log(np.abs(x+1))
    d = (x*np.sin(v**2))*(np.sqrt(params[5])+np.sqrt(2*x**2))
    e = (x**4)*(v**2)*(np.tan(params[8]*v)-1)
