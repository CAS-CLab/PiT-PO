    b = (x**6 - 18*x**4*v**2 + 42*x**2*v**4)*v*params[1]**2
    c = (x**5 - 15*x**3*v**2 + 25*x*v**4)*x**2*params[2]**2
    d = (x**4 + x**3 + x**2)*v**2*params[3]**2
    e = (x**5 - 15*x**3*v**2 + 25*x*v**4)*(x**3 - 3*x*v**2)*params[4]**2
    f = (x**2 - 3*x*v**2)*v*params[5]**2
    g = x**2*params[6]**2 + x*v*params[7]**2 + x*v**2*params[8]**2 + x*v**3*params[9]**2
    h = e + f + g
    i = a + b + c + d + h
    return i
