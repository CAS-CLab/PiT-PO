def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (2*np.sin(np.pi*params[8])*x*(np.sin(2*np.pi*params[0])*v**3-np.cos(7*np.pi*0)*x*v))
    b = (np.sin(4*np.pi*1)*x**7)
    c = (np.cos(2*np.pi*5)*x*v*(np.sin(2*np.pi*9)*x-3*np.cos(2*np.pi*3)*x))
    d = (np.sin(np.pi*6)*v*(np.cos(2*np.pi*4)*x-3*np.sin(2*np.pi*7)*v))
    e = (np.sin(2*np.pi*7)*x*(np.sin(8*np.pi*8)*x-np.cos(11*np.pi*5)*v))
    f = (3*np.cos(np.pi*2)*x*(np.sin(2*np.pi*4)*x-5*np.sin(2*np.pi*3)*v))
    g = (2*np.cos(5*np.pi)*x*v*(np.sin(3*np.pi*1)*x-4*np.cos(5*np.pi*8)*v))
    h = (4*np.cos(5*np.pi)*x*v*(np.sin(2*np.pi*4)*x-3*np.cos(2*np.pi*5)*x))
    i = (2*np.sin(3*np.pi*0)*x*(np.cos(7*np.pi*0)*x-4*np.sin(2*np.pi*1)*v))
    return h-i-g-f-e+d-c-b-a
