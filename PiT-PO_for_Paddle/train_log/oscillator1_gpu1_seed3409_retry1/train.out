    params[2] * x**2 * v**3 + params[3] * (x * v**3 - x * v) + \
    params[4] * (x**2 * v**2 + x**2 * v**3) + \
    params[5] * (x * v + x * v**4) + params[6] * x**2 * v + \
    params[7] * (x * v**2 - x * v**4) + params[8] * (x * v**2 + x * v**3)
