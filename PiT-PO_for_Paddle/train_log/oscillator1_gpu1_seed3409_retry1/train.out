    d = 2*np.sin(2*np.pi*params[3])*v*x*np.sin(2*np.pi*params[7])
    e = (2*np.sin(2*np.pi*params[2])*x+3*np.sin(2*np.pi*params[6])*v-4*np.cos(2*np.pi*params[8]))* \
    np.sin(2*np.pi*params[4])
