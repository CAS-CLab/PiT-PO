    b = (x**2 + v**2)*((x**2 + v**2)**2 + (x**4 + 2*x**2*v**2 + v**4)*x*(x**2 + v**2))
    c = (x**2 + v**2)*((x**4 + 2*x**2*v**2 + v**4)*np.sin(np.sqrt(x**2 + v**2)*x) + (x**2 + v**2)**2*np.cos(np.sqrt(x**2 + v**2)*v))
    dv = a + b - c
    return dv
