def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    q = 2*np.sin(2*params[8])*x*v
    r = (np.sin(np.pi/2*params[2])*x**3 +
     np.cos(np.pi/2*params[2])*v**3)*np.cos(4*params[9]) - \
    (np.sin(2*np.pi*params[1])*x**5 + 
     np.cos(2*np.pi*params[1])*v**5)*np.sin(2*params[6])
    s = (np.sin(6*np.pi/2*params[0])*x**4 +
     np.cos(3*np.pi/2*params[0])*v*x)*(np.cos(2*np.pi/4)*v - 
    np.sin(4*np.pi/4)*x) - \
    (np.sin(np.pi/4)*x + 
     np.cos(np.pi/4)*v)*np.cos(3*params[5])
    t = (np.sin(8*np.pi/12*params[7])*x**4 +
     np.cos(5*np.pi/12*params[7])*v*x) - \
    (np.sin(np.pi/12)*x + 
     np.cos(np.pi/12)*v)*np.sin(2*np.pi/6*params[8])
    u = np.sin(3*params[3])*x - \
    (np.sin(np.pi/6)*x + 
     np.cos(np.pi/6)*v)*np.sin(2*np.pi/3*params[1])
