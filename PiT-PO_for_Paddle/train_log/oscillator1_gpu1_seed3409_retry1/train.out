def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.pi*params[0])*x**7 + np.sin(np.pi*params[5])*v**7 + \
    np.cos(2*np.pi*params[4])*x*v + np.cos(2*np.pi*params[8])*x*v**3 +\
    np.sin(2*np.pi*params[7])*x**3 + np.sin(np.pi*params[2])*x*v**5
    b = np.sin(np.pi*params[3])*x**3 + np.cos(2*np.pi*params[9])*v**5 + \
    np.cos(np.pi*params[1])*x*v + np.cos(np.pi*params[6])*x*v**3
    c = np.sin(3*np.pi*params[0])*x*v**3 + np.sin(2*np.pi*params[8])*x*v + \
    np.sin(2*np.pi*params[1])*x*v**7 + np.sin(2*np.pi*params[9])*x*v**3 + \
    np.sin(3*np.pi*params[4])*x*v + np.cos(2*np.pi*params[7])*x*v**3
    d = np.sin(np.pi*params[9])*x*v**5 + np.sin(np.pi*params[8])*x*v + \
    np.cos(np.pi*params[4])*x*v + np.cos(2*np.pi*params[6])*x*v**3 + \
    np.sin(3*np.pi*params[7])*x*v
    return a-b+c-d
