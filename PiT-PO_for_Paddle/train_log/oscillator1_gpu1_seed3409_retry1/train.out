def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*params[0]*np.sqrt(v**2 + (x-0.5*np.pi/2)**2))
    b = np.cos(3*params[1]*x) - np.exp(-(x-1.5*np.pi)**2/(2*params[5]))
    c = np.sum((np.array([1, 2, 3]) * (v**2)) / (x**2 + 2*x*params[4] + 4*np.pi**2))
    d = (x-np.pi/2)**2 * (np.sqrt(v**2) - np.sqrt(np.sum((v-np.pi/2)**2)))
    e = (x-np.pi/2)*np.sqrt(np.sum((v-np.pi/2)**2))*np.tan(2*params[8]*(x-np.pi/2))
    f = np.exp(-(x+0.5*np.pi)**2/(2*params[2]))*np.sin(2*params[0]*np.sqrt(v**2+(x-0.5*np.pi/2)**2))
    g = (np.sin(3*params[1]*x)+np.cos(2*params[2]*(x+0.5*np.pi))) / (x**2 + 2*x*params[4] + 4*np.pi**2)
    h = (x-np.pi/2)*(np.cos(2*params[2]*(x+0.5*np.pi))+np.sin(3*params[1]*(x-np.pi/2)))
    i = (np.sum((v-np.pi/2)**2)/((x+0.5*np.pi)**2 + 2*(x+0.5*np.pi)*np.pi*params[4]+np.pi**2))
    j = (x-np.pi/2)*np.sqrt(np.sum((v-np.pi/2)**2))*np.sin(2*params[8]*(x-np.pi/2))
    dv = (a+b+c+d+e+f-g-h+i+j)
    return dv
