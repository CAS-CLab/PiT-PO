def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(2*np.pi*params[8])*x*(np.sin(2*np.pi*3*params[0])*v**3 - np.cos(np.pi*7*params[2])*x*v))
    b = (np.sin(np.pi*4*params[1])*x**7 + np.sin(3*np.pi*8*params[7])*v*x**2)
    c = (np.cos(2*np.pi*5*params[3])*x*(np.sin(2*np.pi*2*params[0])*x**3 + np.sin(9*np.pi*3*params[0])*x))
    d = (np.sin(np.pi*9*params[4])*v*(np.sin(2*np.pi*6*params[6])*x**3 - np.cos(6*np.pi*8*params[7])*v))
    u = (np.sin(np.pi*8*params[7])*v*(np.sin(8*np.pi*8*params[8])*x - np.cos(5*np.pi*6*params[6])*v))
    w = (np.cos(np.pi*6*8*params[5])*x*v**3 + np.sin(np.pi*5*2*params[1])*x**7 + \
     np.sin(2*np.pi*3*4*params[4])*v*x)
    z = (np.sin(2*np.pi*7*8*params[0])*v*(np.sin(np.pi*5*6*params[6])*x - np.cos(4*np.pi*8*params[9])*x**5))
    return a+b-c+d+u-w*z
