def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum((x**(2*params[0]) + x**(4*params[1])*v**2)/((x**2 + v**2)**(2*params[2]))) + \
    np.sum((x**(2*params[3]) + v**2*(x**2 + v**2)) / ((x**2 + v**2)**(2*params[4]))) + \
    np.sum((x**(2*params[5]) + v**2*(x**2 + v**2)) / ((x**2 + v**2)**(2*params[6]))) + \
    np.sum((x**(2*params[7]) + v**2*(x**2 + v**2)) / ((x**2 + v**2)**(2*params[8]))) + \
    np.sum((x**(2*params[9]) + v**2*(x**2 + v**2)) / ((x**2 + v**2)**(2*params[0])))

    b = np.sum((x**(2*params[1]) + x**2*v**2*np.exp(-2*params[2]*v)) / ((x**2 + v**2)**(2*params[3]))) + \
    np.sum((x**2 + v**2*np.exp(-2*params[4]*x)) / ((x**2 + v**2)**(2*params[5]))) + \
    np.sum((x**2 + v**2*np.exp(-2*params[6]*x)) / ((x**2 + v**2)**(2*params[7]))) + \
    np.sum((x**2 + v**2*np.exp(-2*params[8]*v)) / ((x**2 + v**2)**(2*params[9]))) + \
    np.sum(np.exp(-2*params[0]*v))

    dv = a + b
    return dv
