    c = (x**2*np.sin(np.sqrt(params[6])*x)*np.sin(np.sqrt(np.pi/2*params[7])*x)) / \
    ((1-np.cos(np.sqrt(np.pi/2*params[8])*x))**(params[9]+2))
    dv = a-b-c+c
    return dv
