def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[0]*(x**3 - 3*x*v**2),
            params[1]*(v**4 - v**2*x**2), 
            params[2]*(x**2 + v**2)**(3/2),
            params[3]*x**2 + params[4]*v**2,
            params[5]*np.sin(params[6]*x)])
    b = np.sum([params[7]*np.cos(params[8]*v) +
            np.sin(params[6]*x)*params[9]*v,
            np.cos(params[8]*v)*params[9]*x,
            np.cos(params[8]*v)*params[8]*x,
            np.sin(params[6]*v)*params[7]*x,
            np.cos(params[8]*x)*np.sin(params[6]*v),
            np.sin(np.arctan(params[8])*v)*np.cos(np.arctan(params[8])*x),
            np.cos(np.arctan(params[8])*v)*np.sin(np.arctan(params[8])*x)])
    c = np.sum([params[0]*(x**2 + v**2)**(3/2),
            np.sum([params[1]*x**i*np.cos(i*np.arctan(v/x)), 
                    np.sin(i*np.arctan(v/x))*np.cos(i*np.arctan(v/x))*params[i], 
                    np.sin(i*np.arctan(v/x))*np.sin(i*np.arctan(v/x))*params[6],
                    np.cos(i*np.arctan(v/x))*np.cos(i*np.arctan(v/x))*params[8]]),
            np.sum([params[2]*x**i*np.cos(i*np.arctan(v/x)),
                    np.sin(i*np.arctan(v/x))*np.cos(i*np.arctan(v/x))*params[9],
                    np.sin(i*np.arctan(v/x))*np.sin(i*np.arctan(v/x))*params[7],
                    np.cos(i*np.arctan(v/x))*np.cos(i*np.arctan(v/x))*params[5]])])
    dv = a + b + c
    return dv
