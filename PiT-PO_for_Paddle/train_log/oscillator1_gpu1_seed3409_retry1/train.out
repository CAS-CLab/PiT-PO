    d = (params[5]*v + np.tanh(np.sqrt(params[6]*x))) * x**2 + (params[7]*v + np.arctanh(np.sqrt(v**2))) * v**2
    e = (params[8]*x + np.log(np.sqrt(params[9]*x + np.exp(params[0])))) * np.sin(np.sqrt(params[1]*v**2 + np.pi*params[2]*x))
    f = (np.exp(-(np.abs(np.sqrt(params[3]*x + np.sqrt(params[4]*v**2))))) + np.cosh(np.sqrt(np.abs(params[3]*x + np.sqrt(params[4]*v**2))))) * x * v
    dv = a + b + c + d + e + f
    return dv
