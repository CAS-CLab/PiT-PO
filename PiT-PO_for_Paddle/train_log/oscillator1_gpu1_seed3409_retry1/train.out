def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    e_2 = 0.36*np.sin(9*params[8]*x)
    f_2 = 0.42*np.sin(2*params[3]*x)*np.cos(6*params[1]*v)
    a_2 = 0.23*np.cos(5*params[7]*x)*np.sin(8*params[0]*x)
    c_2 = 0.48*np.cos(4*params[2]*x)*(np.sin(3*params[4])-0.11*np.sin(5*params[1]))
    dv = 0.69*np.sin(6*params[4]*x)*f_2+a_2*(0.87*np.cos(3*params[9]*v)+0.33*np.sin(5*params[5]*x)) \
     -c_2*(0.56*np.sin(8*params[7]*x)-0.21*np.sin(2*params[6]*x))+\
     0.29*np.sin(9*params[8]*x)*(0.46*np.sin(3*params[0])-0.98*np.sin(2*params[7]*x))
    return dv
