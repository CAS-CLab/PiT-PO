    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**2 + v**2)**2
    b = (x**5 - 5*x**3*v**2)/20
    c = (x**7 - 21*x**5*v**2 + 35*x**3*v**4)/420
    d = (x**11 - 77*x**9*v**2 + 231*x**7*v**4 - 35*x**5*v**6)/25200
    e = (x**13 - 143*x**11*v**2 + 735*x**9*v**4 - 1715*x**7*v**6 + 1195*x**5*v**8)/3088800
    f = (x**15 - 1365*x**13*v**2 + 6435*x**11*v**4 - 12075*x**9*v**6 + 8555*x**7*v**8 - 30075*x**5*v**10)/1684309600
    g = (x**17 - 5005*x**15*v**2 + 20425*x**13*v**4 - 27425*x**11*v**6 + 170675*x**9*v**8 - 387175*x**7*v**10 + 2578125*x**5*v**12)/2402375680000
    dv = (a + b + c + d + e + f + g)*x**2 + \
     (b - 7*a + 19*c - 37*d + 5*e - 61*f + 23*g)*x*v**2 + \
     (c - 3*b + 7*d - 11*e + 13*f - 5*g)*v**4 + \
     (d - 3*c + 5*e - 7*f + 3*g)*v**6 + \
     (-2*e + f - 3*g)*v**8 + \
     (e - 2*f + 3*g)*v**10
    return dv
