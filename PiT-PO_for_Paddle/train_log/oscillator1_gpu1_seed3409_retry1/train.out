    e = (x**2 + v**2)**8 * (np.sum([2*x*i*v**(17-i) for i in range(19)])) * (x**4 + v**4) * np.sin(np.pi*params[6]*x) * np.cos(np.pi*params[7]*v)
    f = (x**2 + v**2)**9 * (np.sum([2*x*i*v**(16-i) for i in range(18)])) * (x**4 + v**4) * np.sin(np.pi*params[8]*x) * np.cos(np.pi*params[9]*v)
