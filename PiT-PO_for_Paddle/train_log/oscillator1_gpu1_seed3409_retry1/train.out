    b = np.sum([np.power((x**2+v**2),j)*np.cos(j*params[8]*v) for j in range(1, 11)])
    c = np.sum([np.power((x**2+v**2),k)*(np.sin(k*params[8]*v)+np.cos(k*params[8]*v)) for k in range(1, 11)])
    dv = a + b + c
    return dv
