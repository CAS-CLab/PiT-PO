def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    f_x = np.sin(2*params[8]*v)*np.sin(np.pi/2*params[0]*(x+1))
    g_y = (np.cos(3*params[5]*x)-np.sin(2*params[1]))**3
    h_z = (np.cos(2*params[9]*v)-np.sin(4*params[3]*x))*np.exp(-0.54*params[4]*x)
    i_w = 0.83*(x**2)*(np.cos(6*params[7]*v)+np.sin(3*params[6]))
    a = h_z-i_w
    b = g_y*f_x
    c = 0.36*(np.cos(2*params[2]*x)-np.sin(5*params[0]*v))*(np.sin(2*params[8]*v)-np.cos(3*params[4]*x))
    d = 0.14*(np.cos(3*params[5]*x)+np.sin(2*params[6]))*np.sin(4*params[0]*x)
    e = 0.39*(x**9)*(np.sin(2*params[2]*x)-np.cos(5*params[0]*v))
    return a-b-c-d+e
