     np.sum([x*y*z for y in range(2, 11) for z in range(y+1, 12)]) +
     np.sum([x*y*z for y in range(2, 11) for z in range(y+1, 12)]) +
     np.sum([x*y*z for y in range(1, 11) for z in range(y+1, 12)]) +
     0.5*np.sum([x*y**2 for y in range(1, 11)]) +
     0.25*np.sum([y**2 for y in range(2, 11)]) +
     np.sin(np.pi*x)*np.cos(v))
    ay = (np.sum([x*y*z for y in range(1, 11)]) +
     0.5*np.sum([x*y**2 for y in range(1, 11)]) +
     0.25*np.sum([y**2 for y in range(2, 11)]) +
     np.sum([x*y**3 for y in range(1, 11)]) +
     0.5*np.sum([x*y**2 for y in range(1, 11)]) +
     np.cos(np.pi*x)*np.sin(v))
    return a + ay
