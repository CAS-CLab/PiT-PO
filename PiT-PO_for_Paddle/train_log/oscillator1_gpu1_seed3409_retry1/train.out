def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin((x**2 + v**2)*params[0])
    b = np.cos(v*params[1]) - x*np.sqrt(x**2 + v**2)*np.exp(-params[2]*(x**2 + v**2))
    c = np.tanh((x**2 + v**2)*params[3]) - x*(x**2 + v**2)*np.arctanh(np.exp(-(x**2 + v**2)*params[4]))
    d = np.log(np.cosh((x**2 + v**2)*params[5])) - v*(x**2 + v**2)*np.log(np.sinh((x**2 + v**2)*params[6]))
    e = np.sqrt(np.pi)*np.sin((x**2 + v**2)/2)*np.exp((-1/2)*(x**2 + v**2)*np.cos((x**2 + v**2)*np.pi*params[7]))
    f = np.abs(np.sin(x)*np.sin(v*(x**2 + v**2))*np.exp((x**2 + v**2)*np.tan(params[8])))
    g = np.cos(v*params[9])*np.sqrt(x**2 + v**2)*np.log(np.cosh((x**2 + v**2)*np.pi*params[0]))
    return f*g - (c*e + d*f + b*a)
