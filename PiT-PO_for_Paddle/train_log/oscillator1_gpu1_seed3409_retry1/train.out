    a = (params[6]*x + 2*params[9]*x*v +
     3*params[0]*(x**2*v - v*(x**2*v)) -
     4*params[5]*x*v**2)
    b = (2*params[1]*x*v - 3*params[2]*x**2*v +
     4*params[4]*x*v**2 - 3*params[8]*v**3)
    c = (3*params[3]*x**2 - 6*params[0]*x*v**2 +
     2*params[7]*x*v**3 + 9*params[9]*x*v**2)
    d = (6*params[5]*x*v**2 - 12*params[1]*x**2*v +
     8*params[8]*x**2*v**2 - 3*params[2]*v**3)
    e = (3*params[4]*x*v**2 - 6*params[8]*x*v**3 +
     2*params[7]*x**2*v + 18*params[9]*x**2*v**2)
    f = (2*params[7]*x*v**2 - 4*params[6]*x**2*v**2 +
