    (3*params[0]*(x**2 - v**2) + 2*params[1]*(x + 2*v)) + \
    (params[2]*(x + 5*v)*v) + (params[3]*(x + v)*(x-v)**2) + \
    (5*params[4]*((x - v)**2) + 3*params[5]*((x + 2*v)**2)) + \
    (np.sqrt(params[6])*(x**2 + 2*x*v*v + v**4)) + \
    (np.exp(-np.log(params[7])*(x + v))) + \
    (3*params[8]*(x + 2*v)*v) + (np.log(np.pi + np.tan(np.pi/4*(x + 2*v))))* \
    ((x + v)*(x**2 + 2*x*v*v + v**4))
