    a = (x**4)*(v**3)*np.cos(v*x) + \
    (v**3)*(x**2)*np.sin(v*x) + \
    (x**2)*(v**2)*np.sin(v*x) + \
    (x**2)*(v**3)*np.cos(v*x) + \
    (x**(3/2))*(v**3)*np.cos(v*x) + \
    (x**(5/2))*np.sin(v*x) + \
    (x**(7/2))*(v**2)*np.cos(v*x) + \
