    b = (x**(3/2))*(v**(5/2))*np.sqrt(np.pi)+ \
    ((x**(1/2))*v**(3/2))*((x**2)/(x+1))+(x*(v**2)/x)*(np.log(v+x))/np.exp(
        (x-1)/(x+1))
    c = (x*np.sin(v))/(np.cos(x))-(np.cos(v)*x)/(np.sin(x+v))
    dv = a+b+c
    return dv
