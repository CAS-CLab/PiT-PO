def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (v**2 * (np.sin(2*np.pi*params[0]*x)**2 + np.sin(4*np.pi*params[0]*x)**2) +
    v * (np.sin(np.pi*params[1]*x)*np.cos(np.pi*params[2]*x) + np.sin(2*np.pi*params[3]*x)*np.sin(2*np.pi*params[4]*x))) * x + \
    (x**2 * (np.cos(np.pi*params[5]*x)*np.sin(np.pi*params[6]*x) + np.sin(2*np.pi*params[7]*x)*np.sin(2*np.pi*params[8]*x)))
    ay = (x**2 * (np.sin(2*np.pi*params[0]*x)**2 + np.sin(4*np.pi*params[0]*x)**2) +
    x * (np.sin(np.pi*params[1]*x)*np.cos(np.pi*params[2]*x) + np.sin(2*np.pi*params[3]*x)*np.sin(2*np.pi*params[4]*x))) * v + \
    (v**2 * (np.cos(np.pi*params[5]*x)*np.sin(np.pi*params[6]*x) + np.sin(2*np.pi*params[7]*x)*np.sin(2*np.pi*params[8]*x)))
    a = ax + ay
    return a
