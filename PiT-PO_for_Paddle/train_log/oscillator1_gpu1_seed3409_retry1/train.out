     2*(np.sqrt(params[7])*x)*np.exp(-(np.sqrt(params[9])+np.sqrt(params[0])*x)**2)/np.sqrt(np.pi))
    b = (2*(np.sqrt(params[0])*v)**3*np.cos(2*np.sqrt(params[0])*x)-
