                               3*np.sin(2*np.pi*params[1])*v**3)
    d = (np.cos(np.pi*params[9])*x**5 + 3*np.sin(np.pi*params[8])*v**3 *
     np.cos(np.pi*params[7]) - 2*np.sin(2*np.pi*params[5])*x*v)
    return d
