def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 6*params[1]*v*np.sinh(params[8]*x)**3 + \
    18*params[4]*x*np.cosh(params[7]*v) - \
    24*params[5]*(x**2 + v**2)*np.sinh(params[8]*x)*np.cosh(params[7]*v) + \
    12*params[9]*np.sinh(params[8]*x)*np.tanh(params[8]*x) + \
    6*params[0]*v*(x**3 - 3*x*v**2)*np.sinh(params[8]*x)**2 + \
    4*params[3]*v*(x**2 + v**2)**2*np.sinh(params[8]*x)*np.sinh(params[8]*x) + \
    4*params[8]*x*(x**2 + v**2)*np.sinh(params[8]*x)*np.cosh(params[7]*v) + \
    4*params[6]*x*v*np.sinh(params[8]*x)*np.sinh(params[8]*x) + \
    12*params[2]*v*(x**2 + v**2)**2*np.sinh(params[8]*x)*np.sinh(params[8]*x) + \
    4*params[8]*v*(x**2 + v**2)*np.cosh(params[7]*v)*np.sinh(params[8]*x)
    return a
