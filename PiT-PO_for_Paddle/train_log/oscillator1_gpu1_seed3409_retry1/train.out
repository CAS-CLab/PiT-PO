def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    w = np.sin(2*np.pi*params[4])*v**7 + \
    np.sin(np.pi*params[2])*x*v + np.cos(2*np.pi*params[9])*x**5 +\
    np.cos(2*np.pi*params[6])*v*x - np.sin(np.pi*params[5])*x*v**3
    u = np.sin(2*np.pi*params[0])*x**7 + \
    np.sin(2*np.pi*params[7])*v*x + np.cos(np.pi*params[8])*x*v +\
    np.cos(2*np.pi*params[3])*v*x + np.cos(np.pi*params[9])*v**5
    y = np.sin(np.pi*params[1])*x**5 + \
    np.cos(np.pi*params[8])*x*v + np.cos(np.pi*params[4])*x*v +\
    np.cos(2*np.pi*params[5])*v**3 + np.sin(2*np.pi*params[8])*x**7
    a = y-u+w
    return a
