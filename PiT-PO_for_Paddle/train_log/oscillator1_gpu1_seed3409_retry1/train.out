def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(7*params[0])*x**5 + \
    np.sin(5*params[8])*x + \
    2*np.cos(6*params[1])*v*np.sin(3*params[4])*x + \
    np.cos(9*params[7])*v**3 + \
    np.cos(4*params[2])*x + \
    2*np.sin(2*params[9])*v + \
    np.cos(8*params[5])*x**3 + \
    2*np.sin(9*params[8])*x**5 + \
    2*np.cos(6*params[6])*x + \
    np.sin(5*params[0])*v**5 + \
    np.sin(3*params[4])*x**3
    dv = a + \
    (np.cos(7*params[3])*v + \
     np.sin(9*params[8])*x + \
     np.cos(5*params[7])*v**3 + \
     2*np.cos(6*params[2])*v + \
     np.sin(3*params[4])*x**5 + \
     2*np.sin(4*params[2])*x + \
     2*np.sin(8*params[3])*x + \
     np.sin(2*params[6])*v + \
     2*np.cos(7*params[1])*x + \
     np.cos(5*params[3])*v**5 + \
     np.sin(8*params[6])*x + \
     2*np.sin(6*params[9])*v + \
     np.sin(5*params[0])*x**3)
    return dv
