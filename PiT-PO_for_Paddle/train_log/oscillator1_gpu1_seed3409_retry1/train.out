    g_2 = -0.53*np.cos(2*params[3]*v)+(0.58-0.17*params[0])*np.sin(7*x)
    h_2 = 0.83*(x**12)-(0.49-0.45*params[6])*np.cos(3*params[4]*x)
    i_2 = (0.99-0.25*params[8])*v*np.sin(4*params[0]+2*params[7]*x)
