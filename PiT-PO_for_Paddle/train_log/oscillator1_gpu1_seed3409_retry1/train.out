def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    f = (x**3 + v**2*(x**2 - 3*x*v**2)) / (x**2 + v**2)**(3/2)
    g = x*v*(v**2*x + x**2 - 2*x*v**2)
    h = x**2*(v**2*x + x**2 - 2*x*v**2)
    i = v*(x**2 + 2*x*v**2)
    j = x*(v**4 - v**2*x**2 + v**2*x**2)
    k = x*v*(v**2*x + x**2)
    l = x*v*(v**2*x + x**2)
    m = x*v*(v**2*x + x**2)
    n = x*v*(v**2*x + x**2)
    o = x*v*(v**2*x + x**2)
    p = (x*v*(v**2*x + x**2)) / (x**2 + v**2)**(3/2)
    q = (x**3 + v**2*(x**2 - 3*x*v**2)) / (x**2 + v**2)**(3/2)
    r = x**3 + v**2*(x**2 - 3*x*v**2)
    s = x**3 + v**2*(x**2 - 3*x*v**2)
    t = x**3 + v**2*(x**2 - 3*x*v**2)
    u = x**2 + 2*x*v**2
    v = x**2 + 2*x*v**2
    w = x**2 + 2*x*v**2
    x_ = (x**2 + 2*x*v**2) * (x**2 + 2*x*v**2)
    y = (x**2 + 2*x*v**2) * (x**2 + 2*x*v**2)
    z = (x**2 + 2*x*v**2) * (x**2 + 2*x*v**2)
    a = (x**3 + v**2*(x**2 - 3*x*v**2)) / (x**2 + v**2)**(3/2)
    dv = r + s + t + q + p
    return dv
