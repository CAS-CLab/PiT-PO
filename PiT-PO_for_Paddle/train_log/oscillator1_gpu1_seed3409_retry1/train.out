def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (params[0] * x**3 +
      params[1] * x**2 * v + 
      params[2] * x * v**2 + 
      params[3] * x**4 + 
      0.5*params[4]*x**2*v**2 + 
      0.5*params[5]*x*v**3 + 
      0.25*params[6]*x**2*v**2 + 
      0.0625*params[7]*x*v**4 + 
      0.015625*params[8]*x**3*v + 
      0.003906*params[9]*x**2*v**2)
    ay = (0.5*params[0]*x**2*v**2 +
      0.5*params[1]*x*v**3 + 
      0.25*params[2]*x*v**2 + 
      0.125*params[3]*x**4 + 
      0.03125*params[4]*x**2*v**3 + 
      0.0078125*params[5]*x*v**4 + 
      0.001953125*params[6]*x**2*v**3 + 
      0.0009765625*params[7]*x*v**4 + 
      0.000244140625*params[8]*x**3*v**2 + 
      0.000060546875*params[9]*x**2*v**3)
    a = ax + ay
    b = (params[8]*x +
     0.5*params[9]*v + 
     0.25*np.sin(4*params[0]*x))
    c = (0.5*x +
     0.25*params[6]*v + 
     0.0625*np.cos(8*params[1]*v))
    d = (0.0625*x +
     0.015625*v + 
     0.003906*np.sin(16*params[2]*x))
    dv = a + b + c + d
    return dv
