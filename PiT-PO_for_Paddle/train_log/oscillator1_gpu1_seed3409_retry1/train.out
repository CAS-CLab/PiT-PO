def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (np.sin(np.pi*params[0]*x)*np.cos(np.pi*params[1]*x) +
     np.sin(2*np.pi*params[2]*x)*np.sin(2*np.pi*params[3]*x) *
     ((x + v)**2 + (x - v)**2)) + \
     (np.cos(np.pi*params[4]*x)*np.sin(np.pi*params[5]*x) + 
      np.sin(2*np.pi*params[6]*x)*np.sin(2*np.pi*params[7]*x) *
      (x**2 + v**2)) + \
     (np.sin(np.pi*params[8]*x)*np.cos(np.pi*params[9]*x) + 
      np.sin(2*np.pi*params[0]*x)*np.sin(2*np.pi*params[1]*x) *
      (x**4 + 2*x**2*v**2 + v**4))
    ay = (np.sin(np.pi*params[0]*x)*np.cos(np.pi*params[1]*x) +
     np.sin(2*np.pi*params[2]*x)*np.sin(2*np.pi*params[3]*x) *
     (x + v)*(x - v)) + \
     (np.cos(np.pi*params[4]*x)*np.sin(np.pi*params[5]*x) + 
      np.sin(2*np.pi*params[6]*x)*np.sin(2*np.pi*params[7]*x) *
      (x + v)*(x**2 + v**2)) + \
     (np.sin(np.pi*params[8]*x)*np.cos(np.pi*params[9]*x) + 
      np.sin(2*np.pi*params[0]*x)*np.sin(2*np.pi*params[1]*x) *
      (x - v)*(x**2 + v**2))
    a = ax + ay
    return a
