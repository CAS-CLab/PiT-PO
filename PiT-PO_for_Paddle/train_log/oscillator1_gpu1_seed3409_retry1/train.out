    6*np.sin(3*params[9])*x*np.cos(2*params[1])*v**3 + \
    12*np.cos(2*params[1])*x**3*np.sin(4*params[8]) + \
    24*np.sin(2*params[5])*x*v**3*np.cos(3*params[0])

    b = 36*np.cos(5*params[1])*x**5*np.sin(3*params[8]) + \
