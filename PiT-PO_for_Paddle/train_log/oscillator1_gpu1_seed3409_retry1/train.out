def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum([params[0]*(x**(i+2)) - 3*params[0]*x*v*(x**(i-1))
           for i in range(3)])
    b = np.sum([np.sign(v)*params[1]*x*np.abs(v)**(i+1)
            for i in range(3)])
    c = np.sum([params[2]*x**(i+2) - 2*params[2]*x*v*(x**(i+1))
             for i in range(3)])
    d = np.sum([np.sign(v)*np.abs(v)**(i+2) - 2*np.sign(v)*x*np.abs(v)**(i+1)
              for i in range(3)])
    e = np.sum([np.sum([params[i]*x**(j+i)
                     for j in range(i)]) 
            for i in range(4)])
    f = np.sum([np.sum([params[j]*v**(k-j)
                     for k in range(j)]) 
            for j in range(4)])
    g = np.sum([x**3*(v**2) + np.sum([params[i]*x**(j-i+3)
                                    for i in range(j)]) 
               for j in range(4)])
    h = np.sum([v**3*(x**2) + np.sum([params[i]*v**(j-i+3)
                                   for i in range(j)]) 
              for j in range(4)])
    return a + b + c + d + e + f + g + h
