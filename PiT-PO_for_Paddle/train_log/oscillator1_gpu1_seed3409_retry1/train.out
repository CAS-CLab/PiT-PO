def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = (params[0]*x**3 +
      (params[1]+params[5])*x*v + 
      (params[2]+params[7])*v**2 +
      (params[3]+params[4])*x*v**2 +
      (params[6]+params[9])*x*v)

    ay = ((params[0]+params[4])*x**2*v**2 +
      (params[1]+params[8])*x*v**3 + 
      (params[2]+params[7])*v**2 +
      (params[3]+params[6])*x*v**3 + 
      (params[4]+params[9])*x*v**2 +
      (params[5]+params[8])*x*v)

    a = ax + ay
    b = (params[6]-params[5])*np.sin(np.sqrt((params[0]+params[4])*x**2+(params[1]+params[8])*x*v+(params[2]+params[7])*v**2))
    c = (params[7]-params[6])*np.cos(np.sqrt((params[0]+params[4])*x**2+(params[1]+params[8])*x*v+(params[2]+params[7])*v**2))
    d = (params[8]-params[7])*x + (params[9]-params[8])*v
    dv = a + b + c + d
    return dv
