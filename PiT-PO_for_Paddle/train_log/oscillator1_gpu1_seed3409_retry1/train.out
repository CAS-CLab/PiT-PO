def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = (x**2+v**2)*np.sin(v*params[5]*x)/((x**2+v**2)**(1-1/2*params[1]*v))
    f = (x**2+v**2)**2*params[1]*v*np.cos(params[6]*x)
    g = -2*x*params[8]*v*np.sin(v*params[8]*x)
    k = x**2*params[0]*v*np.cos(v*params[2]*x)
    l = (x**2+v**2)*v*np.sin(v*2*params[7]*x)
    m = x*params[9]*v**2*np.cos(v*2*params[8]*x)
    n = x*params[9]*v*np.cos(v*2*params[7]*x)
    p = -x*np.sin(v*2*params[4]*x)
    o = -x*v*np.sin(v*2*params[6]*x)
    q = x*v*np.sin(v*2*params[7]*x)
    r = x*v*np.sin(v*2*params[8]*x)
    s = x*v**2*np.cos(v*2*params[8]*x)
    t = -x*v**2*np.cos(v*2*params[8]*x)
    u = x**2*np.sin(v*2*params[8]*x)
    dv = h+f-g+k+l+m+n+p+o+q+r+s+t-u
    return dv
