    c = (np.sin(np.pi*params[6]*x)-x*np.cos(np.pi*params[6]*x))*np.exp(-(np.sqrt(1+64*params[3]*x**2)-np.sqrt(1+64*params[9]*v**2))/8) +\
    (np.cos(np.pi*params[4]*x)-v**2*np.sin(np.pi*params[4]*x))*(np.sqrt(1+64*params[3]*x**2)+np.sqrt(1+64*params[9]*v**2))

    dv = a + b + c
    return dv
