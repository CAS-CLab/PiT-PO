    b = (3*params[2]*x - 3*params[8]*x**2) / x
    c = (3*params[3]*x - 3*params[6]*x**2 - 3*params[7]*v**2) / x
    d = (3*params[1]*v**2 - 3*params[4]*x*v) / v
    e = (3*params[0]*v**2 - 3*params[1]*x*v) / v
    f = (3*params[2]*x - 3*params[8]*x**2) / v
    dv = e + f
    return dv
