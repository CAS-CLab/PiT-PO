    j = (3*2*params[8]*x*(v**2)+2*3*params[6]*x*(v**2))
    k = (3*2*3*params[4]*x*(v**2)+2*3*3*params[7]*x*(v**2))
    return (a+b+c+d+e+f+g+h+i+j+k)
