def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 3*np.sum([3*params[i]*x**(i+2) for i in range(8)]) + \
    3*np.sum([3*(x*v)**(i+1) for i in range(7)])
    b = 3*np.sum([3*params[i]*(x*v)**(i+1) for i in range(7)]) + \
    3*np.sum([3*(x*v)**(i+2) for i in range(6)]) + \
    3*np.sum([3*(x*v)**(i+3)*x for i in range(5)]) + \
    3*np.sum([3*(x*v)**(i+3)*v for i in range(4)]) + \
    3*np.sum([3*(x*v)**(i+4)*x for i in range(3)]) + \
    3*np.sum([3*(x*v)**(i+4)*v for i in range(2)]) + \
    3*np.sum([3*(x*v)**(i+5)*x for i in range(1)]) + \
    3*np.sum([3*(x*v)**(i+5)*v for i in range(0)]) + \
    np.sum([3*params[-2]*x**2 + 3*params[-1]*x*v])
    return a+b
