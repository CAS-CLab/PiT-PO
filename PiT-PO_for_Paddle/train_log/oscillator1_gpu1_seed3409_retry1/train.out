def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    y1 = 0.125*np.sin(3*np.pi*params[0])*v*(np.sin(np.pi*params[4])*x-0.75*np.cos(2*np.pi*params[3])*v)
    y2 = (0.0625*np.sin(2*np.pi*params[6])*x**3+0.03125*np.sin(np.pi*params[8])*v**3)*np.cos(np.pi*params[1])
    a = y1+y2+(0.25*np.sin(np.pi*params[2])*x**5-0.0625*np.cos(np.pi*params[9])*v**5)
    b = (0.0625*np.sin(3*np.pi/2*params[7])*x**3+0.03125*np.sin(2*np.pi*params[1])*v**3)*np.cos(np.pi*params[4])
    c = (0.125*np.sin(np.pi*params[5])*x*(np.sin(np.pi*params[2])*x+0.75*np.cos(2*np.pi*params[8])*v))
    return 0.03125*b-a-c+0.0625*y1
