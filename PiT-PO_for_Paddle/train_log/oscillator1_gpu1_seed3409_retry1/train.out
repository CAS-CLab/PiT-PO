    e_v = (v**7 - np.cos(params[7]*v)**7)/params[1]
    a = e_x + e_v + (x**3 - np.sin(params[6]*x)**3)*(v**3 - np.cos(params[7]*v)**3)
    b = np.sqrt((x**5 - np.sin(params[6]*x)**5)**2 + (v**5 - np.cos(params[7]*v)**5)**2)
    c = np.exp(-((x**3 - np.sin(params[6]*x)**3)**2 + (v**3 - np.cos(params[7]*v)**3)**2)/2*b**2)
    d = np.exp(-((x**3 - np.sin(params[6]*x)**3)**2 + (v**3 - np.cos(params[7]*v)**3)**2)/2*(b**2 + c**2))
