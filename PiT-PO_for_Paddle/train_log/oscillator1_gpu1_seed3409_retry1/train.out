    b = params[1] * (v**3 - 3*x*(v**2)*x)
    c = (params[2] + 2*params[3] +
     2*params[4]*x + 2*params[5]*v + 
     2*params[6]*x*v + 2*params[7]*(x*v)**2 +
     2*params[8]*(x*v)**3)
    dv = a + b + c
    return dv
