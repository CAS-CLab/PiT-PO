    d = (-2*np.sqrt(np.pi)*((np.sqrt(params[0])*v)**3*np.exp(-(np.sqrt(params[9]+np.sqrt(params[0])*x)))-
                        (np.sqrt(np.pi)*np.sqrt(params[2])*x)**3*np.exp(-np.sqrt(np[8])*v)))
    return a + b + c + d
