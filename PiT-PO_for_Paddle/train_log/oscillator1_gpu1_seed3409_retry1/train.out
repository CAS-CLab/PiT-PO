def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    l = np.sum((np.arange(0, 10)*params[0] +
            np.arange(1, 11)*np.arange(0, 10)**2*params[1] +
            np.arange(0, 11)**3*np.arange(1, 12)*np.arange(0, 10)**2*params[2])*(x+np.arange(0, 11)*v))
    m = np.sum(np.arange(1, 11)*(np.arange(0, 10)+np.arange(0, 11))**2*params[3])
    n = np.sum(np.arange(0, 10)*np.arange(1, 11)**2*np.arange(2, 12)*np.arange(0, 10)**2*params[4])
    o = np.sum(np.arange(0, 11)*np.arange(1, 12)**2*np.arange(3, 13)*np.arange(0, 10)**2*params[5])
    p = np.sum(np.arange(0, 11)**3*np.arange(2, 12)**2*np.arange(4, 14)*np.arange(0, 10)**2*params[6])
    q = np.sum(np.arange(0, 10)*np.arange(1, 12)**3*np.arange(3, 13)**2*np.arange(0, 10)**2*params[7])
    r = np.sum(np.arange(0, 11)*np.arange(1, 12)**3*np.arange(4, 14)**2*np.arange(0, 10)**2*params[8])
    s = np.sum(np.arange(0, 11)**4*np.arange(2, 12)**3*np.arange(5, 15)*np.arange(0, 10)**2*params[9])
    return l + m + n + o + p + q + r + s + (np.sum(params[:5])*x + np.sum(params[6:]))*v
