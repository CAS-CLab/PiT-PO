def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    y2 = (8*params[7]*x + 2*np.sin(3*np.pi*params[1])*x**5)*(np.sin(4*np.pi*params[8])*v + 5*np.cos(2*np.pi*params[0])*x)
    a = 2*np.sin(3*np.pi*params[5])*v*(np.cos(2*np.pi*params[9])*x + 5*np.sin(2*np.pi*params[8])*v)
    b = np.sin(2*np.pi*params[2])*x*(np.sin(2*np.pi*params[1])*x**3 + 6*np.sin(np.pi*params[0])*x*v)
    c = 4*np.sin(2*np.pi*params[8])*x*(np.sin(3*np.pi*params[3])*x + 3*np.cos(2*np.pi*params[6])*v)
    d = (np.sin(4*np.pi*params[8])*v - np.cos(2*np.pi*params[0]))**2
    dv = a + b - 2*c - d
    return dv
