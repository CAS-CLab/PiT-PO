    b = params[2] * np.tanh(np.sqrt(params[3])*(x**2 + v**2))
    c = np.sin(params[4]*x)*(x*v + np.cos(params[5]*x))
    d = np.sinh(params[6]*v)*(x + np.cosh(params[7]*x))
    e = np.sin(params[8]*v)
    f = x**2 * v**2 * np.sinh(params[9]*v)
    return f + c - e + d - b*a
