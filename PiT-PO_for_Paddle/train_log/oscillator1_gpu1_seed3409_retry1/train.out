def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sum((x - np.pi/2) * (v - np.sqrt(1-(x - np.pi/2)**2)) * (np.exp(-(x - np.pi/2)**2) + np.exp(-(x - np.pi/2)*np.sqrt(1-(x - np.pi/2)**2))))
    a = u * (x**2 + v**2) + np.sum(np.sin(np.radians(u))*x*np.cos(np.radians(u))) + np.sum(v*(np.cos(np.radians(u))*(x**2 + v**2) - np.sin(np.radians(u))*x))
    b = np.sum(x**4*(np.exp(-(x - np.pi/2)**2) + np.exp(-(x - np.pi/2)*np.sqrt(1-(x - np.pi/2)**2)))) + 3*np.sum(x**2*v*(np.exp(-(x - np.pi/2)*np.sqrt(1-(x - np.pi/2)**2))))
    c = np.sum(np.sin(np.radians(u))*np.cos(np.radians(u))*(x**2 + v**2)**3) + np.sum(np.sin(np.radians(u))*np.cos(np.radians(u))*v*(x**2 + v**2)**2) + np.sum(v**4*(np.cos(np.radians(u))*(x**2 + v**2) - np.sin(np.radians(u))*x))
    dv = a + b + c
    return dv
