    b = (np.sum([2*x*i*v**(11-i) for i in range(13)])) * (x**6 + v**6) * np.sin(np.pi*params[2]*x) * np.cos(np.pi*params[3]*v)
    c = (np.sum([x**i*v**(14-i) for i in range(15)])) * (x**8 + v**8) * np.sin(np.pi*params[4]*x) * np.cos(np.pi*params[5]*v)
