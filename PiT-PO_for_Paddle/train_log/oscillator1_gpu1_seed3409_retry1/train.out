    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (3*np.pi/2)*np.sin(np.sqrt((x**2 + v**2)*(x**4 - v**4)))
    b = (2*np.pi/3)*(x**2 + v**2)**(3/2)*np.cos(v*(2*x - v))
    c = (3*np.pi/4)*np.sin(np.sqrt((x**2 + v**2)*((2*x - v)**2)))
    d = (1/2)*np.sin(np.sqrt((x**2 + v**2))*np.sqrt((x**2 + v**2)*(3*x**2 - v**2)))
    e = (1/3)*np.sin(np.sqrt((x**2 + v**2))*(x**2 + v**2))
    f = (1/2)*np.sin(np.sqrt((x**2 + v**2))*(2*x - v))
    g = (3/4)*np.sin(np.sqrt((x**2 + v**2))*(2*x - v))
    h = (1/2)*np.sin(np.sqrt((x**2 + v**2))*np.sqrt((x**2 + v**2)*(3*x**2 - v**2)))
    i = (1/4)*np.sin(np.sqrt((x**2 + v**2))*(2*x - v))
    dv = (3*np.pi/4)*a + (2*np.pi/3)*b + (1/2)*c + (1/2)*d + (1/3)*e + (1/2)*f + (3/4)*g + (1/2)*h + (1/4)*i
    return dv
