def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(params[1])*x)*np.cos(np.sqrt(2*params[9])*v)
    b = 0.75*np.exp(-(x/np.sqrt(8*params[3])))
    c = 0.5*(x+np.sqrt(3)/3*np.sqrt(2*params[8])*v)**2
    d = 2*np.sqrt(2*params[8])*x*np.sqrt(3)*(np.cos(2*np.pi*params[4]*x)-np.cos(np.pi*np.sqrt(2*params[0])*v))
    e = np.exp(-np.sqrt(2*params[2])*x)*np.cos(np.pi*np.sqrt(2*params[5])*v)
    f = 0.25*params[7]*(x-np.sqrt(2*params[6])*v)**2*np.sqrt(2*params[8])
    g = 0.5*np.sqrt(2*params[0])*x*np.sqrt(2*params[8])*(np.cos(np.sqrt(2*params[0])*x)-np.cos(np.pi*np.sqrt(2*params[4])*v))
    h = 0.5*(np.cos(np.pi*np.sqrt(2*params[5])*v)+np.cos(2*np.pi*np.sqrt(2*params[9])*x))*(2*np.sqrt(2*params[8])*x-3*np.sqrt(2*params[1])*v)
    return h + f + e - d - g - b - c-a
