    (2*params[0]-3*params[1])*np.sin(np.sqrt(2*(x**2+v**2))) + 
    (2*params[3]-3*params[2])*x*np.cos(np.sqrt(2*(x**2+v**2)))
    )

    b = (
    (2*params[4]-3*params[5])*(
        np.sin(x)*np.sin(x)*x + 
