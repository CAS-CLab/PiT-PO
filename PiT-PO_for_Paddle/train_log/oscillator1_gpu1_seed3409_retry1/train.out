def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(3*np.pi*params[0]*x+2*np.pi*params[8]*v)
    w = np.cos(np.pi*params[1]*x-2*np.pi*params[5]*v**2)
    z = (np.sqrt(params[7]*x**2+np.sqrt(16*params[9]*v**2)))**(3/2)
    y = np.sin(np.pi*params[2]*(x-v))/(np.sqrt(np.pi*params[3]*x**2+np.pi*params[4]*v**2))
    b = u*z*w*y
    c = np.cos(2*np.pi*params[6]*x)+w
    d = w*(2*np.sqrt(np.pi*params[8]*x**2)-2*np.sqrt(np.pi*params[0]*v**2))
    e = np.sqrt(np.pi*params[1]*x**2+np.pi*params[9]*v**2)/(np.sqrt(np.pi*params[7]*x**2+np.sqrt(16*params[8]*v**2)))
    f = w*u*(x-v)**2/(np.sqrt(16*np.pi*params[8]*v**2))
    g = z*(w*(2*np.pi*params[2]*x+2*np.pi*params[5]*v**2))-(w**3)*(x-v)**2/(np.sqrt(16*np.pi*params[8]*v**2))
    return g+f+d*e+w*c+b
