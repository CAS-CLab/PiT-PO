def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    e = np.sin(2*np.pi*4*params[0])*v + \
    np.sin(5*np.pi*9)*x**7 + 5*np.sin(np.pi*6)*x*v + \
    3*np.cos(np.pi*8)*(x*v) + 2*np.sin(3*np.pi*2)*x**3
    f = np.cos(2*np.pi*8)*x*v + 2*np.cos(np.pi*5)*v**7 + \
    np.sin(5*np.pi*7)*x + 3*np.sin(2*np.pi*1)*v*x + \
    np.sin(2*np.pi*9)*v + np.sin(np.pi*0)*x*v
    g = np.sin(5*np.pi*8)*x**5 + 2*np.sin(2*np.pi*6)*v*x + \
    np.cos(5*np.pi*4)*x**7 + 3*np.sin(2*np.pi*8)*v**3
    h = np.sin(3*np.pi*1)*x**3 + np.sin(2*np.pi*0)*x*v + \
    3*np.sin(5*np.pi*8)*x + np.sin(2*np.pi*9)*x*v + \
    np.sin(np.pi*1)*v*x
    return e+f+g-h
