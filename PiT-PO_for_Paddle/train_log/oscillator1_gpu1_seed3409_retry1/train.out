    (v * (x ** 4 + 4 * x ** 2 * (v ** 2 + 1)) / (x ** 6 + 6 * x ** 2 * (v ** 2 + 1))) + \
    (x * (v ** 4 + 2 * (v ** 2 + 1) * x) / (x ** 4 + 4 * x ** 2 * (v ** 2 + 1)))

    return a + b
