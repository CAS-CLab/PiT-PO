    b = np.sin(3*np.pi*params[5])*x**2*(2*np.sin(2*np.pi*params[9]))
    c = np.cos(2*np.pi*params[1])*v*(2*np.sin(3*np.pi*params[2]))
    d = 2*np.sin(2*np.pi*params[1])*v*(3*np.sin(2*np.pi*params[6]))
