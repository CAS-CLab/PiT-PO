    (np.sin(9*params[0])*x*v**3 +
     2*np.sin(7*np.pi/4)*x**3 +
     2*np.sin(2*np.pi*4)*v*x)

    z = \
    2*np.sin(np.pi*params[4])*x*v**3 + \
    2*np.sin(np.pi*params[6])*v*x

    a = \
