    a = (np.sum(np.concatenate([[(i+2)*(j+1)] for i in range(4) for j in range(3)])*x[:,None]**4))
    b = (np.sum(np.concatenate([[-1]*k for k in range(2)]))*x) + (np.sum(np.concatenate([[-2]*l for l in range(2)]))*v) + \
     (np.sum(np.concatenate([[m]*2 for m in range(2)]))*x**2) + (np.sum(np.concatenate([[n]*3 for n in range(3)]))*v**2) + \
     (np.sum(np.concatenate([[o]*2 for o in range(2)]))*x*v) + (np.sum(np.concatenate([[p]*5 for p in range(5)]))*x*v**3) + \
     (np.sum([(q+1)*(r+2)]*x[:,None]**2)) + (np.sum([(s+3)*(t+1)]*v**3)*x[:,None])
    return a + b
