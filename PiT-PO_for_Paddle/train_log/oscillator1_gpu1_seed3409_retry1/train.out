def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    e_x = (x**7 - np.sin(params[6]*x)**7)/params[0]
    e_v = (v**7 - np.cos(params[7]*v)**7)/params[1]
    a = e_x + e_v + params[2]*x**5 + params[3]*v**5 + params[4]*x**3 + params[5]*v**3 + np.tan(params[8]*x)*v
    b = np.sqrt((x**3 - np.sin(params[6]*x)**3)**2 + (v**3 - np.cos(params[7]*v)**3)**2)
    c = np.exp(-(x**3 - np.sin(params[6]*x)**3)**2/2*b**2)
    d = np.exp(-(v**3 - np.cos(params[7]*v)**3)**2/2*c**2)
    dv = (a*params[0]*c + np.sin(params[3]*v)*np.cos(params[4]*x)*params[2] +
      np.sin(np.pi/2 + np.arccos(c))*np.cos(np.pi/2 + np.arcsin(d))*np.sin(np.pi/2 + np.arctan(b))*
      (np.cos(params[8]*x)*v + np.sin(params[8]*x)*x))/c*d
    return dv
