     np.cos(2*np.pi*params[8])*x**3)*np.cos(4*params[9]) + \
    (np.cos(2*np.pi*params[6])*v*x**2 + np.cos(np.pi*params[5])*v*x**3 +
     np.sin(2*np.pi*params[0])*x**7)*np.sin(8*params[4])

