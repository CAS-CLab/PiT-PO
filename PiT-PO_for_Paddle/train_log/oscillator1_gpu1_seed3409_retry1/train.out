    b = (x**7 - 7*x*v**3)/(params[1]*(x**2 + v**2))
    c = (x**2 + v**2)**(-1/4) + np.log(params[2]/(x**2 + v**2)) + (np.sqrt(params[3])/x)*v
    d = np.pi*params[4]*x*np.sin(np.sqrt(params[5])*v) + (np.sqrt(params[6])**3)/(x**2 + v**2)
