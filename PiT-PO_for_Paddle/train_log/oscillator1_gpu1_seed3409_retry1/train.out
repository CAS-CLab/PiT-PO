def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ay = (
    (np.sin(params[0]*x)*v**3) + 
    (np.cos(v*params[1])*x**2) + 
    (np.exp(np.log(params[2])*x)*(x**4*v**2)) + 
    (np.sqrt(params[3])*(x*v**2 - x**3*v**3)) + 
    (np.tan(x*np.pi/4)*v) + 
    (x**2*np.sqrt(params[4])) + 
    (np.cosh(np.sqrt(params[5])*x)*v**2) + 
    (np.sinh(np.sqrt(params[6])*x)*x*v) + 
    (np.exp(-np.sqrt(params[7])*x)*x**2*v**2) + 
    (np.log(np.sqrt(1+np.sinh(np.sqrt(params[8])*x))))*v 
    )

    a = (
    (np.sinh(x*np.pi/4)*np.exp(np.log(np.sqrt(1+np.sinh(np.sqrt(params[9])*x))))*v**3) + 
    (np.cos(x*np.pi/2)*x**2*v**2) + 
    (np.tanh(x*np.pi/4)*v) + 
    (x**2*np.arcsin(np.sinh(x*np.pi/4))) + 
    (x*np.pi/4*np.sinh(x*np.pi/4)*v) + 
    (x**2*np.sqrt(np.sinh(x*np.pi/4))*v**2) + 
    (np.cot(x*np.pi/4)*x*v) + 
    (x**2*np.sqrt(np.tanh(x*np.pi/4))*(x**4*v**2)) + 
    (np.exp(-np.pi/4)*x*v**2) + 
    (x**2*np.csc(x*np.pi/4)*(x**4*v**3))
    )


    return a + ay
