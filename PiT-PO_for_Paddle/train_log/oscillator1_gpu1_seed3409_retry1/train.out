     np.cos(params[1]) * (v**3 - 3*x*v**2) + 
     np.exp(np.log(params[2])) * (x + v + 2*x**2 + 3*x*v + 4*x**2*v + 5*v**2))
    b = (np.sin(params[3]) * x**4 +
