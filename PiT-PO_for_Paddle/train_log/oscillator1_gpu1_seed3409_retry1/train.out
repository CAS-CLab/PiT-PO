def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*np.pi*params[0])*x**6*np.cos(8*params[2])
    b = np.cos(4*np.pi*params[9])*v**4*np.sin(np.pi*params[1])
    c = np.sin(7*params[6])*x**3*np.sin(2*np.pi*params[8])
    d = 2*np.sin(3*np.pi*params[4])*x*v**2*np.cos(2*np.pi*params[7])
    e = 2*np.sin(6*np.pi*params[9])*x**5*np.cos(np.pi*params[5])
    f = 2*np.sin(9*np.pi*params[3])*v**3*np.sin(2*np.pi*params[8])
    g = 2*np.sin(8*np.pi*params[3])*x**5*np.cos(3*np.pi*params[5])
    h = np.sin(8*np.pi*params[8])*x**5*np.cos(2*np.pi*params[3])
    i = np.sin(2*np.pi*params[1])*x**3*np.cos(2*np.pi*params[6])
    dv = a*b*e+f-h*i
    return dv
