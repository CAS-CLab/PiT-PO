    j = (x**2 + v**2)**(3/2) * x * v**2
    k = (x**2 + v**2)**(5/2) * x * v**2
    l = (x**2 + v**2)**(3/2) * x**2 * v**2
    dv = a + b + c + d + e + f + g + h + i + j - k - l
    return dv
