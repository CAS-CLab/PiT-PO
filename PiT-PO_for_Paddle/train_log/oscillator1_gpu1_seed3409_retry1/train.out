def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    y3 = np.sin(np.pi*params[8])*x**3*np.cos(2*np.pi*params[1]) +\
    (np.sin(2*np.pi*params[0])*x*v*np.cos(np.pi*params[2])+ \
     (np.sin(2*np.pi*params[3])*v*x + np.cos(np.pi*params[9])*x**3)*np.sin(2*np.pi*params[8]))
    a = y3 + (np.sin(np.pi*params[8])*x**3*np.sin(2*np.pi*params[7]) + \
         np.sin(2*np.pi*params[0])*x*v*np.sin(2*np.pi*params[9]))*np.cos(np.pi*params[5])
    b = np.sin(2*np.pi*params[8])*v*x*(np.cos(np.pi*params[7])*x+np.sin(2*np.pi*params[8])*x**3)
    c = (np.sin(2*np.pi*params[4])*x**3*np.sin(np.pi*params[6]) + \
     np.sin(2*np.pi*params[8])*v*x*np.cos(2*np.pi*params[3]))*np.cos(np.pi*params[1])
    d = (np.sin(2*np.pi*params[7])*x*v*np.cos(np.pi*params[4])+ \
     np.sin(2*np.pi*params[1])*x*np.cos(np.pi*params[9]))*np.sin(np.pi*params[8])
    return a+b-c-d
