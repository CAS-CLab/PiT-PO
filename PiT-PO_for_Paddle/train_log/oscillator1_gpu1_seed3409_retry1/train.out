def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(7*params[6])*x**5 - 9*np.cos(3*params[8])*v*x**2 +
    np.cos(2*params[1])*v**3 + 3*np.sin(2*params[4])*x**3 +
    2*np.cos(5*np.pi/4)*v*x) * np.cos(8*params[2])
    b = (2*np.cos(2*np.pi/4)*x**2 + 2*np.sin(5*np.pi/4)*v*x**2 +
    np.sin(3*np.pi/4)*v**2 + 2*np.sin(2*np.pi/4)*x**2 +
    np.cos(3*params[3])*x*v) * np.sin(4*params[7])
    c = (2*np.sin(2*np.pi/2)*v*x - 2*np.sin(2*np.pi/4)*x**2 +
    np.sin(2*np.pi/4)*x**2 + 2*np.cos(2*np.pi/4)*x**2) * np.cos(3*params[0])
    d = (2*np.sin(2*np.pi/4)*x**2 + np.sin(2*np.pi/2)*v*x +
    2*np.sin(5*np.pi/4)*v*x**2 - 3*np.sin(2*nppi/3)*x*v) * np.sin(2*params[8])
    return np.sum([a*b*c*d, -2*np.sin(5*np.pi/4)*v*x**2,
                -2*np.sin(2*np.pi/2)*x**2 + 3*np.cos(5*np.pi/4)*x**2,
                -3*np.sin(2*nppi/3)*x*v + 2*np.cos(2*np.pi/4)*x*v,
                -2*np.sin(2*nppi/3)*x**2 + 2*np.sin(2*np.pi/2)*x**2,
                np.cos(3*params[2])*x**3 + np.cos(2*params[1])*v**3])
