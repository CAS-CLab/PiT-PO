    b = (x**2 + v**2)**(3/2) + (x**2 + v**2)*(np.sqrt(params[2])*v)
    c = (x**2 + v**2)*np.tan((np.sqrt(params[3])*x + np.sqrt(params[4])*v)/np.sqrt(params[5]))
