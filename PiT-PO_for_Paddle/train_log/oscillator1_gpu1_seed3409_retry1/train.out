def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(x**2 + v**2)) * (np.cos(params[8]*v) * (x**3 - 3*x*(v**2)*np.cos(params[9]*v)))
    b = np.cos(np.sqrt(x**2 + v**2)) * (v**2*np.sin(params[6]*x) + x**2*(v**2)*(np.sin(params[6]*x) + np.cos(params[8]*v)))
    c = np.sin(np.sqrt(x**2 + v**2)) * (np.exp(-params[0]*(x**2 + v**2))*((x**3 - 3*x*v**2)*np.cos(params[6]*x) + (v**4 - v**2*x**2)*np.sin(params[8]*v)))
    d = (v**2)*(x**2 + v**2)**(3/2)*(np.sin(params[9]*x)*np.cos(params[8]*v))
    e = (x**2)*(v**2)*(x**3 - 3*x*v**2)*(np.sin(params[6]*x) + np.cos(params[8]*v)) + \
    (x**2)*(v**2)*(x**3 - 3*x*v**2)*(np.cos(params[6]*x)*np.sin(params[9]*v)) 
    f = x*(v**2)*(x**3 - 3*x*v**2)*(np.cos(params[6]*x) + np.sin(params[8]*v)) + \
     (x*v**2)*(x**3 - 3*x*v**2)*(np.sin(params[6]*x)*np.cos(params[9]*v)) 
    dv = a + b + c + d + e + f
    return dv
