def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.pi*params[6]*x)*np.cos(2*np.pi*params[5]*(x-1/2)))*(x**8-8*x**6*v**2+16*x**4*v**4-8*x**2*v**6)
    b = (np.tan(np.pi*params[4]*x))**(2)*(np.cos(2*np.pi*2*params[0]*x))*(x**6-12*x**4*v**2+48*x**2*v**4-24*v**6)
    c = (np.exp(-np.sqrt(params[8])*x))*(x**2-2*x*v)*(x**4-4*x**2*v**2+v**4)
    d = (np.log(np.sqrt(np.pi*2*params[1]*x)))*(x**5-5*x**3*v**2+5*x*v**4)
    e = (np.cosh(2*np.pi*3*params[2]*x))*((x-3*v)**2)*(x**3-3*x*v**2)
    f = (np.arccos(2*np.pi*2*params[0]*v))**(2)*(x**2-2*x*v)
    g = (np.tanh(np.pi*4*params[7]*x))*(x-2*v*x)*(x**2-2*x*v)
    h = (np.cos(np.pi*2*params[3]*x))**(2)*(x**4-4*x**2*v**2+2*x**4-v**4)
    i = (np.sinh(2*np.pi*5*params[9]*x))*(x-2*v*x)*(x**2-2*x*v)
    j = (np.sin(np.pi*2*2*params[1]*x))**(2)*(x**5-5*x**3*v**2+5*x*v**4)
    dv = a+b+c+d+e+f+g+h+i+j
    return dv
