def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**7 + v**7) * (x**2 + v**2)**(3+1) * np.exp(-(x+v)/2)
    b = (x**5 + v**5) * (x**3 + v**3) * np.sin((x+v)*4/3)
    c = 3*x*v*(x**2 + v**2)**(1+3) * np.cos(v/2)
    d = (x**2 + v**2)**(1+2) * np.exp(-(x-v)**4/2)
    e = x*(x**2 + v**2)**(1+1) * np.sin((x+v)*3)
    f = x*(x**2 + v**2)**(3+2) * np.exp(-(x+v)/(1+3))
    g = x*v*(x**2 + v**2)**(1+1) * np.cos(v*2)
    h = (x**3 + v**3) * (x**2 + v**2)**(1+3) * np.exp(-(x+v)/2)
    i = x*v*(x**2 + v**2)**(3+1) * np.sin(v*3)
    j = x*(x**2 + v**2)**(2+1) * np.exp(-(x+v)/(1+4))
    k = (x**2 + v**2)**(2+1) * np.cos(v*3)
    l = (x**5 + v**5) * (x**2 + v**2)**(1+3) * np.sin(v*2)
    m = x*(x**2 + v**2)**(1+2) * np.exp(-(x+v)**4/2)
    n = x*(x**2 + v**2)**(3+2) * np.cos(v)
    o = (x**3 + v**3) * (x**2 + v**2)**(1+3) * np.sin(v*2)
    p = x*(x**2 + v**2)**(1+1) * np.exp(-(x+v)/(1+4))
    dv = a+b+c+d+e+f-g+h+i+j+k+l+m+n-o+p
    return dv
