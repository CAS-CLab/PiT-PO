    (120*params[7]*((x + v)*v)) + \
    (130*params[8]*(x**2 + v**2)) + \
    (140*params[9]*((x - v)**2))
    ay = (150*params[0]*x*v) + \
    (160*params[1]*x*v) + \
    (170*params[2]*(x**2 + v**2)) + \
    (180*params[3]*x*v) + \
    (190*params[4]*v) + \
    (200*params[5]*x) + \
    (210*params[6]*x) + \
    (220*params[7]*v) + \
    (230*params[8]*x) + \
    (240*params[9]*x)
    return a + ay
