def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    h = (x**2+v**2)*np.sin(v*(4*x**2+2*3*x+3))
    f = ((x**4+2*x**2)*v*np.cos(6*v*(x**2+1)))
    g = -2*x*(8*v**2)*(x**3+4*x**2+3*x+2)
    k = 2*x*v*(5*x**3+11*x**2+13*x+7)*np.cos(2*v*(x**2+x))
    l = (x**2+v**2)*v*(x**2+4*x+1)*np.sin(5*v*(x**2+4*x+4))
    m = (16*x*v**3)*(x**2+3*x+1)*np.cos(9*v*(x**2+3*x+3))
    n = x*v*(x**2+4*x+1)*(x**2+8*x+20)*np.sin(2*v*(x**2+8*x+20))
    p = x*(x**2+2*x+1)*np.sin(7*x*(x**2+7*x+15))
    o = x*v*(x**2+8*x+20)*np.sin(7*x*(x**2+7*x+15))
    q = (x**2+v**2)*v*(x**2+8*x+20)*np.sin(7*x*(x**2+7*x+15))
    r = x*v*(x**2+8*x+20)*np.sin(7*x*(x**2+7*x+15))
    s = x*v**3*(x**2+3*x+1)*np.cos(2*v*(x**2+3*x+3))
    t = -x*v**3*(x**2+3*x+1)*np.cos(2*v*(x**2+3*x+3))
    u = (x**2+v**2)*np.sin(2*v*(x**2+4*x+4))*np.cos(2*v*(x**2+3*x+3))
    dv = h+f-g+k+l-m-n+p+o-q-r+s-t-u
    return dv
