    (-19*x**5 + 38*x**4*v**2 + 32*x**3*v**3)*params[0] +\
    (25*x**3 - 60*x*v**2)*params[1] +\
    (30*x**2 - 54*x*v)*params[2] +\
    (-28*x + 36*v)*params[3] +\
    (-22*x**2 + 19*x*v + 44*v**2)*params[4] +\
    (15*x + 18*v)*np.sin(params[5]) +\
