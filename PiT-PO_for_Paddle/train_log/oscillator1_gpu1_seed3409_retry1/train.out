    b = (2*params[4]+3*params[5])*np.sin(v)*np.cos(x) - (2*params[6]+3*params[7])*np.sin(x)*np.sin(v)
    c = (2*params[8]-3*params[9])*v**3
    dv = a + b + c
    return dv
