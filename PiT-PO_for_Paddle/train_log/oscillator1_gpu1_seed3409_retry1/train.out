def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(params[6]*x) + np.cos(params[7]*v)
    a = (params[0]-u)*(x**11-u**11) + (params[1]+u)*(v**11+u**11) + \
    (params[2]-u)*x**9 + (params[3]+u)*v**9 + \
    (params[4]-u)*x**7 + (params[5]+u)*v**7 + \
    (params[8]-u)*v*x + (params[9]+u)*x*v + \
    (np.sin(params[6]*x)-np.cos(params[7]*v))*(u**12-x**12-v**12)

    b = (params[0]-u)*x**9 + (params[1]+u)*v**9 + \
    (params[2]-u)*x**7 + (params[3]+u)*v**7 + \
    (params[4]-u)*x**5 + (params[5]+u)*v**5 + \
    (params[8]-u)*v*x + (params[9]+u)*x*v + \
    (np.sin(params[6]*x)-np.cos(params[7]*v))*(u**11-x**11-v**11)

    c = (params[0]-u)*x**7 + (params[1]+u)*v**7 + \
    (params[2]-u)*x**5 + (params[3]+u)*v**5 + \
    (params[4]-u)*x**3 + (params[5]+u)*v**3 + \
    (params[8]-u)*v*x + (params[9]+u)*x*v + \
    (np.sin(params[6]*x)-np.cos(params[7]*v))*(u**10-x**10-v**10)

    d = (params[0]-u)*x + (params[1]+u)*v + \
    (params[2]-u)*x**2 + (params[3]+u)*v**2 + \
    (params[4]-u)*x*u + (params[5]+u)*v*u + \
    (np.sin(params[6]*x)-np.cos(params[7]*v))*(u**9-x**9-v**9)

    dv = a + b + c + d
    return dv
