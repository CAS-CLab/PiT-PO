def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[0]*x) * np.cos(v*params[1])
    b = np.sum([np.power(params[2], i)*(x**(2*i)) for i in range(3)])
    c = np.sum([np.power(v, 2*j)*(x**(2*j+1)) for j in range(3)]) + \
    np.sum([np.power(v, 2*i)*np.power(x, 2*i+1) for i in range(3)]) + \
    np.sum([np.power(np.sin(v), 3)*x for i in range(3)]) + \
    np.sum([x*np.power(np.sin(v), 2)*x for i in range(3)]) + \
    np.sum([x*np.power(np.sin(v), 2)*v for i in range(3)]) + \
    np.sum([v**2*np.power(x, 2)+x*np.power(v, 2)+x*v*np.power(v, 2) for i in range(3)]) + \
    np.sum([x*np.power(np.sin(v), 3)*np.cos(v) for i in range(3)]) + \
    np.sum([x*np.power(np.sin(v), 2)*np.cos(v)*v for i in range(3)])
    dv = a + b + c
    return dv
