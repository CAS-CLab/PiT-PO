    params[8]*x*(v**3*x - v**3*x**3) + 
    params[9]*(x*v**2 - x*v**4))
    ay = (
    params[0]*x*v**2*(x - x**3) + 
    params[1]*(x**3*v - x**3*v**3) + 
    params[2]*x*v*(x - x**3) + 
