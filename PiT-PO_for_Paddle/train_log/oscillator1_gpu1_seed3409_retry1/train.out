def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum(params[:3])*(x**2)*v + \
    np.sum([i for i in range(3, 6)]*x*v**2) + \
    np.sum([i for i in range(6, 9)]*x*v**3) + \
    np.sum([i for i in range(9)]*x*v) + \
    np.sum([i for i in range(3, 6)]*x*v) + \
    np.sum([i for i in range(6, 9)]*x*v) + \
    np.sum(np.array([1, 2])*x*v**2) + \
    np.sum(np.array([3, 4])*x*v) + \
    np.sum(np.array([1, 2])*v)

    ay = np.sum(params[:3])*(x*v**2) + \
    np.sum([i for i in range(3, 6)]*x*v) + \
    np.sum([i for i in range(6, 9)]*v**3) + \
    np.sum([i for i in range(9, 12)]*v**2) + \
    np.sum([i for i in range(9)]*x*v) + \
    np.sum(np.array([1, 2])*x*v) + \
    np.sum([i for i in range(3, 6)]*v) + \
    np.sum([i for i in range(6, 9)]*v) + \
    np.sum(np.array([1, 2])*v)
    return a + ay
