def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*np.pi*params[0]*np.sqrt(x**2 + v**2))
    b = np.cos(2*np.pi*params[1]*(x + v)/np.sqrt(x**2 + v**2))
    c = np.tan(np.arctan(params[2]*x/np.sqrt(x**2 + v**2)) + np.pi/4)
    d = np.log(np.sqrt(np.abs(params[3]*(x**2 + v**2))))
    e = np.exp(-params[4]*np.abs(x - v))
    f = np.sqrt(np.pi/2)*np.sin(np.pi*(x - v)/2 + np.pi/4)
    g = np.sum(np.where((x > v), 1, -1)*params[5])
    h = np.prod(np.where((x >= 0), np.sqrt(x), -np.sqrt(-x)), axis=0)
    i = np.mean(np.where((x < 0), 1, -1)*np.array([x, v]), axis=0)
    j = np.sum(params[8]*x + np.log(np.abs(v)) + np.arange(len(x)))
    k = np.trigamma(params[9]*np.sqrt(x**2 + v**2))
    return a*b*c*d*e*f*g*h*i+j+k
