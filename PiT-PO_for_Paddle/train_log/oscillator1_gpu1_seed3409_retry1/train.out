def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sqrt(1 + (v**2)/(8*params[8]*x)) * (x**2 + v**2)**(3/2))/x
    b = -(np.sqrt((x-v)**2+(x+v)**2)/2)*(x*np.sqrt(1+8*params[8]*x**2))
    c = (4*params[0]*(x**2*(2*x**2-1)+v**2)-16*x*v**2*np.sqrt(2*x**2-1))/(64*params[8]*x)
    d = 2*params[8]*x*np.sqrt(x**2-(2*x**2-1)*v**2)
    e = 8*params[0]*x*v*np.sqrt(x**2+(2*x**2-1)*v**2)
    f = (3*np.sqrt(1+8*params[8]*x**2)-2*np.sqrt(2*x**2-1))*v
    g = (8*params[0]*x**(2/3)-32*np.sqrt(2*x**2-1)*x**2*np.sqrt(x**2+(2*x**2-1)*v**2)-16*params[0]*x*v**2*np.sqrt(x**2+(2*x**2-1)*v**2))
    h = (8*params[0]*x**4*np.sqrt(2*x**2-1)-16*params[8]*x**3*np.sqrt(x**2-(2*x**2-1)*v**2))
    return np.sum([a*b*c,d,e,f,g,h])
