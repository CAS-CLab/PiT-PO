    b = params[1] * (v**4 - v**2*x**2)
    c = np.sqrt((x**2 + v**2)**3)
    d = params[3] * (x**2 + v**2) + params[4] * v**2
    e = np.sin(params[6]*x) + np.cos(params[8]*v) + params[5] * x * v
