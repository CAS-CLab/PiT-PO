def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (x**5)*(v**7)*(np.cos(3*np.pi*params[0])) - \
    (x**5)*(v**7)*(np.cos(3*np.pi*params[8])) + \
    (x**7)*(v**5)*(np.sin(2*np.pi*params[1])) + \
    (x**7)*(v**5)*(np.sin(2*np.pi*params[9])) - \
    (x**7)*(v**3)*(np.sin(2*np.pi*params[6])) + \
    (x**7)*(v**3)*(np.sin(2*np.pi*params[7]))
    b = (x**7)*(v**5)*(np.sin(2*np.pi*params[2])) + \
    (x**7)*(v**5)*(np.sin(2*np.pi*params[4])) + \
    (x**3)*(v**5)*(np.sin(2*np.pi*params[5])) + \
    (x**3)*(v**5)*(np.sin(2*np.pi*params[8])) + \
    (x**3)*(v**3)*(np.cos(2*np.pi*params[0])) - \
    (x**3)*(v**3)*(np.cos(2*np.pi*params[9]))
    c = (x**7)*(v**3)*(np.sin(2*np.pi*params[3])) + \
    (x**7)*(v**3)*(np.sin(2*np.pi*params[4])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[5])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[6])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[8])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[9]))
    d = (x**7)*(v**3)*(np.cos(2*np.pi*params[1])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[0])) + \
    (x**3)*(v**3)*(np.sin(2*np.pi*params[8]))
    return a+b+c+d
