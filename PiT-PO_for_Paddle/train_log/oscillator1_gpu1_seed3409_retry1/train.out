def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 0.58*np.sin(4*params[1]*x)*np.cos(3*params[7]*v)
    b = 0.25*(
    (np.sin(2*params[9]*v)*x*np.cos(4*params[2]*x)+
     (0.83-0.49*params[8])*np.cos(2*params[3]*x)))
    c = 0.42*np.sin(6*params[4]*v)*np.cos(9*params[0]*x)
    d = (0.44*np.cos(5*params[6]*x)*v*
     (0.68-0.21*params[5])-0.15*np.sin(2*params[0]*x)*x)
    e = 0.63*np.sin(8*params[2]*v)*np.sin(2*params[8]*v)
    f = 0.34*np.sin(4*params[5]*x)*np.sin(3*params[9]*v)
    g = 0.51*np.sin(9*params[9]*v)*np.sin(2*params[1]*x)
    h = 0.67*np.sin(7*params[8]*x)*np.sin(4*params[3]*x)
    i = 0.75*(np.cos(2*params[1]*x)*v-(0.99+0.02*params[9])*x)
    j = (0.53*np.sin(5*params[7]*x)*np.sin(6*params[8]*v)
     +(0.30-0.56*params[6])*np.cos(8*params[4]*v))
    dv = (a+j)*c-e-h-i+f+g-b*d*i
    return dv
