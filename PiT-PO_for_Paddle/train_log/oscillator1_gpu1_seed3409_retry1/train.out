    z = 0.18*np.sin(6*params[0]*x)*np.cos(2*params[8]*v)-0.43*np.cos(3*params[7]*v)*np.sin(3*params[3]*x)
    w = 0.58*np.sin(2*params[4]*x)*np.cos(5*params[6]*v)+0.29*np.sin(4*params[8]*v)*np.cos(2*params[0]*x)
    return w-y+z
