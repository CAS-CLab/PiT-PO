def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*np.pi*params[2])*x**3+\
    np.cos(6*np.pi*0)*x*v*np.sin(2*np.pi*8)+\
    np.sin(4*np.pi*8)*x*v*np.sin(2*np.pi*8)+\
    np.cos(5*np.pi*0)*x*v*np.sin(2*np.pi*7)-\
    np.sin(2*np.pi*4)*x*v**3+\
    np.cos(5*np.pi*6)*x*v**3

    b = np.cos(3*np.pi*8)*x*v**3+\
    np.sin(2*np.pi*7)*x*v**3+\
    np.sin(2*np.pi*3)*x*v**3+\
    np.cos(5*np.pi*0)*x*np.sin(2*np.pi*9)*v**5+\
    np.sin(4*np.pi*9)*x*np.sin(2*np.pi*4)*v+\
    np.sin(3*np.pi*8)*x*v**3+\
    np.sin(2*np.pi*8)*x*v**3

    c = np.sin(3*np.pi*8)*x*v*np.cos(np.pi*0)+\
    np.sin(2*np.pi*4)*x*v**3+\
    np.cos(5*np.pi*3)*x*v**3+\
    np.cos(2*np.pi*3)*x**3+\
    np.sin(2*np.pi*1)*x*v*np.sin(2*np.pi*0)+\
    np.sin(2*np.pi*9)*x*v*np.sin(2*np.pi*3)

    d = np.sin(2*np.pi*8)*x*v**5+\
    np.cos(3*np.pi*8)*x*v**5+\
    np.sin(3*np.pi*8)*x*np.sin(2*np.pi*9)*v+\
    np.cos(2*np.pi*8)*x*np.sin(2*np.pi*8)+\
    np.sin(2*np.pi*1)*x*v**5+\
    np.cos(3*np.pi*7)*x*np.sin(2*np.pi*9)*v
    return a+b+c+d
