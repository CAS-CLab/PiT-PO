def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.sqrt(params[0]*(x**2+v**2)))**2)/(params[1]*(x+params[2]*v))
    b = (x*np.cos(v*(np.pi/2+np.tan(params[3]*x))))/(params[4]*(x**2+v**2)) - \
    (x**(3/2)*np.sin(v*(np.pi/2+np.tan(params[5]*x))))/(2*params[6]*(x+v)*(x-v))
    c = (x**2 + v**2)**(3/2)/((x**2 + v**2)**(3/2)*np.sqrt(params[7]*(x**2 + v**2))) + \
    (x**2 + v**2)/((x**2 + v**2)**(3/2)*np.sqrt((x**2 + v**2)*np.exp(-np.log(params[8])*x))) + \
    (x**2 + v**2)/((x**2 + v**2)**(3/2)*np.sqrt(np.exp(-np.log(params[9])*(x+v)))) + \
    (x**2 + v**2)/(2*params[1]*(x**2 + v**2)**(3/2)*np.sin(np.arcsin(params[8]*np.sqrt(x**2 + v**2))))
    dv = a + b + c
    return dv
