    b = params[2] * (x ** 4 + 2*x**2*v**2 + v**4)
    c = params[3] * np.sin(params[4]*x) * np.cos(params[5]*v)
    d = params[6] * (x**2 + v**2) * np.sin(params[7]*x) + params[8] * v * np.cos(params[9]*v)
