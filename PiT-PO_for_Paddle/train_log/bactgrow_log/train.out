    params[5] * np.sin(np.arcsin(b/params[6])) + \
    params[7] * np.cos(np.arccos(temp/params[8])) + \
    params[9] * np.power((s+params[10]), params[11]) - \
    params[12] * np.exp(params[13]*(pH-params[14]))
    return a
