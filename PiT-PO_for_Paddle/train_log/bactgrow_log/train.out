    b = params[9] * np.log(s) + np.sin(temp) * z + np.cos(pH) * x
    c = np.sinh(params[0] * b - params[1] * s)
    d = x * a * b
    e = d * (1 + z**2)**params[0]
    f = e * (1 - np.exp(-params[1] * y))
    g = f * (1 + np.sin(params[2] * s))
    h = g * (1 + np.cos(params[3] * b))
