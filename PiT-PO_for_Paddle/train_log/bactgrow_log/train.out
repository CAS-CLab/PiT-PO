    y = params[3] * np.cos(pH)
    z = params[4] * np.sqrt(params[5]) + params[6] * np.log(params[7]) + params[8] * np.tan(3*np.pi/2-pH)
    w = params[9] * np.sin(params[5]*temp)
    return x + y + z + w
