        A numpy array representing bacterial growth rate as the result of applying the mathematical function to the inputs.
    """
    x = np.exp(params[0] * b / (np.exp(params[1]) + s))
    y = np.sin(np.pi * temp) * np.cos(np.pi * pH)
    z = np.tanh(params[4] * b + params[5] * s + params[6] * temp + params[7] * pH)
