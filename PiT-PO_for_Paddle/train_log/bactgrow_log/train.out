    params[2] * np.sin(pH) * np.cos(params[3] * s) +\
    params[4] * np.sqrt(params[5] + 1) * b +\
    params[6] * np.log(np.sin(params[7] * temp)) +\
    params[8] * np.tan(3 * np.pi / 2 - pH) * np.sin(params[9] * s)
