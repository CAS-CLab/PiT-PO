def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.exp(-np.sqrt(params[0])*v/np.sqrt(np.sum((x**2 + v**2)**2)))
    b = np.cos(2*np.pi*params[1]*(x+v))
    c = (x**2 + v**2)*(np.exp(-np.sqrt(params[2])*v)-1)/np.sqrt(np.sum((x**2 + v**2)**2))
    d = np.exp(-(x-params[3])**2/np.sum((x-v)**2)) * (x+np.sqrt(np.sum((x-v)**2))*v)
    e = np.sinh(np.sqrt(np.sum((x-v)**2))*np.sqrt(np.sum((x-v)**2)))
    f = np.arctan2(v, x)*np.sqrt(np.sum((x-v)**2))
    g = (x**2 + v**2) * (np.exp(-np.sqrt(np.sum((x-v)**2))*v) - 1) / np.sqrt(np.sum((x-v)**2))
    h = (x-np.sqrt(np.sum((x-v)**2))*v)**2
    i = x * (np.exp(-np.sqrt(np.sum((x-v)**2))*v) + 1) / np.sqrt(np.sum((x-v)**2))
    j = np.exp(-np.sqrt(np.sum((x-v)**2))*v) * (x**2 + v**2)
    dv = (
    a*b*c*d*e*f*g*h*i+j*
    -(x**2 + v**2)/2*np.sinh(np.sqrt(np.sum((x-v)**2))*np.sqrt(np.sum((x-v)**2)))
    )
    return dv
