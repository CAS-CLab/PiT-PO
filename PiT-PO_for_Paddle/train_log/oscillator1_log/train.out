    (np.sum(np.abs(x)**3 * v, axis=1)) +\
    (np.sum(np.abs(v)**4 * x, axis=1)) +\
    (np.sum((x + v)**3 * np.sin(2*np.pi*(x + v)), axis=1)) +\
    (np.sum((x + v)**4 * (x + v), axis=1))
