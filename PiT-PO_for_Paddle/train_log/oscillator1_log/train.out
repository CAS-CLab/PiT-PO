def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[0]*x, np.power(params[1]*v, 2), np.power(params[2], 3)]))**3 \
    - 3*np.sum([np.power(params[3], 4)*np.sum([x+np.power(params[4]*v, 2)+np.power(params[5], 3),
                                              np.power(np.sum([x*np.power(params[6], 2), v*np.power(params[7], 2)], axis=1), 2)])]) \
    * (np.sum([x+np.power(params[4]*v, 2)+np.power(params[5], 3),
              np.power(np.sum([x*np.power(params[6], 2), v*np.power(params[7], 2)], axis=1), 2)])**3)

    b = np.sum([np.power(np.sum([np.power(x, 5), np.power(v, 5)]), 5)-5*np.power(np.sum([x+np.power(v, 2),
                                                                                       np.power(np.sum([x*np.power(params[6], 2), v*np.power(params[7], 2)], axis=1), 2)], axis=1), 5)])

    c = a+b
    dv = c
    return dv
