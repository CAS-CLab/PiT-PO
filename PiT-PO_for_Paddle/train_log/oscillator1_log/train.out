def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(params[:3]) * x +
     np.sum([p * v**i for i, p in enumerate(params[3:])]) * 
     np.sum([p * x**(i+1) for i, p in enumerate(params[3:])])) * \
    (np.sum([q * x**(i//2) for i, q in enumerate(np.abs(params[3:]))]) *
    np.sum([r * v**(i//2) for i, r in enumerate(np.abs(np.array(params[3:])))]))
    b = (np.sum([s * x**(i+1) for i, s in enumerate(np.abs(np.array(params[:3])))]) *
    np.sum([t * v**(i+1) for i, t in enumerate(np.abs(np.array(params[3:])))])) * \
    (np.sum([u * x**(i+1) for i, u in enumerate(np.abs(np.array(params[:3])))]) *
    np.sum([v * v**(i+1) for i, v in enumerate(np.abs(np.array(params[3:])))]))
    c = (np.sum([w * x**(i+1) for i, w in enumerate(np.abs(np.array(params[:3])))]) *
    np.sum([x * v**(i+1) for i, x in enumerate(np.abs(np.array(params[3:])))])) * \
    (np.sum([y * x**(i+1) for i, y in enumerate(np.abs(np.array(params[:3])))]) *
    np.sum([z * z**(i+1) for i, z in enumerate(np.abs(np.array(params[3:])))]))
    dv = a + b + c
    return dv
