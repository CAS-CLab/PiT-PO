    params[0] * x 
    + (params[1] + 2 * params[2] * x**3) * v 
    + (params[3] + 3 * (params[4] + 2 * params[5] * v**2)) * x**2 
    + (params[6] + 4 * (params[7] + 3 * params[8] * (x - v)**2)) * np.sin(params[9] * x) 
    + (params[0] + 2 * (params[1] + 2 * params[2] * x**3)) * x**4 
    + (params[3] + 2 * (params[4] + 2 * params[5] * v**2)) * x**3 
    + (params[5] + 2 * (params[6] + 3 * params[7] * (x - v)**2)) * v**3 
    + (params[0] + 2 * (params[1] + 2 * params[2] * x**3)) * v**2 
    )
    dv = a
