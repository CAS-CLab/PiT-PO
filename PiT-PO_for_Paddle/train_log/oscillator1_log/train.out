    (params[1] * v**3) + \
    (params[2] * (x**2 + v**2)) + \
    (params[3] * (np.cos(params[4] * x) - 1)) + \
    (params[5] * (np.exp(params[6] * v))) + \
    (params[7] * (x * v)) + \
    (params[8] * (np.sin(params[9] * x)))
    return a
