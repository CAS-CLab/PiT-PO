     + np.sum([x**(i+1)*v**(3-i) for i in range(9)], axis=0) 
     + np.sum([x**(i+1)*v**2 for i in range(9)], axis=0) 
     + np.sum([x*v**(i-1) for i in range(1,10)], axis=0) 
