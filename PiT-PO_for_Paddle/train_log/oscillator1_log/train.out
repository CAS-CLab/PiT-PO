    i = params[1] * np.sin(params[2] * x) + params[3] * v**2 * np.cos(params[4] * v) + params[5] * x * v**2 * np.sin(params[6] * x)
    j = params[7] * v**3 * np.exp(-params[8] * v) + params[9] * x * v * np.cos(params[2] * x)
    a = h + i + j
