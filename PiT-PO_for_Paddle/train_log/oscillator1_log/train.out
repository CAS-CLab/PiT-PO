    a0, b0, c0, d0, e0, f0, g0, h0, i0, j0 = np.array([*params])
    dv = (a0*(v**2 - 2*e0*v) +
      b0*np.sin(f0*x) + 
      c0*x**3 + 
      d0*x*v + 
      g0*x + 
      h0*v + 
