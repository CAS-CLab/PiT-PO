    params[0], params[1], \
    np.sin(np.pi/2 * x), 
    3*params[4]**2, 
    2*params[4]*v, 
    np.cos(2*np.pi*x) + np.sin(f1 * x) + \
    2*g0*x + 2*h0*v + \
    (i0*(x**3 - 3*j0*v**3))*(x**3 + v**3)
    return dv
