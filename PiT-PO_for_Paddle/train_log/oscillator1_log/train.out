def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(params[:3])*x + np.sum([p*x for p in params[3:6]])*v +
     np.sum([p*v for p in params[:3]]))
    b = (np.sum([p*x for p in params[6:9]])*x +
     np.sum([p*v for p in params[6:9]])*v + 
     np.sum([p*(x**2+v**2) for p in params[9]]))
    c = (a + (b + np.sum([p*(x**3+v**3) for p in params[9]])))**3 - 3*np.sum([p*(x**3+v**3) for p in params[9]])*(np.sum([p*x for p in params[3:6]])+np.sum([p*v for p in params[6:9]]))*(np.sum([p*x for p in params[3:6]])+np.sum([p*v for p in params[6:9]]))
    dv = (np.sum([p*x for p in params[9]])*x + np.sum([p*v for p in params[9]])*v)**2*(a + b + np.sum([p*(x**3+v**3) for p in params[9]]))**2 - 3*np.sum([p*(x**3+v**3) for p in params[9]])**2*(np.sum([p*x for p in params[3:6]])*x + np.sum([p*v for p in params[6:9]])*v)
    return dv
