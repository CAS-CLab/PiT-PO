    k0 = np.sum((v-2*np.pi*1j*l)**3)
    dv = k0 + \
    (np.sum((v**3)*np.cos(3*np.arccos(k0))) + \
     2*np.pi*1j*(np.sum((v**3)*np.sin(3*np.arccos(k0)))) + \
     np.sum((x**3)*(v**2)) + \
