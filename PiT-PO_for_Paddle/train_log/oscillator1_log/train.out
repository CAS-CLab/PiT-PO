def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (h := np.sin(params[0] * x) * (v**3) * (np.cos(params[1] * v))) + \
    (i := v**2 * np.sin(params[2] * x) + v**4 * np.cos(params[3] * v)) + \
    (j := np.exp(params[4] * x) * (v**3 * (x**2 * np.sin(params[5] * v)))) + \
    (k := v**3 * (x * np.sin(params[2] * x) * np.exp(-np.abs(v - x) / (2 * np.sqrt(params[6] ** 2))))) + \
    (l := v**2 * (x * v * np.cos(params[3] * v))) + \
    (m := v**2 * (x * v * np.sin(params[2] * x) * np.exp(-np.abs(v - x) / (2 * np.sqrt(params[7] ** 2))))) + \
    (n := v * (x * v * np.sin(params[2] * x) * np.exp(-np.abs(v - x) / (2 * np.sqrt(params[8] ** 2))))) + \
    (o := v**3 * (x * v * np.sin(params[2] * x) * np.exp(-np.abs(v - x) / (2 * np.sqrt(params[9] ** 2)))))
    dv = o
    return dv
