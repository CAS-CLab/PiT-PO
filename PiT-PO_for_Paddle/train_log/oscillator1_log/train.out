    (np.sum((x - v) * (x ** 3)) / len(v)) + \
    (np.sum(np.exp(-(x - v) * 2) * (x ** 4)) / len(v)) + \
    (np.sum(np.sin(2 * v) * (x * v ** 3)) / len(v)) + \
    (np.sum(np.cos(4 * v) * (x * v ** 4)) / len(v))

    dv = a
    return dv
