    a0 = np.sin(params[3]) / (np.sin(params[3])**2 + np.exp(-2*params[0])*np.cos(2*np.pi*params[1]))
    b0 = np.sqrt(np.exp(-2*params[0]) - 1)
    c0 = np.tanh(params[2])
    f0 = np.arctanh(b0 * np.sin(np.pi/4) + np.cosh(np.pi/4))
    e0 = np.log(np.abs(a0))
    d0 = np.sqrt(e0**2 - c0**2)
    g0 = np.cos(d0 * np.pi/2)
    h0 = np.sin(d0 * np.pi/2)
