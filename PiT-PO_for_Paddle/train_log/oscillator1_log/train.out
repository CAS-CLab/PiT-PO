def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[i] * (x**(i+1) + v**(i+1)) for i in range(10)])) + \
    (np.sum([np.cos(i * np.pi * x) for i in range(1, 6)]) * np.sum([np.sin(i * np.pi * x) for i in range(6, 11)])) + \
    (np.sum([np.sin(np.pi * x)**2 for i in range(1, 6)]) * np.sum([np.cos(np.pi * x)**2 for i in range(6, 11)])) + \
    (np.sum([x**(i+1) * v**(i+1) for i in range(10)])) - \
    (np.sum([x**i * v**(i+1) for i in range(10)])) - \
    (np.sum([x**(i+1) * v**i for i in range(10)])) + \
    (np.sum([x * v * np.sin(np.pi * x)**2 for i in range(1, 6)]) * np.sum([x * v * np.cos(np.pi * x)**2 for i in range(6, 11)])) + \
    (np.sum([x * v * (x + v) * np.sin(np.pi * x)**2 for i in range(1, 6)]) * np.sum([x * v * (x + v) * np.cos(np.pi * x)**2 for i in range(6, 11)])) + \
    (np.sum([x * v * np.sin(np.pi * x)**2 for i in range(1, 6)]) * (np.sum([x * v * np.cos(np.pi * x)**2 for i in range(6, 11)])))
    return a
