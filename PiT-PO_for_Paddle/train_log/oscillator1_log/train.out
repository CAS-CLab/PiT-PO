    c0 = np.exp(np.log(np.abs(params[3]))*np.array(v));
    e0 = np.sqrt(np.sum(c0**2, axis=1))**2 / np.sum(c0**2);
    g0 = np.cos(np.pi*params[4]); h0 = np.sin(np.pi*params[4]);
