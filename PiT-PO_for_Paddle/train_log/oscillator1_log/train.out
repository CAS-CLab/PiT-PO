    params[0] * (x**7 - 14*x**5*v**2 + 21*x**3*v**4 - 14*x*v**6 + v**7) +
    params[1] * (x**6 - 6*x**4*v**2 + 3*x**2*v**4 + v**6) +
    params[2] * (x**5 - 5*x**3*v**2 + 3*x*v**4) +
