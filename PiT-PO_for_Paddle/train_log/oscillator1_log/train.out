def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[i] * (x + v + i*params[6]) for i in range(5)], axis=0))**(11)
    b = (np.sum([params[i] * (x + v + i*params[6]) for i in range(5)], axis=0))**(9)
    c = (np.sum([params[i] * (x + v + i*params[6]) for i in range(5)], axis=0))**(7)
    d = (np.sum([params[i] * (x + v + i*params[6]) for i in range(5)], axis=0))**(5)
    e = np.sum([i*params[9]*(x + v + i*params[6]) for i in range(5)])
    f = np.sum([i*params[6]*(x + v + i*params[7]) for i in range(5)])
    g = np.sum([i*params[9]*e for i in range(5)])
    h = np.sum([i*params[9]*f for i in range(5)])
    return a + b - c + d - e + g + h
