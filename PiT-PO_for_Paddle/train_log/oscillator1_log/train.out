        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = params[0]
    b0 = params[1]
    c0 = params[2]
    d0 = np.sin(params[3] * (x ** 2))
    e0 = np.exp(-(x ** 2) / (2 * v))
    f0 = np.cos(v) * (x ** 2)
    g0 = np.sinh((x ** 2) / v)
    h0 = np.sin(params[4] * x)
    i0 = np.sinh(v) * (x ** 2)
    j0 = np.cosh(v) * (x ** 2)

    dv = a0 * v + b0 * f0 + c0 * g0 + \
     d0 * (x**4 - 2*(x**2)*(v**2)) + \
     e0 * (x**2 * (x**2 + v**2)) + \
     f0 * x + h0 * v + i0 * v**3 + j0 * x * v
    return dv
