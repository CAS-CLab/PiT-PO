    (np.sum(np.square(x)) / np.sum(np.square(x))) + \
    (np.sum(np.square(x)) / np.sum(np.square(x))) * \
    (np.sum(x**2) / np.sum(np.square(x))) + \
    (np.sum(np.square(v)) / np.sum(np.square(x))) * \
    (np.sum(v * np.square(x)) / np.sum(np.square(x)))
    return a
