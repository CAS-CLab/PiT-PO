    params[1] * v**2 + \
    params[2] * np.sin(params[3] * (x - v)) + \
    params[4] * np.exp(params[5] * x) + \
    params[6] * x * v**2 + \
    params[7] * np.cos(params[8] * (x + v)) + \
    params[9] * x
    return a
