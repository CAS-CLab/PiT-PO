    b0 = np.cos(params[1] * x)
    c0 = np.exp(-(x - np.sum(params[2:]))) / (np.sum(params[3:]) + np.sum(np.abs(np.array(params[2:]))))
    e0 = np.sum(np.abs(np.array(params[2:])))
    f1 = np.sin(params[4] * v)
    g0 = np.sinh((x - np.sum(params[5:])) / (np.sum(np.abs(np.array(params[6:])) + np.sum(np.abs(np.array(params[5:]))))))
    h0 = np.cosh((x - np.sum(np.array(params[5:])))) / (np.sum(np.abs(np.array(params[6:])) + np.sum(np.abs(np.array(params[5:])))))
