    b1 = params[1]
    c1 = params[2]
    d1 = params[3]
    e1 = params[4]
    f1 = params[5]
    g1 = np.sin(params[6])
    h1 = np.cos(params[7])
    i1 = np.exp(-params[8])
    j1 = x**2 * v + x * (x**2)
    dv = a1*j1 + b1*v + c1*x + d1*x*v + e1*v**2 + f1*(x**3) + g1*i1 + h1*x + i1*x + j1
    return dv
