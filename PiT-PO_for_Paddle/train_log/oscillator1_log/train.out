def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0, b0, c0, d0, e0, f0, g0, h0, i0, j0 = \
    np.sin(np.sqrt(params[8]) * np.pi/2 * x) * \
    np.cos(np.sqrt(params[7]) * np.pi/4 * x)**2 * \
    np.exp(-np.sqrt(params[6]) * (v + d0)/d0) * \
    np.cos(np.sqrt(np.abs(d0-1)) * np.pi/6 * x) * \
    np.sin(np.sqrt(np.abs(d0-1)) * np.pi/12 * x) * \
    (v**3 * \
     (c0 * (x - d0)*v**2 + \
      e0 * x**(3/2) * v + \
      f0 * x**3 * v) + \
     g0 * (b0 * x**(1/2) * np.sin(f0 * x) + \
           h0 * x**(1/2) * v) + \
     i0 * x**(3/2) * v**3 + \
     j0 * x**(1/2) * v**3);
    return a0 * v + b0 * x**2 * np.sin(f0 * x) + c0 * x * v**2 + d0 * x**3 + e0 * v * x**(3/2) + f0 * x**3 * v + \
       g0 * (b0 * x**(1/2) * np.sin(f0 * x) + h0 * x**(1/2) * v) + \
       h0 * (v**2 * x**(1/2) * np.cos(f0 * x) - \
            0.5 * v * (np.cos(f0 * x) - 1)) + \
       i0 * x**(3/2) * v**3 + \
       j0 * x**(1/2) * v**3;
