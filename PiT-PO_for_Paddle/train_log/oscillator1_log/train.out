    u = (v**2 - 2*e0*v) + \
    np.sin(f0*x) + \
    c0*x**3 + g0*x + \
    h0*v + \
    i0*(x**5 - 3*j0*v**3) + \
    d0*(x**3 - np.pi/2)**2 + \
