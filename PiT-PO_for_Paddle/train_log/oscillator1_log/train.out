            (params[1] * x**2 + params[2] * v**2 + 
             params[3] * np.sin(params[4] * v) + params[5] * np.cos(params[6] * x) + 
             params[7] * np.power(x, 3) + params[8] * np.power(v, 3))
    dv = f_x + f_v
    return dv
