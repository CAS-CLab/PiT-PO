    j0 = a0 * v + b0 * v**3 + c0 * x**4
    k0 = a0 * v + b0 * v**2 + c0 * v**3
    l0 = a0 * x + b0 * x**2 + c0 * x**3
    m0 = a0 * x**2 + b0 * x**3 + c0 * x**4
    n0 = a0 * v**2 + b0 * v**3 + c0 * v**4
    o0 = a0 * v**3 + b0 * v**4 + c0 * x**5
