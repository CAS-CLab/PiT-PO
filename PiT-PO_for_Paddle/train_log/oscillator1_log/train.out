    params[1] * (x**4 + 2*x**2*v**2) + \
    params[2] * (x**3 + v**3) + \
    params[3] * (x**2 + v**2) + \
    params[4] * (x + v) + \
    params[5] * ((x+v)**2) + \
    params[6] * np.sin(3*np.pi*x) + \
    params[7] * np.cos(2*np.pi*(x-v))
    return a
