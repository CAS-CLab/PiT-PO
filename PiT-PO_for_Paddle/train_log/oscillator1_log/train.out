def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    A0 = np.power(params[0], 4)
    B0 = np.power(v, 4) - 2*np.power(params[1], 2)*np.power(v, 2)
    C0 = np.sin(np.power(params[2], 0)*x)
    D0 = np.power(x, 7)
    E0 = np.power(params[3], 0)*x*np.power(v, 3)
    F0 = np.power(params[4], 0)*x*np.power(v, 2)
    G0 = np.power(x, 3)*np.power(v, 2)
    H0 = np.power(v, 5)*np.power(x, 11)
    I0 = np.power(v, 5)*np.power(v, 5)

    dv = \
    (A0*B0 - C0+F0+G0+H0) + \
    (E0*(x**5 + 5*params[8]*x*3**(5/2)/params[8])) + \
    (D0+I0) + \
    (2*params[6]*x*(x**9-9*params[6]*x**7+19*params[6]*x**5-35*params[6]*x**3+21*params[6]*x))

    return dv
