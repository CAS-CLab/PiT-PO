    j0 = np.sin(d0 * 3*np.pi/2)

    dv = a0*(v**2-2*e0*v) + \
     b0*np.sin(f0*x) + \
     c0*x**3 + \
     g0*x + \
     h0*v + \
     i0*((x**5 - 3*j0*v**3)*x**7 + (x**5 + v**3)*x) 

    return dv
