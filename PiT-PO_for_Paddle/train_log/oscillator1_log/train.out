    dv = (a0*(v**2-2*e0*v)
     + b0*np.sin(f0*x) 
     + c0*x**3 
     + g0*x 
     + h0*v 
     + i0*(x**5 - 3*j0*v**3) 
     + 2*d0*x*np.cos(f0*x) 
     + f0*x*v 
     + e0*x**2 
     + x**4 
     + x**2)
    return dv
