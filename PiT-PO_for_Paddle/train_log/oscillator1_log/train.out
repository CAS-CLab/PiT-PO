def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[0]*x**(i+1) for i in range(3)], dtype=np.float64) +
     np.sum([params[1]*v**(i+1) for i in range(3)], dtype=np.float64) +
     np.sum([params[2]*(x**i*v**(i)) for i in range(10)], dtype=np.float64))
    b = (np.sum([params[3]*x**(i+2) for i in range(3)], dtype=np.float64) +
     np.sum([params[4]*v**(i+2) for i in range(3)], dtype=np.float64) +
     np.sum([params[5]*(x**i)*v**(i+1) for i in range(10)], dtype=np.float64) +
     np.sum([params[6]*x**(i+1)*v**(i+1) for i in range(10)], dtype=np.float64))
    c = (np.sum([params[7]*x**(i+1) for i in range(10)], dtype=np.float64) +
