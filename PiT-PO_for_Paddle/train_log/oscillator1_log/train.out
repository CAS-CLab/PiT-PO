def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (params[0] * x + params[1] * v + (params[5]*x+params[6]*v+params[7])*params[8])**5 - 5 * params[3] * ((params[0] * x + params[1] * v + (params[5]*x+params[6]*v+params[7])*params[8])**3 - 3 * (params[0] * x + params[1] * v + (params[5]*x+params[6]*v+params[7]))*(params[0]*x+params[1]*v+params[2])*(params[5]*x+params[6]*v+params[7]))
    b = (params[0] * x + (params[5]*x+params[6]*v+params[7])*params[8])**3 - 3 * (params[0] * x + (params[5]*x+params[6]*v+params[7]))*(params[0]*x+params[1]*v+params[2])*(params[0]*x+params[1]*v+params[2])
    c = (params[0] * x + (params[5]*x+params[6]*v+params[7])*params[8])**2 - 2 * (params[0] * x + (params[5]*x+params[6]*v+params[7]))*(params[0]*x+params[1]*v+params[2])
    d = (params[0] * x + (params[5]*x+params[6]*v+params[7])*params[8])**2 - 2 * (params[5]*x+params[6]*v+params[7])*(params[0]*x+params[1]*v+params[2])
    return a*b - c*d
