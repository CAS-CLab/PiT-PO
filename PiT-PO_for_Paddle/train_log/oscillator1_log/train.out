def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = params[0]
    b0 = np.sum((x + v)**4 * (np.array([x, v])**2))
    c0 = np.sum(np.array([x, v])**3)
    d0 = np.sum(params[0] * (x + v)**2 * (x + v) * (x + v) / 4)
    e0 = np.sum(c0 * x + b0 * v)
    f0 = np.sum(d0 * x + e0 * v)
    g0 = np.sum(f0 * x + x**3 * v**2)
    h0 = np.sum(g0 * v + v**3 * x**2)
    i0 = np.sum(h0 * v + x**2 * v**3)
    j0 = np.sum(i0 * v + x * v**3)
    k0 = np.sum(j0 * v + x * v**3)
    l0 = np.sum(k0 * v + x * v**3)
    m0 = np.sum(l0 * x + x * v**3)
    n0 = np.sum(m0 * v + x * v**3)
    o0 = np.sum(n0 * x + x * v**3)
    p0 = np.sum(o0 * v + x * v**3)
    q0 = np.sum(p0 * v + x * v**3)
    r0 = np.sum(q0 * v + x * v**3)
    s0 = np.sum(r0 * v + x * v**3)
    t0 = np.sum(s0 * v + x * v**3)
    u0 = np.sum(t0 * v + x * v**3)
    v0 = u0 - k0 * j0 + l0 * i0 + n0 * h0 + o0 * f0 + p0 * e0 + r0 * d0 + t0 * c0 + v0 * b0
    return v0
