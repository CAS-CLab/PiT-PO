def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(params[:5]) * (x**2 + v**2)) + \
    (np.sum([params[i] * x for i in range(5)]) + np.sum([params[i] * v for i in range(5)])) + \
    (np.sum([params[5 + i] * (x**2 + v**2) for i in range(5)])) + \
    (np.sum([params[5 + i] * x for i in range(5)]) + np.sum([params[5 + i] * v for i in range(5)])) + \
    (np.sum([params[10] * x for i in range(5)]) + np.sum([params[10] * v for i in range(5)]))

    b = (np.sum([params[i] * (x**2 + v**2) for i in range(5)]) - 2 *
     (np.sum([params[i + 5] * (x**(i+3)) for i in range(5)]) + np.sum([params[i + 5] * (v**(i+3)) for i in range(5)])))

    return np.sin(b)
