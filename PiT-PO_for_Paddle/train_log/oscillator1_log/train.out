def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(np.sum((x+1j*2*np.pi*params[0])*np.abs(v+1j*2*np.pi*params[1])**2))) \
    /(x+1j*2*np.pi*params[2])
    b = np.cos(2*np.pi*np.sum((np.abs(x-v)-1j*np.pi*2*params[3])/np.abs(v+1j*2*np.pi*params[4]))) \
    /(np.abs(x-v)-1j*np.pi*2*params[3])
    c = np.exp(-np.abs(x-(v+2*params[5]))/(v+2*params[6]))
    dv = a*v + b*((x**2+v**2)**1.5)*np.sin(2*np.pi*np.sum((np.abs(x-v)+1j*np.pi*2*params[7])/np.abs(v+1j*2*np.pi*params[8]))) \
    +c*(x+3*params[9]) + (x**3+v**3)*(2*params[10]*(x+3*params[11])) \
    +(x**4+v**4)*(2*params[12]*(x+3*params[13]))
    return dv
