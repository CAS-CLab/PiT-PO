    b0 = params[1]
    c0 = params[2]
    d0 = params[3]
    e0 = params[4]
    f0 = np.tanh(params[5]) * (x**3 + v**3)
    g0 = np.cosh(params[6]) * (x + v)
    h0 = np.arctan2(v, x) * (x**2 - v**2 + np.sqrt((x**2 + v**2)**3))
    i0 = (a0 * np.log(x) + b0 * np.log(v) +
      c0 * (x + v) + 
      d0 * (x**2 + v**2) + 
      e0 * (x + v)) / (x + v)
    j0 = (f0 * x + g0 * v + h0 * (x**2 + v**2)) / (x + v)
