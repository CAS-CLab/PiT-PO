     + x*v*(x**2*(v**2+16*params[7]*(x**2+v**2))*params[8]+2*x**2*v**2*2*params[9])

    dv = a + b + (x**4*(v**2*2-4*params[0]*(x**2+v**2)) + v**2*(x**2*(v**2+4*params[0]*(x**2+v**2))-2*x**2*v**2*params[1])* \
