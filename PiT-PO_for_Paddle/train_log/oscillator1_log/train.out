def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sin(np.pi*params[0]) * (x**2)
    b0 = np.cos(np.pi*params[1]) * (v**2)
    c0 = np.exp(-np.sqrt(params[2])*x) * x * v
    d0 = np.log(np.sqrt(params[3])) * x + \
    np.tan(np.arctan2(v, x)) * np.sin(np.pi*params[4])
    e0 = np.sqrt(params[5]) * x * (x + v)
    f0 = np.cosh(np.sqrt(np.sum([params[i] for i in range(6)]))*x) * x + \
     np.sinh(np.sqrt(np.sum([params[i] for i in range(6)]))*x) * v
    g0 = np.log(np.sqrt(np.prod([np.sin(np.pi*params[6]), np.cos(np.pi*params[7]), np.exp(-np.sqrt(np.sum([params[i] for i in range(8)]))*x), np.cosh(np.sqrt(np.sum([params[i] for i in range(9)]))*x)]))) * x + \
     np.log(np.sqrt(np.prod([np.sin(np.pi*params[6]), np.cos(np.pi*params[7]), np.exp(-np.sqrt(np.sum([params[i] for i in range(8)]))*x), np.cosh(np.sqrt(np.sum([params[i] for i in range(9)]))*x)]) * np.sin(np.pi*params[8]))) * v
    return a0 + b0 + c0 + d0 + e0 + f0 + g0
