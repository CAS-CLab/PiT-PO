    b0 = np.cos(params[4] * np.sqrt(params[5]))
    c0 = np.sin(params[4] * np.sqrt(params[5]))*np.exp(-2*params[6]*np.abs(v))
    d0 = np.sinh(np.sqrt(2*params[7])*(x+np.sign(v)*np.sqrt(params[8])))
