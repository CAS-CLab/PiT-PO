d = 1/(1+np.exp(-(x**3)/(2*np.sqrt(np.sum(np.square(v+np.sqrt(3*params[0])*x))))))
e = (d*(np.sqrt(2*params[3])*x)**3)/np.cos(np.sqrt(2*params[4]))
f = (x**5)*np.exp(-np.sum(np.abs(v+np.sqrt(3*params[0])*x))*np.sqrt(np.sum(np.square(v+np.sqrt(3*params[0])*x)))))
g = (f*3*np.sqrt(2*params[5])*v*np.sin(np.sqrt(2*params[6])*x))/(2*np.cos(np.sqrt(2*params[7])*x))
h = (f*3*np.sqrt(2*params[8])*v*np.cos(np.sqrt(2*params[9])*x))/(2*np.sin(np.sqrt(2*params[9])*x))
i = (h*np.exp(-np.sum(np.abs(v+np.sqrt(3*params[0])*x))))
j = ((-np.exp(-(x**3)/(2*np.sqrt(np.sum(np.square(v+np.sqrt(3*params[0])*x))))))*
     (np.sqrt(2*params[3])*x)**5)/np.cos(np.sqrt(2*params[4]))
dv = a*b*c+e+f*g+h*i+j
return dv
