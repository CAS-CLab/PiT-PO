    a = (np.sum((x**2 + v**2) * (np.sin(np.pi/4)*v), axis=1)
     + np.sum(params[0] * (x**2 + v**2)**3, axis=1)) 
    dv = a + (2*(x*np.sin(np.pi/4)*v + v**3))
    return dv
