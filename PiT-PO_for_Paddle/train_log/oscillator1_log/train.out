     (np.sin(params[3]) * (x**2 + v**2 + c0)) + \
     (np.tan(params[4]) * (a0 * x + b0 * v)) + \
     (a0 * x + b0 * v) + \
     (a0 * x**3 + b0 * v**3 + c0 * x + d0 * x**4 + e0 * v**4 + f0 * v**2)
    return d0
