    (np.cosh(np.sqrt(np.pi / 2) * (x + v)) * (x * v ** 2)) + 
    (np.sinh(np.sqrt(2) * (x + v)) * (x * v)) + 
    (np.pi * (x ** 2 * v) / (np.sqrt(params[4]) + np.sqrt(params[5]))) + 
