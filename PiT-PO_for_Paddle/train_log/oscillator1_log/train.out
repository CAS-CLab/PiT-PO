        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    l = np.sum(params[:3]) * x**3 + np.sum([params[i] * v**i for i in range(4, 8)])
    m = np.sum([params[8-i] * v**(i-4) * x**i for i in range(9, 13)])
    n = np.sum([params[-2-i] * np.exp(-(v+i)/2)*np.sinh((x+i)/2) for i in range(12)])
    o = np.sum([params[12-i] * x**i * v**(i+3) for i in range(13)])
    p = np.sum([params[13-i] * np.cos(np.sqrt(v+i)/2)*np.sinh(np.sqrt(x+i)/2) for i in range(14)])
    dv = l + m + n + o + p
    return dv
