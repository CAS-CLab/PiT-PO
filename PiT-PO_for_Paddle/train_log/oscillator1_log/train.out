def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = params[0]
    b0 = params[1]
    c0 = params[2]
    d0 = params[3]
    e0 = params[4]
    f0 = params[5]
    g0 = params[6]
    h0 = params[7]
    i0 = params[8]
    j0 = params[9]
    k0 = params[9]
    l0 = params[0] * v
    m0 = params[1] * x**2
    n0 = params[2] * v**3
    o0 = params[3] * x**4
    p0 = params[4] * np.sin(params[5] * x) * x
    q0 = params[5] * x**2 + params[6] * x + params[7]
    r0 = params[8] * x**3
    s0 = params[9] * np.cos(params[0] * v) * x
    t0 = a0 * l0 + m0 + n0 + o0 + p0 + q0 + r0 + s0
    u0 = params[1] * x**2 * v
    v0 = params[2] * x**3
    w0 = params[3] * v**2 * x
    x0 = params[4] * np.sin(params[5] * x) * v
    y0 = params[5] * x * v**2
    z0 = params[6] * x**2 * v + params[7] * x * v + params[8] * x**2 * v**2
    return (a0*b0*c0*d0*e0*f0*g0*h0*i0*j0*k0*l0+m0*n0*o0+p0*q0*r0*s0*t0+u0*v0*w0+x0*y0+z0)
