    u1 = np.sin(np.sqrt(params[0]) * x)
    u2 = np.sin(np.sqrt(params[1]) * v)
    a = u1 * (x**2 - 2*u2*x + u2**2) + \
    (u2 * (u2 * x + x * u2)) * (u2 ** 2 * x + u2 ** 2 * v) + \
    (u1 ** 2 * x + u1 ** 2 * v) + \
    (u1 * u2 ** 3) + \
    (u1 ** 3 * x + u2 ** 3 * y) + \
    (u1 * u2 * (u2 * x + x * u2)) + \
    u2 * (u2 * x + x * u2) + \
    (u1 * u2 ** 2 * x + u2 ** 2 * y)
    return a
