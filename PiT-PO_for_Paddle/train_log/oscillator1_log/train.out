         v**2*((x**2 + v**2)*np.sin(2*params[3]*v) - np.cos(2*params[4]*v)) +
         (params[5]*v**5 - 1/6*(x**3 + v**3)*np.sin(2*params[6]*v) +
          1/2*(x**5 - v**5)*np.cos(2*params[7]*v) + 
          1/12*np.sin(4*params[8]*x)*np.cos(2*params[9]*v)))
    dv = a
    return dv
