def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a2 = np.sin(np.sqrt(np.sum([params[i]**2 for i in range(10)])) * x) * (v**2 + x**2)
    b2 = np.sum([params[i] * v**i for i in range(10)])
    c2 = np.sum([params[10-i] * x**(i+2) for i in range(10)])
    d2 = np.sum([params[10-i] * v**(i+1) for i in range(10)]) * x
    e2 = np.exp(np.sum([np.log(params[i]) * x**i for i in range(10)]))
    f2 = np.cos(np.sqrt(np.sum([params[i]**2 for i in range(10)])) * v) * (x**2 + v**2)
    g2 = np.sum([x**(2*i-1) * v**(i) for i in range(1,11)])
    h2 = np.prod([x**i * v**(10-i) for i in range(10)])
    return a2 + b2 - c2 - d2 + e2 + f2 - g2 + h2
