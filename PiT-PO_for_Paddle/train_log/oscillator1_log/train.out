    0.5*params[0]*(x**2 + v**2), 
    0.25*params[1]*x**4, 
    0.25*params[2]*v**4, 
    0.01*np.sin(5*params[4]*x), 
    0.05*np.cos(3*params[6]*v), 
    0.1*x**3, 
    0.1*v**3, 
    0.1*x*v, 
