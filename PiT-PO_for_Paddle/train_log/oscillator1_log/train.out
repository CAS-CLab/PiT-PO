def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sin(2*np.pi*params[0]*x)
    b0 = np.cos(3*np.pi*params[1]*v)
    c0 = np.sin(4*np.pi*params[2]*x)
    d0 = np.sin(8*np.pi*params[3]*v)
    e0 = (c0*(x**7 - 14*np.sqrt(np.sum([np.square(p) for p in params[:9]]))*v**5)).real
    f0 = (d0*(x**11 - 11*np.sqrt(np.sum([np.square(p) for p in params[:9]]))*v**3)).real
    g0 = (np.cos(12*np.pi*params[4])*x**5).real
    h0 = (np.cos(24*np.pi*params[5])*v**7).real
    i0 = (np.sin(20*np.pi*params[6])*v**5).real
    j0 = (np.sin(28*np.pi*params[7])*v**9).real
    dv = \
    (a0 * (v**4 - 8*e0*v**2 + 8*d0*v) +
     b0 * (f0 * np.sin(c0 * x ** 3 + g0 * x)) +
     c0 * x ** 5 +
     h0 * x *
     i0 * (x ** 9 - 9 * j0 * v ** 3)) + \
    (np.cos(18*np.pi*params[8])*v**3)*(x**5 - v**3)
    return dv
