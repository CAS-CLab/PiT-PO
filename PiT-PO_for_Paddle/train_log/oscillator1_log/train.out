    (x**2*v**4*(x-1)**2 +
     0.25*params[6]*(x-1)*(x-1)*np.exp(-4*params[8]*v)) +\
    (x**2*np.sin(np.pi*params[1]*v) + v**2*np.cos(3*np.pi*params[3]*v))*(x**2 + v**2) +\
    (x**2*v**4*np.exp(-2*params[9]*v) + v**4*np.exp(-4*params[8]*v) + v**4*np.exp(-2*params[9]*v) + \
