    0.02*x*v + \
    0.035*(x**2 + v**2) + \
    0.045*(x + v) + \
    0.025*x*np.sin(2*np.pi*x) + \
    0.015*np.cos(v) + \
    0.02*x**2*v + \
    0.0025*(x**2 + v**2)**2 + \
    0.0125*(x**3 + v**3)*(x + v)
    )
    return a
