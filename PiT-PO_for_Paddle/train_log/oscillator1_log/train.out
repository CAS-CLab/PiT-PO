def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sin(np.sqrt(params[0]) * x)
    b0 = np.cos(np.pi/2 * v)
    f1 = (np.sin(np.sqrt(params[1]) * x)**3) / (1 + np.cos(2*params[2] * v))
    g0 = np.sinh(np.cosh(np.sqrt(params[3]) * (x**2 - v**2)))
    h0 = np.tanh(np.sqrt(params[4]) * x * v)
    i0 = (np.cosh(2*np.sqrt(params[5]) * (x**3 - v**3))) / np.sinh(np.sqrt(np.sum([params[i+6] for i in range(6)])) * (x**2 - v**2))
    j0 = (np.sinh(3*np.sqrt(np.sum([params[i] for i in range(10)])) * (x**5 - 5*x*v**3))) / (1 + np.cos(2*np.sqrt(np.sum([params[i] for i in range(10)])) * v))
    dv = (a0*(v**3 - 3*f1*(v + f1 * x))*(v + f1 * x) +
      b0*(g0*x + i0*(x**5 - 5*j0*x*v**2) + 
          h0*x*v + 
          j0*(v**3 - 3*f1*v*(v + f1 * x))))*x + \
      (g0*x + i0*(x**5 - 5*j0*x*v**2) + 
       j0*(v**3 - 3*f1*v*(v + f1 * x))) + \
      f1*(x + h0)*v + \
      j0*(v**3 - 3*f1*v*(v + f1 * x))
    return dv
