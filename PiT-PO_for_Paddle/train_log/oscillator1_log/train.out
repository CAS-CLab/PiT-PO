def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * (x**2 + v**2) + params[1] * x**3 + params[2] * v**3 + params[3] * np.sin(params[4] * x) + params[5] * np.cos(params[6] * v) + params[7] * x * v + params[8] * x**4 + params[9] * v**4
    b = params[0] * (x**3 + v**3) + params[1] * (x**5 - x**3) + params[2] * (x**7 - x**5) + params[3] * x * np.cos(params[4] * v) + params[5] * x * np.sin(params[6] * x) + params[7] * np.sin(params[8] * v)
    c = params[0] * (x**5 + v**5) + params[1] * (x**7 + x**5) + params[2] * (x**9 + x**7) + params[3] * x * np.cos(params[4] * v) + params[5] * x * np.sin(params[6] * x) + params[7] * np.sin(params[8] * v)
    dv = a + b - c
    return dv
