def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.exp(-v**2/10000)*np.sin(np.sqrt(a0/50)*x+np.pi/2)
    b0 = a0*np.cos(np.sqrt(a0/50)*x)*v
    c0 = np.sum([a0*(np.sinh(i*np.sqrt(a0/50)*x)+np.cosh(j*np.sqrt(a0/50)*x))*v for i,j in [(2,4),(5,6),(7,8)]])
    d0 = a0*np.sinh(np.sqrt(a0/50)*(x+v))
    e0 = (b0+a0*(v**2+np.tanh(np.sqrt(a0/50)*x)*x))/(1+np.cosh(np.sqrt(a0/50)*x)+np.tanh(np.sqrt(a0/50)*x)*x)
    f0 = (a0*(v**2+np.sinh(np.sqrt(a0/50)*x)*x))/(1+np.cosh(np.sqrt(a0/50)*x)+np.tanh(np.sqrt(a0/50)*x)*x)
    g0 = (a0/20)*(x-v)*np.tanh(np.sqrt(a0/50)*x)
    h0 = (a0/40)*v*(v**2-np.tanh(np.sqrt(a0/50)*x)*x)
    i0 = (a0/80)*v*(v**3-np.tanh(np.sqrt(a0/50)*x)*x)
    dv = a0 * v + b0 * np.sin(f0 * x) + \
     c0 * v**2 + \
     d0 * np.sin(d0 * v) + \
     e0 + \
     f0 * x * v + \
     g0 * x + \
     h0 * v + \
     i0 * v**3
    return dv
