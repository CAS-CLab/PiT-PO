     c0 * np.exp(-(x**2 + h0**2)) + \
     e0 * v * np.exp(-(x**2 + h0**2)) + \
     g0 * x + j0 * np.sin(2*x*v) + \
     np.exp(h0**2) * (v**2 + i0 * v**3)
    return dv
