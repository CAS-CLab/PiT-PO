def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0, b0, c0, d0, e0, f0, g0, h0, i0, j0, k0 = params
    l0 = a0 * v
    m0 = b0 * x**2
    n0 = c0 * v**3
    o0 = d0 * x**4
    p0 = e0 * np.sin(f0 * x) * x
    q0 = g0 * x**2 + h0 * x + i0
    r0 = j0 * x**3
    s0 = k0 * np.cos(a0 * v) * x
    t0 = l0 + m0 + n0 + o0 + p0 + q0 + r0 + s0
    u0 = h0 * x**2 * v
    v0 = i0 * x**3
    w0 = d0 * v**2 * x
    x0 = e0 * np.sin(f0 * x) * v
    y0 = f0 * x * v**2
    z0 = g0 * x**2 * v + h0 * x * v + i0 * x**2 * v**2
    dv = (j0 + k0)*r0 + (i0*h0 + e0*j0)*u0 + \
      (h0*g0 + e0*f0 + i0*d0)*w0 + \
      (g0*e0 + h0*f0 + i0*c0)*x0 + \
      (f0*d0 + g0*c0 + h0*b0)*y0 + \
      (e0*d0 + f0*b0 + g0*a0)*z0 + \
      (d0*v**3 + c0*v + b0*x**2)*v + \
      (c0*v**2 + b0*x)*(np.sin(2*x*v)) + \
      (b0*x*(np.cos(a0*v))) + \
      (a0*np.sin(b0*v))
    return dv
