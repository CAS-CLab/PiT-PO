def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (params[0] * x + params[1] * v + params[2]) * ((params[3] * x + params[4] * v + params[5]) *
                                                    (params[6] * (x + params[7] * v + params[8])) - 
                                                    2 * params[9] * (x + params[7] * v + params[8]))
    b = (params[8] * (x + params[7] * v + params[8])**2) * (params[0] * x + params[1] * v + params[2])
    c = (params[3] * x + params[4] * v + params[5]) * (params[0] * x + params[1] * v + params[2])
    d = (params[6] * (x + params[7] * v + params[8])) * (params[3] * x + params[4] * v + params[5])
    e = (x + v + 2*x*v) * (x + v + 2*x*v) * (x + v + 2*x*v)
    f = (x + v + 2*x*v) * (x + v + 2*x*v) * (x + v + 2*x*v)
    g = (x + v + 2*x*v) * (x + v + 2*x*v) * (x + v + 2*x*v)
    h = (x + v + 2*x*v) * (x + v + 2*x*v) * (x + v + 2*x*v)
    return a*b - c*d - e*f + g*h
