def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sum([np.power(params[0], k) * np.power(x, 2*k) for k in range(11)])
    b0 = np.sum([np.power(params[1], k) * np.power(v, 2*k) for k in range(11)])
    dv = (
    a0 +
    b0 * 
    (np.sin(np.pi/4* x)*np.cos(3*np.pi/4* v)) +
    (np.sin(np.pi/4* v)*np.cos(3*np.pi/4* x)) +
    (np.sum([np.power(params[6], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.power(v, 4)) +
    (np.sum([np.power(params[7], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.power(v, 2)) +
    (np.sum([np.power(params[8], k) * np.power(x, 2*k) for k in range(10)]) * 
     v) +
    (np.sum([np.power(params[9], k) * np.power(v, 2*k) for k in range(10)]) * 
     np.cos(2*np.pi* x)) -
    (np.sum([np.power(params[2], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.cos(np.pi/4* v)) +
    (np.sum([np.power(params[3], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.cos(3*np.pi/4* v)) +
    (np.sum([np.power(params[4], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.cos(np.pi/4* x)) +
    (np.sum([np.power(params[5], k) * np.power(x, 2*k) for k in range(10)]) * 
     np.sin(3*np.pi/4* v)) +
    (np.sum([np.power(params[6], k) * np.power(x, 2*k) for k in range(10)]) * 
     v)
    ) 
    return dv
