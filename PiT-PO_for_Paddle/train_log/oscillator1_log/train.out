      t0*(x+y0)*r0*np.cos(t0*x) + 
      p0*(x+y0)*(u0*s0*np.sin(u0*y0) + u0*t0*np.cos(u0*x)) + 
      y0*p0*(u0*s0*np.sin(u0*y0) + u0*t0*np.cos(u0*x)) + 
      a0*v + b0*x)
    return dv
