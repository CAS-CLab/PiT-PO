def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0, b0, c0, f0, e0, f1, g0, h0, i0, j0 = np.array(
    [np.mean(np.abs(params)), 
     np.std(np.abs(params)), 
     np.var(np.abs(params)), 
     np.mean(np.abs(np.sin(np.array(params))), axis=0), 
     np.std(np.abs(np.sin(np.array(params))), axis=0), 
     np.var(np.abs(np.sin(np.array(params))), axis=0), 
     np.mean(np.abs(np.array(x))**3, axis=0), 
     np.std(np.abs(np.array(x))**3, axis=0), 
     np.var(np.abs(np.array(x))**3, axis=0), 
     np.mean(np.abs(np.array(v))**3, axis=0)])

    dv = \
    (a0*(np.array(v)**2 - 2*e0*np.array(v))) + \
    (b0*np.sin(f0*np.array(x))) + \
    (c0*np.array(x)**3) + \
    (f1*np.array(x)*np.array(v)) + \
    (g0*np.array(x)) + \
    (h0*np.array(v)) + \
    (i0*np.array(x)**5) + \
    (j0*np.array(v)**3)

    return dv
