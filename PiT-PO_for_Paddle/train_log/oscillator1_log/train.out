def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = 0.5*params[0]*(x+v)**2*(x-v)**2*(
    0.25*(x-v)**2*np.sin(params[0]*(x+0.5*v)) +
    0.25*(x+v)**2*np.cos(2*params[0]*(x+0.5*v))
    )

    b0 = (
    0.0625*(x-v)**4*np.sin(4*params[0]*(x+0.5*v)) +
    0.0625*(x+v)**4*np.cos(4*params[0]*(x+0.5*v))
    )

    c0 = (
    0.03125*(x-v)**2*np.cos(2*params[0]*(x+0.5*v)) +
    0.03125*(x+v)**2*np.sin(2*2*params[0]*(x+0.5*v))
    )

    dv = a0 + b0 + c0 + \
     0.125*(x**2 - v**4)*np.sin(5*params[0]*(x+0.5*v)) + \
     0.0625*x*np.sin(3*params[0]*(x+0.5*v)) + \
     0.125*v*np.sin(3*2*params[0]*(x+0.5*v)) + \
     0.0625*v**5*np.cos(5*2*params[0]*(x+0.5*v))
    return dv
