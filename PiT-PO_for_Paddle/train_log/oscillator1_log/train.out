     3*np.sum(b*x + np.sqrt(params[8]**2 + v**2)*a*(a**2), axis=0)) / (a + b)

    dv = (a**3 - 3*b*(a**2), a**3 - 3*b*(a**2), a**3 - 3*b*(a**2))
    return dv
