    params[1] * (x**3 + v**3) +\
    params[2] * x * v +\
    params[3] * (x**2 + v**2) +\
    params[4] * (x + v) +\
    params[5] * (x*np.sin(2*np.pi*x)) +\
    params[6] * np.cos(v) +\
    params[7] * x**2 * v +\
    params[8] * ((x**2 + v**2)**2 + x*v*(x-v)) +\
    params[9] * (x**3 + v**3)*(x+v)
    return a
