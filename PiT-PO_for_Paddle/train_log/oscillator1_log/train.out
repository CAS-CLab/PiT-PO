    (params[0] * (x + v)) * \
    (x**2 + v**2) + \
    (params[1] * (x**3 + v**3)) * \
    (x + v) + \
    (params[2] * (x**4 - v**4)) * \
    (x * np.sin(x) + v * np.cos(x)) + \
    (params[3] * (np.exp(-v) + np.exp(x))) * \
    (x**2 + v**2) + \
    (params[4] * (x * v + x * np.sin(x))) * \
    (x**3 + v**3) + \
    (params[5] * (x * v + x * np.sin(x))) * \
    (x**2 + v**2) + \
    (params[6] * (x * v + x * np.sin(x))) * \
    (x + v) + \
    (params[7] * (x * v + x * np.sin(x))) * \
    (x**2 + v**2) + \
    (params[8] * (x * v + x * np.sin(x))) * \
    (x + v) + \
    (params[9] * (x**3 + v**3)) * \
    (x + v)
