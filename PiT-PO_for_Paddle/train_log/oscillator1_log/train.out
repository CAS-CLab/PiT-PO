     np.sum(params[3:6] * x[:, None] + params[6:9] * v[:, None])) * \
    (np.sum(params[9:] * (x[:, None]**2 + v[:, None]**2)) +
     np.sum(params[0:3] * x[:, None]**2 + params[6:9] * v[:, None]**2))
    return a
