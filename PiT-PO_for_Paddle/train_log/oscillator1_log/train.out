    b0 = np.cos(np.sqrt(params[1]) * x) * v + np.sin(np.sqrt(params[1]) * v) * x
    c0 = (x ** 4) * (v ** 2) + (x ** 2) * (v ** 4) + (x * v) ** 2 * (np.sqrt(params[5]) * v - np.sqrt(params[5]) * x)
