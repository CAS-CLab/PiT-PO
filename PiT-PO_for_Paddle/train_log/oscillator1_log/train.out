     (params[3] * x + params[4] * np.sin(params[5] * v)) + \
     (params[6] * v**3 + (params[7] + a0) * x**4) + \
     ((a0 + b0 * v) * x + (a0 + b0 * v) * v**2 + (a0 + b0 * v)**2 * x**2)
    return d0
