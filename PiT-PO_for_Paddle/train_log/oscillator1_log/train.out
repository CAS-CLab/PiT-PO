    (v**2 + (x - np.exp(-(x**2 + v**2)/(np.sqrt(v**2)* 2)))**2) + \
    (x**4 + v**5) + \
    (x**2 + v**2)**(np.sqrt(v**2)* 4) * (np.sin(np.pi* np.sqrt(x**2)* x) * (v**2 + x**2))
    dv = a
    return dv
