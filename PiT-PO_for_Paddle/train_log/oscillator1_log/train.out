def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sin(np.sqrt(params[0]) * x) / np.sqrt(params[0]))
    b = (v**2 * (np.cosh(np.sqrt(params[1]) * v) - 1)) / (2 * np.sqrt(params[1]))
    c = (np.tanh(np.sqrt(params[2]) * v) * (np.exp(np.sqrt(params[3]) * x) - 1)) / (np.exp(np.sqrt(params[4]) * v) - 1)
    d = (np.sinh(np.sqrt(params[5]) * x) * v**3) / (3 * np.sqrt(np.pi) * np.cosh(np.sqrt(np.pi) * v))
    e = (x**4 * (np.exp(np.sqrt(params[6]) * x) - 1)) / (4 * np.sqrt(np.pi) * np.cosh(np.sqrt(np.pi) * v))
    f = (x * v * (np.sinh(np.sqrt(np.pi) * v) - 1) * (np.exp(np.sqrt(np.pi) * x) - 1)) / (2 * np.sqrt(np.pi) * (np.cosh(np.sqrt(np.pi) * v) - 1))
    dv = a + b + c + d + e + f
    return dv
