    (
    (x + v**2) * (x**2 * np.sin(params[0] * v) + v**3 * np.cos(params[1] * x)) + \
    (x * v**2 + v**3 * x) * (np.sqrt(np.sum([params[2], params[3]], axis=0)) * (x**2 + v**2)) + \
    (x**2 * v + x * v**2 + v**3 * x) * (np.sin(2*np.pi*params[4]*x) * np.cosh(2*params[5]*v)) + \
