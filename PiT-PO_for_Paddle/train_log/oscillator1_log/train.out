     - 3*params[1]*x*v 
     - 3*params[2]*v*x 
     + np.sum(np.sin(2*np.pi*(x+0.5*params[3]))*params[4]) 
     + np.sum(np.cos(2*np.pi*(v+0.5*params[5]))*params[6]) 
     - 2*np.sum(x*v**3*params[7])
     + np.sum(v**5*params[8]))
    dv = a
    return dv
