def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(params[:3]) * x**7 + np.sum([p for p in params[3:] if p % 2 == 0]) * x**5 * v +
     np.sum([p for p in params[3:] if p % 3 == 0]) * x**3 * v**2 + 
     np.sum([p for p in params[3:] if p % 4 == 0]) * x * v**3 + 
     np.sum([p for p in params[3:] if p % 5 == 0]) * x**4 * v**2 + 
     np.sum([p for p in params[3:] if p % 6 == 0]) * x**2 * v**4 + 
     np.sum([p for p in params[3:] if p % 7 == 0]) * x * v**5 + 
     np.sum([p for p in params[3:] if p % 8 == 0]) * v**6 + 
     np.sum([p for p in params[3:] if p % 9 == 0]) * x**2 + 
     np.sum([p for p in params[3:] if p % 10 == 0]) * x*v**3)
    b = np.sum(np.array(params[3:]) * (x + np.sum([p for p in params[3:] if p % 11 == 0]) * v + np.sum([p for p in params[3:] if p % 12 == 0])))
    c = np.sum(np.array(params[3:]) * (x + np.sum([p for p in params[3:] if p % 13 == 0]) * a))
    dv = (a**3 - 3*b*c)/c
    return dv
