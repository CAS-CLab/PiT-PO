    a = (np.sum([params[i] * (x + v)**i for i in range(10)])) + \
    (np.sum([params[i+10] * np.sin(np.pi * x**i) for i in range(10)])) + \
    (np.sum([params[i+20] * np.cos(np.pi * v**i) for i in range(10)]))
    dv = a
    return dv
