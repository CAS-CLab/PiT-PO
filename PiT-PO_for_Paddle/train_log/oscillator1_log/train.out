    a = (np.sum([params[i] * (x**i + v**i) for i in range(10)])) + \
    (np.sum([-np.exp(-(x**2 - v**2)/2), np.exp(-(v**2 - x**2)/2)]) * np.sum([x**(2*i+1), v**(2*i+1)]) / 12)
    dv = a
    return dv
