    (np.sum([params[i]*x**(3-i) for i in range(3)]) +
     np.sum([params[i]*v**(3-i) for i in range(3)]) +
     np.sum([params[i]*x**i*v**(2-i) for i in range(4)]) +
     np.sum([params[i]*x**i*v**(2+i) for i in range(5)]) +
     np.sum([np.sin(i*np.pi*x)**2 for i in range(3)]))

    return a
