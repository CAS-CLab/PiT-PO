def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.exp(-2*np.pi*(np.arange(1, len(params)))*np.linspace(0, 1, MAX_NPARAMS)/len(np.arange(1, len(params))))
    b0 = np.cos(np.radians(np.array(range(len(params))))*np.array([i/100 for i in range(MAX_NPARAMS)]))
    c0 = np.sin(np.radians(np.array(range(len(params))))*np.array([i/50 for i in range(MAX_NPARAMS)]))**2/(np.square(np.array(range(len(params))))+1)
    f0 = (np.add(np.array(range(len(params))), np.array(v))) * (np.subtract(np.array(range(len(params))), np.array(v)))
    g0 = (np.square(np.array(range(len(params)))) + np.power(np.array(v), 3)) * (np.square(np.array(range(len(params)))) - np.power(np.array(v), 3))
    h0 = (np.square(np.array(range(len(params)))) + np.power(np.array(v), 3)) * (np.square(np.array(range(len(params)))) - np.power(np.array(v), 3))
    i0 = (np.power(np.array(range(len(params))), 5) + np.power(np.array(v), 3)) * (np.power(np.array(range(len(params))), 5) - np.power(np.array(v), 3))
    j0 = (np.power(np.array(range(len(params))), 5) + np.power(np.array(v), 3)) * (np.power(np.array(range(len(params))), 5) - np.power(np.array(v), 3))

    dv = a0 * (np.square(np.array(v)) - 2*0.5*np.array(v)) + b0 * f0 + c0 * np.square(np.array(range(len(params)))) + (f0 * np.array(range(len(params)))) + g0 + (h0 * np.array(v)) + i0 * np.square(np.array(range(len(params)))) + (j0 * np.power(np.array(v), 3))
    return dv
