    a = np.exp(-1*params[0]*np.abs(v))
    b = np.sin(params[1]*v)*np.cos(np.sqrt(2)*x)
    c = (1/2)*(np.tanh(params[2]*x) - 1)/(np.cosh(params[3]*x)**2)
    d = np.exp(-(x+np.abs(v))**2/(2*params[4]))
    e = np.log(np.sqrt(1+np.tanh(params[5]*x)))
    f = np.sqrt(np.pi*params[6]) * np.exp(-((x-np.pi/2)/np.sqrt(2*params[7]))**2)
    g = (1-params[8])*np.cos(2*np.arctan2(v, x)) + np.exp(params[9]*x)
    return a*b*c*d*e*f*g
