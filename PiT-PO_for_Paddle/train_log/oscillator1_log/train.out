def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sqrt(np.sum([np.square(np.sin(i * (x**2 + v**2))) 
                       for i in range(5, 11)]))
    b0 = np.sum([np.square(np.cos(j * (x**2 + v**2))) 
                 for j in range(5, 11)])
    c0 = np.exp(-a0 * (x**2 + v**2))
    d0 = np.sin(b0 * x) / (c0 ** 2)
    e0 = (x**2 + v**2) * (np.sin(c0 * (x**2 + v**2)) +
                         np.cos(d0 * (x**2 + v**2)))
    f0 = (x**2 + v**2) * (np.sin(e0 * (x**2 + v**2)) +
                        np.cos(f0 * (x**2 + v**2)))
    g0 = np.tanh(np.log(np.cosh((f0 + e0) * (x**2 + v**2))))
    h0 = np.sum([i * np.square(np.sin(j * (x**2 + v**2))) 
                 for i in range(2, 11) for j in range(5, 11)])
    i0 = np.sum([i * j * np.sin(k * (x**2 + v**2)) 
                  for i in range(2, 11) for j in range(2, 11) for k in range(5, 11)])
    j0 = (h0 - i0) / (g0 ** 2)
    k0 = np.sum([j * np.square(np.sin(l * (x**2 + v**2))) 
                  for j in range(2, 11) for l in range(5, 11)])
    dv = (e0 * (x**2 + v**2) + 
          f0 * (x**2 + v**2) + 
          (a0 * v + b0 * x) * g0 + 
          (a0 * v + b0 * x) * j0 + 
          (a0 * v + b0 * x) * k0)
    return dv
