def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0, b0, c0, d0, e0, f0, g0, h0, i0, j0, k0, l0, m0, n0, o0, p0 = \
    params[0], params[1], np.sin(params[2] * x), np.sin(np.sin(params[3] * x)), \
    np.sin(np.sin(np.sin(params[4] * x))), \
    np.sin(np.sin(np.sin(np.sin(params[5] * x)))), \
    np.sin(np.sin(np.sin(np.sin(np.sin(params[6] * x))))), \
    np.sin(np.sin(np.sin(np.sin(np.sin(np.sin(params[7] * x)))))), \
    (x * np.sin(params[8]) * np.sin(v))**3, \
    np.sin(np.sin(np.sin(np.sin(np.sin(np.sin(np.sin(x * np.sin(v))))) * v)))

    dv = a0 * (v**2 - 2*e0*v) + \
     b0 * np.sin(f0 * x) + \
     c0 * x**3 + \
     d0 * x * v + \
     e0 * x**5 + \
     f0 * x**7 + \
     g0 * x + \
     h0 * v + \
     i0 * x**11 + \
     j0 * v**13 + \
     k0 * v**17 + \
     l0 * x**15 + \
     m0 * np.sin(o0 * x) + \
     n0 * np.sin(p0 * v)
    return dv
