def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.random.uniform(-10, 10)
    b0 = np.random.uniform(-10, 10)
    c0 = np.random.uniform(-10, 10)
    d0 = np.random.uniform(-10, 10)
    e0 = np.random.uniform(-10, 10)
    f1 = np.random.uniform(-10, 10)
    g0 = np.random.uniform(-10, 10)
    h0 = np.random.uniform(-10, 10)
    i0 = np.random.uniform(-10, 10)
    j0 = np.random.uniform(-10, 10)
    k1 = np.random.uniform(-10, 10)

    m = len(v)
    n = m*(m-1)//2

    dv = \
    a0 * v + \
    b0 * np.sum(np.sin(f1 * x[:, None]) * v) + \
    c0 * np.sum((x[:, None] - e0 * v[:, None])**2) + \
    g0 * x + \
    h0 * v + \
    i0 * np.sum(v**3) + \
    j0 * np.sum(np.sin(2*x[:, None]*v[:, None])) + \
    k1 * np.sum(np.cos(g0 * x + h0 * v + i0 * v**3))

    return dv
