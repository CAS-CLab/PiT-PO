    (b0 * np.sin(3*np.pi*(x**2 + 2*params[3]*v))) + \
    (c0 * (x**3 - 3*np.sqrt(np.sum([np.square(p) for p in np.array([4*a0, 2*b0, 3*c0, 5*dv, 6*e0, 7*f1, 8*g0, 9*h0, 10*i0, 11*j0])]))*v**5)) + \
