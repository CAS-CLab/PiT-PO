def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sin(np.sqrt((x**2)*(v**2))*x)
    b0 = np.cos(np.sqrt((x**2)*(v**2))*x)
    c0 = np.exp(-(x - np.dot(params[:3], x)/np.add(v, np.dot(params[3:], v))))
    d0 = a0 + b0 + c0
    dv = d0 + \
     np.dot(np.array([np.sin(2*np.pi*params[4]*x), np.sin(2*np.pi*params[5]*x)]),
           np.array([x, v])) + \
     0.25*(np.cos(2*np.pi*2*params[4]*x)-1)*v**3 + \
     0.0625*(np.cos(2*np.pi*2*params[5]*x)-1)*v**5 + \
     np.sum(np.square(np.dot(np.array([1, 2, 3])*v, np.array([1, 2, 3])*v))) + \
     np.dot(np.array([1, 2, 3])*v, np.array([1, 2, 3])*v) * \
     (np.cos(np.pi*params[6]*x) - 1) + \
     np.dot(np.array([1, 2, 3])*v, np.array([1, 2, 3])*v)**1.5 * \
     (np.cos(np.pi*2*params[7]*x) - 1) + \
     np.sum(np.square(np.dot(np.array([1, 2, 3])*v, np.array([1, 2, 3])*v)))
    return dv
