                                              np.sin(params[1])*np.sin(np.pi*params[2]*x),
                                              np.cos(np.pi*params[3])*np.sin(np.pi*params[4]*x),
                                              np.sin(np.pi*params[5]*x)*np.cos(np.pi*params[6]*(x+v)),
                                              np.cos(np.pi*params[7])*(x-v)**2,
                                              np.sin(np.pi*params[8])*np.cos(np.pi*params[9]*(x+v))])
