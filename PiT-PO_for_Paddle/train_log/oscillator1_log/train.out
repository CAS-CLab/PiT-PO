    (x**3 + v**3) * (np.sum([params[i]*np.cos(params[i+5]*x) for i in range(0, 9, 2)])) + \
    (x*v) * (np.sum([params[i]*np.sin(params[i+1]*x) for i in range(0, 9, 2)])) + \
    (x**4 + v**4) * (np.sum([params[i]*np.sin(params[i+5]*x) for i in range(0, 9, 2)])) + \
    (x**5 + v**5) * (np.sum([params[i]*np.cos(params[i+3]*v) for i in range(0, 9, 2)]))
