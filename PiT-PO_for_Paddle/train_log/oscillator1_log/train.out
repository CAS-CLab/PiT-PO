def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a0 = np.sum([x**(7*i+3)*v**(14*i+3) for i in range(5)])
    b0 = np.cos(np.pi*(x**2+1)*np.sum([i*np.cos(2*np.pi*i*x) for i in range(5)]))
    c0 = (np.sin(np.pi*x))**4/(x**2+1)
    d0 = np.sin(3*np.pi*x)/x**2
    e0 = np.sum([i*np.tanh(i*x) for i in range(5)])
    f0 = np.pi*(x**2+1)
    g0 = np.sum([i*np.cos(2*np.pi*i*x) for i in range(5)])
    h0 = np.pi*np.sin(2*np.pi*x)
    i0 = np.sum([i*np.cosh(i*x) for i in range(5)])
    j0 = np.sum([i*np.sinh(i*x) for i in range(5)])
    u = (v**2 - 2*e0*v) + np.sin(f0*x) + \
    c0*x**3 + g0*x + \
    h0*v + i0*(x**5 - 3*j0*v**3) + \
    d0*(x**3 - np.pi/2)**2 + \
    np.exp(d0*(x-v)) * \
    (f0*x + g0*(x-v) + np.sin(h0*(x-v)))
    dv = a0*u + b0*g0*(x-v) + \
    c0*(x**3 - np.pi/2)**2 + \
    g0*x + \
    h0*v + \
    i0*(x**5 - 3*j0*v**3) + \
    d0*(x**3 - np.pi/2)**2 + \
    np.exp(d0*(x-v)) * \
    (f0*x + g0*(x-v) + np.sin(h0*(x-v)))
    return dv
