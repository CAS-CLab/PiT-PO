def equation(x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum(np.square(v), axis=0) +
     np.sum(np.square(x), axis=0)) * (v**2 - x**2) / np.sum(x**2, axis=0)
    b = np.sum(np.sin(2 * np.pi * np.arange(len(v)) * np.sqrt(np.sum(x**2, axis=0))) * x, axis=0)
    c = np.sum(np.exp(-2 * np.pi * np.arange(len(v)) * np.sqrt(np.sum(x**2, axis=0))) * v, axis=0)
    d = np.dot(x, v) * np.sum(np.sqrt(np.sum(x**2, axis=0)))
    e = np.exp(2 * np.pi * np.arange(len(v)) * np.sqrt(np.sum(x**2, axis=0))) - 1
    f = (np.sum(np.exp(2 * np.pi * np.arange(len(v)) * np.sqrt(np.sum(x**2, axis=0)))) - 1) * np.exp(-2 * np.pi * np.arange(len(v)) * np.sqrt(np.sum(x**2, axis=0)))
    dv = a + b + c + d + e + f
    return dv
