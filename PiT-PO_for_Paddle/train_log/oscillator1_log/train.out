    a0 = params[0]
    b0 = np.sin(np.pi * (v + 1)**2 * (x ** 2 + 1))
    c0 = np.exp(-0.05*(x-1)**2)
    d0 = np.sin(0.02*np.sqrt(v+1)*x)
    e0 = np.sqrt((np.cos(1.1*x)-1)**2+(np.sin(0.8*v)-1)**2)
    f0 = np.pi * np.arccos(np.dot((x-1), (x-1)))
    g0 = np.tanh(0.01*x)
    h0 = x * v * (x-1) * (v-1)
    i0 = np.log(np.exp(0.005*(x**2+v**2))+1)
    j0 = np.sin(0.015*x-v)
    k1 = np.cos(0.0005*f0* x + 0.001*h0*v + 0.002*i0*v**3)
    dv = a0 * v + b0 * x + \
     c0 * (x-1)*(x-1) + \
     d0 * (v-1)*(v-1) + \
     e0 * (x-1) + \
     f0 * (v+1) + \
     g0 * (x-1) + \
     h0 * v + \
     i0 * v**3 + \
     j0 * (x-1) + \
     k1 * x
    return dv
