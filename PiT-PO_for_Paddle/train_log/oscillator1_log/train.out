    (params[0] * (x ** 2) * (v ** 2)) + 
    (np.sin(2 * np.pi * v) * (x ** 2) * (v ** 3)) + 
    (np.cos(2 * np.pi * (x + v)) * (x * v)) + 
    (np.exp(np.log(params[1]) * (x + v)) * (x ** 2 * v)) + 
    (np.tanh(np.sqrt(params[2]) * v) * (x * v ** 3)) + 
