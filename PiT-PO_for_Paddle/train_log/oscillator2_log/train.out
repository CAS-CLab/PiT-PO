    (x/2) * (t**2) + 
    (x**2) + 
    (v*(t+x)) + 
    (x**2/v) + 
    (t**2/v)
    )
    c = (v**3)/(16*np.sqrt(1+(v**2/4)))
    d = (v*(t-x)) + (x**2/v)
