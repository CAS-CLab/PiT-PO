def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * t + \
    0.5 * (params[1] * (t + x)**2 * (x + 2*v)) + \
    0.25 * ((params[2] * (t + v)**2 * x) + (params[3] * (v - x)**2 * v)) + \
    0.125 * (np.sin(2*np.pi*params[4]*(t + x/2)*v) * (2*x + v*t)) + \
    0.0625 * (np.cos(np.pi*params[5]*(t + x/2)*v) * (2*x + v*t)) + \
    0.03125 * (np.sin(np.pi*params[6]*(t + x/2)*v) * (2*x + v*t)) + \
    0.015625 * (np.cos(np.pi*params[7]*(t + x/2)*v) * (2*x + v*t)) + \
    0.0078125 * (np.tanh(0.5*params[8]*(t + v/2))*x**3 + np.tanh(0.5*params[9]*(t + v/2))*v**2)

    dv = a + (np.sin(0.5*params[2]*t)*x**3 + np.cos(0.5*params[2]*t)*v**2 + np.sin(0.5*params[8]*t)*x**3 + np.cos(0.5*params[8]*t)*v**2 + np.sin(0.5*params[9]*t)*x**3 + np.cos(0.5*params[9]*t)*v**2)
    return dv
