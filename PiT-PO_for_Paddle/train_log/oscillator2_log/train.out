    + (-x**2*np.cos(np.radians((np.pi/6)*t)) + x*v + v**2*np.sin(np.radians((np.pi/12)*t)))\
    + (x*np.cos(np.radians((np.pi/4)*t)) + v*np.sin(np.radians((np.pi/3)*t)))
    return a
