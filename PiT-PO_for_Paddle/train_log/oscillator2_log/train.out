    0.5 * (params[0] * (x - 2 * t**2 + 0.5 * t**4)) + 
    params[1] * t * (v - 2 * t * x + t**3) + 
    0.25 * (t**2 + x**2) * (v**2 - 0.04 * t**2 + 0.02 * x**2)
    )
    b = 0.5 * (t**2 + 2*x*t) * (v**2 + 0.015 * t**2 - 0.005 * x**2)
    dv = a + b
    return dv
