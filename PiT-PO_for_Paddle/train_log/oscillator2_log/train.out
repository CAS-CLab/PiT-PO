                   np.sin(np.sqrt(1 + (x + v)**2)*np.pi/2) + \
                   x * np.cos(np.arcsin((v - u)/np.sqrt(1 + (x + v)**2)))

    dv_dt_quadratic = 2*(x + v)*du_dt

