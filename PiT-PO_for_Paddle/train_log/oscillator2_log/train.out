    d = np.sin(np.sqrt(params[2])*t)*np.cos(np.pi*(np.sqrt(params[2])*t - np.pi/2))
    e = np.sin(2*np.pi*params[7]*t)/2
    f = np.cos(2*np.pi*params[7]*t)/2
    dv = (a * x + b * v + c * t) + \
     e * (np.sin(2*np.pi*params[7]*t) * np.sin(2*np.pi*params[7]*t) / f +
          np.cos(2*np.pi*params[7]*t) * np.cos(2*np.pi*params[7]*t) / f *
