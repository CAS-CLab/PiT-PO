def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(2*np.pi*t)**2*(x - 0.5*params[7]*v**2 - 0.25*params[7]**2*t**2 + \
                           0.125*params[7]*t**3*(t-1) + \
                          0.0625*params[7]*t**4*((t-1)**2 - 8*t**2))
    b = (t**2 + 2*2*np.pi*t + 12*np.pi**2)*(x - 0.5*np.cos(2*np.pi*t) - \
                         0.125*np.cos(2*np.pi*t)*t**2*(t-1) + \
                        0.0625*np.cos(2*np.pi*t)*t**3*((t-1)**2 - 8*t**2))
    c = (v**2 + 2*0.0625*3*np.pi**2*t**2 - 2*0.0625*3*np.pi**2*t**4 + \
         0.03125*3*np.pi**2*t**6*((t-1)**2 - 8*t**2))*0.1875*2*np.pi*3*np.pi**2*t**2
    dv = b*a + c + x**2*(0.5*2*np.pi*3*np.pi**2*t**2 - 2*0.0625*3*np.pi**2*t**4 + \
                      0.03125*3*np.pi**2*t**6*((t-1)**2 - 8*t**2)) + \
       v**2*(0.125*2*np.pi*3*np.pi**2*t**4 - 0.0625*2*np.pi*3*np.pi**2*t**6 + \
            0.03125*2*np.pi*3*np.pi**2*t**8*((t-1)**2 - 8*t**2)) + \
      0.5*x*v*(2*np.pi*3*np.pi**2*t**2 - 0.125*2*np.pi*3*np.pi**2*t**4 + \
               0.0625*2*np.pi*3*np.pi**2*t**6*((t-1)**2 - 8*t**2))
    return dv
