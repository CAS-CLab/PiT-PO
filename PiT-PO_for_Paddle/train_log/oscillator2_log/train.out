def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(3*params[2]*t) + \
    (params[7]*(x**3 + v**2)/np.sqrt(x**2 + v**2)) + \
    (params[6]*t*(t-2*np.pi/3)) + \
    (params[1]*t*np.cos(2*t)) + \
    (np.sin(np.pi/2)*v) + \
    (np.sin(np.pi/2)*x*np.cos(2*t))
    b = (3*x**2*np.sin(3*np.pi*t))/np.sqrt(x**2 + v**2) + \
    (2*v*np.cos(2*np.pi*t))*v + \
    (np.sin(np.pi/2)*x**2*np.cos(2*t)) + \
    (np.sin(2*np.pi*t)*(np.sin(2*np.pi*t)-1)*np.sin(3*np.pi*t)/2) + \
    (np.sin(2*np.pi*t)*(np.sin(2*np.pi*t)+1)*np.sin(5*np.pi*t)/2 + \
     np.sin(2*np.pi*t)*np.sin(4*np.pi*t)*np.sin(6*np.pi*t)/4)
    dv = a + b - (np.sin(2*np.pi*t)*x*np.sin(2*np.pi*t)*np.sin(3*np.pi*t)/2 - \
             np.sin(2*np.pi*t)*x*np.sin(4*np.pi*t)*np.sin(5*np.pi*t)/2 + \
             np.sin(2*np.pi*t)*x*np.sin(6*np.pi*t)/2 + \
             np.sin(2*np.pi*t)*y*np.sin(2*np.pi*t)*np.sin(3*np.pi*t)/2 - \
             np.sin(2*np.pi*t)*y*np.sin(4*np.pi*t)*np.sin(5*np.pi*t)/2 + \
             np.sin(2*np.pi*t)*y*np.sin(6*np.pi*t)/2 + \
             0.05*np.sin(2*np.pi*t)*np.sin(4*np.pi*t)*np.sin(6*np.pi*t)/4 + \
             0.01*np.sin(2*np.pi*t)*np.sin(6*np.pi*t))
    return dv
