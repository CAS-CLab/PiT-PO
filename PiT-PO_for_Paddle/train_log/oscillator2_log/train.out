    params[0] * t**2 + 
    params[1] * x * v + 
    params[2] * v**2 + 
    params[3] * (x + params[4] * v)**2 + 
    params[5] * (t**2 - 2*t*params[6]*np.sin(params[7] * t) - 2*params[8]*t*np.cos(params[8] * t))
    )
    return a
