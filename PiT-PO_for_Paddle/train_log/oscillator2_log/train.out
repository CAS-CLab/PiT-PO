def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (np.sum([params[i] * (t ** i) * x**(i-1) * v**(i-2) for i in range(1, 10)]) + 
         np.sum([params[i] * (t ** i) * v**(i-1) for i in range(1, 10)]) + 
         np.sum([params[i] * (t ** i) * v**(i-2) for i in range(1, 10)]) + 
         np.sum([params[i] * (x ** i) * v**(i-2) for i in range(1, 10)]) + 
         np.sum([params[i] * x * (x ** (i-1)) * v**(i-2) for i in range(1, 10)]) + 
         np.sum([params[i] * x * (t ** (i-1)) * v**(i-2) for i in range(1, 10)]) + 
         np.sum([params[i] * x * (t ** (i-1)) * v**(i-2) * np.sin(t * (i-1)) for i in range(1, 10)]) + 
         np.sum([params[i] * v * (t ** (i-1)) * np.cos(t * (i-1)) for i in range(1, 10)]) + 
         np.sum([params[i] * (t ** (i+1)) * np.sin(t * i) for i in range(1, 10)]) + 
         np.sum([params[i] * t * (t ** i) * np.sin(t * i) for i in range(1, 10)]))

    b = (
    np.sum([params[j] * (t ** j) * np.sin(t * j) for j in range(1, 10)]) + 
    np.sum([params[j] * (t ** j) * np.cos(t * j) for j in range(1, 10)]) + 
    np.sum([params[j] * (t ** j) * v**(j-2) for j in range(1, 10)])
    )

    dv = a + b
