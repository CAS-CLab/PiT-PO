    (v**2*(np.exp(2*t)-1))/np.sqrt(3) + \
    (np.sin(2*np.pi*t)*(x-v)/2) + \
    ((-np.sin(np.pi*t/2))*v)/(np.pi/2) + \
    (-x*v*np.cos(np.pi*t/2))/(np.pi/2) + \
    (t**3)/3 + \
    x/(np.pi*3**(1/2)*np.tanh(np.pi*t/2))
    return a
