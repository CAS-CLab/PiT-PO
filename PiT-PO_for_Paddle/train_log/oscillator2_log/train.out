def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = 0.5*(x**2 - 2*v**2) + \
    0.25*params[8]*np.cos(np.pi*t)*(x + v)**2 + \
    0.0625*params[8]*x*np.sin(np.pi*t) + \
    0.0625*params[8]*v*np.sin(np.pi*t) + \
    0.03125*params[9]*x**2*np.cos(2*np.pi*t) + \
    0.03125*params[9]*v**2*np.cos(2*np.pi*t) + \
    0.015625*params[9]*x*np.sin(2*np.pi*t) + \
    0.015625*params[9]*v*np.sin(2*np.pi*t) + \
    0.0078125*(x**3 + v**3)*np.cos(np.pi*t) + \
    0.0078125*0.5*params[6]*np.sin(np.pi*t)*(x**3 - 3*x*v**2)
    dv = a + 0.75*0.5*params[7]*x**3 + \
      0.75*0.5*0.5*params[7]*v**2 + \
      0.75*0.25*0.5*params[7]*x*np.sin(np.pi*t) + \
      0.75*0.25*0.5*0.5*params[7]*v*np.sin(np.pi*t)
    return dv
