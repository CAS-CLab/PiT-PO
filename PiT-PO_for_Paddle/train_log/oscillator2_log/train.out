def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = \
    (np.dot(x, v)**2) * (2*params[3]) + \
    4*(x**3)*v*params[3] + \
    2*x*np.dot(v, np.array([t, x]))*params[0] + \
    4*t*v*np.dot(np.sin(2*np.pi*t), x)*np.dot(params[8], np.linspace(0, 10, len(t))) + \
    np.dot(v, np.sin(2*np.pi*t))*np.sqrt((x+np.dot(v, np.ones(len(t))))**2+(t*np.cos(2*np.pi*t)-np.sin(2*np.pi*t))**2)*(2*params[4]-4*params[3])
    u = \
    (2*np.dot(x, v)) + \
    12*(x**2)*v*params[3]+ \
    2*np.dot(x, np.sin(2*np.pi*t))*np.sqrt((x+np.dot(v, np.ones(len(t))))**2+(t*np.cos(2*np.pi*t)-np.sin(2*np.pi*t))**2)*np.dot(params[8], np.linspace(0, 10, len(t))) + \
    24*(t**2)*v*params[3]+ \
    4*np.dot(np.sin(2*np.pi*t), x)*np.dot(v, np.cos(2*np.pi*t))*(2*params[6]*np.cos(2*np.pi*t)+2*np.dot(v, np.cos(2*np.pi*t)))
    return u
