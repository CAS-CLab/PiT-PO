     (x**2 + v**2)**(params[1] / 2) +
     np.cos(params[2] * x) *
     (t**2 + 2*v**2*np.sin(params[3] * t) + x**4*np.cos(params[4] * t)) +
     np.tanh(params[5] * t) * np.exp(params[6] * v) +
     np.log(x + np.sqrt(v**2 + 1))) * np.sqrt(1 - np.sinh(params[7] * x)**2)
    return a
