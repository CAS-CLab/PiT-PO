def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    params[0] * t + 
    params[1] * np.sin(params[2] * t) + 
    params[3] * ((params[4] * x + params[5] * v) + (params[6] * t - params[7])*(x+v)) +
    params[4] * x**2 * (params[8] * np.cos(params[9] * t) + 1) +
    params[5] * v**2 * (params[8] * np.cos(params[9] * t) + 1) +
    params[6] * x * (np.cos(params[2] * t) * (t - np.arcsin((v - np.sqrt(v**2 - x**2))/x))) +
    params[8] * np.tanh(params[9] * t) *
    (params[4] * x**3 + params[5] * v**2 + np.sqrt(v**2 - x**2) + 2 * np.pi * (t + np.arccos(v / np.sqrt(v**2 - x**2))))
    )

    b = (
    3 * np.sqrt(v**2 - x**2) * 
    (np.cos(params[2] * t) * (t - np.arcsin((v - np.sqrt(v**2 - x**2))/x))) +
    2 * np.pi * (t + np.arccos(v / np.sqrt(v**2 - x**2)))
    )

    dv = a + b
    return dv
