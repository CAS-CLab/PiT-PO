def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(x)*np.cos(3*np.pi*t/2)) + t*(x*np.sin(2*np.pi*t)-v*np.cos(2*np.pi*t)+np.sin(2*np.pi*t)/2) + \
    np.cos(2*np.pi*t)*(v*x*np.sin(2*np.pi*t)+np.sin(2*np.pi*t)/4) + \
    t*(np.sin(np.sqrt(x))*np.sin(2*np.pi*t)-x*np.sin(np.sqrt(x))/2) + \
    np.sin(np.sqrt(x))*(x*v-np.sin(2*np.pi*t)/2) + \
    np.sin(np.sqrt(x))*np.sin(np.sqrt(x)*np.sin(2*np.pi*t))
    b = np.sin(np.sqrt(x))*np.sin(2*np.pi*t) + np.sin(2*np.pi*t)/2 + np.exp(-0.5*np.sin(2*np.pi*t)**2)
    dv = a + b - (t*(x*np.sin(2*np.pi*t)+v*np.cos(2*np.pi*t)*np.sin(np.sqrt(x))+np.sin(2*np.pi*t)/2))
    return dv
