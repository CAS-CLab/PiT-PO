def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x))) * (x - np.sqrt(params[1]) * t)
    b = (t**2 + 2*np.sqrt(2)*t + np.sqrt(3)) / 3
    c = np.exp(-(np.sqrt(params[8]) * t)**2/2) * (np.sqrt(params[8]) * v + np.sqrt(params[9]) * np.sin(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x))))
    dv = b * a + c + \
         (np.sqrt(params[1]) * x * v**2) + \
         (np.sqrt(params[8]) * (x * v * np.sin(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x))) - b * np.cos(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x))))) + \
         (np.sqrt(2)*t * v) + \
         (np.sqrt(3)*t) + \
         (np.sqrt(params[8]) * v) + \
         (np.sqrt(params[9]) * np.sin(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x)))) + \
         (np.sqrt(params[1]) * x * np.sqrt(params[8]) * np.cos(np.sqrt(params[0]) * (np.pi*t + np.arctan2(v, x)))) + \
         (np.sqrt(2)*t * np.sqrt(params[8])) + \
         (np.sqrt(3)*t * np.sqrt(params[8])) + \
         (np.sqrt(2)*np.sqrt(params[8])*v) + \
         (np.sqrt(3)*np.sqrt(params[8])*v)
    return dv
