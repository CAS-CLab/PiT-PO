    params[0] * (x ** 2 / (params[1] ** 2) - dv ** 2 / params[2]) + 
    (params[3] * (t ** 4 / (params[4] ** 4))) * (dxdt ** 3) + 
    (params[6] * (t * dxdt / (params[7] ** 2))) + 
    (params[8] * (t * x / (params[9] ** 2)))
    )
    return dvdt
