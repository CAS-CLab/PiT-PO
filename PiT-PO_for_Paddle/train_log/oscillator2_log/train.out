def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sqrt(np.sum(x**2 + v**2)) * (v / u + np.cos(2 * np.arctan2(v, x)))
    dv = (u ** 3) * (np.dot((x * v - u**2), np.array([np.cos(2 * np.arctan2(v, x)), np.sin(2 * np.arctan2(v, x))]))) \
      + np.dot((x + v**2 / u**2), (t * np.sin(np.sqrt(1 - v**2 / u**2) * t))) \
      + (np.sin(2 * np.arctan2(v, x)) * np.dot((x + v**2 / u**2), np.sin(np.sqrt(1 - v**2 / u**2) * t))) \
      + (2 * np.tan(np.arctan2(v, x)) * (v**3 / u**3)) + np.sin(np.sqrt(1 - v**2 / u**2) * t) * np.sum(np.sin(2 * np.arctan2(v, x)) * (x * v + u**2)) \
      + (2 * np.tan(np.arctan2(v, x)) * (v * u**2)) + np.dot((x + v**2 / u**2), (t * np.sin(np.sqrt(1 - v**2 / u**2) * t))) \
      - np.dot((x + v**2 / u**2), (np.sin(2 * np.arctan2(v, x)) * t)) + np.sin(2 * np.arctan2(v, x)) * np.dot((x + v**2 / u**2), (t * np.sin(np.sqrt(1 - v**2 / u**2) * t))) \
      + 2 * np.dot((x * v - u**2), np.sin(np.sqrt(1 - v**2 / u**2) * t))
    return dv
