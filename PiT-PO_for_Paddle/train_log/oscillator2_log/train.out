def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = params[0] * x + params[1] * x**2 * v + params[2] * (v**4 + x * v**3 + x**2 * v**2) \
    + params[3] * (t**2 * x + x * v**2 + x**3 / v) + \
    params[4] * (t * x * v**2 + x * v**3 + x * v**4) \
    + params[5] * (x * v**3 + x * v**4 + x * v**5) + \
    params[6] * (t * np.sin(params[7] * t) * v + np.sin(params[7] * t) * v) \
    + params[8] * (t * v * np.cos(params[9] * t) + v * np.cos(params[9] * t))
    b = params[0] * x**2 * v**2 + params[1] * x * v**3 + params[2] * (t**2 * v + x * v**2) \
    + params[3] * (t * x * v + x * v^2) + \
    params[4] * (x * v**3 + x * v**4) + \
    params[5] * (x * v**2 + x * v**3 + x * v**4) + \
    params[6] * (x * v**3 + x * v**4 + x * v**5) + \
    params[7] * (x**2 * v**2 + v**3 * x) + \
    params[8] * (t**2 + x**2 / params[9]) + \
    params[9] * (x**2 / v**2)
    dv = a + b
    return dv
