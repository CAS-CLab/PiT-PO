def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    from numpy import sin, cos, exp

    a = np.dot(v, v) # compute acceleration squared
    b = np.dot(x, x) # compute position squared
    c = np.dot(a, v) # compute cross product of acceleration and velocity
    d = b - c # compute difference between position squared and cross product
    e = np.sin(np.sqrt(d)) # compute square root of difference
    f = np.cos(np.sqrt(b)) # compute cosine of position squared
    g = f * e # compute product of cosine and square root
    h = g * np.exp(np.sum(params[:3])) # compute exponential sum of first three coefficients multiplied by product of cosine and square root
    i = h * np.sin(2 * np.pi * t) # compute sine of twice pi times time
    j = i * np.cos(2 * np.pi * t) # compute cosine of twice pi times time
    k = j + np.sin(np.pi * t) * np.exp(np.sum(params[6:])) # compute sum of cosine of twice pi times time and sine of pi times time times exponential sum of last six coefficients
    l = k * np.exp(np.sum(np.multiply(params[3:9], np.square(v)))) # compute exponential sum of products of remaining coefficients multiplied by squares of velocity
    m = l * np.sin(np.pi * t) # compute sine of pi times time times exponential sum of products of remaining coefficients multiplied by squares of velocity
    n = m + (np.dot(x, np.dot(np.ones_like(t), v))) # compute dot product of position and ones times velocity
    o = n * np.exp(np.sum(np.multiply(params[:3], np.square(x)))) # compute exponential sum of products of first three coefficients multiplied by squares of position
    p = o * np.sin(np.pi * t) # compute sine of pi times time times exponential sum of products of first three coefficients multiplied by squares of position
    q = p + (np.dot(x, np.dot(np.ones_like(t), v))) # compute dot product of position and ones times velocity
    r = q * np.exp(np.sum(np.multiply(params[6:9], np.square(x)))) # compute exponential sum of products of last six coefficients multiplied by squares of position
    s = r * np.sin(np.pi * t) # compute sine of pi times time times exponential sum of products of last six coefficients multiplied by squares of position
    return s
