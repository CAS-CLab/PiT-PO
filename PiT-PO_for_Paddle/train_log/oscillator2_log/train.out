def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    dxdt = 2 * (x * v + np.cumsum(v**2, axis=0))
    dvdt = np.diff(x, axis=0) + v[:-1] * np.diff(np.append(0, v), axis=0)

    a = (
        np.sum((dxdt - x) * v, axis=1) + 
        np.sum(dvdt * v, axis=1) + 
        np.dot(np.cumsum(dxdt, axis=0), v) - np.dot(x, np.cumsum(v, axis=0)) + 
        np.sum(v[:, None]**3, axis=1) - 
        np.sum(x[:, None]**2 * v**2, axis=1) + 
        np.sum(x[:, None] * v**3, axis=1) + 
        np.sum(np.exp(params[5] * t[:, None]), axis=1) - 
        np.sum(np.exp(-params[6] * t[:, None]), axis=1)
    )

    a *= np.insert(params[7], 0, 1)

    b = np.insert(np.insert(np.cumsum(a, axis=1), 0, 0), 0, 0)
    b += np.insert(np.cumsum(np.diff(x, axis=0)**2 * v**2, axis=0), 0, 0)

    dvdt_result = a + b
    return dvdt_result
