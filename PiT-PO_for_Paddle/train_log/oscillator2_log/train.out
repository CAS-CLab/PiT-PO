      (x + v*(np.sin(np.sqrt(2*params[9])*t)-np.cos(np.sqrt(2*params[9])*t)))**2*params[4] + \
      2*x*v*np.cos(np.sqrt(2*params[9])*t)*np.sin(np.sqrt(2*params[9])*t)*np.tan(params[9]) + \
