     (t**2)*(np.sin(x)*np.cos(2*t)+v*x+np.cos(2*t)-2*np.sin(t)*np.cos(np.pi*x))*np.sin(2*t) + \
     (v**2)*(np.sin(x)*np.sin(np.pi*t*(x*np.cos(t)+v))+2*v*np.sin(np.pi*t*(x*np.cos(t)+v))-np.sin(2*t))/2 + \
     x*(np.sin(x)*np.sin(2*t)+v*np.sin(np.pi*t*(x*np.cos(t)+v))) + \
