        np.ones_like(x)*x,
        np.ones_like(x)*v,
        np.ones_like(t)**3,
        np.sin(np.pi*t),
        x*x*x,
        np.sin(np.pi*t)*x,
        v*v*v,
        t**2
    ]),
    np.array([params[0], 0.1*np.exp(0.02*t), 0.02*np.cos(0.03*t), 0.04*np.sin(0.08*t), 0.06*np.cos(0.08*t)])
