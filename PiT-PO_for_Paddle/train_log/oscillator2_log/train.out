    ax = (
    np.dot(
        np.array([x, v, t**2]),
        np.column_stack((np.zeros((3, 4)), 
                        np.ones((3, 4)) * 0.25,
                        np.eye(3)*0.5,
                        np.zeros((3, 4)),
                        np.eye(3),
                        np.zeros((3, 4))))
