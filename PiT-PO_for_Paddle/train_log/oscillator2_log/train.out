    (np.sin(np.sqrt(0.75 * (t**2 + x**2 + v**2))) * np.sin(np.sqrt(0.25 * (t**2 + x**2 + v**2))))* 
    (params[0] * (x + y)**2 + np.pi**2 * (y*x + z**2) + 
     np.cos(z*t)* (z*y + z**3 + t**2)*(t**2 + y**2 + z**2))
