    (np.sin(np.sqrt((x-2*v+3*t)/4)*t)-t/5) * \
    (np.tan(2*params[8]*t)+3*np.exp(-(t-1)**2/2)) + \
    (np.log(x+np.exp(-t))+v**2*params[6]-t**2*np.sin(t*4*params[5])) * \
    np.cos(4*np.arctan2(v,t))
    return a
