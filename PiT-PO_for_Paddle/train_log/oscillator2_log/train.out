     params[8] * v * np.cos(params[2] * t) + params[9] * x * np.sin(params[2] * t) * (v**2 + params[7] * v + params[8])
    dv = ax + params[10] * x * np.cos(params[2] * t) * (v**2 + params[7] * v + params[8]) + params[11] * x * np.sin(params[2] * t) * (v**2 + params[7] * v + params[8])
    return dv
