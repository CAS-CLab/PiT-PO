    ((params[1] * (x ** 2)) / (np.exp(params[2]*t) + 1)) + \
    (params[3] * v * (np.sin(params[4]*t) + params[5])) + \
    (params[6] * t**3) + \
    (params[7] * np.log(np.tanh((x + params[8]) / (np.abs(v) + 1)))) + \
    (params[9] * np.arctan(x / v))
    return a
