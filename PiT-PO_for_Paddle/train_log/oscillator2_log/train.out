    b = params[4] * (t - x) + params[5] * x ** 2 + params[6] * x * (v - a) + params[7] * (v - a) ** 2
    c = params[8] * np.sin(params[9] * t)
    dv = a + b + c + params[10] * (x * v + a * t)
    return dv
