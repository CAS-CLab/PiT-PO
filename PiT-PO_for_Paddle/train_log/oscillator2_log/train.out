    (np.sum([np.cos(2*params[2]*t)*t**5, 
              np.sin(2*params[2]*t)*(t**7-15*t**5/8+15*t**3/16)], axis=0) 
     + 
    8*np.sum([x*(np.sin(2*params[2]*(t+np.pi/2))-np.sin(2*params[2]*t)), 
               v*np.cos(2*params[2]*(t+np.pi/2))+v*np.cos(2*params[2]*t)], axis=0))
    + 
    np.sum([np.exp(np.log(t)/params[9])*t, 
            np.exp(np.log(x)/params[9])*np.cos(2*params[2]*t)])
    )/np.sum(
        [
            np.sin(2*params[2]*t),
            np.cos(2*params[2]*t),
            (t**2 + x**2)**2,
            (t**2 + x**2)**3,
            (t**2 + x**2)**4,
            (t**2 + x**2)**5,
            (t*x)**2,
            (t*v)**2,
            (x*v)**2,
            np.exp(np.log(t)/params[9]),
            np.exp(np.log(x)/params[9])
        ], axis=0)
    )
return dv
