    params[4] * (t**2 + params[5] * t + params[6]) * v + \
    params[7] * (v**2 + params[8] * v + params[9]) * np.exp(-params[10] * t)

    b = params[10] * x * (x - params[1] * np.sin(params[2] * t) - params[3] * np.cos(params[3] * t))

    dv = b * a + b
