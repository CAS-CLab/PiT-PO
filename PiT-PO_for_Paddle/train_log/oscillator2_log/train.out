    c_v = v**2 + 2*v*np.sqrt(3)/np.sqrt(2)
    d_xv = np.sqrt(2)*a_x*c_v + b_t*a_x + np.sin(np.sqrt(2)*t)*(c_v-a_x*(x-c_v))
