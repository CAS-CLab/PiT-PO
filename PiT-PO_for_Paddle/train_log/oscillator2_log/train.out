    b = params[6] * (v**2 + params[7] * v + params[8]) + params[9] * x * np.cos(params[2] * t)
    dv = b * a + b + params[10] * v**3 + params[11] * v * x + params[12] * x * np.sin(params[2] * t)
    return dv
