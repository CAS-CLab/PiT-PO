     (np.dot(x, np.array([np.sqrt(params[3]), np.sqrt(params[4])])) + \
      np.dot(v, np.array([np.sqrt(params[5]), np.cos(np.sqrt(params[7])*t)])) + \
      np.dot(t**2, np.array([np.sqrt(params[8]), np.cos(np.sqrt(params[9])*t)])))
    return a + dv
