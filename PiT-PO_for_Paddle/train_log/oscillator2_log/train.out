def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(np.sqrt(params[0]) * t) * v - \
    (np.sin(params[1] * t) / (np.pi ** 2 * (t - np.pi))) * x + \
    (np.tan(params[2] * t) / (t + np.pi)) * np.sin(np.sqrt(params[3]) * (t - np.pi)) + \
    (np.exp(-np.cosh(2 * np.arctanh(np.sqrt(params[4]))) * t) * \
     (np.cosh(np.sqrt(2 * np.log(2)) * (t - np.pi)) * v + \
      np.tanh(np.sqrt(2 * np.log(2)) * (t - np.pi)) * x))
    a = u + \
    (np.cos(np.sqrt(5) * t) / (np.pi ** 2)) * x + \
    (-np.sin(np.sqrt(5) * t) / (np.pi ** 2 * (t - np.pi))) * v + \
    (np.cos(np.sqrt(6) * t) / (t + np.pi)) * v + \
    (np.sin(np.sqrt(6) * t) / (t + np.pi)) * x + \
    (np.exp(-(np.sqrt(7) - 1) * np.arcsinh(np.sqrt(params[8]))) * \
     (np.cosh((np.sqrt(7) - 1) * np.arcsinh(np.sqrt(params[8]))) * v + \
      np.sinh((np.sqrt(7) - 1) * np.arcsinh(np.sqrt(params[8]))) * x))
    return a
