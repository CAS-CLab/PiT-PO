def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(params[2] * t) * (x - params[1] * (t**2 + params[4] * t + np.exp(-params[0] * t)))
    b = (t**2 + np.exp(-params[0] * t)) * (v**2 + np.cos(params[2] * t) * (x - params[1] * np.sin(params[2] * t)))
    c = np.exp(-params[0] * t) * (v**2 + np.cos(params[2] * t) * (x - params[1] * np.sin(params[2] * t))) + \
    np.cos(params[2] * t) * (a * (t**2 + np.exp(-params[0] * t)) + np.sin(params[2] * t) * (x - params[1] * (t**2 + np.exp(-params[0] * t))))
    dv = (b * a + c + (x - params[1] * np.sin(params[2] * t)) * (np.cos(params[2] * t) * (v**2 + np.cos(params[2] * t) * (x - params[1] * np.sin(params[2] * t)))) +
      (x**2 + np.cos(params[2] * t) * (v**2 + np.cos(params[2] * t) * (x - params[1] * np.sin(params[2] * t)))) ** 2 +
      (t**2 + np.exp(-params[0] * t)) ** 3 + np.sin(params[2] * t) * x * (v**2 + np.cos(params[2] * t) * (x - params[1] * np.sin(params[2] * t))))
    return dv
