    # Compute derivatives of position and velocity with respect to time
    dxdt = 2 * (x * v + np.cumsum(v**2, axis=0))
    dvdt = np.diff(x, axis=0) + v[:-1] * np.diff(np.append(0, v), axis=0)

    # Define acceleration using the chain rule
    a = (
        np.sum((dxdt - x) * v, axis=1) + 
        np.sum(dvdt * v, axis=1) + 
        np.dot(np.cumsum(dxdt, axis=0), v) - np.dot(x, np.cumsum(v, axis=0)) + 
        np.sum(v[:, None]**3, axis=1) - 
        np.sum(x[:, None]**2 * v**2, axis=1) + 
        np.sum(x[:, None] * v**3, axis=1) + 
        np.sum(np.exp(params[5] * t[:, None]), axis=1) - 
        np.sum(np.exp(-params[6] * t[:, None]), axis=1)
    )

    # Scale coefficients to match original equations
    a *= np.insert(params[7], 0, 1)

    # Scale coefficients to match original equations
    b = np.insert(np.insert(np.cumsum(a, axis=1), 0, 0), 0, 0)
    b += np.insert(np.cumsum(np.diff(x, axis=0)**2 * v**2, axis=0), 0, 0)

    # Compute acceleration as the sum of terms
    dvdt_result = a + b
    return dvdt_result
