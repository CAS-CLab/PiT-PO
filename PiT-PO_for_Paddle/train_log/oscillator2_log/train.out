    b = np.sum([x[i]**3*np.exp(-(i+1)*np.pi/2) for i in range(4)]) + \
    np.sum([x[i]*np.cos(np.pi/2*i)*np.exp(-(i+1)*np.pi/2) for i in range(4)]) + \
    np.sum([v[i]**2*np.exp(-np.pi*(i+1)/2) for i in range(4)]) + \
    np.sum([t*np.cos(np.pi/2*i)*np.sin(v[i]) for i in range(4)]) + \
    np.sum([x[i]*np.exp(-(i+1)*np.pi/2) for i in range(4)]) + \
    np.sum([v[i]*np.sin(np.pi/2*i)*np.exp(-i*np.pi/2) for i in range(4)])
    c = b + 0.1*np.tanh(np.sum([x[i]*np.exp(-i*np.pi/2) for i in range(4)]))
    dv = a + c
    return dv
