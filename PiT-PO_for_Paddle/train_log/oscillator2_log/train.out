    b = np.cos(4*x)/np.tan(np.pi/2*np.sin(t)) - 5*(x + 2*t*v)
    c = (x - t*v)**3/(np.abs(np.sin(3*t))**2) - np.cos(2*x)*np.exp(-t)
    dv = a + b + c
    return dv
