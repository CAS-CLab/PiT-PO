def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.sin(np.sqrt(1+np.cos(2*params[2]*t))*x)
    v0 = np.sqrt(u**2 + (u*(np.cos(2*params[2]*t)-1)*v)**2/((1-np.cos(2*params[2]*t))**2))
    a = v0*(np.cos(2*params[2]*t)/np.sqrt((1-np.cos(2*params[2]*t))**2 + (u*(np.cos(2*params[2]*t)-1))**2))
    b = 1/(1-np.cos(2*params[2]*t))
    c = b*np.dot(v, u)
    d = b*np.cos(2*params[2]*t)*(b*v0-u*(np.cos(2*params[2]*t)))
    e = b*np.cos(2*params[2]*t)*np.dot((u*(np.cos(2*params[2]*t)-1)), v)
    f = np.sin(2*params[2]*t)/(b*(1-np.cos(2*params[2]*t)))
    g = (np.sin(2*params[2]*t)/(1-np.cos(2*params[2]*t))) * np.dot(v, (u*(np.cos(2*params[2]*t)-1)))
    h = b*np.cos(2*params[2]*t)*g
    i = u*h
    j = np.sin(2*params[2]*t)*i
    k = (b*f)*i
    l = j + (k-2*i)*v
    m = u*l
    n = u*d
    o = v0*b*c
    p = d-o
    q = f*m - g*n
    r = np.pi/2 - np.arccos(b*np.cos(2*params[2]*t))
    s = np.tan(r)*q
    return (s-b*o+b*np.dot(v,v0))*(f-d+(c-s)*d/2-(e-i+n/2)*d/2)
