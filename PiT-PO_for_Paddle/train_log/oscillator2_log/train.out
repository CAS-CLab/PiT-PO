def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(1+2*params[0])*t) * (x - np.tanh(params[1]*np.sin(np.sqrt(1+2*params[0])*t)))
    b = (t**2 + 2*np.exp(-np.log(2)*np.sqrt(1+2*params[0]))*t + 3*np.exp(-np.log(2)*np.sqrt(1+2*params[0])**2)*t**2)*(x - np.cos(np.sqrt(1+2*params[0])*t))
    c = (v**2 + 2*np.exp(-np.log(2)*np.sqrt(1+2*params[0]))*v + 3*np.exp(-np.log(2)*np.sqrt(1+2*params[0])**2)*t**2)*np.tanh(np.sqrt(1+2*params[0]))
    dv = b*a + c + ((x**2 + 2*v**2)/np.exp(-np.log(2)*np.sqrt(1+2*params[0])))*(np.sin(np.sqrt(1+2*params[0])*t)-np.sin(np.sqrt(1+2*params[0])*t)) + \
      ((t**2 + 2*np.exp(-np.log(2)*np.sqrt(1+2*params[0]))*t + 3*np.exp(-np.log(2)*np.sqrt(1+2*params[0])**2)*t**2))/np.exp(-np.log(2)*np.sqrt(1+2*params[0]))
    return dv
