def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = (
    (np.sum([params[0], np.sum([params[3]*x**i * v**(j-i+1) for i in range(1,3) for j in range(i)])]) + 
    2*np.sum([params[4]*x*v + params[8]*(x*t+v*(t-1/2)*np.sin(params[2]*t)) for _ in range(2)])) / 3 + 
    np.sum([params[5]*(x**2 + 2*x*v*t + v**2*t**2) for _ in range(2)]) + 
    np.sum([params[6]*x*v*(t**2 - t/2*(t-1)**2*np.sin(params[2]*t)) for _ in range(2)]) + 
    np.sum([params[7]*(x**3)*(t-1)**3*np.sin(params[2]*t)/12 for _ in range(2)])
    )

    b = (
    np.sum([params[8]*(v**2)*(t-1/2)**2*np.sin(params[2]*t) for _ in range(2)]) + 
    np.sum([params[9]*np.cos(params[2]*t)*(t-1/2)**3 for _ in range(2)])
    )

    return a + b
