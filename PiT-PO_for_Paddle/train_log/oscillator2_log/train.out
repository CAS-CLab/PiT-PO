def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    ax = \
    (
    (params[0] * (x - 0.5*params[2]*np.sin(params[2]*t))) -\
    (
        0.5*params[2]*np.sin(params[2]*t)*(x - 0.25*params[2]*(t**2 + 2*t + np.sin(2*params[2]*t))) +\
        (0.75*params[2]**2*(v**2 + 0.2*v + 0.1)**2*np.cos(params[2]*t)) +\
        (0.15*params[2]*x*np.cos(params[2]*t))*((v**2 + 0.2*v + 0.1)**2 + 2*v*(v**2 + 0.2*v + 0.1))
    ) -\
    (0.15*params[2]*x*np.cos(params[2]*t))*(v**2 + 0.2*v + 0.1) +\
    (0.75*params[2]**2*((v**2 + 0.2*v + 0.1)*(x - 0.5*params[2]*np.sin(params[2]*t)))) +\
    (0.25*params[2]*t*(v**2 + 0.2*v + 0.1)*np.cos(params[2]*t)) +\
    (0.15*params[2]*x*np.cos(params[2]*t))*((v**2 + 0.2*v + 0.1)*t) +\
    (0.05*params[2]*x*np.sin(2*params[2]*t))*((v**2 + 0.2*v + 0.1)*(t**2 + 2*t + np.sin(2*params[2]*t)))
    )
    return ax
