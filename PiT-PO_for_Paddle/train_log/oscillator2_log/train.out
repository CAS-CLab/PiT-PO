    b = 0.1*(np.cos(2*np.pi*t) + np.exp(-(t-0.5)**2)*x)
    c = 0.05*(np.sin(5*np.pi*x) + np.tanh(v)*t)
    d = np.dot((x+v), np.array([x-v, 0]))
    dv = a + b + c + d
    return dv
