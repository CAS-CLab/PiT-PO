    (params[1] * (x ** 2)) + \
    (params[2] * v) + \
    ((- (t ** 2) * (params[3] * np.exp(-(t ** 2)))) / \
     ((1 - (t ** 2)) ** (3/2))) + \
    ((t * (v ** 2)) / \
     (4 * (np.sqrt((t ** 2) - 1)))) + \
    (np.tanh(x) * (np.sinh(v) * t))
    return a
