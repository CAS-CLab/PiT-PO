    params[0] * t**2 + 
    params[1] * t * (x + params[2] * v) + 
    params[3] * (x + params[2] * v)**2 + 
    params[4] * x * v + 
    params[5] * v**2 + 
    params[6] * x * np.sin(params[7] * t) + 
    params[8] * v * np.cos(params[9] * t)
    )
    return a
