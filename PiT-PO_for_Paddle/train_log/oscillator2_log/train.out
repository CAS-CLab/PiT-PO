def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(t**2 + 2*t + 1) * np.pi/2) * x - np.sin(3*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * np.sin(params[2] * t)
    b = (t + np.sqrt(t**2 + 2*t + 1) + np.sin(3*np.sqrt(t**2 + 2*t + 1) * np.pi/2)) ** 2 * np.sin(np.sqrt(t**2 + 2*t + 1) * np.pi/2)
    c = v**2 * np.cos(2*np.sqrt(t**2 + 2*t + 1) * np.pi/2) + v * np.cos(4*np.sqrt(t**2 + 2*t + 1) * np.pi/2)
    d = np.cos(3*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * np.cos(2*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * v
    e = b * a + c + d * v + 0.5 * np.sin(2*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * (x - np.sin(3*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * np.sin(params[2] * t))
    f = e + np.sin(np.sqrt(t**2 + 2*t + 1) * np.pi/2) * (np.sin(np.sqrt(t**2 + 2*t + 1) * np.pi/2) * x - 0.25 * np.sin(3*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * np.sin(2*np.sqrt(t**2 + 2*t + 1) * np.pi/2) * v)
    return f
