def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = \
    (np.sqrt(np.sum((t*x-v)**2))*np.sin(2*np.pi*(t-1))) +\
    (np.sqrt(np.sum(x**2))*np.cos(2*np.pi*(t-2))) +\
    (np.sqrt(np.sum(v**2))*np.sin(2*np.pi*(t-3))) +\
    (np.sqrt(np.sum((x+np.sin(2*np.pi*(t-4)))*v)))*(np.cos(2*np.pi*(t-5))) +\
    (np.sqrt(np.sum(x*v)))*np.cos(2*np.pi*(t-6)) +\
    (np.sqrt(np.sum((x+np.sin(2*np.pi*(t-7)))*v)))*(np.cos(2*np.pi*(t-8))) +\
    (np.sqrt(np.sum((x+np.sin(2*np.pi*(t-9)))*v)))*(np.cos(2*np.pi*(t-10)))
    u = np.sqrt(np.sum((x-v)**2))
    dv = u + np.sqrt(np.sum((x+v)**2))*np.sin(2*np.pi*(t-11)) +\
     np.sqrt(np.sum(x**2))*(np.cos(2*np.pi*(t-12))) +\
     np.sqrt(np.sum(v**2))*(np.cos(2*np.pi*(t-13))) +\
