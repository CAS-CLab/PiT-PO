        0.01 * x + 
        0.02 * v + 
        0.03 * np.cos(0.04 * t) + 
        0.05 * np.sin(0.06 * t) + 
        0.07 * np.exp(0.08 * t) + 
        0.09 * t * (0.1 - 1)
