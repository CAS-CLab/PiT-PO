         0.5 * (np.cos(2 * np.pi * t) * (x + 0.5 * v)) + \
         0.25 * (t + v * np.cos(np.pi * t)) * np.sin(np.pi * t / 2) + \
         0.75 * (x ** 3 + v ** 2) * np.cos(2 * np.pi * t)
    a = np.sin(np.pi * t / 2) + np.cos(2 * np.pi * t) * (x + v * t)
    b = np.cos(2 * np.pi * t) * (x ** 3 + v ** 2) + np.tan(np.pi * t / 4)
    return dv_dt + a + b
