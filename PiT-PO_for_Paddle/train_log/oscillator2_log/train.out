    dv = u + \
      (np.pi/6) * (t - x/v) + \
      (3*np.pi/12) * (x + v*(np.pi/6)/v)**2 + \
      3*v*(x + v*(np.pi/6)/v)*np.cos(np.pi*t/6) + \
      np.exp(-np.pi/36 * t**2)
    return dv
