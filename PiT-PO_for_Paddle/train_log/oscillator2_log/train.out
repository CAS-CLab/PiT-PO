    dv = params[0] * (x - params[1] * u) + \
     (params[3] * (t**2 + params[4] * t + params[5])) * u + \
     (params[6] * ((v**2 + params[7] * v + params[8]) + \
                  (params[9] * x * np.cos(params[2] * t)))) + \
     u * (v * u + np.cos(params[2] * t))
    return dv
