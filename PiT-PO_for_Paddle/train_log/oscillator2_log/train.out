def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    u = np.multiply(x, v)
    dv = u + np.sin(np.multiply(params[2], t)) + \
     np.multiply(np.add(np.multiply(params[4], (x + np.multiply(params[5], v))), np.multiply(0.5, np.sin(np.multiply(2*np.pi, t)))), np.sin(np.multiply(2*np.pi, t))) + \
     np.multiply(v, np.cos(np.multiply(params[9], t)))
    a = np.multiply(t, np.multiply(params[0], 2)) + np.multiply(u, np.multiply(0.75, np.sin(np.multiply(3*np.pi, t)))) + \
     np.multiply(params[6], t**2)
    b = np.multiply(x**3, np.multiply(params[7], 4)) + np.multiply(v**2, np.multiply(params[8], 0.25)) - np.multiply(np.cos(np.multiply(2*np.pi, t)), np.multiply(np.sin(np.multiply(3*np.pi, t))))
    return np.add(a, b)
