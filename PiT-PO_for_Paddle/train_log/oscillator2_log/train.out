def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum(np.array([
    (np.dot(params[:5], x) + np.dot(x, v) + np.dot(v, x)),
    np.dot(x, v),
    np.dot(x, v)**2,
    0.5*np.dot(x, np.sin(2*params[6]*t)),
    np.dot(v, np.cos(2*params[9]*t)),
    0.5*np.dot(v, np.sin(2*params[2]*t))
    ]) +
    np.dot(t, np.dot(params[5], np.dot(x, v))) -
    np.dot(x, v)*np.dot(np.dot(params[6], np.sin(2*params[7]*t)), t))

    u = np.dot(params[0], x*v)

    dv = u + np.dot(np.sin(2*params[2]*t), t) + \
     np.dot(np.sin(2*params[6]*t), np.dot(x, v)) + \
     np.dot(np.sin(2*params[8]*t), np.dot(x, v)) + \
     np.dot(np.sin(2*params[7]*t), np.dot(x, v)) + \
     np.dot(x, v)*np.cos(2*params[2]*t) + \
     np.dot(x, v)*np.cos(2*params[9]*t) + \
     0.25*np.dot(x, np.sin(4*params[2]*t)) + \
     0.25*np.dot(x, np.sin(4*params[6]*t))

    dVdt = (dv +
         np.dot(np.sin(2*params[2]*t), t) + 
         np.dot(np.sin(2*params[9]*t), v) + 
         np.dot(np.sin(2*params[8]*t), v) + 
         np.dot(x, v)*(np.sin(2*params[6]*t) + np.sin(2*params[7]*t)) + 
         np.dot(x, v)*(2*np.dot(np.cos(2*params[2]*t), t) + 2*np.dot(np.cos(2*params[9]*t), t)))

    return dVdt
