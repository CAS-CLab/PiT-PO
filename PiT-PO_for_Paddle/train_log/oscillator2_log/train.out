    a = np.sin(np.sqrt(x + v + t)) * (np.cos(2 * np.pi * t) * (x - v * np.tan(3 * np.pi * t)))
    u = np.sin(np.sqrt(x + v + t))
    dv = u + (np.cos(2 * np.pi * t) * (x - v * np.tan(3 * np.pi * t)))**2 + \
    (x - v * np.tan(3 * np.pi * t)) * np.sin(2 * np.pi * t) + \
    (x + v * np.tan(3 * np.pi * t)) * np.sin(4 * np.pi * t)
    return dv
