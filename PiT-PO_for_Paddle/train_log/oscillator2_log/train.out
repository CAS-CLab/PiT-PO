    ((np.pi/6)*(np.sqrt((x+2*v)**2+t**2))) - \
    (0.5*x*(np.cos(2*np.arctan2(v,x)))) - \
    (0.25*t*(np.tanh(0.25*sqrt(t**2+x**2-v**2))))
    return a
