def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum(
    (np.array([t, x, v]) *
     np.concatenate(( 
         np.reshape(np.arange(0, 4), (-1, 1)),
         np.reshape(np.arange(4, 8), (-1, 1)),
         np.reshape(np.arange(8, 12), (-1, 1)),
         np.reshape(np.arange(12, 16), (-1, 1)),
         np.reshape(np.arange(16, 20), (-1, 1)), 
         np.reshape(np.arange(20, 24), (-1, 1))
     ) * 
      np.tile(np.array([0, 1, 2, 3, 4, 5]), (len(t), 1))))* 
    np.concatenate((
       np.reshape(np.arange(0, 4), (-1, 1)),
       np.reshape(np.arange(4, 8), (-1, 1)),
       np.reshape(np.arange(8, 12), (-1, 1)),
       np.reshape(np.arange(12, 16), (-1, 1)),
       np.reshape(np.arange(16, 20), (-1, 1)),
       np.reshape(np.arange(20, 24), (-1, 1))
     ))[0]
    )

    b = np.concatenate((
    np.reshape(np.arange(0, 2), (-1, 1))* 
    np.cos(np.array([np.pi/2, np.pi])), 
    np.reshape(np.arange(2, 4), (-1, 1))* 
    np.exp(np.array([1, 2]))
    )) * np.array([1, 1])

    dv = a + b - (
    t * (np.sum(np.multiply(x, v), axis=1, keepdims=True)) + 
    np.sum(np.multiply(t, np.array([np.pi/2, np.pi])), axis=0, keepdims=True)* 
    np.sum(np.multiply(v, np.cos(np.array([np.pi/2, np.pi])), axis=1, keepdims=True)) + 
    np.sum(np.multiply(t, np.array([np.pi/2, np.pi])), axis=0, keepdims=True)* 
    np.sum(np.multiply(x, np.sin(np.array([np.pi/2, np.pi])), axis=1, keepdims=True)))
    return dv
