        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sum(
    [
        (t**2)*(np.cos(np.sqrt(2*params[9])*t)*np.sin(np.sqrt(2*params[9])*t)/np.sqrt(2*params[9])),
        t*x*np.sin(np.sqrt(2*params[9])*t),
        t*v*(np.cos(np.sqrt(2*params[9])*t)+np.sin(np.sqrt(2*params[9])*t)),
        x**2*np.sin(np.sqrt(2*params[9])*t),
        x*v*(np.sin(np.sqrt(2*params[9])*t)-np.cos(np.sqrt(2*params[9])*t)),
        v**2*(np.sin(np.sqrt(2*params[9])*t)**2/np.sqrt(2*params[9])+(np.cos(np.sqrt(2*params[9])*t))**2/np.sqrt(2*params[9]))
