def equation(t: np.ndarray, x: np.ndarray, v: np.ndarray, params: np.ndarray) -> np.ndarray:
    """ Mathematical function for acceleration in a damped nonlinear oscillator

    Args:
        t: A numpy array representing time.
        x: A numpy array representing observations of current position.
        v: A numpy array representing observations of velocity.
        params: Array of numeric constants or parameters to be optimized

    Return:
        A numpy array representing acceleration as the result of applying the mathematical function to the inputs.
    """
    a = np.sin(np.sqrt(np.sum((x - np.sin(params[2]*t)**2))) * np.pi*params[0])
    b = np.cos(np.sqrt(np.sum((x - np.sin(params[2]*t)**2))) * np.pi*params[1])
    c = np.sinh(np.sqrt(np.sum((v - np.cosh(params[8]*t)**2))) * np.pi*params[2])
    d = np.exp(-(np.sum(((t - np.arcsin(params[1]*np.sin(params[2]*t)))**2))))*params[3]
    e = d * v + b * a * np.sin(np.pi*params[2]*t) + c * np.sinh(np.pi*params[8]*t) + np.sum((x - np.sin(params[2]*t)**2) * np.sin(np.pi*(t - np.arcsin(params[1]*np.sin(params[2]*t)))))
    f = e + np.sum((x - np.sin(params[2]*t)**2) * np.sin(np.pi*(t - np.arcsin(params[1]*np.sin(params[2]*t)))) * np.cos(np.pi*params[2]*t)) + np.sum((t - np.arcsin(params[1]*np.sin(params[2]*t)))**2) * np.sin(np.pi*params[2]*t) + np.sum((v - np.cosh(params[8]*t)**2) * np.sinh(np.pi*params[8]*t))
    g = np.sin(f) + d * v + b * a * np.cos(np.pi*params[2]*t) + np.sum((x - np.sin(params[2]*t)**2) * np.sin(np.pi*(t - np.arcsin(params[1]*np.sin(params[2]*t)))) * np.cos(np.pi*params[2]*t)) + np.sum((v - np.cosh(params[8]*t)**2) * np.sinh(np.pi*params[8]*t))
    return g
