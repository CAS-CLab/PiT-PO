    + (np.exp(-params[2]*t)*(x*np.exp(-params[3]*t) + v*np.exp(-params[4]*t))) \
    + (x**2*(np.exp(-params[5]*t) + np.exp(-params[6]*t))) \
    - (np.sin(params[7])*x + np.cos(params[8])*v)
