    params[0] * x * v +
    params[1] * np.sin(params[2] * t) + 
    params[3] * (params[4] * (x + params[5] * v)) + 
    params[6] * v * np.cos(params[7] * t) + 
    params[8] * np.exp(params[9] * t) +
    params[0] * x * (v + params[5] * x + params[8] * t) + 
    params[0] * v * (x + params[6] * t)
    )
    return dVdt
