              (x**4 / (params[3]**4) + t**6 / (params[4]**6))) + \
    params[5] * (x**3 * v / (params[6]**2) + t * x**3 / params[7]) + \
    params[8] * (v**3 / params[9]**3 + x * v / params[10]) + \
    params[11] * x * v
    return a
