    (params[1] * x - 2*params[2] * t * v) + 
    (params[3] * x + 2*params[4] * v) + 
    (params[5] * (v**2 + 0.25*(x**2 - 4*t*v))) + 
    (params[6] * (t*v + x)) * np.cos(2*np.pi/3 * t) + 
    (np.sqrt(3)/2 * x * (t**2 + 0.75*x)) 
    )
    return a
