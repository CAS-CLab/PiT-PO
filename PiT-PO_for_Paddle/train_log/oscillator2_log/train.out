    a = (x*dot(v, v)-dot(x, v)*power(v, 2))/power(power(v, 2)+power(x, 2))
    b = (dot(dot(v, v), v)+dot(v, x)) / (power(power(v, 2)+power(x, 2))**(3/2))
    c = (dot(v, x)/2 - dot(v, v)*(x+power(x, 2)/2)) / power(power(v, 2)+power(x, 2))
    d = (dot(v, x) - dot(v, v)*x) / (2*power(power(v, 2)+power(x, 2)))
    e = (sin(2*params[2]*t)*cos(params[1]*t))/2
    f = (exp(-power(params[2], 2)*power(v, 2))*cos(2*params[2]*t))/(exp(-power(params[2], 2)*power(v, 2))*(power(power(v, 2)+power(x, 2))**(3/2)))
    g = (exp(-power(params[2], 2)*power(v, 2))*sin(2*params[2]*t))/(2*power(power(v, 2)+power(x, 2)))
    h = (exp(-power(params[2], 2)*power(v, 2))*exp(-power(params[2], 2)*power(x, 2)))/(2*power(power(v, 2)+power(x, 2)))
    return a+b+c+d+f+e-g-h
